        "gaps": [
          {
            "problem": "A full re-overlay repair or GitHub update rewrites an IsolatedFolder clone's manifest with clonedAoe3:false and aoe3SourcePath:null.",
            "impact": "After the first repair or full update of any cloned mod (all 5 installable mods today), uninstall does an overlay-only removal and leaves the multi-GB AoE3 clone on disk. It also erases the source path a smarter base-file repair would need.",
            "evidence": "NativeInstallService.cs:626-628 vs delta path 795; UninstallService.cs:183-197, 347-348"
