            "evidence": "NativeInstallService.cs:2605, 2634-2642, 2702-2729; InstallManifest.cs:97-188; VerifyService.cs:60-69",
            "verified": true
          },
          {
            "claim": "The only consumers of InstallManifest.Files are the diagnostic FindUnexpectedFiles and InstallSnapshot's file count; nothing uses it to decide where a file came from",
            "evidence": "grep: VerifyService.cs:293, InstallSnapshot.cs:104 (TranslationService Files hits are the translation manifest, a different type)",
