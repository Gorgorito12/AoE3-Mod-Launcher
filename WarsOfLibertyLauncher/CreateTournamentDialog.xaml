<Window x:Class="WarsOfLibertyLauncher.CreateTournamentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="New tournament"
        Width="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="UiTitleText" Color="#F4F8FC"/>
    </Window.Resources>
    <!-- Design 81, the twin of the create-room window: the window of the chosen mod, three glass
         cards in two columns, and Cancel beside the one primary button. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Star, not Auto: once MaxHeight clamps the window it is the row that gives. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl" TitleSize="14"
                           ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
            <Grid Margin="22,22,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Which tournament. The mod goes first: every room of the bracket is created
                         with it, and the proposed name follows it. -->
                    <Border x:Name="WhatCard" Style="{DynamicResource WindowCard}" Padding="16,14">
                        <StackPanel>
                            <StackPanel x:Name="ModBlock" Visibility="Collapsed" Margin="0,0,0,14">
                                <TextBlock x:Name="ModLabel" Style="{DynamicResource WindowCardLabel}"/>
                                <Button x:Name="ModPickButton" Style="{DynamicResource GlassPickButton}" Margin="0,7,0,0"
                                        Click="ModPickButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource WindowSecondary}">
                                            <Border x:Name="ModIconHost" CornerRadius="6"/>
                                        </Border>
                                        <TextBlock x:Name="ModNameText" Grid.Column="1" Margin="10,0,8,0"
                                                   FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource UiHeadText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border x:Name="ModInstalledChip" Grid.Column="2" Height="22" Padding="9,0" CornerRadius="11"
                                                Margin="0,0,8,0" BorderThickness="1" Background="#1F4FD68A" BorderBrush="#594FD68A">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#4FD68A" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ModInstalledText" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource SetCaptionSize}" FontWeight="SemiBold"
                                                           Foreground="#8FE0B0"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="ModChevron" Grid.Column="3" Text="&#x25BE;"
                                                   FontSize="{DynamicResource SetCaptionSize}"
                                                   Foreground="{DynamicResource UiMutedText}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NameLabel" Style="{DynamicResource WindowCardLabel}"/>
                                <TextBlock x:Name="NameCount" Grid.Column="1"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="{DynamicResource SetDescSize}"
                                           Foreground="{DynamicResource WindowFineText}"/>
                            </Grid>
                            <Border x:Name="NameField" Style="{DynamicResource GlassFieldBox}" Height="36" Margin="0,7,0,0">
                                <TextBox x:Name="NameEntry" Style="{DynamicResource DialogBareText}" MaxLength="80"
                                         FontSize="{DynamicResource FontSizeBody}"
                                         TextChanged="NameEntry_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="NameProblem" Style="{DynamicResource GlassHint}" Visibility="Collapsed"
                                       Margin="0,7,0,0" Foreground="#F5BD76"/>
                        </StackPanel>
                    </Border>

                    <!-- How it is played. How teams are formed exists only for a team format. -->
                    <Border x:Name="HowCard" Style="{DynamicResource WindowCard}" Padding="16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="FormatLabel" Style="{DynamicResource WindowCardLabel}"/>
                            <controls:SegmentRow x:Name="FormatRow" Raised="True" SegmentHeight="50" Margin="0,6,0,0"/>
                            <TextBlock x:Name="FormatWhy" Style="{DynamicResource GlassHint}" Margin="0,6,0,0" Foreground="#A8BCD2"/>

                            <StackPanel x:Name="TeamSourceBlock" Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBlock x:Name="TeamSourceLabel" Style="{DynamicResource WindowCardLabel}"/>
                                <StackPanel x:Name="SourceRows" Margin="0,7,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Who gets in. -->
                <Border x:Name="WhoCard" Grid.Column="2" Style="{DynamicResource WindowCard}" Padding="16,14" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="EntryModeLabel" Style="{DynamicResource WindowCardLabel}"/>
                        <controls:SegmentRow x:Name="EntryRow" Raised="True" SegmentHeight="36" Margin="0,6,0,0"/>
                        <TextBlock x:Name="EntryWhy" Style="{DynamicResource GlassHint}" Margin="0,6,0,0" Foreground="#A8BCD2"/>

                        <TextBlock x:Name="CapacityLabel" Style="{DynamicResource WindowCardLabel}" Margin="0,14,0,0"/>
                        <controls:SegmentRow x:Name="CapacityRow" Raised="True" SegmentHeight="36" Margin="0,6,0,0"/>

                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MathPlayersCard" Style="{DynamicResource TournamentMathCard}">
                                <StackPanel>
                                    <TextBlock x:Name="MathPlayers" Style="{DynamicResource TournamentMathFigure}"/>
                                    <TextBlock x:Name="MathPlayersWord" Style="{DynamicResource TournamentMathWord}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MathRoundsCard" Grid.Column="2" Style="{DynamicResource TournamentMathCard}">
                                <StackPanel>
                                    <TextBlock x:Name="MathRounds" Style="{DynamicResource TournamentMathFigure}"/>
                                    <TextBlock x:Name="MathRoundsWord" Style="{DynamicResource TournamentMathWord}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MathRoomsCard" Grid.Column="4" Style="{DynamicResource TournamentMathCard}">
                                <StackPanel>
                                    <TextBlock x:Name="MathRooms" Style="{DynamicResource TournamentMathFigure}"/>
                                    <TextBlock x:Name="MathRoomsWord" Style="{DynamicResource TournamentMathWord}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="WaitlistHint" Style="{DynamicResource GlassHint}" Margin="0,6,0,0"
                                   Foreground="#8C9CB1"/>

                        <Border Margin="0,12,0,0" Padding="0,11,0,0" BorderThickness="0,1,0,0" BorderBrush="#14FFFFFF"
                                Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OpenRow_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock x:Name="OpenTitle" Style="{DynamicResource GlassRowTitle}"
                                               FontSize="{DynamicResource DialogBodySize}"/>
                                    <TextBlock x:Name="OpenWhy" Style="{DynamicResource GlassHint}" Margin="0,3,0,0"
                                               Foreground="#A8BCD2"/>
                                </StackPanel>
                                <ToggleButton x:Name="OpenToggle" Grid.Column="1" Style="{DynamicResource GlassToggle}"
                                              VerticalAlignment="Center" IsChecked="True"
                                              Checked="OpenToggle_Changed" Unchecked="OpenToggle_Changed"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="22,18,22,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Style="{DynamicResource GlassRowBody}" Foreground="#F5BD76"
                       Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Grid.Column="1" Style="{DynamicResource WindowSecondaryButton}"
                    MinWidth="112" FontSize="{DynamicResource SetRowDescSize}" IsCancel="True" Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Grid.Column="2" Style="{DynamicResource WindowPrimaryButton}"
                    MinWidth="136" Padding="16,0" Margin="8,0,0,0" FontSize="{DynamicResource SetRowDescSize}"
                    ToolTipService.ShowOnDisabled="True" IsDefault="True" Click="OkButton_Click"/>
        </Grid>
    </Grid>
</Window>
