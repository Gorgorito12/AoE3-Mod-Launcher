<Window x:Class="WarsOfLibertyLauncher.CreateTournamentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="New tournament"
        Width="780"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="UiTitleText" Color="#F4F8FC"/>
    </Window.Resources>
    <!-- Design 81, laid out again by design 108 (docs/design_14nov): the window of the chosen mod,
         two glass cards of the same height, the summary under them, and Cancel beside the one
         primary button. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Star, not Auto: once MaxHeight clamps the window it is the row that gives. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl" TitleSize="14"
                           ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel Margin="22,16,22,0">
                <!-- Design 108: two columns of the same height, the TOURNAMENT on the left and the
                     REGISTRATION on the right; under them, at full width, how teams are formed (team
                     formats only) and the summary. Nothing here has a fixed height that could cut a
                     line: every box grows with its text. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- The tournament: mod, name, format, places. -->
                    <Border x:Name="WhatCard" Style="{DynamicResource WindowCard}" Padding="16,14">
                        <StackPanel>
                            <StackPanel x:Name="ModBlock" Visibility="Collapsed" Margin="0,0,0,14">
                                <TextBlock x:Name="ModLabel" Style="{DynamicResource WindowCardLabel}"/>
                                <Button x:Name="ModPickButton" Style="{DynamicResource GlassPickButton}" Margin="0,7,0,0"
                                        Click="ModPickButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource WindowSecondary}">
                                            <Border x:Name="ModIconHost" CornerRadius="6"/>
                                        </Border>
                                        <TextBlock x:Name="ModNameText" Grid.Column="1" Margin="10,0,8,0"
                                                   FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource UiHeadText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border x:Name="ModInstalledChip" Grid.Column="2" MinHeight="22" Padding="9,0" CornerRadius="11"
                                                Margin="0,0,8,0" BorderThickness="1" Background="#1F4FD68A" BorderBrush="#594FD68A">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#4FD68A" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ModInstalledText" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource SetCaptionSize}" FontWeight="SemiBold"
                                                           Foreground="#8FE0B0"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- A drawn chevron that turns over while the list is open, never the character. -->
                                        <Path x:Name="ModChevron" Grid.Column="3" Width="10" Height="6"
                                              Data="M1 1l4 4 4-4" Stroke="{DynamicResource UiMutedText}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="ModChevronTurn" Angle="0"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NameLabel" Style="{DynamicResource WindowCardLabel}"/>
                                <TextBlock x:Name="NameCount" Grid.Column="1"
                                           FontFamily="Consolas, Courier New, monospace"
                                           FontSize="{DynamicResource SetDescSize}"
                                           Foreground="{DynamicResource WindowFineText}"/>
                            </Grid>
                            <Border x:Name="NameField" Style="{DynamicResource GlassFieldBox}" Height="36" Margin="0,7,0,0">
                                <TextBox x:Name="NameEntry" Style="{DynamicResource DialogBareText}" MaxLength="80"
                                         FontSize="{DynamicResource FontSizeBody}"
                                         TextChanged="NameEntry_TextChanged"/>
                            </Border>
                            <TextBlock x:Name="NameProblem" Style="{DynamicResource GlassHint}" Visibility="Collapsed"
                                       Margin="0,7,0,0" Foreground="#F5BD76"/>

                            <TextBlock x:Name="FormatLabel" Style="{DynamicResource WindowCardLabel}" Margin="0,14,0,0"/>
                            <controls:SegmentRow x:Name="FormatRow" Raised="True" SegmentHeight="50" Margin="0,7,0,0"/>
                            <TextBlock x:Name="FormatWhy" Style="{DynamicResource GlassHint}" Margin="0,7,0,0" Foreground="#A8BCD2"/>

                            <TextBlock x:Name="CapacityLabel" Style="{DynamicResource WindowCardLabel}" Margin="0,14,0,0"/>
                            <controls:SegmentRow x:Name="CapacityRow" Raised="True" SegmentHeight="36" Margin="0,7,0,0"/>
                            <TextBlock x:Name="WaitlistHint" Style="{DynamicResource GlassHint}" Margin="0,7,0,0"
                                       Foreground="#8C9CB1"/>
                        </StackPanel>
                    </Border>

                    <!-- The registration: who gets in, who sees it, and (held to the bottom) whether
                         registration opens on creation. -->
                    <Border x:Name="WhoCard" Grid.Column="2" Style="{DynamicResource WindowCard}" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="EntryModeLabel" Style="{DynamicResource WindowCardLabel}"/>
                                <controls:OptionRows x:Name="EntryRow" Margin="0,7,0,0"/>

                                <!-- Public or private (2026-11-13). Collapsed against a server that does not
                                     say it understands it, which would make a private request public. -->
                                <StackPanel x:Name="VisibilityBlock" Visibility="Collapsed">
                                    <TextBlock x:Name="VisibilityLabel" Style="{DynamicResource WindowCardLabel}" Margin="0,14,0,0"/>
                                    <controls:OptionRows x:Name="VisibilityRow" Margin="0,7,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="#14FFFFFF"
                                    Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OpenRow_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock x:Name="OpenTitle" Style="{DynamicResource GlassRowTitle}" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource DialogBodySize}"/>
                                        <TextBlock x:Name="OpenWhy" Style="{DynamicResource GlassHint}" Margin="0,3,0,0"
                                                   Foreground="#A8BCD2"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="OpenToggle" Grid.Column="1" Style="{DynamicResource GlassToggle}"
                                                  VerticalAlignment="Center" IsChecked="True"
                                                  Checked="OpenToggle_Changed" Unchecked="OpenToggle_Changed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- How teams are formed: only in 2v2 and 3v3, three choices side by side. -->
                <Border x:Name="TeamSourceBlock" Style="{DynamicResource WindowCard}" Padding="16,12"
                        Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TeamSourceLabel" Style="{DynamicResource WindowCardLabel}"/>
                        <controls:OptionRows x:Name="SourceRows" Columns="3" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- The summary: the three figures on one line, wrapping when they do not fit. -->
                <Border x:Name="MathStrip" Margin="0,12,0,0" Padding="14,7" CornerRadius="9" BorderThickness="1">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,22,2">
                            <TextBlock x:Name="MathPlayers" Style="{DynamicResource TournamentStripFigure}"/>
                            <TextBlock x:Name="MathPlayersWord" Style="{DynamicResource TournamentStripWord}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,22,2">
                            <TextBlock x:Name="MathRounds" Style="{DynamicResource TournamentStripFigure}"/>
                            <TextBlock x:Name="MathRoundsWord" Style="{DynamicResource TournamentStripWord}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <TextBlock x:Name="MathRooms" Style="{DynamicResource TournamentStripFigure}"/>
                            <TextBlock x:Name="MathRoomsWord" Style="{DynamicResource TournamentStripWord}"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- The footer: the reason the primary is off takes the room on the left and may wrap;
             the buttons have a minimum width, never a fixed one. -->
        <Grid Grid.Row="2" Margin="22,14,22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Style="{DynamicResource GlassRowBody}" Foreground="#F5BD76"
                       Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Grid.Column="1" Style="{DynamicResource WindowSecondaryButton}"
                    MinWidth="112" MinHeight="32" FontSize="{DynamicResource SetRowDescSize}" IsCancel="True" Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Grid.Column="2" Style="{DynamicResource WindowPrimaryButton}"
                    MinWidth="136" MinHeight="32" Padding="16,0" Margin="8,0,0,0" FontSize="{DynamicResource SetRowDescSize}"
                    ToolTipService.ShowOnDisabled="True" IsDefault="True" Click="OkButton_Click"/>
        </Grid>
    </Grid>
</Window>
