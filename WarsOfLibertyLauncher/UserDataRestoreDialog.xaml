<controls:BaseDialog x:Class="WarsOfLibertyLauncher.UserDataRestoreDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
                     Width="520"
                     Tone="Info">
    <controls:BaseDialog.Resources>
        <!-- One backup in the list: 44 px, and the chosen one wears the blue fill. -->
        <Style x:Key="BackupCard" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource UiTitleText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="10,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Border x:Name="Box" Grid.Column="1" Width="16" Height="16" CornerRadius="4"
                                        Margin="10,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                        Background="{DynamicResource DialogPickBox}"
                                        BorderBrush="{DynamicResource DialogPickBoxRing}">
                                    <TextBlock x:Name="Tick" Text="&#x2713;" Visibility="Hidden" FontSize="11"
                                               FontWeight="Bold" Foreground="#FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource DialogPickHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource DialogPickSelected}"/>
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource MpAction}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MpAction}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:BaseDialog.Resources>

    <StackPanel>
        <TextBlock x:Name="ListLabelText" Style="{StaticResource WindowFieldLabel}"/>
        <ListBox x:Name="BackupsList"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource BackupCard}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MaxHeight="264"
                 Margin="0,6,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding DateLabel}"
                                   FontSize="{DynamicResource DialogBodySize}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource UiTitleText}"/>
                        <TextBlock Text="{Binding DetailLabel}"
                                   FontSize="{DynamicResource SetDescSize}"
                                   Foreground="{DynamicResource WindowFineText}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="ReassuranceText" Style="{StaticResource DialogHint}" Margin="0,10,0,0"/>
    </StackPanel>
</controls:BaseDialog>
