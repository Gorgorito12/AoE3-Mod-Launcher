<Window x:Class="WarsOfLibertyLauncher.LobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Lobby"
        Height="660" Width="980"
        MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="True">

    <!--
        Non-modal lobby window. Replaces the in-tab Canvas overlay that
        used to live inside MultiplayerTab (`RoomPanel` Grid + Canvas +
        floating-card Border). Same content; the chrome is now real OS
        chrome instead of a hand-rolled floating card, which means:

          • Native edge-drag resize from any side/corner (no custom
            Thumb grip — the resize thumb that was added in a previous
            iteration is gone).
          • Native title-bar drag from anywhere in the CaptionHeight=40
            strip at the top (no MouseLeftButtonDown handlers on the
            sub-header strip).
          • The window can be moved outside the launcher's bounds,
            alt-tabbed to, and minimised independently of the main
            launcher window — which was the whole point of this
            refactor versus the in-tab popup.

        Single-instance + non-modal contract (same as LauncherSettings
        and ModProperties — see the bullet in CLAUDE.md under Runtime
        conventions): opened via .Show() from MultiplayerTab, tracked
        in a single-instance field there; the window's Closed event
        triggers the leave-room flow on the session.

        Chrome:
          • WindowStyle=None + WindowChrome — dark dorado-imperial
            title bar, no Windows-native white caption
          • Single ✕ close button top-right (DialogCloseButton recipe,
            replicated locally because that style is per-Window scoped)
          • Caption=40 px, ResizeBorderThickness=6 px so edge resize
            still works even though WindowStyle=None hides the OS
            chrome

        Layout (inside the content row below the title bar):
          • RoomHeaderStrip — rich sub-header: crossed-swords icon
            square + room code + status meta + HOST/PLAYERS/ROOM ID
            stats. Used to double as a drag handle in the in-tab
            popup; now passive (Window chrome handles drag). The
            close ✕ that lived here is gone — the title bar's own
            close is the single dismiss path.
          • Body — 2-column grid: left = players list + room/network
            info card + Ready/Start/Leave actions; right = chat panel
            with header, scrollable log, and input bar.
          • CountdownOverlay — despite the name, a THIN BAR that is its
            own layout row above the body (not an overlay), shown during
            the Starting phase. It pushes the body down so the players
            list AND the chat both stay visible/interactive — players can
            ask to abort and the host can Cancel from the bar. InGameOverlay
            — full-content cover during the InGame phase (AoE3 is foreground
            then). See the inline comments.
    -->

    <!-- WindowChrome (caption drag + edge-resize) is applied centrally in
         App.OnAnyWindowLoaded from the TitleBarHeight token; the title bar is
         the shared controls:TitleBar below. -->

    <!-- 1 px frame so the dark window reads as a distinct panel instead of
         melting into the (equally dark) launcher behind it. A literal black
         line can't separate two dark surfaces; this uses the app's standard
         border tone. AllowsTransparency=False rules out a drop shadow, so a
         hard edge is the tool available. -->
    <Border
            BorderBrush="{DynamicResource MpRimMedium}"
            BorderThickness="1"
            Background="{DynamicResource MpAppBg}">
    <!-- x:Name="LobbyRootGrid" — host for MpAlertOverlay confirm cards
         (the in-lobby themed replacement for MessageBox). The overlay is
         injected as the last child BEFORE the MinimizedPill so the pill,
         when shown, still covers everything; in practice the two never
         overlap (you can't pill while a confirm is up). -->
    <Grid x:Name="LobbyRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Title bar (chrome) -->
            <RowDefinition Height="*"/>      <!-- Lobby content -->
        </Grid.RowDefinitions>

        <!-- =========================================================
             TITLE BAR — shared global bar. min/max/restore/close (this
             is an independent, resizable, taskbar window). The rich room
             info (host/players/room id stats) lives below in
             RoomHeaderStrip — the title bar stays honest as "a window"
             without duplicating data. Drag/double-click/restore-on-drag
             come from the central WindowChrome.
             ========================================================= -->
        <controls:TitleBar Grid.Row="0"
                           x:Name="TitleBarControl"
                           Background="{DynamicResource MpTitleBar}"
                           Title="Lobby"
                           ShowMinimize="True"
                           ShowMaximize="True"
                           ShowClose="True"/>

        <!-- =========================================================
             LOBBY CONTENT — one Grid hosts the lobby body + the two
             match-phase overlays. Overlays sit on top by z-order
             (later children render later); their Visibility is
             flipped from ApplyMatchPhaseUi() in code-behind.
             ========================================================= -->
        <Grid Grid.Row="1" x:Name="LobbyContentRoot">

            <!-- =====================================================
                 LOBBY BODY — sub-header strip + 2-column body.
                 ===================================================== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Sub-header (rich) -->
                    <RowDefinition Height="*"/>      <!-- Body (Players | Chat) -->
                </Grid.RowDefinitions>

                <!-- ========== Sub-header strip ==========
                     Was the popup's drag handle in the old in-tab
                     popup. Now passive (Window chrome at the very
                     top handles drag) — keep it as a rich
                     description strip with icon + room code +
                     status + HOST/PLAYERS/ROOM ID stats. The close
                     ✕ that used to sit on the right is gone — the
                     title bar's ✕ is the single dismiss path. -->
                <!-- Room header (design handoff 1e). A single card: the mod icon, the
                     room name with its rename pencil, a status line, and three stats.
                     It used to lead with a 64 px crossed-swords square that said nothing
                     about which mod the room plays; the icon does, and it is the same one
                     the rooms list shows, so a room looks like itself from both sides. -->
                <Border Grid.Row="0"
                        x:Name="RoomHeaderStrip"
                        Background="{DynamicResource MpRowHighlight}"
                        BorderBrush="{DynamicResource MpRimMedium}"
                        BorderThickness="1"
                        Margin="14,14,14,0"
                        Padding="15,13"
                        CornerRadius="{StaticResource RadiusPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>   <!-- mod icon -->
                            <ColumnDefinition Width="*"/>      <!-- name + status -->
                            <ColumnDefinition Width="Auto"/>   <!-- stats -->
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                x:Name="RoomModIconHost"
                                Width="42" Height="42"
                                CornerRadius="8"
                                Background="{DynamicResource MpEventBg}"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                            <TextBlock x:Name="RoomModIconGlyph"
                                       Text="&#x2694;"
                                       Foreground="{DynamicResource MpActionText}"
                                       FontSize="{StaticResource FontSizeSubtitle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           x:Name="RoomTitleText"
                                           Foreground="{DynamicResource MpTextHeading}"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           FontSize="{StaticResource MpRoomNameSize}"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        x:Name="RenameRoomButton"
                                        Click="RenameRoomButton_Click"
                                        Style="{StaticResource MpIconButton}"
                                        Width="24" Height="22"
                                        Padding="0"
                                        Margin="9,0,0,0"
                                        FontSize="{StaticResource MpLabelSize}"
                                        Content="&#x270E;"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <!-- Status and meta share one line: the coloured state, then the
                                 context. Two Runs, so only the state carries the colour. -->
                            <TextBlock x:Name="RoomMetaText"
                                       Foreground="{DynamicResource MpTextFaint}"
                                       FontSize="{StaticResource MpLabelSize}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="22,0,0,0">
                                <TextBlock x:Name="PlayersStatHeader"
                                           Foreground="{DynamicResource MpTextLabel}"
                                           FontSize="{StaticResource MpSectionLabelSize}"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="RoomPlayersText"
                                           Foreground="{DynamicResource MpTextPrimary}"
                                           FontSize="{StaticResource MpStatValueSize}"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="22,0,0,0">
                                <TextBlock x:Name="RoomConnHeader"
                                           Foreground="{DynamicResource MpTextLabel}"
                                           FontSize="{StaticResource MpSectionLabelSize}"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="RoomConnText"
                                           Foreground="{DynamicResource MpOkTextAlt}"
                                           FontSize="{StaticResource MpStatValueSize}"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="22,0,0,0">
                                <TextBlock x:Name="RoomIdStatHeader"
                                           Foreground="{DynamicResource MpTextLabel}"
                                           FontSize="{StaticResource MpSectionLabelSize}"
                                           FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="RoomIdText"
                                               Foreground="{DynamicResource MpTextPrimary}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource MpStatValueSize}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="CopyRoomIdButton"
                                            Click="CopyRoomIdButton_Click"
                                            Style="{StaticResource MpIconButton}"
                                            Width="22" Height="20"
                                            Padding="0"
                                            Margin="7,0,0,0"
                                            FontSize="{StaticResource MpLabelSize}"
                                            Foreground="{DynamicResource MpActionText}"
                                            Content="&#x29C9;"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========== Body: Left (players + checklist + actions) | Right (chat) ========== -->
                <Grid Grid.Row="1" Margin="14,13,14,14">
                    <Grid.ColumnDefinitions>
                        <!-- 352: the reference's fixed left column. Roster, checklist and
                             actions read as one column of equal width; the chat takes the
                             rest. Not a token — a GridLength cannot be one here, since
                             GridLength lives in System.Windows rather than System. -->
                        <ColumnDefinition Width="352"/>
                        <ColumnDefinition Width="13"/>     <!-- gutter -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== Left column ===== -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>      <!-- players card -->
                            <RowDefinition Height="Auto"/>   <!-- before-you-start -->
                            <RowDefinition Height="Auto"/>   <!-- info card -->
                            <RowDefinition Height="Auto"/>   <!-- actions -->
                        </Grid.RowDefinitions>

                        <!-- PLAYERS. The header moved INSIDE the card, which is what lets
                             the roster take the height it needs instead of sitting under a
                             loose label. "Invitar" is the affordance for the empty slots
                             the roster itself renders. -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource MpPanel}"
                                BorderBrush="{DynamicResource MpRimSoft}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusPanel}"
                                Padding="13,12"
                                Margin="0,0,0,11">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               x:Name="PlayersListHeader"
                                               Foreground="{DynamicResource MpTextLabel}"
                                               FontSize="{StaticResource MpPillSize}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            x:Name="InvitePlayersButton"
                                            Click="InvitePlayersButton_Click"
                                            Style="{StaticResource MpLinkButton}"
                                            Foreground="{DynamicResource MpAccountElo}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="0,11,0,0">
                                    <StackPanel x:Name="RoomMembersPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- ANTES DE EMPEZAR. Replaces the amber "so the match counts" band
                             AND its "don't show this again": the notice cannot be silenced
                             any more, but it now costs two lines instead of seven.

                             The first item ticks itself — everyone in the room passed the
                             join gate, which rejects a mismatched fingerprint. The second
                             stays unticked on purpose: the per-match Record Game box is
                             something only the player can do, and the launcher cannot see
                             whether they did (measured — see RecordingIndicator).

                             Nothing here may be animated: these brushes are frozen
                             DynamicResources and animating one throws. -->
                        <Border Grid.Row="1"
                                x:Name="PreflightCard"
                                Background="{DynamicResource MpPanel}"
                                BorderBrush="{DynamicResource MpRimSoft}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusPanel}"
                                Padding="13,12"
                                Margin="0,0,0,11">
                            <StackPanel>
                                <TextBlock x:Name="PreflightHeader"
                                           Foreground="{DynamicResource MpTextLabel}"
                                           FontSize="{StaticResource MpPillSize}"
                                           FontWeight="SemiBold"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            x:Name="PreflightModsBox"
                                            Width="16" Height="16"
                                            CornerRadius="4"
                                            Background="{DynamicResource MpOkBg}"
                                            VerticalAlignment="Top"
                                            Margin="0,1,9,0">
                                        <TextBlock Text="&#x2713;"
                                                   Foreground="{DynamicResource MpOkText}"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               x:Name="PreflightModsText"
                                               Foreground="{DynamicResource MpTextBody}"
                                               FontSize="{StaticResource MpLabelSize}"
                                               LineHeight="16"
                                               LineStackingStrategy="BlockLineHeight"
                                               TextWrapping="Wrap"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="16" Height="16"
                                            CornerRadius="4"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource MpCautionRimBox}"
                                            BorderThickness="1"
                                            VerticalAlignment="Top"
                                            Margin="0,1,9,0"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="PreflightRecordText"
                                               Foreground="{DynamicResource MpCautionText}"
                                               FontSize="{StaticResource MpLabelSize}"
                                               LineHeight="16"
                                               LineStackingStrategy="BlockLineHeight"
                                               TextWrapping="Wrap"/>
                                    <Button Grid.Column="2"
                                            x:Name="PreflightRecordHelp"
                                            Click="PreflightRecordHelp_Click"
                                            Style="{StaticResource MpLinkButton}"
                                            Foreground="{DynamicResource MpAccountElo}"
                                            FontSize="{StaticResource MpPillSize}"
                                            Margin="9,0,0,0"
                                            VerticalAlignment="Top"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Room info. Not in the reference, kept because it carries the one
                             thing nothing else shows: the password a host has to read out.
                             It already collapses whole when there is nothing to say, so for
                             a public room the column looks exactly like the reference. -->
                        <Border Grid.Row="2"
                                x:Name="RoomInfoCard"
                                Background="{DynamicResource MpPanel}"
                                BorderBrush="{DynamicResource MpRimSoft}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusPanel}"
                                Padding="13,12"
                                Margin="0,0,0,11">
                            <StackPanel>
                                <TextBlock x:Name="RoomInfoHeaderText"
                                           Foreground="{DynamicResource MpTextLabel}"
                                           FontSize="{StaticResource MpPillSize}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>
                                <Grid x:Name="RoomModRow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               x:Name="RoomModLabel"
                                               Foreground="{DynamicResource MpTextFaint}"
                                               FontSize="{StaticResource MpLabelSize}"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="RoomModText"
                                               Foreground="{DynamicResource MpTextSecondary}"
                                               FontSize="{StaticResource MpLabelSize}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               x:Name="RoomPasswordLabel"
                                               Foreground="{DynamicResource MpTextFaint}"
                                               FontSize="{StaticResource MpLabelSize}"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="RoomPasswordText"
                                               Foreground="{DynamicResource MpPrivateText}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource MpLabelSize}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid x:Name="RoomCopyRow" Margin="0,7,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               x:Name="RoomCopyLabel"
                                               Foreground="{DynamicResource MpTextFaint}"
                                               FontSize="{StaticResource MpLabelSize}"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="RoomCopyText"
                                               Foreground="{DynamicResource MpTextSecondary}"
                                               FontSize="{StaticResource MpLabelSize}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Actions: ONE primary, then two ghosts of equal weight. They used
                             to be three solid buttons in green, blue and red, all shouting at
                             once; only one of them is the thing you came here to do. -->
                        <StackPanel Grid.Row="3">
                            <Button x:Name="StartButton"
                                    Click="StartButton_Click"
                                    Style="{StaticResource MpPrimaryButton}"
                                    Height="{StaticResource MpPrimaryButtonHeight}"
                                    HorizontalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,9"
                                    Visibility="Collapsed"/>
                            <!-- Reopen AoE3 after it closed while the room kept playing.
                                 Guests only: a host in that state ends the match for
                                 everyone as they exit, so their own Start button is
                                 already the correct way back (see RoomMatchState). -->
                            <Button x:Name="RejoinGameButton"
                                    Click="RejoinGameButton_Click"
                                    Style="{StaticResource MpPrimaryButton}"
                                    Height="{StaticResource MpPrimaryButtonHeight}"
                                    HorizontalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    FontWeight="SemiBold"
                                    Margin="0,0,0,9"
                                    Visibility="Collapsed"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="9"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- No local Background/Foreground on ReadyButton: a local
                                     value beats every ControlTemplate trigger, and the ready
                                     state is painted by the style's Tag="ready" trigger. -->
                                <Button Grid.Column="0"
                                        x:Name="ReadyButton"
                                        Click="ReadyButton_Click"
                                        Style="{StaticResource MpReadyButton}"/>
                                <Button Grid.Column="2"
                                        x:Name="LeaveRoomButton"
                                        Click="LeaveRoomButton_Click"
                                        Style="{StaticResource MpGhostDangerButton}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Right column: Chat & Activity ===== -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource MpPanel}"
                            BorderBrush="{DynamicResource MpRimSoft}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- header -->
                                <RowDefinition Height="*"/>      <!-- chat log -->
                                <RowDefinition Height="Auto"/>   <!-- countdown line (0 px when collapsed) -->
                                <RowDefinition Height="Auto"/>   <!-- input -->
                            </Grid.RowDefinitions>

                            <!-- Header: title left, Clear chat right. -->
                            <!-- Sentence case, not an uppercase table caption: this heads a
                                 conversation, and "Limpiar" beside it is a quiet link rather
                                 than a bordered button. -->
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource MpRimFaint}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               x:Name="ChatHeaderText"
                                               Foreground="{DynamicResource MpTextPrimary}"
                                               FontSize="{StaticResource MpBodySize}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            x:Name="ClearChatButton"
                                            Click="ClearChatButton_Click"
                                            Style="{StaticResource MpLinkButton}"
                                            Foreground="{DynamicResource MpTextMuted}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          x:Name="ChatScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="20,14,14,8">
                                <StackPanel x:Name="ChatLogPanel"/>
                            </ScrollViewer>

                            <!-- Empty-state hint, centred over the (empty)
                                 chat log. Toggled from UpdateChatEmptyState()
                                 in code-behind whenever rows are added/cleared. -->
                            <TextBlock Grid.Row="1"
                                       x:Name="ChatEmptyHint"
                                       Text="No messages yet — say hi!"
                                       Foreground="{DynamicResource MpTextFaint}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>

                            <!-- ===== Countdown line (lives INSIDE the chat) =====
                                 The pre-launch countdown shows here as a single
                                 live line in the chat panel — it used to be a
                                 thin glowing bar above the whole body. Collapsed
                                 → 0 px (Row is Auto); StartCountdown flips it
                                 Visible via ApplyMatchPhaseUi and
                                 UpdateCountdownTick rewrites CountdownNumber in
                                 place (5→4→3…). x:Name stays "CountdownOverlay"
                                 (despite no longer being an overlay) so the
                                 code-behind visibility toggle + CountdownLabel /
                                 CountdownNumber wiring need no change. The chat
                                 stays fully usable during the countdown so
                                 players can still ask to abort. -->
                            <Border Grid.Row="2"
                                    x:Name="CountdownOverlay"
                                    Background="{DynamicResource MpEventBg}"
                                    BorderBrush="{DynamicResource MpEventRim}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Margin="20,0,14,10"
                                    Padding="14,9"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="⏱"
                                               Foreground="{DynamicResource MpActionText}"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock x:Name="CountdownLabel"
                                               Text="Starting in"
                                               Foreground="{DynamicResource MpTextPrimary}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <!-- Default "5" (not "3") so even the
                                         first paint before UpdateCountdownTick
                                         runs shows the right starting number. -->
                                    <TextBlock x:Name="CountdownNumber"
                                               Text="10"
                                               Foreground="{DynamicResource MpActionText}"
                                               FontSize="{StaticResource FontSizeHeading}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Input bar. Emoji icon (decorative
                                 placeholder for now, future emoji
                                 picker) + textbox + Send. -->
                            <Border Grid.Row="3"
                                    BorderBrush="{DynamicResource MpRimFaint}"
                                    BorderThickness="0,1,0,0"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="ChatInputBox"
                                                 Height="{StaticResource MpFieldHeight}"
                                                 Background="{DynamicResource MpField}"
                                                 Foreground="{DynamicResource MpTextPrimary}"
                                                 CaretBrush="{DynamicResource MpActionText}"
                                                 BorderBrush="{DynamicResource MpRimField}"
                                                 BorderThickness="1"
                                                 Padding="11,0"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="{StaticResource MpBodySize}"
                                                 MaxLength="500"
                                                 KeyDown="ChatInputBox_KeyDown"
                                                 TextChanged="ChatInputBox_TextChanged"/>
                                        <TextBlock x:Name="ChatPlaceholderText"
                                                   Foreground="{DynamicResource MpTextFaint}"
                                                   FontSize="{StaticResource MpBodySize}"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>

                                    <Button Grid.Column="1"
                                            x:Name="ChatEmojiButton"
                                            Click="ChatEmojiButton_Click"
                                            Style="{StaticResource MpIconButton}"
                                            Width="34" Height="34"
                                            Margin="6,0,0,0"
                                            Content="&#x1F642;"
                                            FontSize="{StaticResource FontSizeBody}"
                                            ToolTip="Insert emoji"/>

                                    <Button Grid.Column="2"
                                            x:Name="ChatSendButton"
                                            Click="ChatSendButton_Click"
                                            Style="{StaticResource MpPrimaryButton}"
                                            Height="{StaticResource MpFieldHeight}"
                                            Padding="15,0"
                                            FontSize="{StaticResource MpMetaSize}"
                                            FontWeight="SemiBold"
                                            Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- =====================================================
                         IN-GAME PANEL — shown while the match is running.
                         CONFINED to the LEFT column (Grid.Column="0": it
                         covers the roster + Ready/Start/Leave actions) ON
                         PURPOSE, so the chat panel (Column 2) stays VISIBLE
                         and usable during the game. That's the "chat is
                         always accessible" rule: once AoE3 launches (the
                         countdown hits 0) the room controls are blocked —
                         this opaque panel sits over them — but players can
                         still talk. It used to be a full-content cover that
                         hid the chat too; it was moved INTO the body grid +
                         relaid out vertically (stats in a 2×2 grid instead
                         of a 4-wide row) to fit the 340 px column. Pulsing
                         "live" dot, match timer / traffic / connection /
                         room stats, a peer list, and one big Cancel/Leave
                         button. RefreshInGamePanel() (1 Hz) repaints it; all
                         the InGame* x:Names are preserved so the code-behind
                         needs no change. -->
                    <!-- Result card host (design handoff 1f). Sibling of InGameOverlay and
                         in the SAME column, so it inherits the same property: covering
                         column 0 hides the roster, the checklist and the actions with no
                         code, while the chat in column 2 stays alive for the "gg".

                         It exists as its own phase because a reported match CLOSES the
                         room server-side, and until now nothing in the launcher reacted
                         to that: the socket simply reconnected forever and the window
                         lingered with a dead chat and live buttons. The card is what that
                         window is FOR once the match is over. Filled by the code-behind
                         (see EnterResultPhase); starts as the pending line, because the
                         numbers do not exist until the report comes back. -->
                    <Border x:Name="MatchResultOverlay"
                            Grid.Column="0"
                            Background="{DynamicResource MpAppBg}"
                            BorderBrush="{DynamicResource MpRimMedium}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPanel}"
                            Visibility="Collapsed">
                        <Grid x:Name="MatchResultHost" Margin="16"/>
                    </Border>

                    <Border x:Name="InGameOverlay"
                            Grid.Column="0"
                            Background="{DynamicResource MpAppBg}"
                            BorderBrush="{DynamicResource MpRimSoft}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPanel}"
                            Visibility="Collapsed">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- live header + clock -->
                                <RowDefinition Height="Auto"/>   <!-- three cells -->
                                <RowDefinition Height="Auto"/>   <!-- alone-in-the-room box -->
                                <RowDefinition Height="*"/>      <!-- peers -->
                                <RowDefinition Height="Auto"/>   <!-- abort -->
                            </Grid.RowDefinitions>

                            <!-- The clock joins the header instead of taking a cell of its
                                 own: it is the one number that changes every second, and a
                                 cell for it cost a quarter of the row for something the eye
                                 tracks anyway. -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         x:Name="InGameLiveDot"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource MpOk}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="InGameTitleText"
                                           Foreground="{DynamicResource MpTextPrimary}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           x:Name="InGameMatchTimer"
                                           Foreground="{DynamicResource MpTextPrimary}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource MpStatValueSize}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Three cells: what is measurable during a match. The ROOM cell
                                 went with the header (the window title says which room), the
                                 MATCH TIME cell went to the header clock, and RECORDING took
                                 the place both left. -->
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="11"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="11"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{DynamicResource MpPanel}"
                                        CornerRadius="{StaticResource RadiusRow}"
                                        Padding="12,11">
                                    <StackPanel>
                                        <TextBlock x:Name="InGameTrafficHeader"
                                                   Foreground="{DynamicResource MpTextLabel}"
                                                   FontSize="{StaticResource MpSectionLabelSize}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InGameTrafficText"
                                                   Foreground="{DynamicResource MpTextPrimary}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{DynamicResource MpPanel}"
                                        CornerRadius="{StaticResource RadiusRow}"
                                        Padding="12,11">
                                    <StackPanel>
                                        <TextBlock x:Name="InGameConnectionHeader"
                                                   Foreground="{DynamicResource MpTextLabel}"
                                                   FontSize="{StaticResource MpSectionLabelSize}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InGameConnectionText"
                                                   Foreground="{DynamicResource MpOkTextAlt}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- RECORDING says what the LAUNCHER asked for, not what the
                                     game will do: AoE3 decides that with a per-match checkbox
                                     the launcher cannot read (measured — see
                                     RecordingIndicator). A green "active" here would be a lie
                                     in the one place where being wrong costs the player their
                                     rating. -->
                                <Border Grid.Column="4"
                                        Background="{DynamicResource MpPanel}"
                                        CornerRadius="{StaticResource RadiusRow}"
                                        Padding="12,11">
                                    <StackPanel>
                                        <TextBlock x:Name="InGameRecordingHeader"
                                                   Foreground="{DynamicResource MpTextLabel}"
                                                   FontSize="{StaticResource MpSectionLabelSize}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InGameRecordingText"
                                                   Foreground="{DynamicResource MpOk}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Alone in the room. It used to be one italic line inside the
                                 peer list with nothing to press, which describes the problem
                                 and leaves the player holding it. Both buttons act on it. -->
                            <Border Grid.Row="2"
                                    x:Name="InGameSoloBox"
                                    Visibility="Collapsed"
                                    Margin="0,12,0,0"
                                    Padding="12"
                                    CornerRadius="{StaticResource RadiusRow}"
                                    Background="{DynamicResource MpCautionBg}"
                                    BorderBrush="{DynamicResource MpCautionRim}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#x26A0;"
                                               Foreground="{DynamicResource MpCaution}"
                                               FontSize="{StaticResource MpMetaSize}"
                                               VerticalAlignment="Top"
                                               Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="InGameSoloTitle"
                                                   Foreground="{DynamicResource MpCautionTextAlt}"
                                                   FontSize="{StaticResource MpMetaSize}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="InGameSoloBody"
                                                   Foreground="{DynamicResource MpCautionText}"
                                                   FontSize="{StaticResource MpLabelSize}"
                                                   LineHeight="17"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                            <Button x:Name="InGameSoloCopyButton"
                                                    Click="InGameSoloCopyButton_Click"
                                                    Style="{StaticResource MpGhostCautionButton}"
                                                    Padding="11,0"
                                                    Margin="0,0,8,0"/>
                                            <Button x:Name="InGameSoloAnnounceButton"
                                                    Click="InGameSoloAnnounceButton_Click"
                                                    Style="{StaticResource MpGhostCautionButton}"
                                                    Padding="11,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Per-peer link state and RTT. Not in the reference's card, kept
                                 because the handoff's own prose asks for "ping por jugador":
                                 it is the only place a player can see WHICH peer is the
                                 problem. -->
                            <ScrollViewer Grid.Row="3"
                                          VerticalScrollBarVisibility="Auto"
                                          Margin="0,12,0,0">
                                <StackPanel x:Name="InGamePeersPanel"/>
                            </ScrollViewer>

                            <Button Grid.Row="4"
                                    x:Name="InGameCancelButton"
                                    Click="InGameCancelButton_Click"
                                    Style="{StaticResource MpGhostDangerButton}"
                                    Height="38"
                                    Margin="0,12,0,0"
                                    FontSize="{StaticResource MpBodySize}"
                                    FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
