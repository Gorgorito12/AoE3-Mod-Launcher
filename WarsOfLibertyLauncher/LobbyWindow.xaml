<Window x:Class="WarsOfLibertyLauncher.LobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Lobby"
        Height="760" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBoxFocusBrush" Color="#2F7FE0"/>
    </Window.Resources>
    <!-- Designs 87 and 85: the window of the room's mod. Its image as a strip behind the bar, glass
         panels, and in the footer the state of the room with its one primary button. -->
    <Grid x:Name="LobbyRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0"
                           x:Name="TitleBarControl"
                           PlainTitle="True" TitleSize="13"
                           Title="Lobby"
                           ShowMinimize="True"
                           ShowMaximize="True"
                           ShowClose="True"/>
        <Grid Grid.Row="1" x:Name="LobbyContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="RoomHeaderStrip" Margin="28,22,28,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock x:Name="RoomKickerText"
                               Foreground="{DynamicResource ModAccentText}"
                               FontSize="{DynamicResource SetCaptionSize}" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RoomTitleText"
                                   Foreground="{DynamicResource UiHeadText}"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="RenameRoomButton" Click="RenameRoomButton_Click"
                                Style="{DynamicResource RoomSquareButton}" Margin="10,0,0,0"
                                Content="&#x270E;" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="Collapsed"/>
                    </Grid>
                    <WrapPanel Margin="0,10,0,-8">
                        <Border x:Name="RoomModeChip" Style="{DynamicResource RoomChip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="RoomModeDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RoomModeText" Style="{DynamicResource RoomChipText}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RoomVersionChip" Style="{DynamicResource RoomChip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M1,1 H6 L11,6 L6,11 L1,6 Z" Fill="#7EE08B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RoomVersionName" Style="{DynamicResource RoomChipText}"/>
                                <TextBlock x:Name="RoomVersionNumber" Style="{DynamicResource RoomChipText}" Margin="6,0,0,0"
                                           FontFamily="Consolas, Courier New, monospace"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RoomPasswordChip" Style="{DynamicResource RoomChip}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="#A8BCD2" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RoomPasswordChipText" Style="{DynamicResource RoomChipText}"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="CopyRoomIdButton" Click="CopyRoomIdButton_Click" Style="{DynamicResource RoomCodeChip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RoomIdStatHeader" Style="{DynamicResource RoomChipText}"
                                           Foreground="{DynamicResource WindowMuted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RoomIdText" Margin="7,0,0,0" VerticalAlignment="Center"
                                           FontFamily="Consolas, Courier New, monospace" FontWeight="SemiBold"
                                           FontSize="{DynamicResource SetControlSize}"
                                           Foreground="{DynamicResource UiHeadText}"/>
                                <Border Height="18" Padding="7,0" Margin="7,0,0,0" CornerRadius="9" Background="#1AFFFFFF">
                                    <TextBlock x:Name="RoomCopyWord" VerticalAlignment="Center" FontWeight="SemiBold"
                                               FontSize="{DynamicResource SetGroupLabelSize}"
                                               Foreground="{DynamicResource UiBodyText}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="RoomRoundsPath" Orientation="Horizontal" Height="24" Margin="6,0,0,8" Visibility="Collapsed"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,0,0">
                    <Border x:Name="RoomEloCard" Style="{DynamicResource RoomFloatCard}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock x:Name="RoomEloLabel" Style="{DynamicResource RoomFloatLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock x:Name="RoomEloValue" Style="{DynamicResource RoomFloatFigure}"/>
                                    <Border x:Name="RoomEloDeltaChip" Height="24" Padding="10,0" Margin="10,0,0,0" CornerRadius="12" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="RoomEloDelta" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   FontFamily="Consolas, Courier New, monospace"
                                                   FontSize="{DynamicResource SetControlSize}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="RoomEloNote" Margin="0,4,0,0" FontSize="{DynamicResource SetControlSize}"
                                           Foreground="{DynamicResource WindowFineText}"/>
                            </StackPanel>
                            <Border x:Name="RoomEloRankBlock" BorderBrush="#1AFFFFFF" BorderThickness="1,0,0,0"
                                    Margin="18,0,0,0" Padding="18,0,0,0" MaxWidth="248" VerticalAlignment="Stretch" Visibility="Collapsed">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel x:Name="RoomEloRankHead" Orientation="Horizontal"/>
                                    <TextBlock x:Name="RoomEloRankPlace" Margin="0,6,0,0"
                                               FontSize="{DynamicResource RoomChatSystemSize}"
                                               Foreground="{DynamicResource UiBodyText}"/>
                                    <TextBlock x:Name="RoomEloRankNext" Margin="0,6,0,0" TextWrapping="Wrap"
                                               FontSize="{DynamicResource SetControlSize}"
                                               Foreground="#8C9CB1"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="RoomPlaceCard" Style="{DynamicResource RoomFloatCard}" Padding="14,10" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock x:Name="RoomPlaceLabel" Style="{DynamicResource RoomFloatLabel}" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="RoomPlaceValue" Style="{DynamicResource RoomFloatFigure}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            <TextBlock x:Name="RoomPlaceSub" MaxWidth="220" Margin="0,6,0,0" TextAlignment="Right" TextWrapping="Wrap"
                                       FontSize="{DynamicResource SetControlSize}" Foreground="{DynamicResource WindowFineText}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="RoomViewBracketButton" Click="RoomViewBracketButton_Click"
                            Style="{DynamicResource WindowSecondaryButton}" FontSize="{DynamicResource DialogBodySize}"
                            MinWidth="0" Visibility="Collapsed"/>
                    <Button x:Name="InvitePlayersButton" Click="InvitePlayersButton_Click"
                            Style="{DynamicResource WindowSecondaryButton}" FontSize="{DynamicResource DialogBodySize}"
                            MinWidth="0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="28,0,28,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LobbyLeftColumnDef" Width="340"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition x:Name="LobbyMiddleColumnDef" Width="0"/>
                    <ColumnDefinition x:Name="LobbyMiddleGapDef" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" x:Name="LobbyLeftColumn" ClipToBounds="True"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <StackPanel x:Name="LobbyPanels">
                        <Border x:Name="RoomResultPanel" Style="{DynamicResource RoomPanel}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="RoomResultLabel" Style="{DynamicResource RoomPanelLabel}"/>
                                <StackPanel x:Name="RoomResultRows"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="QuickSearchCard"
                                                          Visibility="Collapsed"
                                                          Background="{DynamicResource GlassPanel}"
                                                          BorderBrush="{DynamicResource MpRimSoft}"
                                                          BorderThickness="1"
                                                          CornerRadius="{StaticResource RadiusPanel}"
                                                          Padding="15,12"
                                                          Margin="0,0,0,11">
                                                      <StackPanel>
                                                          <TextBlock x:Name="QuickSearchLabel"
                                                                     FontSize="{DynamicResource SetCaptionSize}"
                                                                     FontWeight="Bold"
                                                                     Foreground="{DynamicResource UiTextFaint}"/>
                                                          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                              <TextBlock x:Name="QuickSearchClock"
                                                                         FontFamily="Consolas, Courier New, monospace"
                                                                         FontSize="{DynamicResource DialogCodeSize}"
                                                                         FontWeight="Bold"
                                                                         Foreground="{DynamicResource WindowStrongText}"/>
                                                              <TextBlock x:Name="QuickSearchSince"
                                                                         FontSize="{DynamicResource SetControlSize}"
                                                                         Foreground="{DynamicResource WindowMuted}"
                                                                         VerticalAlignment="Bottom"
                                                                         Margin="10,0,0,6"/>
                                                          </StackPanel>
                                                          <TextBlock x:Name="QuickSearchBody"
                                                                     FontSize="{DynamicResource DialogBodySize}"
                                                                     Foreground="{DynamicResource UiBodyText}"
                                                                     TextWrapping="Wrap"
                                                                     Margin="0,8,0,0"/>
                                                          <TextBlock x:Name="QuickSearchNote"
                                                                     FontSize="{DynamicResource SetControlSize}"
                                                                     Foreground="{DynamicResource WindowFineText}"
                                                                     TextWrapping="Wrap"
                                                                     Margin="0,10,0,0"/>
                                                      </StackPanel>
                                                  </Border>
                        <Border x:Name="RoomSoloPanel" Style="{DynamicResource RoomPanel}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="InGameSoloTitle" Style="{DynamicResource RoomPanelLabel}"/>
                                <TextBlock x:Name="InGameSoloBody" Style="{DynamicResource RoomPanelBody}" Margin="0,10,0,0"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="InGameSoloCopyButton" Click="InGameSoloCopyButton_Click"
                                            Style="{DynamicResource RoomSmallButton}" Margin="0,0,8,0"/>
                                    <Button x:Name="InGameSoloAnnounceButton" Click="InGameSoloAnnounceButton_Click"
                                            Style="{DynamicResource RoomSmallButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RoomPlayersPanel" Style="{DynamicResource RoomPanel}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PlayersListHeader" Style="{DynamicResource RoomPanelLabel}"/>
                                    <TextBlock x:Name="RoomPlayersCount" Margin="8,0,0,0" FontWeight="SemiBold"
                                               FontFamily="Consolas, Courier New, monospace"
                                               FontSize="{DynamicResource SetControlSize}"
                                               Foreground="{DynamicResource WindowMuted}"/>
                                </StackPanel>
                                <StackPanel x:Name="RoomMembersPanel"/>
                                <TextBlock x:Name="RoomMoreFreeText" Style="{DynamicResource GlassHint}" Margin="0,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RoomRecordPanel" Style="{DynamicResource RoomPanel}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="PreflightHeader" Style="{DynamicResource RoomPanelLabel}"/>
                                <TextBlock x:Name="PreflightRecordText" Style="{DynamicResource RoomPanelBody}" Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="PreflightRecordHelp" Click="PreflightRecordHelp_Click" Style="{DynamicResource RoomTextLink}"/>
                                    <Button x:Name="RoomRecordMute" Click="RoomRecordMute_Click" Style="{DynamicResource RoomTextLink}"
                                            Foreground="{DynamicResource WindowMuted}" Margin="16,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RoomCountsPanel" Style="{DynamicResource RoomPanel}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="RoomCountsLabel" Style="{DynamicResource RoomPanelLabel}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#2455ACEE" BorderBrush="#8055ACEE"
                                            BorderThickness="1" VerticalAlignment="Top">
                                        <TextBlock Text="i" FontWeight="Bold" FontSize="{DynamicResource SetCaptionSize}"
                                                   Foreground="#55ACEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock x:Name="RoomCountsText" Style="{DynamicResource RoomPanelBody}"/>
                                        <TextBlock x:Name="PreflightReplayText" Style="{DynamicResource GlassHint}" Margin="0,8,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RoomStakePanel" Style="{DynamicResource RoomPanel}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="RoomStakeLabel" Style="{DynamicResource RoomPanelLabel}"/>
                                <TextBlock x:Name="RoomStakeText" Style="{DynamicResource RoomPanelBody}" Margin="0,10,0,0"/>
                                <StackPanel x:Name="RoomStakeLines" Visibility="Collapsed"/>
                                <TextBlock x:Name="RoomStakeNote" Style="{DynamicResource GlassHint}" Margin="0,8,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="PreflightAbandonText" Style="{DynamicResource GlassHint}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Column="2" x:Name="LobbyMiddleColumn" ClipToBounds="True" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <StackPanel x:Name="LobbyMiddlePanels"/>
                </ScrollViewer>

                <Border x:Name="RoomChatPanel" Grid.Column="4" Style="{DynamicResource RoomPanel}" Margin="0" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="16,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ChatHeaderText" Style="{DynamicResource RoomPanelLabel}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="ClearChatButton" Click="ClearChatButton_Click"
                                        Style="{DynamicResource RoomSmallButton}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                          x:Name="ChatScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="16,14,16,14">
                                <StackPanel x:Name="ChatLogPanel"/>
                            </ScrollViewer>
                        <TextBlock Grid.Row="1"
                                       x:Name="ChatEmptyHint"
                                       Text="No messages yet — say hi!"
                                       Foreground="{DynamicResource MpTextFaint}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        <Border Grid.Row="2"
                                    x:Name="CountdownOverlay"
                                    Background="{DynamicResource MpEventBg}"
                                    BorderBrush="{DynamicResource MpEventRim}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Margin="16,0,16,10"
                                    Padding="14,9"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="⏱"
                                               Foreground="{DynamicResource MpActionText}"
                                               FontSize="{DynamicResource FontSizeSubtitle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock x:Name="CountdownLabel"
                                               Text="Starting in"
                                               Foreground="{DynamicResource MpTextPrimary}"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <!-- Default "5" (not "3") so even the
                                         first paint before UpdateCountdownTick
                                         runs shows the right starting number. -->
                                    <TextBlock x:Name="CountdownNumber"
                                               Text="10"
                                               Foreground="{DynamicResource MpActionText}"
                                               FontSize="{DynamicResource FontSizeHeading}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>
                        <Border Grid.Row="3" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="ChatInputBox"
                                                 Height="{StaticResource MpFieldHeight}"
                                                 Background="{DynamicResource MpField}"
                                                 Foreground="{DynamicResource MpTextPrimary}"
                                                 CaretBrush="{DynamicResource MpActionText}"
                                                 BorderBrush="{DynamicResource MpRimField}"
                                                 BorderThickness="1"
                                                 Padding="11,0"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="{DynamicResource MpBodySize}"
                                                 MaxLength="500"
                                                 KeyDown="ChatInputBox_KeyDown"
                                                 TextChanged="ChatInputBox_TextChanged"/>
                                    <TextBlock x:Name="ChatPlaceholderText"
                                                   Foreground="{DynamicResource MpTextFaint}"
                                                   FontSize="{DynamicResource MpBodySize}"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                </Grid>
                                <Button Grid.Column="1"
                                            x:Name="ChatEmojiButton"
                                            Click="ChatEmojiButton_Click"
                                            Style="{StaticResource MpIconButton}"
                                            Width="34" Height="34"
                                            Margin="6,0,0,0"
                                            Content="&#x1F642;"
                                            FontSize="{DynamicResource FontSizeBody}"
                                            ToolTip="Insert emoji"/>
                                <Button Grid.Column="2" x:Name="ChatSendButton" Click="ChatSendButton_Click"
                                        Style="{DynamicResource RoomChatSend}" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="TeamCountdownOverlay"
                            Grid.Column="0"
                            Background="{DynamicResource MpAppBg}"
                            Visibility="Collapsed">
                        <Grid VerticalAlignment="Top">
                            <Border CornerRadius="12"
                                    Background="{DynamicResource MpRowHighlight}">
                                <!-- Cached: an empty shadow, blurred once instead of per frame. -->
                                <Border.CacheMode>
                                    <BitmapCache/>
                                </Border.CacheMode>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270"
                                                      Opacity="0.4" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="12"
                                    Background="{DynamicResource MpRowHighlight}"
                                    BorderBrush="{DynamicResource MpRimStrong}"
                                    BorderThickness="1"
                                    Padding="18,18,18,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="52" Height="52">
                                            <Ellipse Stroke="{DynamicResource MpAction}" StrokeThickness="3"/>
                                            <TextBlock x:Name="TeamCountdownNumber"
                                                       Text="5"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="{DynamicResource MpCountdownNumberSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource UiTextHeadline}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TeamCountdownLabel"
                                                       FontSize="{DynamicResource MpMicroSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MpTextMuted}"/>
                                            <TextBlock x:Name="TeamCountdownTitle"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="{DynamicResource MpResultTitleSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource UiTextHeadline}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Margin="0,12,0,0"
                                            Padding="13,11"
                                            CornerRadius="8"
                                            Background="{DynamicResource MpAppBg}">
                                        <TextBlock x:Name="TeamCountdownTeams"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20"
                                                   FontSize="{DynamicResource MpProfileH2HSize}"
                                                   Foreground="{DynamicResource UiTextStrong}"/>
                                    </Border>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TeamCountdownFoot"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="{DynamicResource MpLabelSize}"
                                                   Foreground="{DynamicResource MpRankMutedText}"/>
                                        <Button Grid.Column="1"
                                                x:Name="TeamCountdownCancelButton" Visibility="Collapsed"
                                                Click="TeamCountdownCancelButton_Click"
                                                Style="{StaticResource MpSecondaryButton}"
                                                Height="30"
                                                Padding="14,0"
                                                Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                <Border x:Name="MatchResultOverlay"
                            Grid.Column="0"
                            Background="{DynamicResource MpAppBg}"
                            BorderBrush="{DynamicResource MpRimMedium}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPanel}"
                            Visibility="Collapsed">
                        <Grid x:Name="MatchResultHost" Margin="16"/>
                    </Border>
            </Grid>

            <Border Grid.Row="2" x:Name="QuickSearchFooter"
                        Visibility="Collapsed"
                        Background="{DynamicResource GlassFooter}"
                        BorderBrush="{DynamicResource WindowFooterRule}"
                        BorderThickness="0,1,0,0"
                        Padding="28,13,28,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <controls:WindowSpinner/>
                                <TextBlock x:Name="QuickFooterTitle"
                                           FontSize="{DynamicResource SetBodySize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WindowStrongText}"
                                           Margin="9,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="QuickFooterNote"
                                       FontSize="{DynamicResource SetControlSize}"
                                       Foreground="{DynamicResource WindowMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="QuickStopButton"
                                Style="{StaticResource WindowSecondaryButton}"
                                MinWidth="136"
                                VerticalAlignment="Center"
                                Click="QuickStopButton_Click"/>
                        <Button Grid.Column="2" x:Name="QuickRadminButton"
                                Style="{StaticResource WindowBrowseButton}"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Click="QuickRadminButton_Click"/>
                    </Grid>
                </Border>
            <Border Grid.Row="2" x:Name="RoomFooter"
                    Background="{DynamicResource GlassFooter}"
                    BorderBrush="{DynamicResource WindowFooterRule}"
                    BorderThickness="0,1,0,0"
                    Padding="28,14,28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RoomFooterDot" Width="8" Height="8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RoomFooterTitle" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSizeBodyStrong}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="InGameMatchTimer" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                       FontFamily="Consolas, Courier New, monospace" FontSize="{DynamicResource RoomClockSize}"
                                       Foreground="{DynamicResource UiHeadText}" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="RoomFooterSub" Margin="0,5,0,0" TextWrapping="Wrap"
                                   FontSize="{DynamicResource DialogBodySize}" Foreground="{DynamicResource WindowMuted}"/>
                    </StackPanel>
                    <StackPanel x:Name="LobbyActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LeaveRoomButton" Click="LeaveRoomButton_Click" Style="{DynamicResource RoomFooterButton}"/>
                        <Button x:Name="InGameCancelButton" Click="InGameCancelButton_Click" Style="{DynamicResource RoomFooterButton}"
                                Tag="danger" Visibility="Collapsed"/>
                        <Button x:Name="RoomSecondaryButton" Click="RoomSecondaryButton_Click" Style="{DynamicResource RoomFooterButton}"
                                Margin="10,0,0,0" Visibility="Collapsed"/>
                        <Button x:Name="ReadyButton" Click="ReadyButton_Click" Style="{DynamicResource RoomFooterPrimary}"
                                Margin="10,0,0,0" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="RejoinGameButton" Click="RejoinGameButton_Click" Style="{DynamicResource RoomFooterPrimary}"
                                Margin="10,0,0,0" Visibility="Collapsed"/>
                        <Button x:Name="StartButton" Click="StartButton_Click" Style="{DynamicResource RoomFooterPrimary}"
                                Margin="10,0,0,0" ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="RematchButton" Click="RematchButton_Click" Style="{DynamicResource RoomFooterPrimary}"
                                Margin="10,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Fields of the previous design that the code still writes while a room runs. They
                 describe nothing the new window draws, so nobody sees them. -->
            <Grid Visibility="Collapsed">
                <Border x:Name="RoomModIconHost"><TextBlock x:Name="RoomModIconGlyph"/></Border>
                <Border x:Name="RoomCompetitiveBadge"><TextBlock x:Name="RoomCompetitiveBadgeText"/></Border>
                <TextBlock x:Name="RoomMetaText"/>
                <TextBlock x:Name="PlayersStatHeader"/>
                <TextBlock x:Name="RoomPlayersText"/>
                <TextBlock x:Name="RoomConnHeader"/>
                <TextBlock x:Name="RoomConnText"/>
                <Border x:Name="RoomInfoCard"
                                  Background="{DynamicResource MpPanel}"
                                  BorderBrush="{DynamicResource MpRimSoft}"
                                  BorderThickness="1"
                                  CornerRadius="{StaticResource RadiusPanel}"
                                  Padding="13,12"
                                  Margin="0,0,0,11">
                              <StackPanel>
                                  <TextBlock x:Name="RoomInfoHeaderText"
                                             Foreground="{DynamicResource MpTextLabel}"
                                             FontSize="{DynamicResource MpPillSize}"
                                             FontWeight="SemiBold"
                                             Margin="0,0,0,10"/>
                                  <Grid x:Name="RoomModRow">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="Auto"/>
                                          <ColumnDefinition Width="*"/>
                                      </Grid.ColumnDefinitions>
                                      <TextBlock Grid.Column="0"
                                                 x:Name="RoomModLabel"
                                                 Foreground="{DynamicResource MpTextFaint}"
                                                 FontSize="{DynamicResource MpLabelSize}"
                                                 Margin="0,0,10,0"/>
                                      <TextBlock Grid.Column="1"
                                                 x:Name="RoomModText"
                                                 Foreground="{DynamicResource MpTextSecondary}"
                                                 FontSize="{DynamicResource MpLabelSize}"
                                                 TextTrimming="CharacterEllipsis"/>
                                  </Grid>
                                  <Grid Margin="0,7,0,0">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="Auto"/>
                                          <ColumnDefinition Width="*"/>
                                      </Grid.ColumnDefinitions>
                                      <TextBlock Grid.Column="0"
                                                 x:Name="RoomPasswordLabel"
                                                 Foreground="{DynamicResource MpTextFaint}"
                                                 FontSize="{DynamicResource MpLabelSize}"
                                                 Margin="0,0,10,0"/>
                                      <TextBlock Grid.Column="1"
                                                 x:Name="RoomPasswordText"
                                                 Foreground="{DynamicResource MpPrivateText}"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="{DynamicResource MpLabelSize}"
                                                 TextTrimming="CharacterEllipsis"/>
                                  </Grid>
                                  <Grid x:Name="RoomCopyRow" Margin="0,7,0,0" Visibility="Collapsed">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="Auto"/>
                                          <ColumnDefinition Width="*"/>
                                      </Grid.ColumnDefinitions>
                                      <TextBlock Grid.Column="0"
                                                 x:Name="RoomCopyLabel"
                                                 Foreground="{DynamicResource MpTextFaint}"
                                                 FontSize="{DynamicResource MpLabelSize}"
                                                 Margin="0,0,10,0"/>
                                      <TextBlock Grid.Column="1"
                                                 x:Name="RoomCopyText"
                                                 Foreground="{DynamicResource MpTextSecondary}"
                                                 FontSize="{DynamicResource MpLabelSize}"
                                                 TextTrimming="CharacterEllipsis"/>
                                  </Grid>
                              </StackPanel>
                          </Border>
                <Border x:Name="InGameOverlay"
                            Grid.Column="0"
                            Background="{DynamicResource MpAppBg}"
                            BorderBrush="{DynamicResource MpRimSoft}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPanel}"
                            Visibility="Collapsed">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- live header + clock -->
                                <RowDefinition Height="Auto"/>   <!-- three cells -->
                                <RowDefinition Height="Auto"/>   <!-- alone-in-the-room box -->
                                <RowDefinition Height="*"/>      <!-- peers -->
                                <RowDefinition Height="Auto"/>   <!-- abort -->
                            </Grid.RowDefinitions>

                            <!-- The clock joins the header instead of taking a cell of its
                                 own: it is the one number that changes every second, and a
                                 cell for it cost a quarter of the row for something the eye
                                 tracks anyway. -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0"
                                         x:Name="InGameLiveDot"
                                         Width="8" Height="8"
                                         Fill="{DynamicResource MpOk}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="InGameTitleText"
                                           Foreground="{DynamicResource MpTextPrimary}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Three cells: what is measurable during a match. The ROOM cell
                                 went with the header (the window title says which room), the
                                 MATCH TIME cell went to the header clock, and RECORDING took
                                 the place both left. -->
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="11"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="11"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{DynamicResource MpPanel}"
                                        CornerRadius="{StaticResource RadiusRow}"
                                        Padding="12,11">
                                    <StackPanel>
                                        <TextBlock x:Name="InGameTrafficHeader"
                                                   Foreground="{DynamicResource MpTextLabel}"
                                                   FontSize="{DynamicResource MpSectionLabelSize}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InGameTrafficText"
                                                   Foreground="{DynamicResource MpTextPrimary}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{DynamicResource MpPanel}"
                                        CornerRadius="{StaticResource RadiusRow}"
                                        Padding="12,11">
                                    <StackPanel>
                                        <TextBlock x:Name="InGameConnectionHeader"
                                                   Foreground="{DynamicResource MpTextLabel}"
                                                   FontSize="{DynamicResource MpSectionLabelSize}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InGameConnectionText"
                                                   Foreground="{DynamicResource MpOkTextAlt}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- RECORDING says what the LAUNCHER asked for, not what the
                                     game will do: AoE3 decides that with a per-match checkbox
                                     the launcher cannot read (measured — see
                                     RecordingIndicator). A green "active" here would be a lie
                                     in the one place where being wrong costs the player their
                                     rating. -->
                                <Border Grid.Column="4"
                                        Background="{DynamicResource MpPanel}"
                                        CornerRadius="{StaticResource RadiusRow}"
                                        Padding="12,11">
                                    <StackPanel>
                                        <TextBlock x:Name="InGameRecordingHeader"
                                                   Foreground="{DynamicResource MpTextLabel}"
                                                   FontSize="{DynamicResource MpSectionLabelSize}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InGameRecordingText"
                                                   Foreground="{DynamicResource MpOk}"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Alone in the room. It used to be one italic line inside the
                                 peer list with nothing to press, which describes the problem
                                 and leaves the player holding it. Both buttons act on it. -->
                            

                            <!-- Per-peer link state and RTT. Not in the reference's card, kept
                                 because the handoff's own prose asks for "ping por jugador":
                                 it is the only place a player can see WHICH peer is the
                                 problem. -->
                            <ScrollViewer Grid.Row="3"
                                          VerticalScrollBarVisibility="Auto"
                                          Margin="0,12,0,0">
                                <StackPanel x:Name="InGamePeersPanel"/>
                            </ScrollViewer>

                            
                        </Grid>
                    </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
