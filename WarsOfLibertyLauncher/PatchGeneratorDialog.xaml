<Window x:Class="WarsOfLibertyLauncher.PatchGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Generate patch"
        Width="700" Height="950"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        ShowInTaskbar="False">

    <!--
        Modder-facing delta-patch generator (design 101, on the structure of design 18). Diffs
        overlay .zips by SHA-256 and writes the small patch-<from>-to-<to>.zip + .json that go on
        the modder's NEW GitHub release: the incremental (previous -> new) and, when a baseline is
        supplied, the cumulative (baseline -> new). See Services/DeltaPatchService and
        docs/MODDING.md section 5.1.

        LAYOUT: one CARD PER RELEASE, each holding that release's .zip AND its tag, so the relation
        between a zip and its tag never has to be reconstructed across the screen.
    -->

    <Window.Resources>
        <!-- The shared TextBox template paints its focus ring from TextBoxFocusBrush, gold globally
             and targeted by name, so overriding the key is the only lever. -->
        <SolidColorBrush x:Key="TextBoxFocusBrush" Color="#2F7FE0"/>

        <!-- The 20 px square that opens each card; its fill and glyph say which release it is. -->
        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="CardIconGlyph" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource SetCaptionSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource SetRowTitleSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowStrongText}"/>
            <Setter Property="Margin" Value="9,0,10,0"/>
        </Style>
        <Style x:Key="CardNote" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="{DynamicResource SetDescSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style x:Key="DiagramNode" TargetType="Border">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="#66050A12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowCardRim}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DiagramTag" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="{DynamicResource DialogBodySize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowSoftText}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="DiagramRole" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SetDescSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                           TitleIcon="pack://application:,,,/Aoe3ModLauncher;component/AppIcon.png"
                           ShowMinimize="False" ShowMaximize="True" ShowClose="True"/>

        <ScrollViewer Grid.Row="1" x:Name="BodyScroll" Padding="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,22,22,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock x:Name="HeaderText" Style="{StaticResource WindowHeadline}"/>
                        <TextBlock x:Name="DescriptionText" Style="{StaticResource WindowBody}"
                                   MaxWidth="560" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="HowToggleButton"
                            Style="{StaticResource WindowBrowseButton}"
                            VerticalAlignment="Top"
                            Click="HowToggleButton_Click"/>
                </Grid>

                <!-- What it is doing, under the title (101c). -->
                <Border x:Name="WorkCard" Style="{StaticResource WindowCard}" Padding="16,14"
                        Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <controls:WindowSpinner Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" x:Name="WorkTitle"
                                       FontSize="{DynamicResource SetRowTitleSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WindowStrongText}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="10,0,10,0"/>
                            <TextBlock Grid.Column="2" x:Name="WorkCount"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="{DynamicResource DialogBodySize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource UiBodyText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar x:Name="WorkBar" Height="8" Minimum="0" Maximum="1"
                                     Style="{StaticResource LibraryProgressBar}"
                                     Foreground="{DynamicResource MpAction}"
                                     Margin="0,10,0,0"/>
                        <TextBlock x:Name="WorkSub"
                                   FontSize="{DynamicResource SetRowDescSize}"
                                   Foreground="{DynamicResource WindowMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- How it works: folded until asked for, and it stays as the modder leaves it. -->
                <Border x:Name="HowPanel" Style="{StaticResource WindowCard}" Padding="16,14"
                        Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HowTitleText" Style="{StaticResource WindowCardLabel}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="HowHideButton"
                                    Style="{StaticResource WindowTextLink}"
                                    Click="HowToggleButton_Click"/>
                        </Grid>

                        <!-- One grid and the bars on ColumnSpan: a bar that stops short of the node
                             it points at would be a lie. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource DiagramNode}">
                                <StackPanel>
                                    <TextBlock x:Name="DiagBaseTag" Style="{StaticResource DiagramTag}"/>
                                    <TextBlock x:Name="DiagBaseRole" Style="{StaticResource DiagramRole}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource DiagramNode}">
                                <StackPanel>
                                    <TextBlock x:Name="DiagPrevTag" Style="{StaticResource DiagramTag}"/>
                                    <TextBlock x:Name="DiagPrevRole" Style="{StaticResource DiagramRole}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource DiagramNode}"
                                    Background="#292F7FE0" BorderBrush="#662F7FE0">
                                <StackPanel>
                                    <TextBlock x:Name="DiagNewTag" Style="{StaticResource DiagramTag}"
                                               Foreground="{DynamicResource WindowIncremental}"/>
                                    <TextBlock x:Name="DiagNewRole" Style="{StaticResource DiagramRole}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                                    CornerRadius="8" Background="#292F7FE0" Padding="11,0">
                                <TextBlock x:Name="DiagIncrementalText"
                                           FontSize="{DynamicResource SetControlSize}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource WindowIncremental}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Border Grid.Row="4" Grid.ColumnSpan="5"
                                    CornerRadius="8" Background="#29966EDC" Padding="11,0">
                                <TextBlock x:Name="DiagCumulativeText"
                                           FontSize="{DynamicResource SetControlSize}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource WindowCumulative}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </Grid>
                        <StackPanel x:Name="HowBullets" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Previous release -->
                <Border Style="{StaticResource WindowCard}" Padding="16,13,16,12" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardIcon}" Background="#1AFFFFFF">
                                <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#x2190;"
                                           Foreground="{DynamicResource WindowMuted}"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="CardPrevTitle" Style="{StaticResource CardTitle}"/>
                            <TextBlock Grid.Column="2" x:Name="CardPrevNote" Style="{StaticResource CardNote}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="158"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PrevZipLabel" Style="{StaticResource WindowInputLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource WindowInputShell}">
                                        <Grid>
                                            <TextBlock x:Name="OldZipPlaceholder" Style="{StaticResource WindowInputPlaceholder}"/>
                                            <TextBox x:Name="OldZipBox" Style="{StaticResource WindowInputMono}"/>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="2" x:Name="BrowseOldBtn" Style="{StaticResource WindowBrowseButton}"
                                            Click="BrowseOldBtn_Click"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="PrevTagLabel" Style="{StaticResource WindowInputLabel}"/>
                                <Border x:Name="FromTagShell" Style="{StaticResource WindowInputShell}">
                                    <Grid>
                                        <TextBlock x:Name="FromTagPlaceholder" Style="{StaticResource WindowInputPlaceholder}"/>
                                        <TextBox x:Name="FromTagBox" Style="{StaticResource WindowInputMono}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="HintOldZip" Style="{StaticResource CardHint}"/>
                    </StackPanel>
                </Border>

                <!-- New release -->
                <Border Style="{StaticResource WindowCard}" Padding="16,13,16,12" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardIcon}" Background="#332F7FE0">
                                <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#x2192;"
                                           Foreground="{DynamicResource WindowIncremental}"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="CardNewTitle" Style="{StaticResource CardTitle}"/>
                            <TextBlock Grid.Column="2" x:Name="CardNewNote" Style="{StaticResource CardNote}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="158"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="NewZipLabel" Style="{StaticResource WindowInputLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource WindowInputShell}">
                                        <Grid>
                                            <TextBlock x:Name="NewZipPlaceholder" Style="{StaticResource WindowInputPlaceholder}"/>
                                            <TextBox x:Name="NewZipBox" Style="{StaticResource WindowInputMono}"/>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="2" x:Name="BrowseNewBtn" Style="{StaticResource WindowBrowseButton}"
                                            Click="BrowseNewBtn_Click"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="NewTagLabel" Style="{StaticResource WindowInputLabel}"/>
                                <Border x:Name="ToTagShell" Style="{StaticResource WindowInputShell}">
                                    <Grid>
                                        <TextBlock x:Name="ToTagPlaceholder" Style="{StaticResource WindowInputPlaceholder}"/>
                                        <TextBox x:Name="ToTagBox" Style="{StaticResource WindowInputMono}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="HintNewZip" Style="{StaticResource CardHint}"/>
                    </StackPanel>
                </Border>

                <!-- Baseline: optional, so it sits back until it is filled in. -->
                <Border x:Name="BaseCard" Style="{StaticResource WindowCard}" Padding="16,13,16,12" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardIcon}" Background="#33966EDC">
                                <TextBlock Style="{StaticResource CardIconGlyph}" Text="&#x25C7;"
                                           Foreground="{DynamicResource WindowCumulative}"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="CardBaseTitle" Style="{StaticResource CardTitle}"/>
                            <TextBlock Grid.Column="2" x:Name="CardBaseNote" Style="{StaticResource CardNote}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="158"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="BaseZipLabel" Style="{StaticResource WindowInputLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource WindowInputShell}">
                                        <Grid>
                                            <TextBlock x:Name="BaselineZipPlaceholder" Style="{StaticResource WindowInputPlaceholder}"/>
                                            <TextBox x:Name="BaselineZipBox" Style="{StaticResource WindowInputMono}"/>
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="2" x:Name="BrowseBaselineBtn" Style="{StaticResource WindowBrowseButton}"
                                            Click="BrowseBaselineBtn_Click"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="BaseTagLabel" Style="{StaticResource WindowInputLabel}"/>
                                <Border Style="{StaticResource WindowInputShell}">
                                    <Grid>
                                        <TextBlock x:Name="BaselineTagPlaceholder" Style="{StaticResource WindowInputPlaceholder}"/>
                                        <TextBox x:Name="BaselineTagBox" Style="{StaticResource WindowInputMono}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="HintBaseline" Style="{StaticResource CardHint}"/>
                    </StackPanel>
                </Border>

                <!-- What will be written, in the words the release will use. -->
                <Border x:Name="OutputPreviewPanel" CornerRadius="12" Background="#1A2F7FE0"
                        BorderBrush="#592F7FE0" BorderThickness="1" Padding="13,11" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PreviewHeader"
                                       FontSize="{DynamicResource SetCaptionSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WindowIncremental}"/>
                            <TextBlock Grid.Column="1" x:Name="PreviewTarget"
                                       FontSize="{DynamicResource SetDescSize}"
                                       Foreground="{DynamicResource WindowMuted}"/>
                        </Grid>
                        <StackPanel x:Name="PreviewRows"/>
                        <Border x:Name="PreviewCumulativeHint" CornerRadius="7" BorderBrush="#66966EDC"
                                BorderThickness="1" Padding="10,7" Margin="0,8,0,0">
                            <TextBlock x:Name="PreviewCumulativeText"
                                       FontSize="{DynamicResource SetControlSize}"
                                       Foreground="{DynamicResource WindowCumulative}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="TagWarning" Style="{StaticResource WindowNotice}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource WindowNoticeMark}">
                            <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,1,0,0">
                            <TextBlock x:Name="TagWarnTitle"
                                       FontSize="{DynamicResource DialogBodySize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WindowNoticeTitle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TagWarnBody"
                                       FontSize="{DynamicResource SetRowDescSize}"
                                       Foreground="{DynamicResource WindowNoticeBody}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The result: the files, their sizes and where they go. -->
                <Border x:Name="ResultPanel" Style="{StaticResource WindowCard}"
                        BorderBrush="#5C4FD68A" Padding="16,14" Margin="0,14,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10"
                                    Background="{DynamicResource WindowSafeTick}">
                                <TextBlock Text="&#x2713;" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="ResultText"
                                       FontSize="{DynamicResource SetRowTitleSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WindowStrongText}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="10,0,10,0"/>
                            <Button Grid.Column="2" x:Name="ShowInFolderBtn"
                                    Style="{StaticResource WindowBrowseButton}"
                                    Click="ShowInFolderBtn_Click"/>
                        </Grid>
                        <TextBlock x:Name="ReminderText" Style="{StaticResource WindowBody}" Margin="0,10,0,0"/>
                        <StackPanel x:Name="ResultFiles"/>
                        <Border x:Name="RebaselinePanel" Style="{StaticResource WindowNotice}"
                                Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource WindowNoticeMark}">
                                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="RebaselineText"
                                           FontSize="{DynamicResource SetRowDescSize}"
                                           Foreground="{DynamicResource WindowNoticeTitle}"
                                           TextWrapping="Wrap"
                                           Margin="10,1,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- A failure: the reason in plain words, the exception underneath, the form intact. -->
                <Border x:Name="ErrorBox" Style="{StaticResource WindowNotice}" Padding="11,9"
                        Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource WindowNoticeMark}">
                            <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,1,0,0">
                            <TextBlock x:Name="ErrorTitle"
                                       FontSize="{DynamicResource DialogBodySize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WindowNoticeTitle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ErrorBody"
                                       FontSize="{DynamicResource SetRowDescSize}"
                                       Foreground="{DynamicResource WindowNoticeBody}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ErrorDetail"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="{DynamicResource SetDescSize}"
                                       Foreground="{DynamicResource WindowMuted}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Margin="0,14,0,0">
                    <TextBlock x:Name="LblOutput" Style="{StaticResource WindowInputLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource WindowInputShell}">
                            <TextBox x:Name="OutputBox" Style="{StaticResource WindowInputMono}"/>
                        </Border>
                        <Button Grid.Column="2" x:Name="BrowseOutBtn" Style="{StaticResource WindowBrowseButton}"
                                Click="BrowseOutBtn_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource GlassFooter}"
                BorderBrush="{DynamicResource WindowFooterRule}"
                BorderThickness="0,1,0,0"
                Padding="22,12,22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterNote"
                           FontSize="{DynamicResource SetControlSize}"
                           Foreground="{DynamicResource WindowFineText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <Button Grid.Column="1" x:Name="CloseBtn" Style="{StaticResource WindowSecondaryButton}"
                        MinWidth="112" Click="CloseBtn_Click"/>
                <Button Grid.Column="2" x:Name="GenerateBtn" Style="{StaticResource WindowPrimaryButton}"
                        MinWidth="136" Margin="8,0,0,0" Click="GenerateBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
