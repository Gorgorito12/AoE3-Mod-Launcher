<Window x:Class="WarsOfLibertyLauncher.LauncherSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Ajustes del launcher"
        Height="600" Width="820"
        MinHeight="540" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="True">

    <!--
        Launcher-wide settings dialog, laid out from
        docs/design_handoff_ajustes_y_taller (4a-4d).

        FIVE sections, not seven — see the ShowSection bullet in CLAUDE.md:
          General   — language, startup, notifications, connection, dev mode
          Interface — text size + top-tab order (content unchanged; it only
                      inherits the bounded width)
          Games     — the recording settings, which decide whether a match
                      can be rated
          Mods and updates — the old Updates + Catalog & Sources panels
          Advanced  — the old Maintenance + Privacy + Developer panels

        The panels below KEPT their names and their contents; only the
        grouping moved, which is why no LoadFromConfig / SaveButton_Click
        line had to change. A section may therefore show more than one
        panel, and ShowSection owns that mapping.

        Chrome: WindowStyle=None + the shared controls:TitleBar; WindowChrome
        is applied centrally in App.OnAnyWindowLoaded. The footer is sticky
        so the actions never scroll off, and it now counts what is pending
        rather than showing a permanent Cancel/Save pair.
    -->

    <!-- WindowChrome (caption drag area + edge-resize) is applied centrally
         in App.OnAnyWindowLoaded from the global TitleBarHeight token; the
         title bar itself is the shared controls:TitleBar below. -->

    <Window.Resources>
        <!-- Hairline divider between groups inside a tab panel. Same
             recipe as ModPropertiesDialog's DialogDivider — duplicated
             here because that style lives in the per-Window resources
             of the other dialog and isn't reachable from this scope. -->
        <Style x:Key="DialogDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,18,0,18"/>
        </Style>

        <!-- Hint caption under checkboxes/radios/buttons. Indented 22 px
             to align with the box's label text. -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="22,1,0,8"/>
        </Style>

        <!-- CheckBox / RadioButton / TextBox / ComboBox are now themed
             globally by Styles/Inputs.xaml (dark surfaces, gold accent,
             and — crucially for ComboBox — a full dark ControlTemplate so
             the dropdown popup isn't white). The old local colour-only
             styles lived here but couldn't retemplate the ComboBox, which
             is why the language dropdown rendered white. Removed so the
             global implicit styles apply. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Title-bar close ✕ now lives in the shared controls:TitleBar
             (Styles/Chrome.xaml TitleBarCloseButton) — no per-dialog style. -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="*"/>      <!-- Sidebar + content -->
            <RowDefinition Height="Auto"/>   <!-- Sticky action bar -->
        </Grid.RowDefinitions>

        <!-- =========================================================
             HEADER — shared global title bar (close-only sheet).
             ========================================================= -->
        <controls:TitleBar Grid.Row="0"
                           x:Name="TitleBarControl"
                           ShowMinimize="True"
                           ShowMaximize="True"
                           ShowClose="True"/>

        <!-- =========================================================
             SIDEBAR + TAB PANELS
             ========================================================= -->
        <Grid Grid.Row="1" x:Name="SettingsContentRoot">
            <Grid.ColumnDefinitions>
                <!-- Auto here, with the fixed width on the rail Border itself: a
                     ColumnDefinition takes a GridLength, and a StaticResource holding a
                     double is not converted for it. The width is fixed (not the
                     Auto-that-grows the rest of the launcher uses) because the rail
                     carries a search field and two kinds of signal, and a width that
                     followed the longest label would move all of them whenever a label
                     changed. -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left rail — FIVE entries, not seven.
                 Maintenance + Privacy + Developer merged into ADVANCED (between
                 them they filled half a screen) and Updates + Catalog into MODS
                 AND UPDATES (they explained each other: the update channel sat
                 apart from the catalog the mods come from).

                 216 from the handoff, as a FLOOR rather than a fixed width — and the
                 difference is not pedantry. That comment used to claim 216 was "wide
                 enough for the longest label at 125% text scale", which was never
                 tested because the Set* tokens were not in TextScale.ScaledKeys and
                 the text never grew. Once it did, "Mods y actualizaciones" trimmed to
                 "Mods y actualizacio..." at 110% — measured, on this screen.

                 So: MinWidth, with the column already Auto. At 100% the rail is 216
                 to the pixel, which is the size the reference specifies at the size
                 the reference was drawn for; above that it grows by exactly what the
                 longest label needs. Never Width="Auto" alone — the rail would then
                 SHRINK below the reference on a short-labelled language. -->
            <Border Grid.Column="0"
                    MinWidth="{StaticResource SetRailWidth}"
                    Background="{DynamicResource MpRowHighlight}"
                    BorderBrush="{DynamicResource MpRimFaint}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="10,14,10,0">
                        <!-- Settings search. Chrome-less TextBox inside a Border that
                             owns the inset — one of the two shapes Inputs.xaml
                             documents; mixing them is what once left a placeholder a
                             pixel off its own caret. The placeholder carries the SAME
                             FontSize as the box or the text jumps when you type. -->
                        <Border Style="{StaticResource SetSearchShell}" Margin="2,0,2,12">
                            <DockPanel>
                                <TextBlock Text="&#xE721;"
                                           DockPanel.Dock="Left"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource SetControlSize}"
                                           Foreground="{DynamicResource UiTextIcon}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <Grid>
                                    <TextBox x:Name="SettingsSearchBox"
                                             Style="{StaticResource SetSearchField}"
                                             TextChanged="SettingsSearchBox_TextChanged"/>
                                    <TextBlock x:Name="SettingsSearchPlaceholder"
                                               Style="{StaticResource SetSearchPlaceholder}"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Button x:Name="TabGeneralBtn"
                                Style="{StaticResource SetNavButton}"
                                Click="TabGeneralBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE713;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TabGeneralLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="TabInterfaceBtn"
                                Style="{StaticResource SetNavButton}"
                                Click="TabInterfaceBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE8A1;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TabInterfaceLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                        <!-- The two entries that can carry a signal. Both dock to the
                             RIGHT so the label keeps the remaining space and trims;
                             the handoff is explicit that a signal must never push the
                             text, because a wrapped entry changes that row's height
                             and the rail stops lining up between sections. -->
                        <Button x:Name="TabGamesBtn"
                                Style="{StaticResource SetNavButton}"
                                Click="TabGamesBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE768;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <Ellipse x:Name="TabGamesDot"
                                         DockPanel.Dock="Right"
                                         Width="6" Height="6"
                                         Fill="{DynamicResource MpCaution}"
                                         VerticalAlignment="Center"
                                         Margin="8,0,2,0"
                                         Visibility="Collapsed"/>
                                <TextBlock x:Name="TabGamesLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="TabModsBtn"
                                Style="{StaticResource SetNavButton}"
                                Click="TabModsBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE895;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <Border x:Name="TabModsCount"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SetNavCountPill}"
                                        Margin="8,0,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="TabModsCountText"/>
                                </Border>
                                <TextBlock x:Name="TabModsLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="TabAdvancedBtn"
                                Style="{StaticResource SetNavButton}"
                                Click="TabAdvancedBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE7C1;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TabAdvancedLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Rail footer: which launcher this is, and which build. It
                         answers the first question of any bug report without the
                         user having to find an About box. -->
                    <Border Grid.Row="1"
                            Margin="12,18,12,14"
                            Padding="0,14,0,0"
                            BorderBrush="{DynamicResource MpRimFaint}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock x:Name="RailProductText"
                                       Style="{StaticResource SetRailFooterText}"/>
                            <!-- Also the way in to the developer tools: seven taps here.
                                 Background is what makes it hit-testable at all — a
                                 TextBlock with no Background is transparent to the mouse and
                                 would never see the click. Deliberately carries no cursor
                                 change and no tooltip: a version line that looked clickable
                                 would not be hidden. -->
                            <TextBlock x:Name="RailVersionText"
                                       Style="{StaticResource SetRailFooterText}"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Margin="0,4,0,0"
                                       Background="Transparent"
                                       MouseLeftButtonUp="RailVersionText_MouseLeftButtonUp"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right content area. ONE column, FULL WIDTH.

                 It has now been four shapes, and the first three were each rejected on
                 sight: capped-and-left (half a maximised monitor blank), capped-and-centred
                 (the same emptiness moved into two quarters), and split into columns, which
                 on a wide window drew two UNEQUAL columns with half a panel blank below —
                 4 rows against 7 in the maintainer's own screenshot.

                 So nothing here caps the width: no MaxWidth and no alignment anywhere on the
                 chain from this ScrollViewer down to a section panel, which is what lets a
                 row span the window. That absence IS the feature and it is invisible in a
                 diff, so DialogXamlTests walks the chain and asserts it.

                 The one guard rail left is on the TEXT, not the layout: SetRowDesc wraps, so
                 it carries a MaxWidth of its own to stop a description becoming one line
                 across an ultrawide. See the note on SetDescMaxWidth.

                 The padding stays: it is the margin from the window edges.

                 Each panel below is one section; only the active one is Visible, and a
                 section may show more than one panel (ADVANCED is Maintenance + Privacy +
                 Developer). See ShowSection. -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="{StaticResource SetContentPadding}">
                    <StackPanel>
                    <TextBlock x:Name="SectionTitleText"
                               Style="{StaticResource SetSectionTitle}"/>
                    <!-- Shown INSTEAD of every section when a search matches nothing anywhere.
                         Without it the query simply emptied the page and left the reader looking
                         at a heading over nothing, with no way to tell a search that found no
                         match from one that had broken. -->
                    <TextBlock x:Name="SettingsNoResults"
                               Style="{StaticResource SetRowDesc}"
                               Visibility="Collapsed"
                               Margin="2,10,0,0"/>
                    <!-- The section panels. A StackPanel, NOT a Grid.

                         They used to be Grid siblings, which put them all in the same
                         cell: harmless while exactly one was ever Visible, and broken the
                         moment the redesign merged seven rail entries into five, because
                         MODS AND UPDATES shows two panels and ADVANCED shows three and
                         they drew ON TOP of each other.

                         Nothing in a build or a unit test can see that — the panels really
                         were Visible, which is all a visibility test checks. It is only
                         visible by opening the window. -->
                    <StackPanel>
                    <!-- ===================================================
                         GENERAL (4a)

                         Eleven checkboxes in a flat column all carry the same
                         weight, so you had to read every one to find the one you
                         wanted. They are four groups now, each a card with an
                         UPPERCASE label above it, and every checkbox is a switch
                         you can find by its colour.

                         The two game-recording settings that used to sit in the
                         middle of that column moved to GAMES: they are what
                         decides whether a match can be rated, and they were the
                         least findable things on the page.
                         =================================================== -->
                    <StackPanel x:Name="GeneralPanel" Visibility="Visible">

                        <!-- Language sits on its own above the groups: it is the
                             setting most likely to be the reason someone opened
                             this window at all, and it belongs to no group. -->
                        <Border Style="{StaticResource SetCard}" Margin="0,4,0,0">
                            <Border Style="{StaticResource SetRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LanguageLabel" Style="{StaticResource SetRowTitle}"/>
                                        <TextBlock x:Name="LanguageInstantHint" Style="{StaticResource SetRowDesc}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              x:Name="LanguageCombo"
                                              Style="{StaticResource SetCompactCombo}">
                                        <ComboBoxItem Content="English" Tag="en"/>
                                        <ComboBoxItem Content="Español" Tag="es"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- ================= STARTUP ================= -->
                        <TextBlock x:Name="GroupStartupLabel"
                                   Style="{StaticResource SetGroupLabel}"
                                   Margin="0,20,0,9"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <!-- Auto | Auto | * — the badge hugs the title
                                                 instead of being pushed to the far edge,
                                                 and the star column absorbs the slack. A
                                                 horizontal StackPanel would look the same
                                                 until a long title needed to trim: it
                                                 measures its children with INFINITE width,
                                                 so CharacterEllipsis never fires. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" x:Name="StartWithWindowsTitle"
                                                           Style="{StaticResource SetRowTitle}"/>
                                                <Border Grid.Column="1" Style="{StaticResource SetBadge}"
                                                        Tag="ok" Margin="8,0,0,0">
                                                    <TextBlock x:Name="StartWithWindowsBadge"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="StartWithWindowsHint" Style="{StaticResource SetRowDesc}"/>
                                            <!-- The checkbox reads the REGISTRY, and the Run key is written to
                                                 the hive of the account the launcher runs AS. Under another
                                                 account that is a hive Windows never reads at logon, so the
                                                 switch reads "on" while nothing ever starts — a lie that
                                                 confirms itself. The value is left alone (it is true about its
                                                 own hive); what was missing was the context. See
                                                 Services/RunningAccount.cs. -->
                                            <Border x:Name="StartWithWindowsAccountBox"
                                                    Style="{StaticResource SetNoticeAmber}"
                                                    Margin="0,8,0,0"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="StartWithWindowsAccountWarning"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="StartWithWindowsCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="MinimizeToTrayTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="MinimizeToTrayHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="MinimizeToTrayCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="CloseOnGameTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="CloseOnGameHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="CloseOnGameCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ================= NOTIFICATIONS ================= -->
                        <TextBlock x:Name="GroupNoticesLabel" Style="{StaticResource SetGroupLabel}"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" x:Name="NotifyNewRoomsTitle"
                                                           Style="{StaticResource SetRowTitle}"/>
                                                <Border Grid.Column="1" Style="{StaticResource SetBadge}"
                                                        Tag="ok" Margin="8,0,0,0">
                                                    <TextBlock x:Name="NotifyNewRoomsBadge"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="NotifyNewRoomsHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="NotifyNewRoomsCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="ReceiveInvitesTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="ReceiveInvitesHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="ReceiveInvitesCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="ShowToastsTitle" Style="{StaticResource SetRowTitle}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="ShowToastsCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <!-- Sounds carries a Test button beside its switch: the
                                     only way to judge a sound setting is to hear it, and
                                     the alternative is joining a room and waiting for
                                     someone to type. -->
                                <Border Style="{StaticResource SetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="SoundsTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="SoundsHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                x:Name="SoundTestButton"
                                                Style="{StaticResource SetActionPill}"
                                                Margin="0,0,12,0"
                                                Click="SoundTestButton_Click"/>
                                        <ToggleButton Grid.Column="2" x:Name="SoundsCheck"
                                                      Style="{StaticResource SetToggle}"
                                                      VerticalAlignment="Center"
                                                      Margin="0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ================= CONNECTION ================= -->
                        <TextBlock x:Name="GroupConnectionLabel" Style="{StaticResource SetGroupLabel}"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="EnableJoinLinksTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="EnableJoinLinksHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="EnableJoinLinksCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <!-- The Radmin assistant is three states, not two, so it
                                     stays a dropdown rather than becoming a switch. This is
                                     one of the two behaviour changes the handoff sanctions
                                     — and the config field was already three-state
                                     (RadminAssistantMode), only the UI lied about it. -->
                                <Border Style="{StaticResource SetActionRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="RadAsstLabelText" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="RadAsstHintText" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  x:Name="RadAsstCombo"
                                                  Style="{StaticResource SetCompactCombo}"
                                                  SelectionChanged="RadAsstCombo_SelectionChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- The developer-mode switch USED to sit here, as a loose row at the
                             bottom of GENERAL. It is gone: a row that says "developer tools"
                             to every player is an invitation, and these tools are for the
                             handful of people who author mods and translations. The switch now
                             lives inside the DEVELOPER card it governs — which is only
                             reachable once the card is, and the card is reached by the tap
                             gesture on the version line in the rail. See
                             RailVersionText_MouseLeftButtonUp. -->
                    </StackPanel>

                    <!-- ===================================================
                         GAMES (4b) — the recording settings.

                         They decide whether a match can be rated at all, and they
                         used to sit in the middle of the General column with a
                         four-line paragraph under each. Their own section, at the
                         top, with the consequence stated once.
                         =================================================== -->
                    <StackPanel x:Name="GamesPanel" Visibility="Collapsed">
                        <TextBlock x:Name="GamesIntroText"
                                   Style="{StaticResource SetRowDesc}"
                                   Margin="0,4,0,0"/>

                        <!-- The one banner in this window that reads real state: whether
                             AoE3 is set to record, taken from the mod's own profile on
                             disk. THREE answers, not two — on, off, and no profile yet
                             (the game writes it on its first run), and only the middle
                             one is a problem worth interrupting for. -->
                        <Border x:Name="RecordingOffBanner"
                                Style="{StaticResource SetNoticeAmber}"
                                Margin="0,14,0,0"
                                Padding="{StaticResource SetActionRowPadding}"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="28" Height="28"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="{DynamicResource MpProvisionalBg}"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="!"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource MpCaution}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="RecordingOffTitle"
                                               Style="{StaticResource SetRowTitle}"
                                               Foreground="{DynamicResource MpCautionTextAlt}"/>
                                    <TextBlock x:Name="RecordingOffBody"
                                               Style="{StaticResource SetRowDesc}"
                                               Foreground="{DynamicResource MpCautionText}"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="RecordingOffButton"
                                        Style="{StaticResource SetActionButtonLg}"
                                        Click="RecordingOffButton_Click"/>
                            </Grid>
                        </Border>


                        <TextBlock x:Name="GroupRecordingLabel" Style="{StaticResource SetGroupLabel}"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" x:Name="GameRecordingTitle"
                                                           Style="{StaticResource SetRowTitle}"/>
                                                <Border Grid.Column="1" Style="{StaticResource SetBadge}"
                                                        Tag="ok" Margin="8,0,0,0">
                                                    <TextBlock x:Name="GameRecordingBadge"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="GameRecordingHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="GameRecordingCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="RecordReminderTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="RecordReminderHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="RecordReminderCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- RANKING. Both rows are drawn and unread — see the block comment
                             on LauncherConfig.ShowMyElo. Hiding a rating is the SERVER's
                             call (it joins and pushes the number to everyone else), and
                             the replay upload endpoint is unverified. -->
                        <TextBlock x:Name="GroupRankingLabel" Style="{StaticResource SetGroupLabel}"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="ShowEloTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="ShowEloHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="ShowEloCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetActionRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ReplayUpTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="ReplayUpHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource SetSegment}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ReplayAskRadio"
                                                             GroupName="ReplayUpload"
                                                             Style="{StaticResource SetSegmentItem}"/>
                                                <RadioButton x:Name="ReplayAlwaysRadio"
                                                             GroupName="ReplayUpload"
                                                             Style="{StaticResource SetSegmentItem}"/>
                                                <RadioButton x:Name="ReplayNeverRadio"
                                                             GroupName="ReplayUpload"
                                                             Style="{StaticResource SetSegmentItem}"
                                                             Margin="0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================================================
                         INTERFACE TAB — reorder the top nav tabs.
                         The rows in TabOrderList are built in code-behind
                         from the in-memory order list so ↑/↓ reordering is
                         just a re-render. The first row = the tab that
                         opens on launch.
                         =================================================== -->
                    <!-- INTERFACE. Same content as before, in the shared card shape —
                         which is exactly what the handoff asks of it: "it does not change
                         content, it only inherits the bounded width". -->
                    <StackPanel x:Name="InterfacePanel" Visibility="Collapsed">
                        <Border Style="{StaticResource SetCard}" Margin="0,4,0,0">
                            <Border Style="{StaticResource SetActionRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TextScaleLabel" Style="{StaticResource SetRowTitle}"/>
                                        <TextBlock x:Name="TextScaleHint" Style="{StaticResource SetRowDesc}"/>
                                        <!-- Not decoration: "Automatic" is the default, so
                                             without this line the setting never says what it
                                             decided or why. -->
                                        <TextBlock x:Name="TextScaleResolvedText"
                                                   Style="{StaticResource SetMonoValue}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="TextScaleCombo"
                                              Style="{StaticResource SetCompactCombo}"
                                              SelectionChanged="TextScaleCombo_SelectionChanged"/>
                                </Grid>
                            </Border>
                        </Border>

                        <TextBlock x:Name="TabOrderLabel" Style="{StaticResource SetGroupLabel}"/>
                        <Border Style="{StaticResource SetCard}">
                            <Border Style="{StaticResource SetRowLast}">
                                <StackPanel>
                                    <TextBlock x:Name="TabOrderHint" Style="{StaticResource SetRowDesc}" Margin="0"/>
                                    <!-- One row per nav tab (built by RenderTabOrderList):
                                         position badge + tab name + up/down. -->
                                    <StackPanel x:Name="TabOrderList"
                                                Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>

                    <!-- ===================================================
                         UPDATES TAB
                         =================================================== -->
                    <!-- ===================================================
                         MODS AND UPDATES (4d) — the old Updates + Catalog panels.

                         Four of these rows are new and NOTHING READS THEM YET: auto-update,
                         delta-only, the channel and the download limit. They are drawn
                         because the handoff draws them; the engine behind each is separate
                         work. See the block comment on LauncherConfig.AutoUpdateMods, and
                         READ IT before wiring the verify-signature switch — payload
                         verification is already conditional, so "off" must never come to
                         mean "skip the check".
                         =================================================== -->
                    <StackPanel x:Name="UpdatesPanel" Visibility="Collapsed">
                        <TextBlock x:Name="UpdatesGroupLabel"
                                   Style="{StaticResource SetGroupLabel}"
                                   Margin="0,20,0,9"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" x:Name="AutoUpdateTitle"
                                                           Style="{StaticResource SetRowTitle}"/>
                                                <Border Grid.Column="1" Style="{StaticResource SetBadge}"
                                                        Tag="ok" Margin="8,0,0,0">
                                                    <TextBlock x:Name="AutoUpdateBadge"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="AutoUpdateHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="AutoUpdateCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="DeltaOnlyTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="DeltaOnlyHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="DeltaOnlyCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetActionRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ChannelTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="ChannelHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource SetSegment}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="ChannelStableRadio"
                                                             GroupName="UpdateChannel"
                                                             Style="{StaticResource SetSegmentItem}"/>
                                                <RadioButton x:Name="ChannelBetaRadio"
                                                             GroupName="UpdateChannel"
                                                             Style="{StaticResource SetSegmentItem}"
                                                             Margin="0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetActionRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DownloadLimitTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="DownloadLimitHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="DownloadLimitCombo"
                                                  Style="{StaticResource SetCompactCombo}"/>
                                    </Grid>
                                </Border>

                                <!-- The two update settings that DO work. The handoff does
                                     not draw them; dropping a real setting to match a mock
                                     would be a regression, so they keep the same shape as
                                     the rest of the card. -->
                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="AutoCheckTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="AutoCheckHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="AutoCheckCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="OpenPostUpdateTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="OpenPostUpdateHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="OpenPostUpdateCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- INSTALLED MODS. Version comes from the per-mod state the config
                             already holds; the reference also shows a size and a fingerprint,
                             and neither exists without walking the disk or hashing files, so
                             the line ships without them rather than with invented ones. -->
                        <Grid Margin="0,18,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="InstalledModsLabel"
                                       Style="{StaticResource SetGroupLabel}"
                                       Margin="0"/>
                            <TextBlock Grid.Column="1" x:Name="InstalledModsCount"
                                       Style="{StaticResource SetMonoValue}"/>
                        </Grid>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <StackPanel x:Name="InstalledModsList"/>
                                <Border x:Name="InstalledModsEmptyRow"
                                        Style="{StaticResource SetRowLast}"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="InstalledModsEmpty" Style="{StaticResource SetRowDesc}" Margin="0"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================================================
                         CATALOGUE — second block of MODS AND UPDATES.
                         =================================================== -->
                    <StackPanel x:Name="CatalogPanel" Visibility="Collapsed">
                        <TextBlock x:Name="CatalogSubheader" Style="{StaticResource SetGroupLabel}"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SetActionRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="CatalogSourceTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="CatalogSourceValue"
                                                       Style="{StaticResource SetMonoValue}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="CatalogChangeButton"
                                                Style="{StaticResource SetActionButton}"
                                                Click="CatalogChangeButton_Click"/>
                                    </Grid>
                                </Border>

                                <!-- The three ways to point the catalogue somewhere else stay
                                     exactly as they were; they just fold away, because the
                                     reference shows one line and a Change button and this is
                                     what "Change" opens. -->
                                <Border x:Name="CatalogEditBlock"
                                        Style="{StaticResource SetRow}"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <RadioButton x:Name="CatalogDefaultRadio" GroupName="Catalog"/>
                                        <RadioButton x:Name="CatalogCustomRadio" GroupName="Catalog" Margin="0,8,0,0"/>
                                        <TextBox x:Name="CatalogCustomBox" Margin="22,6,0,0" MaxWidth="360"
                                                 HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="CatalogInvalidText"
                                                   Style="{StaticResource SetRowDesc}"
                                                   Foreground="{DynamicResource MpDestructiveText}"
                                                   Margin="22,4,0,0"
                                                   Visibility="Collapsed"/>
                                        <RadioButton x:Name="CatalogDisabledRadio" GroupName="Catalog" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SetActionRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="CatalogRefreshTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="ClearCacheHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="ClearCacheButton"
                                                Style="{StaticResource SetActionButton}"
                                                Click="ClearCacheButton_Click"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" x:Name="VerifyDownloadsTitle"
                                                           Style="{StaticResource SetRowTitle}"/>
                                                <Border Grid.Column="1" Style="{StaticResource SetBadge}"
                                                        Tag="ok" Margin="8,0,0,0">
                                                    <TextBlock x:Name="VerifyDownloadsBadge"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="VerifyDownloadsHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="VerifyDownloadsCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Translation sources. Not in the handoff either, and real. -->
                        <TextBlock x:Name="TxSourcesHeader" Style="{StaticResource SetGroupLabel}"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SetRow}">
                                    <StackPanel>
                                        <TextBlock x:Name="TxDefaultLabel" Style="{StaticResource SetRowTitle}"/>
                                        <TextBlock x:Name="TxAddHeader" Style="{StaticResource SetRowDesc}"/>
                                        <StackPanel x:Name="TxRepoList" Margin="0,8,0,0"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="TxAddBox" MaxWidth="360"
                                                     HorizontalAlignment="Left" MinWidth="240"/>
                                            <Button Grid.Column="1" x:Name="TxAddButton"
                                                    Style="{StaticResource SetActionButtonSm}"
                                                    Margin="10,0,0,0"
                                                    Click="TxAddButton_Click"/>
                                        </Grid>
                                        <TextBlock x:Name="TxInvalidText"
                                                   Style="{StaticResource SetRowDesc}"
                                                   Foreground="{DynamicResource MpDestructiveText}"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="TxDisabledTitle"
                                                   Style="{StaticResource SetRowTitle}"
                                                   Margin="0,0,14,0"/>
                                        <ToggleButton Grid.Column="1" x:Name="TxDisabledCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetActionRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ClearTxCacheTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="ClearTranslationsCacheHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="ClearTranslationsCacheButton"
                                                Style="{StaticResource SetActionButton}"
                                                Click="ClearTranslationsCacheButton_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="MaintenancePanel" Visibility="Collapsed">
                        <TextBlock x:Name="MaintenanceGroupLabel"
                                   Style="{StaticResource SetGroupLabel}"
                                   Margin="0,20,0,9"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SetActionRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ClearAssetsTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="ClearAssetsHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="ClearAssetsButton"
                                                Style="{StaticResource SetActionButton}"
                                                Click="ClearAssetsButton_Click"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetActionRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ClearTempTitle" Style="{StaticResource SetRowTitle}"/>
                                            <!-- The reference shows the size here ("Interrupted downloads · 318 MB").
                                                 Nothing measures the temp root today, so the sentence ships without
                                                 the figure rather than with an invented one. -->
                                            <TextBlock x:Name="ClearTempHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="ClearTempButton"
                                                Style="{StaticResource SetActionButton}"
                                                Click="ClearTempButton_Click"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetActionRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="OpenDataFolderTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="OpenDataFolderHint"
                                                       Style="{StaticResource SetMonoValue}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="OpenDataFolderButton"
                                                Style="{StaticResource SetActionButton}"
                                                Click="OpenDataFolderButton_Click"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetActionRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" x:Name="LauncherVersionTitle"
                                                           Style="{StaticResource SetRowTitle}"/>
                                                <!-- The reference badges this "v2.4.1 up to date". The window
                                                     cannot know that — only MainWindow's self-update check can —
                                                     so it states the version and no verdict. -->
                                                <Border Grid.Column="1" Style="{StaticResource SetBadge}" Margin="8,0,0,0">
                                                    <TextBlock x:Name="LauncherVersionBadge"
                                                               FontFamily="{DynamicResource MonoFont}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="CheckLauncherUpdateHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="CheckLauncherUpdateButton"
                                                Style="{StaticResource SetActionButton}"
                                                Click="CheckLauncherUpdateButton_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- "Install on this PC" gets its own blue box, out of the grey
                             list: it is the one action in this section somebody actually
                             comes looking for. -->
                        <Border x:Name="SelfInstallRow"
                                Margin="0,14,0,0"
                                Background="{DynamicResource MpEventBg}"
                                BorderBrush="{DynamicResource MpEventRim}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusPanel}"
                                Padding="{StaticResource SetActionRowPadding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="28" Height="28"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="{DynamicResource MpActionSoftBg}"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE896;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="{DynamicResource SetDescSize}"
                                               Foreground="{DynamicResource MpActionText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SelfInstallTitle" Style="{StaticResource SetRowTitle}"/>
                                    <TextBlock x:Name="SelfInstallHint" Style="{StaticResource SetRowDesc}"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="SelfInstallButton"
                                        Style="{StaticResource SetActionButtonPrimary}"
                                        Click="SelfInstallButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Not in the handoff, which never drew this row — but the
                             launcher can genuinely be uninstalled from here and dropping
                             a real action to match a mock would be a regression, not
                             fidelity. It takes the danger treatment the reference uses
                             for the mod's own danger zone. -->
                        <Border x:Name="UninstallRow"
                                Style="{StaticResource SetNoticeDanger}"
                                Margin="0,14,0,0"
                                Padding="{StaticResource SetActionRowPadding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UninstallTitle"
                                               Style="{StaticResource SetRowTitle}"
                                               Foreground="{DynamicResource MpDestructiveText}"/>
                                    <TextBlock x:Name="UninstallHint" Style="{StaticResource SetRowDesc}"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="UninstallButton"
                                        Style="{StaticResource SetActionButton}"
                                        Foreground="{DynamicResource MpDestructiveText}"
                                        BorderBrush="{DynamicResource UiRimDanger}"
                                        Click="UninstallButton_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===================================================
                         PRIVACY + DEVELOPER — the last two blocks of ADVANCED.

                         This wrapper existed to sit them SIDE BY SIDE back when the
                         sections split into columns; they simply stack now. It is kept
                         because ShowSection then toggles ADVANCED's second half once
                         instead of twice, and because the section search goes through
                         THIS wrapper (AllSectionPanelsWithId) rather than the two panels
                         inside it — FilterRows treats each direct child as one group and
                         RowsIn descends, so a group with no match collapses whole.
                         =================================================== -->
                    <StackPanel x:Name="AdvancedExtrasPanel" Visibility="Collapsed">

                    <StackPanel x:Name="PrivacyPanel">
                        <TextBlock x:Name="PrivacyHeader" Style="{StaticResource SetGroupLabel}"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="TelemetryTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="TelemetryHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="TelemetryCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <!-- The one switch in the launcher that sends data off this
                                     machine that is not about a match you played. Off by
                                     default, disclosed in PRIVACY.md, and beside the telemetry
                                     switch because they are the same kind of decision. -->
                                <Border Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="ShareDecksTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="ShareDecksHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="ShareDecksCheck"
                                                      Style="{StaticResource SetToggle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource SetActionRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="PrivacyPolicyTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="PrivacyPolicyHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="PrivacyPolicyButton"
                                                Style="{StaticResource SetActionButton}"
                                                Click="PrivacyPolicyButton_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================================================
                         DEVELOPER — third block of ADVANCED.

                         The WHOLE panel is now hidden unless developer mode is on. It
                         used to stay on screen, folded, reading "turn on developer
                         mode" — which told every player the tools were there and how
                         to get them, the opposite of what it should have been doing.
                         The switch that closes it again lives in this header: the old
                         objection ("inside the section it governs it could never be
                         switched back ON") is answered by the tap gesture on the
                         version line, which is now the only way in.
                         =================================================== -->
                    <StackPanel x:Name="TranslationsPanel" Visibility="Collapsed">
                        <TextBlock x:Name="DevGroupLabel" Style="{StaticResource SetGroupLabel}"/>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border x:Name="DevHeaderRow" Style="{StaticResource SetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="DevTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="DevDesc" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" x:Name="DeveloperModeCheck"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource SetToggle}"
                                                      Checked="DeveloperModeCheck_Changed"
                                                      Unchecked="DeveloperModeCheck_Changed"/>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="DevTools">
                                    <Border Style="{StaticResource SetActionRow}"
                                            BorderThickness="0,1,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="LocalModsHeader" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="LocalModsDescription" Style="{StaticResource SetRowDesc}"/>
                                                <StackPanel x:Name="LocalModsList" Margin="0,8,0,0"/>
                                                <TextBlock x:Name="LocalModsEmptyHint" Style="{StaticResource SetRowDesc}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="AddLocalModButton"
                                                    Style="{StaticResource SetActionButtonLg}"
                                                    Click="AddLocalModButton_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetActionRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TranslationsHeader" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="TranslationsDescription" Style="{StaticResource SetRowDesc}"/>
                                                <TextBlock x:Name="TranslationsHint" Style="{StaticResource SetRowDesc}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="OpenPackagerButton"
                                                    Style="{StaticResource SetActionButtonLg}"
                                                    Click="OpenPackagerButton_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetActionRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="PatchGenHeader" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="PatchGenDescription" Style="{StaticResource SetRowDesc}"/>
                                                <TextBlock x:Name="PatchGenHint" Style="{StaticResource SetRowDesc}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="OpenPatchGeneratorButton"
                                                    Style="{StaticResource SetActionButtonLg}"
                                                    Click="OpenPatchGeneratorButton_Click"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetActionRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="PreviewToastsTitle" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="PreviewToastsHint" Style="{StaticResource SetRowDesc}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="PreviewToastsButton"
                                                    Style="{StaticResource SetActionButtonLg}"
                                                    Click="PreviewToastsButton_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- The tournament preview, beside the toast one and for the
                                         same reason: a sixteen-entrant bracket with played rounds
                                         cannot be reached by trying. This is the entry point that
                                         works with the launcher ALREADY OPEN, which the
                                         command-line argument cannot be, because the
                                         single-instance mutex kills a second process first. -->
                                    <Border Style="{StaticResource SetActionRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="DemoTournamentsTitle" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="DemoTournamentsHint" Style="{StaticResource SetRowDesc}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="DemoTournamentsButton"
                                                    Style="{StaticResource SetActionButtonLg}"
                                                    Click="DemoTournamentsButton_Click"/>
                                        </Grid>
                                    </Border>

                                    <!-- The same aid for the Statistics page, and it is needed
                                         for a harder reason: the filled civilization table
                                         needs hundreds of rated matches carrying a
                                         civilization, and this community has none yet - the
                                         launcher only started recording them. That page
                                         cannot be looked at by playing. -->
                                    <Border Style="{StaticResource SetActionRowLast}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="DemoStatsTitle" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="DemoStatsHint" Style="{StaticResource SetRowDesc}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="DemoStatsButton"
                                                    Style="{StaticResource SetActionButtonLg}"
                                                    Click="DemoStatsButton_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Shown ONLY to somebody who just switched developer mode off in this
                         window, and never on a cold open. Turning it off makes the panel
                         vanish under the finger that did it, so without this the way back
                         would be a gesture nobody was ever told about. A player who has never
                         been in here never sees this line. -->
                    <TextBlock x:Name="DevOffHint"
                               Style="{StaticResource SetRowDesc}"
                               Margin="0,18,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- =========================================================
             STICKY FOOTER.

             It counts what is pending instead of showing a permanent Cancel/Save
             pair: an untouched window then has nothing to decide, and a window
             with changes says how many before you close it.

             It says "changes apply instantly" because they now do: RefreshFooter
             writes and persists every setting the moment it is touched
             (ApplyInstantSettings). What it does NOT claim is that ALL of them
             do — the catalog repo and the background trio can be REFUSED (a
             repo that fails RepoRegex, a Run key that policy or an AV blocks),
             and a setting that can be rejected cannot apply the instant you
             touch it. Those two keep Save, and while one of them is pending the
             footer counts it instead. That split is exactly what SPEC-1 rule 8
             describes; the earlier pass shipped the counting half alone rather
             than print a promise the code did not keep.
             ========================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource MpRowHighlight}"
                Padding="18,11"
                BorderBrush="{DynamicResource MpRimSoft}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            x:Name="UnsavedIndicator"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <!-- The amber dot belongs to the PENDING state alone; the line beside
                         it stays either way, because "already applied" is worth stating
                         once rather than leaving the reader to infer it from a blank strip. -->
                    <Ellipse x:Name="UnsavedIndicatorDot"
                             Width="7" Height="7"
                             Fill="{DynamicResource MpCaution}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0"/>
                    <TextBlock x:Name="UnsavedText"
                               Foreground="{DynamicResource MpCautionText}"
                               FontSize="{DynamicResource SetDescSize}"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="1"
                        x:Name="CancelButton"
                        Style="{StaticResource SetFooterGhostButton}"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>
                <Button Grid.Column="2"
                        x:Name="SaveButton"
                        Style="{StaticResource SetFooterPrimaryButton}"
                        Click="SaveButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
