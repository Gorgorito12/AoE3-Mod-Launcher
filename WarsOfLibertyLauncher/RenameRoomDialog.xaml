<controls:BaseDialog x:Class="WarsOfLibertyLauncher.RenameRoomDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
                     Width="480">
    <StackPanel>
        <TextBlock x:Name="FieldLabel" Style="{StaticResource WindowFieldLabel}"/>
        <Border Style="{StaticResource DialogFieldBox}" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameEntry" Style="{StaticResource DialogBareText}"
                         MaxLength="80" VerticalAlignment="Center"
                         TextChanged="NameEntry_TextChanged"/>
                <TextBlock x:Name="CounterText" Grid.Column="1" Margin="10,0,0,0"
                           Style="{StaticResource DialogFieldAux}"/>
            </Grid>
        </Border>
        <TextBlock x:Name="PromptText" Style="{StaticResource DialogHint}" Margin="0,6,0,0"/>
    </StackPanel>
</controls:BaseDialog>
