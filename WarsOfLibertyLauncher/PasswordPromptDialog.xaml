<Window x:Class="WarsOfLibertyLauncher.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Password"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpSurface}"
        ShowInTaskbar="False">
  <!-- Navy for the same reason as RenameRoomDialog, which is a clone of this file. This one is
       the better-travelled of the two: it opens every time somebody joins a private room. -->
  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="Password"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>
    <StackPanel Grid.Row="1" Margin="24,20">
        <TextBlock x:Name="PromptText"
                   Foreground="{DynamicResource MpTextSecondary}"
                   FontSize="{DynamicResource FontSizeBody}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>
        <PasswordBox x:Name="PasswordEntry"
                     Style="{StaticResource MpDialogPasswordField}"
                     MaxLength="50"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <!-- No local Background: it would outrank the template's own hover trigger. -->
            <Button x:Name="CancelButton"
                    Click="CancelButton_Click"
                    Style="{StaticResource MpSecondaryButton}"
                    MinWidth="104"
                    Margin="0,0,8,0"
                    Content="Cancel"/>
            <Button x:Name="OkButton"
                    Click="OkButton_Click"
                    IsDefault="True"
                    Style="{StaticResource MpPrimaryButton}"
                    MinWidth="104"
                    Content="OK"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
