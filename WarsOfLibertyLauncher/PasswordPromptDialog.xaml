<controls:BaseDialog x:Class="WarsOfLibertyLauncher.PasswordPromptDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
                     Width="480">
    <StackPanel>
        <TextBlock x:Name="FieldLabel" Style="{StaticResource WindowFieldLabel}"/>
        <Border Style="{StaticResource DialogFieldBox}" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordEntry" Style="{StaticResource DialogBarePassword}"
                             MaxLength="50" VerticalAlignment="Center"
                             PasswordChanged="PasswordEntry_Changed"/>
                <TextBox x:Name="PasswordPlain" Style="{StaticResource DialogBareText}"
                         MaxLength="50" VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="Placeholder" IsHitTestVisible="False" VerticalAlignment="Center"
                           FontSize="{DynamicResource SetRowTitleSize}"
                           Foreground="{DynamicResource UiTextFaint}"/>
                <Button x:Name="RevealButton" Grid.Column="1" Margin="10,0,0,0"
                        Style="{StaticResource DialogFieldChip}" Click="RevealButton_Click"/>
            </Grid>
        </Border>
    </StackPanel>
</controls:BaseDialog>
