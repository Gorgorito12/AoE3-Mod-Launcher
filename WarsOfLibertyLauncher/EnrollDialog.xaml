<Window x:Class="WarsOfLibertyLauncher.EnrollDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Enter tournament"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="UiTitleText" Color="#F4F8FC"/>
    </Window.Resources>
    <!-- Design 82: one window of the tournament's mod that adapts to how its teams are formed, and
         stays open to say what happened. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl" TitleSize="14"
                           ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel x:Name="Body" Margin="22,22,22,0">
                <TextBlock x:Name="NameText" Margin="2,0,2,0" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold"
                           FontSize="{DynamicResource EnrollTitleSize}" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MetaText" Margin="2,6,2,2" FontFamily="Consolas, Courier New, monospace"
                           FontSize="{DynamicResource SetRowDescSize}" Foreground="#C3D2E5" TextWrapping="Wrap"/>

                <Border x:Name="FactsCard" Style="{DynamicResource WindowCard}" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="FactRows"/>
                </Border>

                <Border x:Name="TeamsCard" Style="{DynamicResource WindowCard}" Padding="16,14" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TeamsLabel" Style="{DynamicResource EnrollHead}"/>
                            <TextBlock x:Name="TeamsHint" Style="{DynamicResource EnrollHeadHint}"/>
                        </StackPanel>
                        <StackPanel x:Name="TeamRows"/>
                        <TextBlock x:Name="FrozenNote" Style="{DynamicResource GlassHint}" Margin="2,9,2,0" Foreground="#A8BCD2"/>
                    </StackPanel>
                </Border>

                <Border x:Name="LineupCard" Style="{DynamicResource WindowCard}" Padding="16,14" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LineupLabel" Style="{DynamicResource EnrollHead}"/>
                            <TextBlock x:Name="LineupHint" Grid.Column="1" Style="{DynamicResource EnrollHeadHint}"/>
                            <TextBlock x:Name="LineupCount" Grid.Column="2" Style="{DynamicResource EnrollCount}"/>
                        </Grid>
                        <UniformGrid x:Name="LineupRows" Columns="2" Margin="-3,6,-3,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BuildCard" Style="{DynamicResource WindowCard}" Padding="16,14" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TeamNameLabel" Style="{DynamicResource EnrollHead}"/>
                        <Border Style="{DynamicResource GlassFieldBox}" Height="36" Margin="0,7,0,0">
                            <Grid>
                                <TextBox x:Name="TeamNameEntry" Style="{DynamicResource DialogBareText}" MaxLength="80"
                                         FontSize="{DynamicResource FontSizeBody}" TextChanged="TeamNameEntry_TextChanged"/>
                                <TextBlock x:Name="TeamNamePlaceholder" IsHitTestVisible="False" VerticalAlignment="Center"
                                           FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource WindowFineText}"/>
                            </Grid>
                        </Border>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MatesLabel" Style="{DynamicResource EnrollHead}"/>
                            <TextBlock x:Name="MatesHint" Grid.Column="1" Style="{DynamicResource EnrollHeadHint}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MatesCount" Grid.Column="2" Style="{DynamicResource EnrollCount}"/>
                        </Grid>
                        <WrapPanel x:Name="ChosenChips" Margin="0,8,-6,-6"/>
                        <Border Height="34" Padding="10,0" CornerRadius="7" BorderThickness="1" Margin="0,8,0,0"
                                Background="{DynamicResource MpField}" BorderBrush="{DynamicResource WindowSecondaryRim}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#8C9CB1"
                                           VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                    <TextBox x:Name="SearchEntry" Style="{DynamicResource DialogBareText}"
                                             FontSize="{DynamicResource SetRowDescSize}" TextChanged="SearchEntry_TextChanged"/>
                                    <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False" VerticalAlignment="Center"
                                               FontSize="{DynamicResource SetRowDescSize}" Foreground="{DynamicResource WindowFineText}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="PlayerScroller" MaxHeight="200" Margin="0,8,0,0" Padding="0"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PlayerRows"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border x:Name="NoTeamCard" Style="{DynamicResource WindowCard}" Padding="20,22" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="NoTeamTitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="{DynamicResource SetSubTitleSize}" FontWeight="SemiBold" Foreground="{DynamicResource UiHeadText}"/>
                        <TextBlock x:Name="NoTeamBody" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"
                                   Margin="0,8,0,0" FontSize="{DynamicResource SetRowDescSize}" Foreground="#C3D2E5"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ModNote" Style="{DynamicResource EnrollInfoNote}" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="i" FontWeight="Bold" Foreground="#55ACEE" FontSize="{DynamicResource SetControlSize}" Margin="0,0,9,0"/>
                        <TextBlock x:Name="ModNoteText" Grid.Column="1" TextWrapping="Wrap" Foreground="#CFE6F8"
                                   FontSize="{DynamicResource SetRowDescSize}" VerticalAlignment="Center"/>
                        <Button x:Name="ModInstallButton" Grid.Column="2" Style="{DynamicResource WindowSecondaryButton}"
                                Margin="10,0,0,0" MinWidth="0" Padding="14,0" Click="ModInstallButton_Click"/>
                    </Grid>
                </Border>

                <Border x:Name="DoneCard" Style="{DynamicResource WindowCard}" Padding="20,22" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DoneDisc" Width="40" Height="40" CornerRadius="20" BorderThickness="1" VerticalAlignment="Top">
                            <TextBlock x:Name="DoneGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock x:Name="DoneTitle" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource UiHeadText}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DoneBody" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#C3D2E5"
                                       FontSize="{DynamicResource SetRowDescSize}"/>
                            <TextBlock x:Name="DoneTeam" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#A8BCD2" Visibility="Collapsed"
                                       FontSize="{DynamicResource SetRowDescSize}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ApprovalNote" Style="{DynamicResource EnrollInfoNote}" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="i" FontWeight="Bold" Foreground="#55ACEE" FontSize="{DynamicResource SetControlSize}" Margin="0,0,9,0"/>
                        <TextBlock x:Name="ApprovalNoteText" Grid.Column="1" TextWrapping="Wrap" Foreground="#CFE6F8"
                                   FontSize="{DynamicResource SetRowDescSize}"/>
                    </Grid>
                </Border>

                <Border x:Name="ErrorNote" Margin="0,14,0,0" Padding="12,9" CornerRadius="8" BorderThickness="1"
                        Background="#1AF4900C" BorderBrush="#73F4900C" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="!" FontWeight="Bold" Foreground="#F4900C" FontSize="{DynamicResource SetControlSize}" Margin="0,0,9,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ErrorTitle" FontWeight="SemiBold" Foreground="#F5BD76" TextWrapping="Wrap"
                                       FontSize="{DynamicResource SetRowDescSize}"/>
                            <TextBlock x:Name="ErrorBody" Margin="0,2,0,0" Foreground="#DCE7F5" TextWrapping="Wrap"
                                       FontSize="{DynamicResource SetRowDescSize}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="22,16,22,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="LeaveButton" Style="{DynamicResource WindowSecondaryButton}" MinWidth="0" Padding="14,0"
                    Foreground="#F0A6A6" FontSize="{DynamicResource SetRowDescSize}" Visibility="Collapsed" Click="LeaveButton_Click"/>
            <TextBlock x:Name="BlockText" Grid.Column="1" Style="{DynamicResource GlassRowBody}" Foreground="#F5BD76"
                       Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Grid.Column="2" Style="{DynamicResource WindowSecondaryButton}"
                    MinWidth="112" FontSize="{DynamicResource SetRowDescSize}" IsCancel="True" Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Grid.Column="3" Style="{DynamicResource WindowPrimaryButton}"
                    MinWidth="150" Padding="16,0" Margin="8,0,0,0" FontSize="{DynamicResource SetRowDescSize}"
                    ToolTipService.ShowOnDisabled="True" IsDefault="True" Click="OkButton_Click"/>
        </Grid>
    </Grid>
</Window>
