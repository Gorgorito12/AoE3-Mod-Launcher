<Window x:Class="WarsOfLibertyLauncher.AntivirusExclusionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBase}"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar x:Name="Chrome" Grid.Row="0"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>
    <StackPanel Grid.Row="1" Margin="24,20">

        <!-- Lead: shield glyph + the explanation of what the antivirus did/does. -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="&#xE72E;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="{DynamicResource FontSizeHeading}"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Top"
                       Margin="0,0,14,0"/>
            <TextBlock Grid.Column="1"
                       x:Name="BodyText"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextWrapping="Wrap"/>
        </Grid>

        <TextBlock x:Name="PathsLabel"
                   Foreground="{DynamicResource TextPrimary}"
                   FontSize="{DynamicResource FontSizeBody}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- The two exact folders. Consolas + selectable so the user can read and
             hand-copy them even if the clipboard button fails. -->
        <Border Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource MenuBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}"
                Padding="{StaticResource CardPadding}"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBox x:Name="TempPathText"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontFamily="Consolas"
                         FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextPrimary}"
                         TextWrapping="Wrap"/>
                <TextBox x:Name="InstallPathText"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0,6,0,0"
                         FontFamily="Consolas"
                         FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextPrimary}"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="HowToText"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="{DynamicResource FontSizeCaption}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <!-- Filled in code-behind by Controls.SupportLink.Build. Here because this dialog
             hands the player a set of Windows Security steps and then stops: if they cannot
             follow them, there was nowhere at all to ask. -->
        <ContentControl x:Name="SupportLinkHost"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16"/>

        <CheckBox x:Name="DontShowAgainCheck"
                  FontSize="{DynamicResource FontSizeBody}"
                  Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyButton"
                    Click="CopyButton_Click"
                    Style="{StaticResource SidebarPrimaryButton}"
                    Background="#3a3d44"
                    Padding="18,6"
                    MinWidth="130"
                    Margin="0,0,10,0"/>
            <Button x:Name="CancelButton"
                    Click="CancelButton_Click"
                    Style="{StaticResource SidebarPrimaryButton}"
                    Background="#3a3d44"
                    Padding="18,6"
                    MinWidth="110"
                    Margin="0,0,10,0"/>
            <Button x:Name="ContinueButton"
                    Click="ContinueButton_Click"
                    IsDefault="True"
                    Style="{StaticResource SidebarPrimaryButton}"
                    Padding="18,6"
                    MinWidth="130"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
