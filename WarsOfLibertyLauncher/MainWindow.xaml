<Window x:Class="WarsOfLibertyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="AoE3 Mod Launcher"
        Height="700" Width="1100"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBase}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <!-- WindowChrome (caption drag + edge-resize + snap/Aero) is applied
         centrally in App.OnAnyWindowLoaded from the TitleBarHeight token; the
         title bar itself is the shared controls:TitleBar below (Grid.Row=0). -->

    <Window.Resources>
        <!-- The dark ToolTip style moved to App.xaml (app-wide) so it also
             reaches the gear ContextMenu popup and the standalone dialogs, and
             so long tooltips wrap instead of clipping. Don't re-add it here. -->

        <!-- Notification rows paint the icon of the mod they are about, resolved
             from the item's ModId through the shared icon cache. Both converters
             return "no icon" for kinds with no mod (launcher update, connectivity)
             and for items whose mod has left the catalog — the row then falls back
             to the per-kind glyph. -->
        <controls:ModIconConverter x:Key="ModIconConv"/>
        <controls:ModIconPresentConverter x:Key="ModIconPresentConv"/>

        <!-- (Removed local SidebarPrimaryButton style — the redesign
             relies on the global one from Styles/Buttons.xaml which
             has the gold gradient + glow effect. Window.Resources used
             to override it with a flat fill, which defeated the
             premium hero CTA look.) -->

        <!-- Sidebar action buttons coded by operation. Background + border
             come from each button instance, so the same template handles
             every color variant: cyan for Update, purple for Verify, amber
             for Repair, soft-red for Uninstall, etc. -->
        <Style x:Key="SidebarColoredButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
<Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar secondary actions — Actualizar, Configuración, Abrir
             carpeta, Verificar archivos. Stretched full width, left-aligned
             label so they line up like a settings list. -->
        <Style x:Key="SidebarSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2a2d34"/>
            <Setter Property="Foreground" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3a3d44"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#22252c"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs across the top of the right-hand content panel. The active
             tab gets its underline + brighter foreground programmatically
             from RefreshTabs() in code-behind. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource BgPanelAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
        </Style>

        <!-- Thin dark scrollbar — replaces the Windows-default light gray
             one so it blends with the rest of the theme. Track is fully
             transparent; the thumb is a subtle pill that brightens on
             hover/drag. The up/down repeat buttons are templated to empty
             so the bar is a pure track + thumb (matches VS Code / Discord
             / Spotify). -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="#3a3d44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5a5d64"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Empty repeat-button template so the up/down arrows disappear
             from the scrollbar without breaking its hit-testing. -->
        <Style x:Key="ScrollBarHiddenButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarHiddenButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarHiddenButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Horizontal variant — same template but with a thin height. -->
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Default ScrollViewer padding: reserves a thin gutter on the
             right so when the scrollbar appears it doesn't push the
             content sideways. The scrollbar is 6 px wide and we reserve 8
             so it has 1 px of breathing room on each side. -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>

        <!-- The Min/Max/Close caption-button styles moved to the global
             Styles/Chrome.xaml (TitleBarButton / TitleBarCloseButton),
             consumed by the shared controls:TitleBar — no per-window copy. -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom title bar (shared controls:TitleBar, height = TitleBarHeightMain
                 token; the slim 28px is secondary-windows only). It now carries the
                 three main tabs as well — the separate nav strip that used to be row 1
                 is gone (design handoff 1a: five stacked bars down to two). -->
            <RowDefinition Height="Auto"/>   <!-- Title bar -->
            <RowDefinition Height="Auto"/>   <!-- Nav tabs -->
            <RowDefinition Height="*"/>      <!-- App content -->
        </Grid.RowDefinitions>

        <!-- The Library's image runs behind the title bar and the tabs, so it lives here rather
             than in PlayView. Nothing in it takes a click. The blurred layer is one image decoded
             small and blurred once, clipped to the panels: a live BlurEffect behind them would be
             recomputed on every frame anything moves. -->
        <Grid x:Name="LibraryBackdrop" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
            <Border x:Name="DashboardBgFill"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Background="{DynamicResource MpAppBg}"/>
            <Border x:Name="DashboardBgFillB"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Opacity="0"/>
            <Border x:Name="LibraryBlurLayer" RenderOptions.BitmapScalingMode="Linear" Visibility="Collapsed"/>
            <Rectangle x:Name="LibraryShadeSide"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#EB0F1C2E" Offset="0"/>
                        <GradientStop Color="#000F1C2E" Offset=".5"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8C0A1321" Offset="0"/>
                        <GradientStop Color="#000A1321" Offset=".22"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Fill="{DynamicResource ModAccentWash}"/>
        </Grid>


        <!-- =============================================================
             ROW 0 - TITLE BAR (36px). Deliberately almost empty: the brand,
             the version chip, and the three chrome affordances that belong
             beside the caption buttons. Every other pixel is window-drag.

             The three main tabs used to live in here (handoff 1a folded the
             nav strip into the bar); the header reference splits them back
             out into row 1. Not a revert for its own sake - a chrome row with
             nothing but a wordmark can afford to BE the drag handle, which is
             what makes the window feel native, and it gives the active tab a
             seam to underline.

             NO bottom border, on purpose: the nav row below is a different
             fill, so the two read as separate surfaces with no rule between
             them, and the rule the CONTENT needs is the nav row's own.

             Height is TitleBarHeightMain and nothing else may set it -
             App.ApplyWindowChrome derives WindowChrome.CaptionHeight from that
             same token, and the caption region IS the drag region. Set one
             without the other and part of a row silently stops (or starts)
             dragging the window.
             ============================================================= -->
        <!-- Below ~1500x900 the launcher is COMPACT (design handoff turns 38-39): the same
             three bars, only LOWER — this one 34 px, the nav row 42. Nothing moves between
             them; an earlier pass (turn 36) folded the tabs into this bar and WORKSHOP ended
             up under the Update pill. MainWindow.ApplyCompactHeader sets this bar's Height,
             its caption-button width AND WindowChrome.CaptionHeight from one key
             (App.MainTitleBarHeightKey), in one call. The values written here are the WIDE
             layout's. -->
        <controls:TitleBar Grid.Row="0"
                           x:Name="MainTitleBar"
                           Background="{DynamicResource ModTitleBar}"
                           Height="{StaticResource TitleBarHeightMain}"
                           ButtonWidth="{StaticResource TitleBarButtonWidthMain}"
                           GlyphSize="10"
                           CloseGlyphSize="13"
                           ShowMinimize="True"
                           ShowMaximize="True"
                           ShowClose="True">
                <!-- Column 0 of the shared TitleBar template ends exactly where the
                     caption buttons begin, so anything right-aligned in here lands
                     immediately left of them with no arithmetic. That is what retired
                     the hand-computed insets this row used to carry (bell at 148 from
                     the right, offline chip at 200, the content grid stopping at 58 -
                     all derived from ButtonWidth 46 x 3).

                     NOTE what is NOT set here: IsHitTestVisibleInChrome. On the grid it
                     would make the whole bar hit-testable and kill the drag; each
                     interactive child sets it for itself instead. The flag does NOT
                     inherit into a ContentControl's Content (the content's inheritance
                     parent is the TitleBar, not the template's ContentPresenter), so
                     "the template already sets it" is no substitute - that exact
                     assumption once left these controls dead to the first click. -->
                <Grid x:Name="TitleBarContentGrid" Height="{StaticResource TitleBarHeightMain}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- brand -->
                        <ColumnDefinition Width="Auto"/>   <!-- version chip -->
                        <ColumnDefinition Width="*"/>      <!-- drag handle -->
                        <ColumnDefinition Width="Auto"/>   <!-- quick-match search pill -->
                        <ColumnDefinition Width="Auto"/>   <!-- self-update pill -->
                        <ColumnDefinition Width="Auto"/>   <!-- offline chip -->
                        <ColumnDefinition Width="Auto"/>   <!-- notification bell -->
                    </Grid.ColumnDefinitions>

                <Button x:Name="TitleBarBrandButton"
                        Grid.Column="0"
                        VerticalAlignment="Stretch"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand"
                        Click="BrandMenuButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <!-- Muted at rest so the hover has something to lift AGAINST;
                                 the scale is rest #93A4B5 (7.31:1) → hover #F0F5FB
                                 (17.04:1) → pressed/open #FFFFFF (18.67:1). The hover
                                 used to be ChromeTextSoft, one rung lower, and was
                                 reported as looking the same as rest: a screenshot taken
                                 WITH the pointer on the button was indistinguishable from
                                 one taken without it. Pressed/open stop at pure white so
                                 the three states remain three — the chevron flip is the
                                 only other signal that the menu is open. -->
                            <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ChromeTextBright}"/>
                                            </Trigger>
                                            <!-- Pressed + Open after hover so
                                                 they win when both match; pure
                                                 white vs hover's near-white
                                                 keeps press/open distinct. -->
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="open">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Source is the 256x256 PNG (sibling to AppIcon.ico,
                             see csproj) NOT the .ico, because WPF's ICO codec
                             picks the smallest frame >= the requested logical
                             size and downscales it: at 20-logical-pixels it
                             selects the 24x24 frame and stretches, which is
                             visibly soft. The PNG decoder skips that frame
                             selection — HighQuality bicubic downscales the
                             native 256x256 directly to the physical pixel
                             size, which lands crisp at every DPI (the global
                             UseLayoutRounding + Display formatting from
                             App.OnStartup pin it to integer device pixels).
                             DecodePixelWidth=256 decodes the NATIVE frame so the
                             only resample is the renderer's single HighQuality
                             bicubic downscale (256 → the physical box). The
                             earlier 64 cap pre-shrank in the decoder first, so a
                             non-integer second downscale softened the icon;
                             decoding native keeps it as sharp as it can be. Costs
                             ~256 KB RAM instead of ~16 KB — trivial, and worth it
                             for a crisp brand mark. (16x16 per the header reference;
                             this replaced an earlier 20x20 rule — the maintainer was
                             shown that a detailed raster mark loses detail at that
                             size and chose fidelity, so softness here is accepted,
                             not a regression.) -->
                        <Image Width="16" Height="16"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <BitmapImage UriSource="pack://application:,,,/AppIcon.png"
                                             DecodePixelWidth="256"
                                             CacheOption="OnLoad"/>
                            </Image.Source>
                            <!-- FULL opacity, and no Style at all. The icon used to sit
                                 at 0.7 and brighten to 1.0 on hover, back when the
                                 wordmark beside it was near-white serif and the mark had
                                 to stay behind it. Against the near-black bar that costs
                                 ~23% of the brightness of artwork that is already dark
                                 (mean luminance 77/255 at render size), which is what made
                                 the whole block read as washed out. The reference asks for
                                 a size and a colour and says nothing about opacity — the
                                 dimming was ours. The button still answers the mouse: the
                                 wordmark and the chevron follow the template's Foreground
                                 triggers, so the affordance survives without knocking the
                                 mark back at rest. -->
                        </Image>
                        <!-- Body font, 12, muted — the prototype's wordmark. Its COLOUR is
                             not set here on purpose: it comes from the button's Style
                             setter so the hover/open triggers can still override it.
                             A local Foreground would beat those triggers and kill the
                             illumination, which is the precedence trap this button has
                             already been bitten by twice. -->
                        <TextBlock Text="AoE3 Mod Launcher"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="{DynamicResource MpMetaSize}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <!-- Chevron flips ▾↔▴ in code-behind on open/close to signal
                             the dropdown is expanded. Named so BrandMenuButton_Click can
                             swap the glyph.

                             No Opacity: it carried a LOCAL 0.7 that nothing ever raised —
                             unlike the icon's, which at least lifted on hover — so it was
                             the one permanently dimmed element in the bar, compositing to
                             4.13:1 against 7.31:1 for the text it sits beside. With it
                             gone the chevron inherits the button's Foreground and finally
                             illuminates WITH the wordmark. -->
                        <TextBlock x:Name="BrandChevron"
                                   Text="&#xE70D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="6,1,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Version of the RUNNING binary, from
                     LauncherUpdateService.CurrentInformationalTag (always "v"-prefixed,
                     and the only source that keeps a WoL-style letter suffix). Static:
                     no IsHitTestVisibleInChrome, so it is part of the drag handle. That
                     also means it can carry no tooltip - a caption hit never raises
                     IsMouseOver - which is fine for a label already fully visible.

                     It took TWO lifts to become legible, and the second is the
                     interesting one. First the text went from the ChromeTextFaint the
                     reference names to ChromeTextDim: at 11px faint measured 3.67:1,
                     under the 4.5:1 floor, and was reported as unreadable. That fixed
                     the letters and NOT the chip — with no background at all it still
                     read as loose text beside a hairline, because a 2.09:1 rim has
                     nothing to cut the shape out of. So it now carries a fill
                     (ChromeVersionBg) and the text sits at ChromeTextSoft, 11.79:1.

                     A local Foreground is safe HERE because the chip is a SIBLING of the
                     brand button, not part of its content — inside it, a local value
                     would beat the template's illumination triggers, which is the trap
                     that has broken this button twice. -->
                <Border x:Name="VersionChip"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Padding="6,2"
                        CornerRadius="{StaticResource ChromeVersionRadius}"
                        Background="{DynamicResource ChromeVersionBg}"
                        BorderBrush="{DynamicResource ChromeVersionRim}"
                        BorderThickness="1">
                    <TextBlock x:Name="VersionChipText"
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="{StaticResource ChromeVersionSize}"
                               Foreground="{DynamicResource ChromeTextSoft}"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- The quick match's search while it runs ("Searching 1v1 · 02:13"), so it stays
                     in sight from Library and Workshop too. Click: back to the room it waits in;
                     the cross stops it. PROVISIONAL, built from existing tokens (MpAction, the
                     update pill's shape): there is no design handoff for it yet. Two real buttons
                     in a Border rather than a button inside a button — each sets
                     IsHitTestVisibleInChrome itself, because the flag does not reach content
                     (see the TitleBarContentGrid note above). Hover lifts the half under the
                     pointer to MpBlueHover; the rounded Border clips it to the pill's shape. -->
                <Border x:Name="QuickMatchPill"
                        Grid.Column="3"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Background="{DynamicResource MpAction}"
                        CornerRadius="{StaticResource RadiusMd}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="QuickMatchPillButton"
                                Cursor="Hand"
                                FontFamily="{DynamicResource BodyFont}"
                                FontSize="{DynamicResource FontSizeCaption}"
                                Click="QuickMatchPill_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="qmPillBorder"
                                            Background="Transparent"
                                            Padding="10,3,4,3">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    TextElement.Foreground="White"
                                                    TextElement.FontWeight="SemiBold">
                                            <TextBlock Text="&#xE721;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="qmPillBorder" Property="Background" Value="{DynamicResource MpBlueHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="QuickMatchPillCancel"
                                Cursor="Hand"
                                Click="QuickMatchPillCancel_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="qmPillCancel"
                                            Background="Transparent"
                                            Padding="6,3,9,3">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="9"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="qmPillCancel" Property="Background" Value="{DynamicResource MpBlueHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>


                <Button x:Name="OfflineChip"
                        Grid.Column="5"
                        Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Click="OfflineChip_Click"
                    FontFamily="{DynamicResource BodyFont}"
                    FontSize="{DynamicResource FontSizeCaption}"
                    ToolTipService.InitialShowDelay="400"
                    ToolTipService.ShowDuration="8000">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder"
                                Background="#24F4900C"
                                BorderBrush="#80F4900C"
                                BorderThickness="1"
                                Height="24"
                                CornerRadius="12"
                                Padding="10,0">
                            <!-- Label comes from the Button's Content (set in
                                 code-behind) — an x:Name'd element inside a
                                 ControlTemplate lives in its own namescope and
                                 isn't reachable from code-behind, so we drive the
                                 text through Content + ContentPresenter, like the
                                 launcher-update pill above. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        TextElement.Foreground="#F5BD76"
                                        TextElement.FontWeight="SemiBold">
                                <Ellipse Width="7" Height="7"
                                         Fill="#F4900C"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
                <Button x:Name="NotificationBellButton"
                        Grid.Column="6"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="NotificationBell_Click"
                    MouseEnter="NotificationBell_MouseEnter"
                    MouseLeave="NotificationBell_MouseLeave"
                    VerticalAlignment="Stretch"
                    ToolTipService.InitialShowDelay="500"
                    ToolTipService.ShowDuration="5000"
                    Style="{StaticResource NotificationBellButton}">
                <Button.ToolTip>
                    <ToolTip x:Name="NotifToolTip"
                             Style="{StaticResource NotifToolTipStyle}"
                             Content="Notificaciones"/>
                </Button.ToolTip>
                <Grid Width="24" Height="24">
                    <!-- Bell drawn as a SOLID vector path (gold) rather than a
                         Segoe MDL2 glyph (which renders as an outline). The pulse
                         animation (PulseNotificationBell) rotates NotificationBellRotate. -->
                    <Path x:Name="NotificationBellGlyph"
                          Fill="#99FFFFFF"
                          Stroke="Black"
                          StrokeThickness="0.6"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="16" Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.15"
                          Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="NotificationBellRotate" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                    <!-- Small unread indicator dot (7px), top-right corner. Thin
                         dark ring separates it from the bell / bar. -->
<Border x:Name="NotificationDot"
                            MinWidth="16" Height="16"
                            Padding="4,0"
                            CornerRadius="8"
                            Background="{DynamicResource MpAction}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-5,-6,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="NotificationCount"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Button>

                </Grid>
        </controls:TitleBar>

        <!-- The notification panel stays a sibling of the TitleBar rather than a child
             of it: a Popup renders in its own HWND and is positioned against its
             PlacementTarget, so it does not need to live inside the bar - and keeping
             it out means the bar's content grid holds only bar-height controls. -->
        <Grid Grid.Row="0" Panel.ZIndex="10">
            <!-- Dropdown panel. Right-aligned under the bell (HorizontalOffset
                 shifts the 360-wide card left so its right edge lands near the
                 bell). Items + empty-state visibility are wired in code-behind. -->
        </Grid>

        <!-- =============================================================
             ROW 1 - NAV. The three main tabs, and the player's state on the
             right. Ordinary client area: it sits BELOW CaptionHeight, so every
             control in here gets normal hit-testing, hover and tooltips with
             no chrome flags at all.

             Its bottom rule is the chrome/content seam for all three tabs.
             Multiplayer draws its own sub-tab bar under this, but Library and
             Workshop have nothing, so without this line the chrome would bleed
             straight into their content. (That rule used to live on the content
             wrapper below, back when the bar it separated from was the title
             bar itself.)
             ============================================================= -->
        <!-- Height and the inner grid's margin are WRITTEN by MainWindow.ApplyCompactHeader in
             the compact layout (42 and 0,0,12,0); the values here are the wide layout's. -->
        <Border Grid.Row="1"
                x:Name="MainNav"
                Height="{StaticResource MainNavHeight}"
                Background="{DynamicResource LibraryNavBg}"
                BorderBrush="{DynamicResource TitleBarLine}"
                BorderThickness="0,0,0,1">
            <Grid x:Name="MainNavGrid" Margin="{StaticResource MainNavPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- MAIN TABS. Same x:Names as ever, so every code-behind consumer
                     (SwitchTopTab, RefreshTopTabHighlight, ApplyStrings,
                     ApplyTopTabOrder, the click handlers) keeps working untouched.
                     Declared HERE rather than in a UserControl because ApplyTopTabOrder
                     clears and refills TopTabBar.Children, which needs the panel in
                     MainWindow's namescope - the same reason TitleBar is a templated
                     ContentControl.

                     The left-to-right child order is re-applied at startup from
                     LauncherConfig.TopTabOrder; the order here is just the default for
                     a fresh config. -->
                <StackPanel x:Name="TopTabBar"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button x:Name="TopTabPlay"
                            Style="{StaticResource NavTabButton}"
                            Click="TopTabPlay_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarLabelDashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- The Workshop is inside the Library now (design 68a). Hidden rather than
                         removed: ApplyTopTabOrder and a saved tab order still name it. -->
                    <Button x:Name="TopTabMods"
                            Visibility="Collapsed"
                            Style="{StaticResource NavTabButton}"
                            Click="TopTabMods_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarLabelCatalog" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TopTabMultiplayer"
                            Style="{StaticResource NavTabButton}"
                            Click="TopTabMultiplayer_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SidebarLabelMultiplayer" VerticalAlignment="Center"/>
                                <Border x:Name="MultiplayerTabDot"
                                        MinWidth="18" Height="18"
                                        Padding="5,0"
                                        Margin="8,0,0,0"
                                        CornerRadius="9"
                                        Background="{DynamicResource MpAction}"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="MultiplayerTabCount"
                                               FontSize="10.5" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <!-- "New room created" dot: set from PollNewRoomsAsync,
                                 cleared when the user switches to Multiplayer. Its
                                 Stroke must track the fill of whatever bar the tab
                                 sits on, so the ring reads as a cut-out and not a halo - hence the NAV
                                 row's brush, not the title bar's. It has moved once
                                 already; move it again if the tabs do. -->

                        </Grid>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="LibraryDownloadPill"
                            Style="{StaticResource LibraryDownloadPill}"
                            Margin="0,0,30,0"
                            Visibility="Collapsed"
                            Click="LibraryDownloadPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="LibraryDownloadDisc" Width="20" Height="20" CornerRadius="10"
                                    Background="{DynamicResource ModAccentSoft}">
                                <TextBlock x:Name="LibraryDownloadGlyph" Text="&#x2193;"
                                           FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ModAccentText}"/>
                            </Border>
                            <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LibraryDownloadLabel"
                                           FontSize="12" FontWeight="SemiBold"
                                           MaxWidth="120" TextTrimming="CharacterEllipsis"
                                           Foreground="#F0F5FB"/>
                                <ProgressBar x:Name="LibraryDownloadBar"
                                             Style="{StaticResource LibraryProgressBar}"
                                             Width="120" Height="3" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="LibraryDownloadPercent"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ModAccentText}"/>
                            <TextBlock Text="&#x25BC;" FontSize="9" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource UiDimText}"/>
                        </StackPanel>
                    </Button>
                    <!-- Persistent, non-invasive launcher self-update reminder.
                         Replaces the old auto-modal that got permanently silenced
                         on Cancel (SkippedLauncherTag). Shown whenever a newer
                         launcher version exists; stays visible on EVERY launch until
                         the user updates (no permanent dismiss). Click opens the
                         existing download/restart dialog. Blue, the shape of the
                         "Connected" chip (design 77k); says "restart" once downloaded.
                         Self-contained template so the global Button style doesn't
                         flatten the pill look. Text + tooltip
                         are localized from code-behind. -->
                    <Button x:Name="LauncherUpdatePill"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            FontFamily="{DynamicResource BodyFont}"
                            FontSize="{DynamicResource SetRowDescSize}"
                            Click="LauncherUpdatePill_Click"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="LauncherUpdatePillScale" ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <!-- The text comes from the Button's Content (set in
                                     code-behind) via the ContentPresenter — x:Name'd
                                     elements inside a ControlTemplate live in their own
                                     namescope and aren't reachable from code-behind, so
                                     we drive the label through Content instead. -->
                                <Border x:Name="pillBorder"
                                        Background="#2455ACEE"
                                        BorderBrush="#7355ACEE"
                                        BorderThickness="1"
                                        Height="28"
                                        CornerRadius="14"
                                        Padding="12,0">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                TextElement.Foreground="#9FD2F6"
                                                TextElement.FontWeight="SemiBold">
                                        <TextBlock Text="{TemplateBinding Tag}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="pillBorder" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Connection capsule. Radmin's full-width green banner used to sit
                         permanently in the Multiplayer tab restating "everything is
                         fine"; it collapses to this, and the banner only returns when
                         something is actually wrong. Driven by MultiplayerTab's own
                         Radmin poll through SetConnectionChip, so there is exactly one
                         probe and one source of truth.

                         Collapsed by default: it appears once the poll reports Radmin
                         ready and hides the moment it isn't. Global rather than
                         Multiplayer-only, per the reference.

                         The detail is the bare 26.x address. What that address IS lives
                         in the tooltip instead - which only works because the capsule is
                         client area now; in the title bar a tooltip could never fire.

                         A BUTTON WITH A DROPDOWN since design handoff turn 36, which is the
                         FOURTH answer to "where is the door to the Radmin assistant", and the
                         first that answers both halves of the question at once. It was a
                         Button here before and failed twice over: a status readout does not
                         read as pressable (its whole affordance was a hand cursor and a rim
                         shift between two nearly invisible greys), and even pressed it never
                         said what it did. Now the capsule is tinted green with a ▾ — the sign
                         that it opens something — and the menu it opens carries the WORD
                         ("Help connecting") beside the Radmin IP it is about. The IP left the
                         capsule for that menu (the handoff's call).
                         MainWindow.ConnectionChip_Click builds the menu. -->
                    <Button x:Name="ConnectionChip"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Padding="12,0"
                            Height="{StaticResource ChromeCapsuleHeight}"
                            Cursor="Hand"
                            Background="{DynamicResource ChromeConnectedBg}"
                            BorderBrush="{DynamicResource ChromeConnectedRim}"
                            Click="ConnectionChip_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <!-- A pill needs an EXPLICIT half-height radius (WPF has no
                                     999px idiom): 15 for the 30-px nav-row capsule, 13 for the
                                     26-px compact one, switched by Tag="compact". -->
                                <Border x:Name="capsule"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ChromeCapsuleRadius}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Tag" Value="compact">
                                        <Setter TargetName="capsule" Property="CornerRadius" Value="{StaticResource ChromeCapsuleRadiusCompact}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="capsule" Property="Background" Value="{DynamicResource ChromeConnectedHoverBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnectionChipDot" Width="7" Height="7"
                                     Fill="{DynamicResource MpOk}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,7,0"/>
                            <TextBlock x:Name="ConnectionChipStatus"
                                       Foreground="{DynamicResource ChromeConnectedText}"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="{DynamicResource MpLabelSize}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectionChipChevron"
                                       Text="▾"
                                       Foreground="{DynamicResource ChromeConnectedChevron}"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Hidden with its neighbours rather than left floating: signed
                         out, both the capsule and the account block collapse, and a
                         divider alone in an empty row reads as a rendering glitch.
                         RefreshChromeDivider owns it. -->
                    <Rectangle x:Name="ChromeDivider"
                               Width="1" Height="20"
                               Visibility="Collapsed"
                               Fill="{DynamicResource ChromeRim}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- Account cluster. Replaces the Multiplayer tab's account ROW
                         (user | Sign out), one of the five stacked bars. Hidden until
                         multiplayer reports a signed-in user, so Library and Workshop
                         don't show an empty avatar before sign-in.

                         No chevron: the reference doesn't draw one. It is still a
                         button and still lifts on hover, which is the affordance. -->
                    <!-- Design 79e: with no session the account block is this. -->
                    <Button x:Name="SignInChip"
                            Style="{StaticResource WindowSecondaryButton}"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            Click="SignInChip_Click"/>

                    <Button x:Name="AccountButton"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            Click="AccountButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Monogram disc. The photo, when there is one, is painted
                                 over it from code-behind so a failed download still
                                 leaves a readable initial underneath. -->
                            <Grid Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse x:Name="AccountAvatarEllipse" Fill="{DynamicResource MpAction}"/>
                                <TextBlock x:Name="AccountAvatarInitial"
                                           Foreground="#FFFFFF"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <!-- The player's rank badge (docs/design_insignias_pantallas_guia,
                                 46b.2), filled from SetAccountChip. Collapsed when the rank is
                                 unknown. Not hit-testable: the click is the account menu's. -->
                            <ContentControl x:Name="AccountRankHost"
                                            Visibility="Collapsed"
                                            Focusable="False"
                                            IsTabStop="False"
                                            IsHitTestVisible="False"
                                            Margin="-4,0,8,0"
                                            VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <!-- Capped and trimmed: this is a Discord login, chosen by
                                             whoever owns the account, sitting in an Auto cell
                                             that measures at infinity. Unbounded it eats the
                                             star spacer and then the tab strip. Short in
                                             practice, which is exactly why nobody would notice
                                             it was the one shape this launcher forbids. -->
                                        <TextBlock x:Name="AccountName"
                                           MaxWidth="180"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ChromeTextStrong}"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="{DynamicResource MpMetaSize}"
                                           FontWeight="SemiBold"/>
                                <!-- Collapses when the standing hasn't been fetched. The
                                     rating is pulled once per session from a
                                     rate-limited endpoint, so this reads that cache and
                                     never polls. -->
                                <!-- MpAccountElo, the token that exists for exactly this
                                     and that LobbyWindow's roster uses. The header rewrite
                                     swapped it for the reference's ChromeTextFaint, which
                                     is 3.30:1 at the app's smallest size — measured
                                     unreadable, and the third time that tone has been. -->
                                <TextBlock x:Name="AccountElo"
                                           Visibility="Collapsed"
                                           Margin="0,1,0,0"
                                           Foreground="{DynamicResource MpAccountElo}"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="{DynamicResource MpMicroSize}"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =============================================================
             Content area. Now full-width (no sidebar column eating
             240px). PlayView is the "cinema" dashboard. Other tabs
             (Workshop, Multiplayer, Settings) overlay on top when
             active.

             ClipToBounds guards the title-bar chrome above (Row 0):
             everything in this row — the full-bleed dashboard background
             image, the hero gradients, the scaled hero block — is clipped
             to the row so none of it can render up over the chrome. This is
             the safety net for the maximized full-bleed image reading as if
             it bleeds into the bar; it does NOT touch the chrome itself.

             The top border is what the deleted nav strip used to provide.
             That strip carried the only chrome/content divider, and it was
             shared by all three tabs — Multiplayer replaces it with its own
             sub-tab bar, but Library and Workshop have nothing, so without
             this line the title bar would bleed straight into their content.
             ============================================================= -->
        <Border Grid.Row="2">
        <Grid x:Name="ContentHost" ClipToBounds="True">

            <!-- ============================================================
                 PLAY VIEW — cinema dashboard.
                 Hero background image of active mod + dark gradient
                 overlays + bottom-anchored title/desc/PLAY/Settings/
                 ChangeMod row + progress strip.
                 All the legacy controls (ModsBar, HeroBanner, StatusCard,
                 ActionPanel, ProgressPanel, MainTabs) stay alive inside
                 LegacyPlayContent (Visibility=Collapsed) so the dozens
                 of code-behind references resolve and the install /
                 update / progress data still pumps through them. The
                 visible Dashboard buttons forward to those hidden
                 controls' click handlers.
                 ============================================================ -->
            <Grid x:Name="PlayView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- The toolbar (design 68a). The right group is docked first so the filters wrap
                     under the search on a narrow window instead of sliding beneath it. -->
                <DockPanel x:Name="LibraryToolbar" Grid.Row="0" Margin="16,14,16,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="LibrarySortButton"
                                Style="{StaticResource LibraryBarButton}"
                                Margin="12,0,0,0"
                                Click="LibrarySortButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LibrarySortText" VerticalAlignment="Center"/>
                                <TextBlock Text="&#x25BC;" FontSize="9" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource UiDimText}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="LibraryRefreshButton"
                                Style="{StaticResource LibraryBarButton}"
                                Width="34" Padding="0"
                                Margin="12,0,0,0"
                                FontSize="15" FontWeight="Normal"
                                Foreground="{DynamicResource UiSoftText}"
                                Content="&#x21BB;"
                                Click="LibraryRefreshButton_Click"/>
                        <Button x:Name="LibraryPublishButton"
                                Style="{StaticResource LibraryPublishButton}"
                                Margin="12,0,0,0"
                                Click="LibraryPublishButton_Click"/>
                    </StackPanel>
                    <WrapPanel x:Name="LibraryFilterRow" Orientation="Horizontal">
                        <Border x:Name="LibrarySearchShell"
                                Height="34"
                                Margin="0,0,12,0"
                                CornerRadius="8"
                                Background="{DynamicResource LibraryControl}"
                                BorderBrush="{DynamicResource GlassRim}"
                                BorderThickness="1">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Width="13" Height="13" Stretch="None" VerticalAlignment="Center"
                                      Stroke="{DynamicResource UiDimText}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M5.5,1 A4.5,4.5 0 1 1 5.49,1 Z M9,9 L12,12"/>
                                <TextBlock x:Name="LibrarySearchHint"
                                           Grid.Column="1" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource UiDimText}"/>
                                <TextBox x:Name="LibrarySearchBox"
                                         Grid.Column="1" Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         FontSize="13"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         Foreground="{DynamicResource UiBodyText}"
                                         CaretBrush="{DynamicResource UiBodyText}"
                                         TextChanged="LibrarySearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                    </WrapPanel>
                </DockPanel>

                <Grid x:Name="LibraryBody" Grid.Row="1" Margin="16,0,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LibraryRailColumn" Width="320"/>
                        <ColumnDefinition x:Name="LibraryGapColumn" Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:ModRail x:Name="LibraryRail" Grid.Column="0"/>

                    <!-- The cover, bottom-aligned. A ScrollViewer arranges its content at least as
                         tall as the viewport, which is what makes VerticalAlignment=Bottom work. -->
                    <ScrollViewer x:Name="LibraryDetailScroll"
                                  Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0"
                                  Focusable="False">
                        <StackPanel x:Name="HeroContentGrid"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left"
                                    MaxWidth="1000"
                                    Margin="0,0,0,4">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border x:Name="LibraryIconTile"
                                        Width="64" Height="64"
                                        CornerRadius="15"
                                        Background="{DynamicResource LibraryControl}"
                                        BorderBrush="#24FFFFFF"
                                        BorderThickness="1">
                                    <Border x:Name="DashboardIconHost"
                                            Width="52" Height="52"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Border>
                                <WrapPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Border x:Name="LibraryStatusChip"
                                            Height="24" Margin="0,0,6,0"
                                            CornerRadius="12" Padding="10,0"
                                            Background="{DynamicResource LibraryControl}"
                                            BorderBrush="{DynamicResource LibraryChipRim}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="LibraryStatusDot" Width="6" Height="6"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="LibraryStatusText"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="#E8EEF6"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DashboardVersionChip"
                                            Height="24"
                                            CornerRadius="12" Padding="8,0,10,0"
                                            Background="{DynamicResource LibraryControl}"
                                            BorderBrush="{DynamicResource LibraryChipRim}"
                                            BorderThickness="1"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12" Height="12" Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource UiVersionIcon}"
                                                  StrokeThickness="1.3"
                                                  StrokeLineJoin="Round"
                                                  Data="M1.5,8.6 V2.2 C1.5,1.8 1.8,1.5 2.2,1.5 H8.6 L14.6,7.5 C14.9,7.8 14.9,8.2 14.6,8.5 L8.9,14.2 C8.6,14.5 8.2,14.5 7.9,14.2 Z M6.2,5 A1.2,1.2 0 1 1 6.19,5 Z"/>
                                            <TextBlock x:Name="DashboardVersionText"
                                                       Margin="6,0,0,0"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource LibraryVersionText}"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <!-- The shadows are blurred COPIES behind the text, cached once: an Effect
                                 on the text itself would turn ClearType off for every glyph. -->
                            <Grid x:Name="LibraryTitleBlock">
                                <TextBlock x:Name="LibraryTitleShadow"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#8C000000"
                                           Margin="0,3,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Effect>
                                        <BlurEffect Radius="16" RenderingBias="Performance"/>
                                    </TextBlock.Effect>
                                    <TextBlock.CacheMode>
                                        <BitmapCache/>
                                    </TextBlock.CacheMode>
                                </TextBlock>
                                <TextBlock x:Name="DashboardTitleText"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#FFFFFF"/>
                            </Grid>
                            <TextBlock x:Name="LibraryAuthorText"
                                       Margin="0,8,0,0"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ModAccentText}"/>

                            <TextBlock x:Name="DashboardDescText"
                                       Margin="0,14,0,0"
                                       HorizontalAlignment="Left"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       LineStackingStrategy="BlockLineHeight"
                                       Foreground="#D6E1EE"/>
                            <Button x:Name="LibraryMoreButton"
                                    Style="{StaticResource LibraryTextLink}"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed"
                                    Click="LibraryMoreButton_Click"/>

                            <WrapPanel x:Name="LibraryActions" Margin="0,14,0,0">
                                <Button x:Name="DashboardPlayButton"
                                        Style="{StaticResource LibraryPrimaryButton}"
                                        Margin="0,0,10,10"
                                        Click="DashboardPlayButton_Click">
                                    <TextBlock x:Name="DashboardPlayButtonText" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="LibraryPlayAnywayButton"
                                        Style="{StaticResource LibraryGlassButton}"
                                        Margin="0,0,10,10"
                                        Visibility="Collapsed"
                                        Click="LibraryPlayAnywayButton_Click"/>
                                <Button x:Name="DashboardSearchInstallButton"
                                        Style="{StaticResource LibraryGlassButton}"
                                        Margin="0,0,10,10"
                                        Visibility="Collapsed"
                                        Click="DashboardSearchInstallButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="18" Height="15" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,9,0"
                                              Stroke="{DynamicResource UiBodyText}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round"
                                              Data="M1,3 C1,2 2,1 3,1 H6.5 L8.5,3.5 H15 C16,3.5 17,4.5 17,5.5 V12 C17,13 16,14 15,14 H3 C2,14 1,13 1,12 Z"/>
                                        <TextBlock x:Name="DashboardSearchInstallButtonText" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DashboardCopyChip"
                                        Style="{StaticResource LibraryGlassButton}"
                                        Padding="14,0"
                                        Margin="0,0,10,10"
                                        Visibility="Collapsed"
                                        Click="DashboardCopyChip_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="18" Height="15" Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource UiBodyText}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round"
                                              Data="M1,3 C1,2 2,1 3,1 H6.5 L8.5,3.5 H15 C16,3.5 17,4.5 17,5.5 V12 C17,13 16,14 15,14 H3 C2,14 1,13 1,12 Z"/>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LibraryCopyCaption" FontSize="11"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource UiMutedText}"/>
                                            <TextBlock x:Name="DashboardCopyText" FontSize="14"
                                                       FontWeight="SemiBold" Margin="0,3,0,0"
                                                       Foreground="#F0F5FB"/>
                                        </StackPanel>
                                        <TextBlock Text="&#x25B2;" FontSize="9" Margin="12,0,2,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource UiDimText}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DashboardSettingsButton"
                                        Style="{StaticResource LibraryGlassButton}"
                                        Width="52" Padding="0"
                                        Margin="0,0,10,10"
                                        Click="DashboardSettingsButton_Click">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="{DynamicResource UiBodyText}"/>
                                </Button>
                                <Button x:Name="LibraryModMenuButton"
                                        Style="{StaticResource LibraryGlassButton}"
                                        Width="52" Padding="0"
                                        Margin="0,0,10,10"
                                        Click="LibraryModMenuButton_Click">
                                    <TextBlock Text="&#x22EF;" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource UiBodyText}"/>
                                </Button>
                                <!-- Retired by the list on the left; kept collapsed because the
                                     operation gate still writes to it. -->
                                <Button x:Name="DashboardChangeModButton"
                                        Visibility="Collapsed"
                                        Click="DashboardChangeModButton_Click">
                                    <TextBlock x:Name="DashboardChangeModButtonText"/>
                                </Button>
                            </WrapPanel>

                            <TextBlock x:Name="LibraryStatusLine"
                                       Margin="0,0,0,10"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       MaxWidth="660"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource UiMutedText}"
                                       Visibility="Collapsed"/>

                            <Border x:Name="DashboardProgressContainer"
                                    MaxWidth="660"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,14,0,14"
                                    Padding="18,16"
                                    CornerRadius="12"
                                    Background="{DynamicResource LibraryCard}"
                                    BorderBrush="{DynamicResource ModAccentLine}"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="LibraryProgressDisc"
                                                Width="34" Height="34" CornerRadius="17"
                                                Background="{DynamicResource ModAccentSoft}">
                                            <TextBlock x:Name="DashboardProgressIcon"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ModAccentText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DashboardProgressLabel"
                                                       FontSize="14.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#F4F8FC"/>
                                            <TextBlock x:Name="DashboardProgressSubtitle"
                                                       FontSize="12.5" Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource UiMutedText}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DashboardProgressPercent"
                                                   Grid.Column="2"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="24" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModAccentText}"/>
                                    </Grid>
                                    <ProgressBar x:Name="DashboardProgressBar"
                                                 Style="{StaticResource LibraryProgressBar}"
                                                 Margin="0,12,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LibraryProgressFoot"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource UiMutedText}"/>
                                        <StackPanel x:Name="DashboardProgressActions"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <Button x:Name="DashboardRetryButton"
                                                    Style="{StaticResource LibraryCardPrimary}"
                                                    Margin="14,0,0,0"
                                                    Visibility="Collapsed"
                                                    Click="DashboardRetryButton_Click"/>
                                            <Button x:Name="DashboardPauseButton"
                                                    Style="{StaticResource LibraryCardButton}"
                                                    Margin="14,0,0,0"
                                                    Click="DashboardPauseButton_Click">
                                                <TextBlock x:Name="DashboardPauseButtonIcon"/>
                                            </Button>
                                            <Button x:Name="DashboardCancelButton"
                                                    Style="{StaticResource LibraryCardDanger}"
                                                    Margin="14,0,0,0"
                                                    Click="DashboardCancelButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Still written by the operation code; the foot line says this. -->
                                    <StackPanel Visibility="Collapsed">
                                        <TextBlock x:Name="DashboardProgressSpeedLabel"/>
                                        <TextBlock x:Name="DashboardProgressSpeed"/>
                                        <TextBlock x:Name="DashboardProgressEtaLabel"/>
                                        <TextBlock x:Name="DashboardProgressEta"/>
                                        <TextBlock x:Name="DashboardProgressPercentLabel"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="LibraryFacts"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,14"
                                    Padding="16,9"
                                    CornerRadius="10"
                                    Background="{DynamicResource GlassTile}"
                                    BorderBrush="{DynamicResource GlassRim}"
                                    BorderThickness="1">
                                <WrapPanel x:Name="LibraryFactsRow"/>
                            </Border>

                            <WrapPanel x:Name="LibraryShots" Margin="0,0,0,14" Visibility="Collapsed"/>

                            <WrapPanel x:Name="LibraryLinks" Visibility="Collapsed">
                                <TextBlock x:Name="LibraryLinksCaption"
                                           FontSize="12"
                                           Margin="0,0,12,6"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource UiMutedText}"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- LEGACY COMPAT: hidden but tree-attached so the
                     existing code-behind keeps working (RefreshActiveMod,
                     RefreshActionPanel, RefreshStatusCard, all the
                     MainTabs handlers, etc.). The visible Dashboard
                     above mirrors data from these on Refresh*. -->
                <Grid x:Name="LegacyPlayContent" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ModsBarLabel"/>
                        <StackPanel x:Name="ModCardsPanel" Orientation="Horizontal"/>
                        <controls:HeroBanner x:Name="ActiveModBanner"/>
                        <controls:StatusCard x:Name="StatusCardControl"/>
                        <controls:ActionPanel x:Name="ActionPanelControl"/>
                        <controls:ProgressPanel x:Name="ProgressPanelControl"/>
                        <controls:MainTabs x:Name="MainTabsControl"/>
                        <Border x:Name="ProgressOverlay" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>   <!-- /PlayView -->

            <!-- v0.9 mod browser — appears overlaying the cinema dashboard
                 when CATALOG is active in the sidebar. -->
            <controls:ModsBrowser x:Name="ModsBrowserView" Visibility="Collapsed"/>

            <!-- v1.0 multiplayer lobby. -->
            <controls:MultiplayerTab x:Name="MultiplayerView" Visibility="Collapsed"/>

            <!-- Settings tab placeholder. -->
            <Grid x:Name="SettingsView" Visibility="Collapsed"
                  Background="{DynamicResource BgBase}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="500">
                    <TextBlock x:Name="SettingsTeaserText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="{DynamicResource FontSizeBodyStrong}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>
                    <Button x:Name="OpenSettingsTabButton"
                            Style="{StaticResource SidebarPrimaryButton}"
                            HorizontalAlignment="Center"
                            MinWidth="200"
                            Click="OpenSettingsTabButton_Click"/>
                </StackPanel>
            </Grid>

        </Grid>   <!-- /Content host -->
        </Border> <!-- /chrome-to-content divider -->

        <!-- In-app toast notifications (AppToast): non-modal, stacked, auto-dismiss
             cards in the bottom-right that float over ANY tab. Spans all rows;
             Background is null so it only intercepts clicks on the cards themselves
             (empty areas stay click-through to the content below). -->
        <!-- The bell's panel (design 70a). In the window, not a Popup: a transparent Popup loses
             ClearType. The veil only closes it. It starts under the caption so the bell can
             still be pressed to toggle it. -->
        <Grid x:Name="NotificationHost" Grid.RowSpan="3" Margin="0,40,0,0" Visibility="Collapsed">
            <Border Background="Transparent" MouseLeftButtonDown="NotificationVeil_MouseLeftButtonDown"/>
            <controls:NotificationPanel x:Name="NotificationPanelView"
                                        HorizontalAlignment="Right"
                                        Margin="0,4,12,12"/>
        </Grid>

        <!-- A screenshot of the selected mod, over everything (design 68a). -->
        <Grid x:Name="LibraryShotViewer"
              Grid.RowSpan="3"
              Background="#E6050A12"
              Visibility="Collapsed"
              MouseLeftButtonUp="LibraryShotViewer_MouseLeftButtonUp">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="78*" MaxWidth="1500"/>
                <ColumnDefinition Width="11*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="LibraryShotImage"
                   Grid.Column="1"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="LibraryShotTitle"
                       Grid.ColumnSpan="3"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="20,20,0,0"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#F0F5FB"/>
            <Button x:Name="LibraryShotClose"
                    Grid.Column="2"
                    Style="{StaticResource LibraryBarButton}"
                    Width="34" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,20,20,0"
                    Content="&#x2715;"
                    Click="LibraryShotClose_Click"/>
            <Button x:Name="LibraryShotPrev"
                    Style="{StaticResource LibraryBarButton}"
                    Width="34" Padding="0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="20,0,0,0"
                    Content="&#x2039;"
                    Click="LibraryShotPrev_Click"/>
            <Button x:Name="LibraryShotNext"
                    Grid.Column="2"
                    Style="{StaticResource LibraryBarButton}"
                    Width="34" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,20,0"
                    Content="&#x203A;"
                    Click="LibraryShotNext_Click"/>
        </Grid>

        <StackPanel x:Name="ToastHost"
                    Grid.Row="0" Grid.RowSpan="3"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="0,0,16,16"
                    Background="{x:Null}"
                    IsHitTestVisible="True"/>

        <!-- Hidden compatibility shim. The old layout had an "AoE3PathRow" that
             code-behind sometimes referenced; the new design folds that info
             into the game footer, so this is just a placeholder so the existing
             references keep compiling. -->
        <StackPanel x:Name="AoE3PathRow" Visibility="Collapsed"/>
        <TextBlock x:Name="InstallPathText" Visibility="Collapsed"/>
        <TextBlock x:Name="LblModPath" Visibility="Collapsed"/>

        <!-- System-tray icon. Hidden by default; the code-behind shows it
             when the user has "Minimize to tray on close" enabled and they
             close the main window. Double-click the tray icon to restore;
             right-click to get a tiny context menu (Show / Exit). The
             icon resource is pack://-loaded so it survives single-file
             publish. -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/AppIcon.ico"
                        Visibility="Collapsed"
                        TrayLeftMouseUp="TrayIcon_LeftClick"
                        TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="TrayMenuShow" Click="TrayMenuShow_Click"/>
                    <Separator/>
                    <MenuItem x:Name="TrayMenuExit" Click="TrayMenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
