<Window x:Class="WarsOfLibertyLauncher.SelfInstallPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar Grid.Row="0" x:Name="Chrome"
                       TitleIcon="pack://application:,,,/Aoe3ModLauncher;component/AppIcon.png"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

    <StackPanel Grid.Row="1" Margin="22,24,22,20">
        <TextBlock x:Name="HeadlineText" Style="{StaticResource WindowHeadline}"/>
        <TextBlock x:Name="BodyText" Style="{StaticResource WindowBody}" Margin="0,8,0,0"/>

        <Border Style="{StaticResource WindowCard}" Padding="16,12" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="WhatItDoesLabel" Style="{StaticResource WindowCardLabel}"/>
                <StackPanel x:Name="StepsList"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource WindowField}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="DestinationLabel" Style="{StaticResource WindowFieldLabel}"/>
                <TextBlock x:Name="DestinationPath" Style="{StaticResource WindowPath}"
                           Margin="0,5,0,0"/>
                <TextBlock x:Name="DestinationSize"
                           FontFamily="Consolas, Courier New, monospace"
                           FontSize="{DynamicResource SetControlSize}"
                           Foreground="{DynamicResource WindowMuted}"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border x:Name="SpaceWarning" Style="{StaticResource WindowNotice}"
                Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource WindowNoticeMark}">
                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="SpaceWarningText"
                           Style="{StaticResource WindowBody}"
                           Foreground="{DynamicResource WindowNoticeTitle}"
                           Margin="10,1,0,0"/>
            </Grid>
        </Border>

        <TextBlock x:Name="NotNowNote"
                   FontSize="{DynamicResource SetControlSize}"
                   Foreground="{DynamicResource WindowFineText}"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="NoButton" Style="{StaticResource WindowSecondaryButton}"
                    MinWidth="112" IsCancel="True" Click="NoButton_Click"/>
            <Button x:Name="YesButton" Style="{StaticResource WindowPrimaryButton}"
                    MinWidth="136" Margin="8,0,0,0" Click="YesButton_Click"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
