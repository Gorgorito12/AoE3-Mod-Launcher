<controls:BaseDialog x:Class="WarsOfLibertyLauncher.PlayerPickerDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
                     Width="520">
    <!-- "Choose exactly N": one dialog for every team question the tournaments ask — whom to
         invite to a team (1), which players make an ad-hoc line-up (2 or 3, the captain fixed),
         who of a registered team plays (the same), and which solo players the organiser folds
         into a team (draft). It only COLLECTS: the tab makes the call, as with
         CreateTournamentDialog. -->
    <StackPanel>
        <!-- A team's name, when the question needs one (ad-hoc line-up, draft merge). -->
        <StackPanel x:Name="NameBlock" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock x:Name="NameLabel" Style="{StaticResource WindowFieldLabel}"/>
            <Border Style="{StaticResource DialogFieldBox}" Margin="0,6,0,0">
                <TextBox x:Name="NameEntry" Style="{StaticResource DialogBareText}"
                         VerticalAlignment="Center" TextChanged="NameEntry_TextChanged"/>
            </Border>
        </StackPanel>

        <!-- The search, when the server can look people up by name. Hidden otherwise: a box
             that never finds anybody would read as a broken search. -->
        <StackPanel x:Name="SearchBlock" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock x:Name="SearchLabel" Style="{StaticResource WindowFieldLabel}"/>
            <Border Style="{StaticResource DialogFieldBox}" Margin="0,6,0,0">
                <TextBox x:Name="SearchEntry" Style="{StaticResource DialogBareText}"
                         VerticalAlignment="Center" TextChanged="SearchEntry_TextChanged"/>
            </Border>
        </StackPanel>

        <ScrollViewer MaxHeight="264"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ListPanel"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource DialogHint}"
                   Margin="0,6,0,0"/>
    </StackPanel>
</controls:BaseDialog>
