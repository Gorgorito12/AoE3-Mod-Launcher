<Window x:Class="WarsOfLibertyLauncher.ModPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Mod properties"
        Height="720" Width="1120"
        MinHeight="540" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <!--
        Steam-style per-mod Properties dialog. Single destination for
        ALL per-mod actions. Layout refactored from cards-in-cards to
        flat full-width sections with thin dividers — matches the way
        Steam's per-game Properties popup uses the whole content area
        instead of padding everything inside nested panels.

        Chrome:
          • WindowStyle=None + WindowChrome — kills the white Windows
            title bar so the header integrates with the dark palette
          • Single ✕ close button top-right (no min/max — modal popup
            shouldn't be minimised; popup is Owner-bound)
          • No footer Close button — the ✕ in the header IS the close

        Tabs:
          GENERAL     — About section + Check for updates
          LOCAL FILES — Install location + Paths grid + Maintenance +
                        Diagnostics + Danger Zone (red divider section)
          USER DATA   — Three rows (Open / Backup / Restore) with the
                        title+description on the left and a button on
                        the right (Steam-style settings row)
          LANGUAGE    — Language combo with description
    -->

    <!-- WindowChrome (caption drag + edge-resize) is applied centrally in
         App.OnAnyWindowLoaded from the TitleBarHeight token; the title bar is
         the shared controls:TitleBar below. -->

    <Window.Resources>
        <!-- The rail of a window of ONE mod: the selection takes its colour (design 71). -->
        <Style x:Key="ModNavButton" TargetType="Button" BasedOn="{StaticResource SetNavButton}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Background" Value="{DynamicResource ModAccentFill}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ============================================================
             Local styles. Scoped to the dialog so the flat-section
             visual language stays self-contained.
             ============================================================ -->

        <!-- Section header — small uppercase caption above each group.
             Same role the old DialogCardTitle had, just with margin
             tuned for the flat-section layout (no card padding to
             offset). -->
        <Style x:Key="DialogSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Secondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtitle}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Section divider — a hairline between flat sections. Same
             colour as BorderSubtle but at 60% opacity so it whispers
             rather than slicing the panel into hard bands. -->
        <Style x:Key="DialogDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,18,0,18"/>
        </Style>

        <!-- Field label (Name / Author / Installed / Website caption). -->
        <Style x:Key="DialogFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Secondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Field value -->
        <Style x:Key="DialogFieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryFixed}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyStrong}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Pill badge for version — used in the header and the GENERAL
             tab Installed row. -->
        <Style x:Key="DialogPillBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TintAccentBadge}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccentBadge}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Action-row title (User Data tab). Larger than the section
             header because each row IS the action, not a sub-section. -->
        <Style x:Key="DialogActionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryFixed}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyStrong}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Description text under an action title. -->
        <Style x:Key="DialogActionDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Secondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Title-bar close ✕ now lives in the shared controls:TitleBar
             (Styles/Chrome.xaml TitleBarCloseButton) — no per-dialog style. -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header (with custom close) -->
            <RowDefinition Height="*"/>      <!-- Tabs + content -->
            <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- The mod's image as a strip behind the title bar, fading into the navy, with the glow
             of its colour under it (BASE.md): a window of one mod, not the whole cover. -->
        <Border x:Name="ModStrip"
                Grid.RowSpan="3"
                Height="340"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                RenderOptions.BitmapScalingMode="HighQuality"/>
        <Rectangle Grid.RowSpan="3" Height="340" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#590F1C2E" Offset="0"/>
                    <GradientStop Color="#D90F1C2E" Offset=".6"/>
                    <GradientStop Color="#FF0F1C2E" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.RowSpan="3" Fill="{DynamicResource ModAccentWash}" IsHitTestVisible="False"/>

        <!-- =========================================================
             HEADER — shared global title bar. Mod icon + name come from
             TitleBar.TitleIcon / .Title (set in code-behind); the version
             pill rides in BarContent (right-aligned). Close-only sheet.
             ========================================================= -->
        <controls:TitleBar Grid.Row="0"
                           x:Name="TitleBarControl"
                           ShowMinimize="True"
                           ShowMaximize="True"
                           ShowClose="True">
            <!-- Design 71: which mod this window is about, and which copy. The name is a mod's
                 own text in an Auto column, so its ceiling sits on the text. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock x:Name="HeaderPrefixText"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           FontSize="{DynamicResource StatsBodySize}"
                           Foreground="{DynamicResource StatsProse}"/>
                <TextBlock x:Name="HeaderModName"
                           VerticalAlignment="Center"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="{DynamicResource DisplayFont}"
                           FontSize="{DynamicResource StatsSubtitleSize}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource StatsStrong}"/>
                <Border x:Name="HeaderVersionBadge"
                        Height="22" Padding="9,0" Margin="10,0,0,0"
                        CornerRadius="11"
                        Background="{DynamicResource ProfilePillFill}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="HeaderVersionText"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="{DynamicResource StatsLabelSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StatsFigure}"/>
                </Border>
                <Border x:Name="HeaderCopyBadge"
                        Height="22" Padding="9,0" Margin="8,0,0,0"
                        CornerRadius="11"
                        Background="{DynamicResource ProfilePillFill}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="HeaderCopyText"
                               VerticalAlignment="Center"
                               MaxWidth="200"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource StatsLabelSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StatsFigure}"/>
                </Border>
            </StackPanel>
        </controls:TitleBar>

        <!-- =========================================================
             TABS + CONTENT
             ========================================================= -->
        <Grid Grid.Row="1" x:Name="PropsContentRoot">
            <Grid.ColumnDefinitions>
                <!-- Auto column, fixed width on the rail Border itself: a
                     ColumnDefinition takes a GridLength and a StaticResource double is
                     not converted for it. -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left rail — same component as the launcher settings window, because the
                 handoff's whole point is that the two stop looking like two different
                 applications. That includes the MinWidth-not-Width rule: 206 is the
                 reference size at the reference text size, and the rail grows from
                 there rather than trimming a label once the text-size setting raises
                 it. See the longer note in LauncherSettingsDialog.xaml. -->
            <Border Grid.Column="0"
                    x:Name="ModRail"
                    MinWidth="{StaticResource SetModRailWidth}"
                    Margin="16,16,0,16"
                    CornerRadius="14"
                    Background="{DynamicResource GlassPanel}"
                    BorderBrush="{DynamicResource GlassRim}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="8,8,8,0">
                        <!-- Six sections and no way to find anything in them. Same box, same
                             styles and the same shared SectionSearch as the launcher settings
                             window; the rail here is structurally identical, so it drops in
                             above the nav entries with nothing to move. -->
                        <Border x:Name="ModSearchShell"
                                Style="{StaticResource SetSearchShell}" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock Text="&#xE721;" RenderTransformOrigin=".5,.5" RenderTransform="-1 0 0 1 0 0"
                                           DockPanel.Dock="Left"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="{DynamicResource SetControlSize}"
                                           Foreground="{DynamicResource UiTextIcon}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <Grid>
                                    <TextBox x:Name="ModSearchBox"
                                             Style="{StaticResource SetSearchField}"
                                             TextChanged="ModSearchBox_TextChanged"
                                             PreviewKeyDown="ModSearchBox_PreviewKeyDown"
                                             LostKeyboardFocus="ModSearchBox_LostKeyboardFocus"/>
                                    <TextBlock x:Name="ModSearchPlaceholder"
                                               Style="{StaticResource SetSearchPlaceholder}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <Button x:Name="TabGeneralBtn"
                                Style="{StaticResource ModNavButton}"
                                Click="TabGeneralBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE946;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TabGeneralLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="TabLocalFilesBtn"
                                Style="{StaticResource ModNavButton}"
                                Click="TabLocalFilesBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TabLocalFilesLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="TabUserDataBtn"
                                Style="{StaticResource ModNavButton}"
                                Click="TabUserDataBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE77B;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TabUserDataLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="TabLanguageBtn"
                                Style="{StaticResource ModNavButton}"
                                Click="TabLanguageBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE775;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TabLanguageLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                        <!-- The count docks RIGHT so the label keeps the remaining space
                             and trims; a signal must never push the text. -->
                        <Button x:Name="TabAddonsBtn"
                                Style="{StaticResource ModNavButton}"
                                Click="TabAddonsBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE710;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <Border x:Name="TabAddonsCount"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SetNavCountPill}"
                                        Margin="8,0,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="TabAddonsCountText"/>
                                </Border>
                                <TextBlock x:Name="TabAddonsLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                        <!-- Decks. Its own section rather than a block under STATISTICS: with
                             icons and descriptions it is a screen, not a footnote, and the two
                             read completely different files. Hidden for the stock game for the
                             same reason STATISTICS is. -->
                        <Button x:Name="TabDecksBtn"
                                Style="{StaticResource ModNavButton}"
                                Click="TabDecksBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE71D;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TabDecksLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                        <!-- Statistics. Hidden for the stock game, which has no
                             launcher-managed user-data folder and nothing to read. -->
                        <Button x:Name="TabStatsBtn"
                                Style="{StaticResource ModNavButton}"
                                Click="TabStatsBtn_Click">
                            <DockPanel>
                                <TextBlock Text="&#xE904;" Style="{StaticResource SetNavIcon}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TabStatsLabel" Style="{StaticResource SetNavLabel}"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Rail footer: who made this mod and where it lives.

                         THE CEILING IS ON THIS BORDER, not on the two TextBlocks: one binding
                         bounds whatever ends up in here, now and later. These two lines are the
                         only content of this window that belongs to the MOD rather than to the
                         launcher, and without a ceiling the Auto column above measured the
                         mod's URL and handed every mod a differently sized page. See
                         SetModRailTextWidth for the arithmetic and for why the TextTrimming
                         that was already here never fired. -->
                    <StackPanel Grid.Row="1">
                    <!-- "PROBLEMS? / Share diagnostics", fixed above the footer so it is one click
                         away from EVERY section (handoff 50a). It runs the same action as the button
                         in LOCAL FILES and does not navigate there.

                         MaxWidth IS THE SAME CEILING AS THE FOOTER'S, and for the same reason: the
                         rail is an Auto column measured at infinity, so a caption in here — the
                         Spanish one is the long one — would otherwise widen the rail, and with it
                         every page. TextTrimming alone cannot bound a measure. -->
                    <Border x:Name="RailDiagCard"
                            MaxWidth="{StaticResource SetModRailTextWidth}"
                            Margin="12,18,12,0"
                            Padding="13,12"
                            CornerRadius="10"
                            BorderThickness="1"
                            Background="{DynamicResource UiDiagSoftBg}"
                            BorderBrush="{DynamicResource UiDiagRim}">
                        <StackPanel>
                            <!-- The title has the card's whole width: beside the icon there are 130 px
                                 and "Compartir diagnóstico" needs 140. -->
                            <TextBlock x:Name="RailDiagTag"
                                       Margin="0,0,0,6"
                                       FontSize="{DynamicResource StatsBodySize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource UiDiagTitle}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30"
                                        CornerRadius="15"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource UiDiagSoftBg}">
                                    <TextBlock x:Name="RailDiagGlyph" Text="&#x21EA;"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource SetBodySize}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource UiDiagText}"/>
                                </Border>
                                <TextBlock x:Name="RailDiagCaption" Grid.Column="1"
                                           FontSize="{DynamicResource StatsNoteSize}"
                                           Foreground="{DynamicResource UiDiagBody}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Button x:Name="RailDiagBox"
                                    Style="{StaticResource SetDiagButton}"
                                    Width="NaN"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0"
                                    Click="RailDiagBox_Click"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RailLogsBtn"
                                        Style="{StaticResource SetActionButton}"
                                        Width="NaN"
                                        Height="32"
                                        Padding="4,0"
                                        Click="ViewLogsBtn_Click"/>
                                <Button x:Name="RailDiscordBtn" Grid.Column="2"
                                        Style="{StaticResource SetActionButton}"
                                        Width="NaN"
                                        Height="32"
                                        Padding="4,0"
                                        Click="RailDiscordBtn_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border MaxWidth="{StaticResource SetModRailTextWidth}"
                            HorizontalAlignment="Left"
                            Margin="14,14,12,14">
                        <StackPanel>
                            <!-- TWO lines before it gives up, because an author is a list of
                                 names often enough that one line loses half of it. "At most two
                                 lines" spelled the way WPF spells it: there is no MaxLines here,
                                 that is WinUI. The cap is a MaxHeight of exactly two line boxes,
                                 which is why LineHeight is pinned rather than left to the font,
                                 and the style's TextTrimming then ellipsises the second. -->
                            <TextBlock x:Name="RailAuthorText"
                                       Style="{StaticResource SetRailFooterText}"
                                       TextWrapping="Wrap"
                                       LineHeight="14"
                                       LineStackingStrategy="BlockLineHeight"
                                       MaxHeight="28"/>
                            <Button x:Name="RailSiteBtn"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    Click="RailSiteBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="RailSiteText"
                                           Style="{StaticResource SetRailFooterText}"
                                           FontSize="{DynamicResource SetDescSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ModAccentText}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right content: ONE column, FULL WIDTH, exactly like the launcher settings
                 window — nothing on the chain from this ScrollViewer down to a section panel
                 sets a MaxWidth or an alignment, which is what lets a row span the window.
                 The long version of why, and the three shapes that were rejected first, is on
                 the same Grid in LauncherSettingsDialog.xaml. The only cap left is on the
                 description TEXT (SetDescMaxWidth), not on the layout. -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="20,20,14,20">
                    <StackPanel>
                        <!-- The heading, and beside it how many search results the list under the
                             search box holds (handoff 50b) — shown only while it holds some. -->
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock x:Name="ModSectionTitle"
                                       Style="{StaticResource SetSectionTitle}"/>
                            <TextBlock x:Name="ModSearchCount"
                                       FontSize="{DynamicResource SetDescSize}"
                                       Foreground="{DynamicResource MpTextMuted}"
                                       VerticalAlignment="Bottom"
                                       Margin="12,0,0,3"
                                       Visibility="Collapsed"/>
                        </WrapPanel>
                        <!-- Shown INSTEAD of every section when a search matches nothing anywhere.
                             Without it the query simply emptied the page and left the reader looking
                             at a heading over nothing, with no way to tell a search that found no
                             match from one that had broken. -->
                        <TextBlock x:Name="ModSearchNoResults"
                                       Style="{StaticResource SetRowDesc}"
                                       Visibility="Collapsed"
                                       Margin="2,10,0,0"/>
                        <!-- A StackPanel, NOT a Grid: sibling panels in one Grid cell
                             overlap, which is invisible while exactly one is ever
                             visible and draws text on top of text the day two are. -->
                        <StackPanel>
                    <!-- ===================================================
                         GENERAL (5a)

                         Five lines of metadata and a thousand pixels of nothing became a
                         header that says WHOSE mod this is and WHICH version, an update
                         state that answers "am I current, when was that checked", and the
                         stay-on-this-version switch with its multiplayer caveat in an
                         amber box instead of a 200-character grey paragraph.

                         Gold survives in exactly one job here — the identity of the mod —
                         which is why the version figure is the only gold thing on the page.
                         =================================================== -->
                    <StackPanel x:Name="GeneralPanel" Visibility="Visible">
                        <!-- Design 71 has no identity card: the bar says which mod and the rail
                             says whose. Kept collapsed because the code still fills it. -->
                        <Border x:Name="ModIdentityCard" Style="{StaticResource SetCard}"
                                Visibility="Collapsed"
                                BorderBrush="{DynamicResource BorderAccentBadge}"
                                Margin="0,4,0,0">
                            <Border Style="{StaticResource SetRowLast}">
                                <Grid>
                                    <!-- TWO THIRDS AND ONE THIRD, always. The status column
                                         used to be Auto, so a status that is a sentence
                                         ("detected — ready to play", for a mod with no
                                         version of its own) took as much as it liked and the
                                         name was ellipsised down to "Age of Empires II…".
                                         A proportion cannot starve either side at any window
                                         width, and cannot overflow the card the way a pair
                                         of minimum widths would. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*" MaxWidth="200"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            x:Name="ModIdentityIcon"
                                            Width="44" Height="44"
                                            CornerRadius="{StaticResource RadiusRow}"
                                            Background="{DynamicResource MpSurfaceAlt}"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center"/>
                                    <!-- THE NAME HAS A FLOOR AND THE STATUS HAS A CEILING.
                                         This card is the one place in the window whose
                                         contents belong to the MOD rather than to the
                                         launcher, so it is the one place a long name or a
                                         long status could rearrange: "Age of Empires III:
                                         The Asian Dynasties" came out as "Age of Empires
                                         II…" because the column beside it grew to fit a
                                         whole sentence. Neither may take the other's room
                                         now, and the card is the same shape for every mod. -->
                                    <StackPanel Grid.Column="1" Margin="0,0,14,0"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="ValName"
                                                   FontFamily="{DynamicResource DisplayFont}"
                                                   FontSize="{DynamicResource SetSectionTitleSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource MpTextHeading}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- ONE line. It carries the author AND the site, and
                                             a long URL wrapped it to three, which made this
                                             card a different height per mod. Both are in the
                                             rail's footer, where the author wraps to two
                                             lines and the site is shortened to the part that
                                             identifies it, with the whole url on hover.
                                             (That footer used to show them at full width,
                                             which is exactly how a mod's own url came to
                                             decide how wide this window's content column
                                             was — see SetModRailTextWidth.) -->
                                        <TextBlock x:Name="ValAuthor"
                                                   Style="{StaticResource SetRowDesc}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="LblVersion"
                                                   Style="{StaticResource SetGroupLabel}"
                                                   Margin="0,0,0,2"
                                                   TextAlignment="Right"/>
                                        <!-- Usually a version number, which never reaches the
                                             cap. Sometimes a sentence — "detected — ready to
                                             play", for a mod with no version of its own — and
                                             that one wraps inside its own column instead of
                                             taking the name's. -->
                                        <TextBlock x:Name="ValVersion"
                                                   FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="{DynamicResource SetSectionTitleSize}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>

                        <!-- Update state. It answers the question the old loose "Check for
                             updates" button only implied. -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblStateSection" Style="{StaticResource SetGroupLabel}"/>
                            <TextBlock x:Name="LblStateCopy" Grid.Column="1"
                                       Style="{StaticResource SetGroupLabel}"
                                       Margin="6,24,4,10"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource StatsNote}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Border x:Name="UpdateStateCard"
                                Style="{StaticResource SetCard}">
                            <StackPanel>
                            <Border Style="{StaticResource SetActionRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            x:Name="UpdateStateIcon"
                                            Visibility="Collapsed"
                                            Width="28" Height="28"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Background="{DynamicResource MpChipOkBg}"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdateStateGlyph"
                                                   Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="{DynamicResource SetDescSize}"
                                                   Foreground="{DynamicResource MpOkText}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdateStateTitle" Style="{StaticResource SetRowTitle}"/>
                                        <TextBlock x:Name="CheckUpdatesResult" Style="{StaticResource SetRowDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="CheckUpdatesBtn"
                                            Style="{StaticResource ModActionButton}"
                                            Click="CheckUpdatesBtn_Click"/>
                                </Grid>
                            </Border>
                            <Border x:Name="GeneralVerifyRow" Style="{StaticResource SetActionRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="GeneralVerifyTitle" Style="{StaticResource SetRowTitle}"/>
                                        <TextBlock x:Name="GeneralVerifyHint" Style="{StaticResource SetRowDesc}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="VerifyBtn"
                                            Style="{StaticResource ModActionButton}"
                                            Click="VerifyBtn_Click"/>
                                </Grid>
                            </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="LblAboutSection" Style="{StaticResource SetGroupLabel}"/>
                        <!-- The whole UPDATES group is this one row, so it lives or dies with
                             it: LoadGeneral hides both when there is no version to pin. It used
                             to hide only the switch and its hint, which left the title and the
                             amber warning about falling behind on updates standing over
                             nothing — on the BASE GAME, which the launcher never updates at
                             all. A card that loses its rows takes its label with it; the search
                             already works that way. -->
                        <Border x:Name="UpdatesCard" Style="{StaticResource SetCard}">
                            <Border Style="{StaticResource SetRowLast}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <TextBlock x:Name="StayOnVersionTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="StayOnVersionHint" Style="{StaticResource SetRowDesc}"/>
                                        </StackPanel>
                                        <!-- Click, not Checked/Unchecked: LoadGeneral sets
                                             IsChecked programmatically, and those two events
                                             would fire on it and write the pin back. This
                                             handler existed and was wired to NOTHING, so the
                                             switch wrote no state at all. -->
                                        <ToggleButton Grid.Column="1" x:Name="StayOnVersionCheck"
                                                      Style="{StaticResource SetToggle}"
                                                      Click="StayOnVersionCheck_Click"/>
                                    </Grid>
                                    <!-- The consequence, in the colour reserved for a warning
                                         that has one — not a grey paragraph nobody reads. -->
                                    <Border Style="{StaticResource SetNoticeAmber}" Margin="0,10,0,0">
                                        <TextBlock x:Name="StayOnVersionWarning" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- The version picker, GitHubReleases-only, unchanged in behaviour. -->
                        <StackPanel x:Name="VersionSection" Visibility="Collapsed">
                            <TextBlock x:Name="VersionSectionLabel" Style="{StaticResource SetGroupLabel}"/>
                            <Border Style="{StaticResource SetCard}">
                                <Border Style="{StaticResource SetActionRowLast}">
                                    <!-- THE SENTENCE ON TOP, THE CONTROLS UNDER IT. Beside
                                         each other they were a paragraph, a picker whose text
                                         is the MOD's ("1.2 — installed, recommended") and a
                                         button, all fighting for one row: the paragraph lost,
                                         fell to about 150 px and broke into nine lines with
                                         its words cut off at the edge. Nothing here can
                                         squeeze anything now, at any window width and for any
                                         mod — which is the whole point, since this row is the
                                         one with the most variable content in the window. -->
                                    <StackPanel>
                                        <TextBlock x:Name="VersionSectionHint" Style="{StaticResource SetRowDesc}" Margin="0"/>
                                        <TextBlock x:Name="VersionStatus" Style="{StaticResource SetRowDesc}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,12,0,0">
                                            <ComboBox x:Name="VersionCombo"
                                                      Style="{StaticResource SetCompactCombo}"
                                                      MaxWidth="260"
                                                      Margin="0,0,10,0"/>
                                            <Button x:Name="InstallVersionBtn"
                                                    Style="{StaticResource ModActionButton}"
                                                    Click="InstallVersionBtn_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <!-- ===================================================
                         FILES (design 71). One card of copies: the one in use on top, in the
                         mod's colour, with its own actions; the others with "Use this one" and
                         a menu; then the row that installs another. Verify lives in General and
                         diagnostics in the rail, so nothing here competes with the copies.
                         =================================================== -->
                    <StackPanel x:Name="LocalFilesPanel" Visibility="Collapsed">

                        <TextBlock x:Name="LblCopiesIntro" Style="{StaticResource SetRowDesc}"
                                   FontSize="{DynamicResource SetDescSize}"
                                   Foreground="{DynamicResource WindowSoftText}"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed"/>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblManageInstalls" Style="{StaticResource SetGroupLabel}"/>
                            <TextBlock x:Name="LblManageInstallsDesc" Grid.Column="1"
                                       Style="{StaticResource SetGroupLabel}"
                                       Margin="6,24,4,10"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource StatsNote}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Border x:Name="ManageInstallsCard" Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border x:Name="ActiveCopyCard" Style="{StaticResource SetRow}"
                                        Background="{DynamicResource ModAccentFill}"
                                        CornerRadius="11,11,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                            <Border x:Name="ActiveCopyPulse" Grid.ColumnSpan="2"
                                                    Margin="-16,-14" CornerRadius="11,11,0,0"
                                                    Opacity="0" IsHitTestVisible="False"/>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                            <WrapPanel x:Name="ActiveCopyHead">
                                                <TextBlock x:Name="ActiveCopyName"
                                                           Style="{StaticResource SetRowTitle}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="ActiveCopyHint" Style="{StaticResource SetRowDesc}"
                                                       Foreground="{DynamicResource WindowSoftText}"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock x:Name="ValInstallPath" Style="{StaticResource SetMonoValue}"
                                                       Foreground="{DynamicResource WindowSoftText}"
                                                       Margin="0,5,0,0"/>
                                            <Border x:Name="NewerCopyNotice" Style="{StaticResource SetNoticeInfo}"
                                                    Margin="0,9,0,0" Visibility="Collapsed">
                                                <TextBlock x:Name="NewerCopyText" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource WindowIncremental}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="OpenFolderBtn"
                                                    Style="{StaticResource ModActionButton}"
                                                    Margin="0,0,8,0" Click="OpenFolderBtn_Click"/>
                                            <Button x:Name="RepairBtn"
                                                    Style="{StaticResource ModActionButton}"
                                                    Margin="0,0,8,0" Click="RepairBtn_Click"/>
                                            <Button x:Name="UninstallBtn"
                                                    Style="{StaticResource ModDangerButton}"
                                                    Click="UninstallBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="CopiesSection">
                                    <StackPanel x:Name="ManageInstallsHost"/>
                                    <Border Style="{StaticResource SetRowLast}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="InstallNewCopyTitle" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="InstallNewCopyDesc" Style="{StaticResource SetRowDesc}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="InstallNewCopyBtn" Grid.Column="1"
                                                    Style="{StaticResource ModActionButton}"
                                                    Click="InstallNewCopyBtn_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="LblPathsSection" Style="{StaticResource SetGroupLabel}"/>
                        <Border x:Name="FoldersGroup" Style="{StaticResource SetCard}">
                            <StackPanel>
                                <Border x:Name="Aoe3FolderRow" Style="{StaticResource SetRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblAoe3PathTitle" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="ValAoe3Path" Style="{StaticResource SetMonoValue}"
                                                       Foreground="{DynamicResource WindowSoftText}"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="OpenAoE3FolderBtn"
                                                    Style="{StaticResource ModActionButton}"
                                                    Margin="0,0,8,0" Click="OpenAoE3FolderBtn_Click"/>
                                            <Button x:Name="ChangeAoE3FolderBtn"
                                                    Style="{StaticResource ModActionButton}"
                                                    Click="ChangeAoE3FolderBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="FindInstallRow" Style="{StaticResource SetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblFindInstallTitle" Style="{StaticResource SetRowTitle}"
                                                       TextWrapping="Wrap" TextTrimming="None"/>
                                            <TextBlock x:Name="LblFindInstallDesc" Style="{StaticResource SetRowDesc}"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="AddExistingFolderBtn"
                                                    Style="{StaticResource ModActionButton}"
                                                    Margin="0,0,8,0" Click="AddExistingFolderBtn_Click"/>
                                            <Button x:Name="SearchInstallBtn"
                                                    Style="{StaticResource ModActionButton}"
                                                    Click="SearchInstallBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="MaintenanceGroup">
                            <TextBlock x:Name="LblMaintenanceSection" Style="{StaticResource SetGroupLabel}"/>
                            <Border Style="{StaticResource SetCard}">
                                <Border Style="{StaticResource SetRowLast}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblTempSection" Style="{StaticResource SetRowTitle}"/>
                                            <TextBlock x:Name="LblTempDesc" Style="{StaticResource SetRowDesc}"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock x:Name="ClearTempResult" Style="{StaticResource SetRowDesc}"
                                                       Margin="0,5,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="ClearTempBtn"
                                                Style="{StaticResource ModActionButton}"
                                                Click="ClearTempBtn_Click"/>
                                    </Grid>
                                </Border>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <!-- ===================================================
                         USER DATA (5c)

                         The backups row that said "none yet" became a real list: when they
                         exist you see each one with its date and size and restore from
                         there. That is one of the two behaviour changes the handoff
                         sanctions, and it costs nothing — UserDataService.ListBackups has
                         always returned the date, the size and the counts, newest first.
                         =================================================== -->
                    <StackPanel x:Name="UserDataPanel" Visibility="Collapsed">
                        <TextBlock x:Name="LblUserDataLocation"
                                   Style="{StaticResource SetGroupLabel}"/>
                        <Border Style="{StaticResource SetCard}">
                            <Border Style="{StaticResource SetActionRowLast}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LblUserDataPathTitle" Style="{StaticResource SetRowTitle}"/>
                                        <TextBlock x:Name="UserDataPathText" Style="{StaticResource SetMonoValue}"
                                                   Foreground="{DynamicResource WindowSoftText}"
                                                   Margin="0,5,0,0"/>
                                        <!-- Documents can be redirected (OneDrive), and the
                                             saves may live in either root. When both hold
                                             files, say so. -->
                                        <TextBlock x:Name="UserDataDivergesText"
                                                   Style="{StaticResource SetRowDesc}"
                                                   Foreground="{DynamicResource MpCautionText}"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="UserDataOtherAccountText"
                                                   Style="{StaticResource SetRowDesc}"
                                                   Foreground="{DynamicResource MpCautionText}"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="UserDataOtherAccountPath"
                                                   Style="{StaticResource SetMonoValue}"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="OpenUserDataFolderBtn"
                                            Style="{StaticResource ModActionButton}"
                                            Click="OpenUserDataFolderBtn_Click"/>
                                </Grid>
                            </Border>
                        </Border>

                        <Grid Margin="0,18,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="LblBackupsSection"
                                       Style="{StaticResource SetGroupLabel}" Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="LblBackupsNote"
                                       Style="{StaticResource SetGroupLabel}"
                                           Margin="6,0,8,0"
                                           VerticalAlignment="Center"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource StatsNote}"
                                           TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" x:Name="CreateBackupBtn"
                                    Style="{StaticResource ModActionButton}"
                                    Click="CreateBackupBtn_Click"/>
                        </Grid>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel>
                                <StackPanel x:Name="BackupsList"/>
                                <Border x:Name="BackupsEmptyRow" Style="{StaticResource SetRowLast}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblRestoreBackupDesc" Style="{StaticResource SetRowTitle}"/>
                                        <TextBlock x:Name="LblRestoreBackupHint" Style="{StaticResource SetRowDesc}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="GameSettingsSection">
                            <TextBlock x:Name="LblGameSettingsSection" Style="{StaticResource SetGroupLabel}"/>
                            <Border Style="{StaticResource SetCard}">
                                <StackPanel>
                                    <Border Style="{StaticResource SetRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <TextBlock x:Name="LblGameSettingsTitle" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="SyncSettingsHint" Style="{StaticResource SetRowDesc}"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" x:Name="SyncSettingsCheck"
                                                          Style="{StaticResource SetToggle}"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SetActionRowLast}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="LblImportTitle" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="LblGameSettingsDesc" Style="{StaticResource SetRowDesc}"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="SettingsSourceCombo"
                                                      Style="{StaticResource SetCompactCombo}"
                                                      Margin="0,0,10,0"/>
                                            <Button Grid.Column="2" x:Name="ImportSettingsBtn"
                                                    Style="{StaticResource ModActionButton}"
                                                    Click="ImportSettingsBtn_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="UserDataResultHint"
                                   Style="{StaticResource SetRowDesc}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="LanguagePanel" Visibility="Collapsed">
                        <TextBlock x:Name="LblLanguageDesc"
                                   Style="{StaticResource SetRowDesc}"
                                   FontSize="{DynamicResource SetDescSize}"
                                   Foreground="{DynamicResource WindowSoftText}"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,14,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblLanguageCurrent"
                                       Style="{StaticResource SetGroupLabel}" Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="LanguageEmptyHint"
                                       Style="{StaticResource SetGroupLabel}"
                                           Margin="6,0,8,0"
                                           VerticalAlignment="Center"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource StatsNote}"
                                           TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" x:Name="RefreshTranslationsBtn"
                                    Style="{StaticResource ModActionButton}"
                                    Click="RefreshTranslationsBtn_Click"/>
                        </Grid>
                        <!-- Shown while the mod is installing/updating: the whole
                             language list is locked (see SetModBusy). -->
                        <Border x:Name="LanguageBusyHint"
                                MaxWidth="520" HorizontalAlignment="Left"
                                Margin="0,0,0,10"
                                Padding="12,8"
                                CornerRadius="6"
                                Background="{DynamicResource BgPanel}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="LanguageBusyHintText"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <!-- The active pack checked against the DISK (LoadLanguage →
                             VerifyActiveTranslationAsync): "in use" used to be read from the
                             config alone, so it stayed true while a compiled .XMB twin hid the
                             copy from the game, or after an update put the English file back.
                             Amber because the consequence is real: the game is not in the
                             language the card says it is. -->
                        <Border x:Name="LanguageLiveWarning"
                                Style="{StaticResource SetNoticeAmber}"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LanguageLiveWarningText"
                                           TextWrapping="Wrap"
                                           MaxWidth="{StaticResource SetDescMaxWidth}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="LanguageLiveWarningAction"
                                        Grid.Column="1"
                                        Style="{StaticResource ModActionButton}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Click="LanguageLiveWarningAction_Click"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel x:Name="LanguageCardList"/>
                        </Border>

                        <!-- TRANSLATION SOURCES. Where the player follows another translator:
                             paste their repo or link once, and every version they publish later
                             shows up in their own card above. The list is launcher-wide (Settings
                             edits the same one); each pack names the mod it is for, so this mod
                             only ever shows its own. -->
                        <StackPanel x:Name="TxSourcesSection">
                            <TextBlock x:Name="TxSourcesTitle" Style="{StaticResource SetGroupLabel}"/>
                            <Border Style="{StaticResource SetCard}">
                                <StackPanel>
                                    <StackPanel x:Name="TxSourceRows"/>
                                    <Border Style="{StaticResource SetRowLast}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock x:Name="TxAddTitle" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="TxAddHint" Style="{StaticResource SetRowDesc}" Margin="0,5,0,8"/>
                                                <Grid>
                                                    <TextBox x:Name="TxAddInput"
                                                             Height="34"
                                                             Padding="8,0,8,0"
                                                             FontFamily="{DynamicResource MonoFont}"
                                                             FontSize="{DynamicResource SetDescSize}"
                                                             VerticalContentAlignment="Center"
                                                             KeyDown="TxAddInput_KeyDown"
                                                             TextChanged="TxAddInput_TextChanged"/>
                                                    <TextBlock x:Name="TxAddPlaceholder"
                                                               IsHitTestVisible="False"
                                                               Margin="11,0,8,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{DynamicResource MonoFont}"
                                                               FontSize="{DynamicResource SetDescSize}"
                                                               Foreground="{DynamicResource UiTextFaint}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <TextBlock x:Name="TxAddResult"
                                                           Style="{StaticResource SetRowDesc}"
                                                           Margin="0,8,0,0"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="TxAddButton"
                                                    Style="{StaticResource ModActionButton}"
                                                    Click="TxAddButton_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===================================================
                         ADDONS (5d)

                         One undifferentiated stack of cards where nothing said what an
                         addon actually touches: "transparent interface" and "replaces 25
                         files the game compares between players" looked identical, and
                         both offered the same button. Now each card states its risk, how
                         many files it writes and which of them are the dangerous ones,
                         and the two sources are separated because they are not verified
                         the same way.

                         Every figure on this screen is READ, never estimated: the counts
                         come from the archive's own entry list and the risk from
                         AddonRisk.Assess over it. An addon whose archive is not on disk
                         yet shows its row and no numbers.
                         =================================================== -->
                    <StackPanel x:Name="AddonsPanel" Visibility="Collapsed">
                        <TextBlock x:Name="LblAddonsSectionHint"
                                   Style="{StaticResource SetRowDesc}"
                                   FontSize="{DynamicResource SetDescSize}"
                                   Foreground="{DynamicResource WindowSoftText}"
                                   Margin="0,0,0,4"/>

                        <Grid Margin="0,18,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="LblAddonsGroupCatalog"
                                       Style="{StaticResource SetGroupLabel}" Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="1" x:Name="LblAddonsGroupCatalogHint"
                                       Style="{StaticResource SetGroupLabel}"
                                           Margin="6,0,8,0"
                                           VerticalAlignment="Center"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource StatsNote}"
                                           TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Border Style="{StaticResource SetCard}">
                            <StackPanel x:Name="AddonCardList"/>
                        </Border>

                        <!-- Importing lives with the group it produces, not at the bottom
                             of the page under everything else. -->
                        <Grid Margin="0,18,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="LblAddonsGroupImported"
                                       Style="{StaticResource SetGroupLabel}" Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="LblAddonsGroupImportedHint"
                                       Style="{StaticResource SetGroupLabel}"
                                           Margin="6,0,8,0"
                                           VerticalAlignment="Center"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource StatsNote}"
                                           TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" x:Name="ImportAddonBtn"
                                    Style="{StaticResource ModActionButton}"
                                    Click="ImportAddonBtn_Click"/>
                        </Grid>
                        <Border x:Name="ImportedAddonCard" Style="{StaticResource SetCard}">
                            <StackPanel x:Name="ImportedAddonList"/>
                        </Border>

                        <TextBlock x:Name="AddonsEmptyHint"
                                   Style="{StaticResource SetRowDesc}"
                                   Margin="0,2,0,0"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="AddonsResultText"
                                   FontSize="{DynamicResource FontSizeBody}"
                                   Margin="0,10,0,0"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel x:Name="StatsPanel" Visibility="Collapsed">
                            <StackPanel x:Name="HumanGamesGroup" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblHumanGamesTitle" Style="{StaticResource SetGroupLabel}" Margin="4,4,4,10"/>
                                    <TextBlock x:Name="LblHumanGamesHint" Grid.Column="1"
                                               Style="{StaticResource SetGroupLabel}"
                                               Margin="6,4,4,10"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource StatsNote}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border Style="{StaticResource SetCard}">
                                    <StackPanel x:Name="HumanGamesList"/>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="AiGamesGroup" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblStatsSectionTitle" Style="{StaticResource SetGroupLabel}" Margin="4,24,4,10"/>
                                    <TextBlock x:Name="LblStatsSectionHint" Grid.Column="1"
                                               Style="{StaticResource SetGroupLabel}"
                                               Margin="6,24,4,10"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource StatsNote}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border Style="{StaticResource SetCard}">
                                    <StackPanel x:Name="AiGamesList"/>
                                </Border>
                            </StackPanel>
                            <Border x:Name="StatsEmptyCard" Style="{StaticResource SetCard}" Visibility="Collapsed">
                                <Border Style="{StaticResource SetRowLast}">
                                    <StackPanel>
                                        <TextBlock x:Name="StatsEmptyHint" Style="{StaticResource SetRowTitle}"/>
                                        <TextBlock x:Name="StatsEmptyDesc" Style="{StaticResource SetRowDesc}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>

                        <!-- DECKS (design 71). The home city in one card; below it, the same card holds
                             the deck pills, the cards in their slots and what the chosen one does.
                             These are the cards a player BRINGS, not the ones they played. -->
                        <StackPanel x:Name="DecksPanel" Visibility="Collapsed">
                            <TextBlock x:Name="LblDecksSectionHint"
                                       Style="{StaticResource SetRowDesc}"
                                       FontSize="{DynamicResource SetDescSize}"
                                       Foreground="{DynamicResource WindowSoftText}"
                                       Margin="0,0,0,4"/>

                            <StackPanel x:Name="DeckContent" Visibility="Collapsed">
                                <TextBlock x:Name="LblDeckCity" Style="{StaticResource SetGroupLabel}"/>
                                <Border Style="{StaticResource SetCard}">
                                    <Border Style="{StaticResource SetRowLast}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="DeckHeadline" Style="{StaticResource SetRowTitle}"/>
                                                <TextBlock x:Name="DeckFacts" Style="{StaticResource SetRowDesc}"
                                                           Margin="0,5,0,0"/>
                                                <TextBlock x:Name="DeckFile" Style="{StaticResource SetMonoValue}"
                                                           Foreground="{DynamicResource WindowSoftText}"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <ComboBox x:Name="DeckCityCombo" Grid.Column="1"
                                                      Style="{StaticResource SetCompactCombo}"
                                                      MaxWidth="260"
                                                      VerticalAlignment="Center"
                                                      Visibility="Collapsed"
                                                      SelectionChanged="DeckCityCombo_SelectionChanged"/>
                                        </Grid>
                                    </Border>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblDeckGroup" Style="{StaticResource SetGroupLabel}"/>
                                    <TextBlock x:Name="DeckCountNote" Grid.Column="1"
                                               Style="{StaticResource SetGroupLabel}"
                                               Margin="6,24,4,10"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource StatsNote}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Border x:Name="DeckGridCard" Style="{StaticResource SetCard}" Padding="16,14">
                                    <StackPanel>
                                        <WrapPanel x:Name="DeckPickerRow" Margin="0,0,0,8"/>
                                        <Grid x:Name="DeckBody" SizeChanged="DeckBody_SizeChanged">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="DeckTilesColumn" Width="*"/>
                                                <ColumnDefinition x:Name="DeckGapColumn" Width="14"/>
                                                <ColumnDefinition x:Name="DeckDetailColumn" Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <UniformGrid x:Name="DeckCardGrid" VerticalAlignment="Top"/>
                                            <Border x:Name="DeckDetailCard" Grid.Column="2"
                                                    MinHeight="150"
                                                    Padding="16,14"
                                                    Background="{DynamicResource ModDeckDetailFill}"
                                                    BorderBrush="{DynamicResource ModAccentLine}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    VerticalAlignment="Top">
                                                <DockPanel>
                                                    <TextBlock x:Name="DeckDetailSlot"
                                                               DockPanel.Dock="Top"
                                                               FontFamily="{DynamicResource MonoFont}"
                                                               FontSize="{DynamicResource SetGroupLabelSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource StatsNote}"/>
                                                    <TextBlock x:Name="DeckDetailInternal"
                                                               DockPanel.Dock="Bottom"
                                                               Style="{StaticResource SetMonoValue}"
                                                               FontSize="{DynamicResource SetGroupLabelSize}"
                                                               Foreground="{DynamicResource StatsNote}"
                                                               Margin="0,10,0,0"/>
                                                    <StackPanel>
                                                        <DockPanel Margin="0,8,0,0">
                                                            <Image x:Name="DeckDetailIcon"
                                                                   DockPanel.Dock="Left"
                                                                   Width="64" Height="64"
                                                                   Margin="0,0,12,0"
                                                                   VerticalAlignment="Top"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="DeckDetailName"
                                                                       Foreground="{DynamicResource ModChipText}"
                                                                       FontSize="{DynamicResource SetSubTitleSize}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap"/>
                                                        </DockPanel>
                                                        <TextBlock x:Name="DeckDetailText"
                                                                   Foreground="{DynamicResource WindowSoftText}"
                                                                   FontSize="{DynamicResource SetRowDescSize}"
                                                                   Margin="0,8,0,0"
                                                                   TextWrapping="Wrap"/>
                                                        <!-- What the card changes, in the game's own wording:
                                                             the only description most shipments have. -->
                                                        <StackPanel x:Name="DeckDetailEffects" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border x:Name="DecksEmptyCard" Style="{StaticResource SetCard}"
                                    Margin="0,8,0,0" Visibility="Collapsed">
                                <Border Style="{StaticResource SetRowLast}">
                                    <StackPanel>
                                        <TextBlock x:Name="DecksEmptyHint" Style="{StaticResource SetRowTitle}"/>
                                        <TextBlock x:Name="DecksEmptyDesc" Style="{StaticResource SetRowDesc}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Height="52"
                Padding="16,0"
                Background="{DynamicResource WindowFooter}"
                BorderBrush="{DynamicResource WindowFooterRule}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ModFooterText"
                           FontSize="{DynamicResource SetRowDescSize}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource UiMutedText}"/>
                <Button x:Name="ModFooterClose"
                        Style="{StaticResource SetFooterBarGhostButton}"
                        HorizontalAlignment="Right"
                        MinWidth="112"
                        Click="ModFooterClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
