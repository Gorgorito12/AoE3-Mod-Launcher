<Window x:Class="WarsOfLibertyLauncher.PublishModDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Publish my mod"
        Width="1120" Height="720" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="False">

    <!--
        "Publish my mod": six steps that write a mod.json for the public catalog and open a
        pre-filled PR against it. Design 73: the chassis of the launcher settings, so the window
        grows with the launcher instead of leaving a narrow column in the middle. Each field is a
        row (name and help left, field right), multi-line fields take the whole width.
        Every font size is a DynamicResource: a StaticResource one silently stops following the
        launcher's text-size setting.
    -->
    <Window.Resources>
        <!-- Gold globally, and the shared TextBox template paints the ring by TargetName. -->
        <SolidColorBrush x:Key="TextBoxFocusBrush" Color="#2F7FE0"/>

        <Style x:Key="WzStepTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource DialogTitleSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="WzStepHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource DialogBodySize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowSoftText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="WzLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource WzLabelSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowStrongText}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <Style x:Key="WzOptional" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource SetDescSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Margin" Value="9,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="WzHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource SetRowDescSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="WzError" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
            <Setter Property="Foreground" Value="#F0A6A6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="WzHeadNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource SetDescSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <!-- One setting: name and help on the left, the field on the right. The line under it
             comes from RefreshCardLines, which knows which row is the last one showing. -->
        <Style x:Key="WzRow" TargetType="Border">
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="WzNoteRow" TargetType="Border" BasedOn="{StaticResource WzRow}"/>
        <Style x:Key="WzNote" TargetType="Border">
            <Setter Property="Background" Value="#1A55ACEE"/>
            <Setter Property="BorderBrush" Value="#6155ACEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="WzNoteText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource SetRowDescSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowSoftText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="WzInput" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource MpField}"/>
            <Setter Property="Foreground" Value="#E8EEF6"/>
            <Setter Property="CaretBrush" Value="{DynamicResource MpActionText}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource MpAction}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowSecondaryRim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="{DynamicResource DialogBodySize}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource MpAction}"/>
                                <Setter TargetName="shell" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WzInputMono" TargetType="TextBox" BasedOn="{StaticResource WzInput}">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource SetRowDescSize}"/>
        </Style>
        <Style x:Key="WzInputMulti" TargetType="TextBox" BasedOn="{StaticResource WzInputMono}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="WzInputProse" TargetType="TextBox" BasedOn="{StaticResource WzInput}">
            <Setter Property="Height" Value="72"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="WzCombo" TargetType="ComboBox" BasedOn="{StaticResource SetCompactCombo}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="WzFoldSummary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource SetRowDescSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="16,14"/>
        </Style>

        <Style x:Key="WzRailStep" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WzRailLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource WzLabelSize}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WzRailDisc" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="WzRailGlyph" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource SetCaptionSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WzMissingPill" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Background" Value="#1FF4900C"/>
            <Setter Property="BorderBrush" Value="#73F4900C"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowNoticeTitle}"/>
            <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                           TitleIcon="pack://application:,,,/Aoe3ModLauncher;component/AppIcon.png"
                           ShowMinimize="False" ShowMaximize="True" ShowClose="True"/>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The steps, with what each one still needs. Painted by RefreshRail(). -->
            <Border x:Name="StepRail" MinWidth="220" CornerRadius="14" Padding="10"
                    Background="{DynamicResource GlassPanel}"
                    BorderBrush="#1AFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="4,4,4,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RailSwatch" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock x:Name="RailInitial" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="RailModName" MaxWidth="170" FontSize="{DynamicResource WzLabelSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WindowStrongText}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="RailModPath" MaxWidth="170" Margin="0,4,0,0" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="{DynamicResource SetDescSize}" Foreground="{DynamicResource WindowFineText}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" Padding="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Button x:Name="RailStep1" Style="{StaticResource WzRailStep}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RailDisc1" Style="{StaticResource WzRailDisc}">
                                        <TextBlock x:Name="RailGlyph1" Style="{StaticResource WzRailGlyph}" Text="1"/>
                                    </Border>
                                    <TextBlock x:Name="RailLabel1" Grid.Column="1" Style="{StaticResource WzRailLabel}"/>
                                    <Ellipse x:Name="RailDot1" Grid.Column="2" Width="7" Height="7" Margin="10,0,0,0" Fill="{DynamicResource WindowNoticeDot}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="RailStep2" Style="{StaticResource WzRailStep}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RailDisc2" Style="{StaticResource WzRailDisc}">
                                        <TextBlock x:Name="RailGlyph2" Style="{StaticResource WzRailGlyph}" Text="2"/>
                                    </Border>
                                    <TextBlock x:Name="RailLabel2" Grid.Column="1" Style="{StaticResource WzRailLabel}"/>
                                    <Ellipse x:Name="RailDot2" Grid.Column="2" Width="7" Height="7" Margin="10,0,0,0" Fill="{DynamicResource WindowNoticeDot}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="RailStep3" Style="{StaticResource WzRailStep}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RailDisc3" Style="{StaticResource WzRailDisc}">
                                        <TextBlock x:Name="RailGlyph3" Style="{StaticResource WzRailGlyph}" Text="3"/>
                                    </Border>
                                    <TextBlock x:Name="RailLabel3" Grid.Column="1" Style="{StaticResource WzRailLabel}"/>
                                    <Ellipse x:Name="RailDot3" Grid.Column="2" Width="7" Height="7" Margin="10,0,0,0" Fill="{DynamicResource WindowNoticeDot}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="RailStep4" Style="{StaticResource WzRailStep}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RailDisc4" Style="{StaticResource WzRailDisc}">
                                        <TextBlock x:Name="RailGlyph4" Style="{StaticResource WzRailGlyph}" Text="4"/>
                                    </Border>
                                    <TextBlock x:Name="RailLabel4" Grid.Column="1" Style="{StaticResource WzRailLabel}"/>
                                    <Ellipse x:Name="RailDot4" Grid.Column="2" Width="7" Height="7" Margin="10,0,0,0" Fill="{DynamicResource WindowNoticeDot}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="RailStep5" Style="{StaticResource WzRailStep}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RailDisc5" Style="{StaticResource WzRailDisc}">
                                        <TextBlock x:Name="RailGlyph5" Style="{StaticResource WzRailGlyph}" Text="5"/>
                                    </Border>
                                    <TextBlock x:Name="RailLabel5" Grid.Column="1" Style="{StaticResource WzRailLabel}"/>
                                    <Ellipse x:Name="RailDot5" Grid.Column="2" Width="7" Height="7" Margin="10,0,0,0" Fill="{DynamicResource WindowNoticeDot}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="RailStep6" Style="{StaticResource WzRailStep}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="RailDisc6" Style="{StaticResource WzRailDisc}">
                                        <TextBlock x:Name="RailGlyph6" Style="{StaticResource WzRailGlyph}" Text="6"/>
                                    </Border>
                                    <TextBlock x:Name="RailLabel6" Grid.Column="1" Style="{StaticResource WzRailLabel}"/>
                                    <Ellipse x:Name="RailDot6" Grid.Column="2" Width="7" Height="7" Margin="10,0,0,0" Fill="{DynamicResource WindowNoticeDot}" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
                        <UniformGrid Rows="1">
                            <Button x:Name="HowItWorksButton" Style="{StaticResource WindowSecondaryButton}" Padding="12,0" Margin="0,0,4,0" MinWidth="0"/>
                            <Button x:Name="GuideButton" Style="{StaticResource WindowSecondaryButton}" Padding="12,0" Margin="4,0,0,0" MinWidth="0"/>
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" x:Name="ContentScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="4,4,6,8">
                <StackPanel>
                    <TextBlock x:Name="StepOfText" FontSize="{DynamicResource SetCaptionSize}" FontWeight="SemiBold"
                               Foreground="{DynamicResource WindowFineText}" Margin="0,0,0,6"/>
                    <Border x:Name="IntroPanel" Style="{StaticResource WzNote}" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="IntroText" Style="{StaticResource WzNoteText}"
                                   FontSize="{DynamicResource DialogBodySize}" Foreground="{DynamicResource UiBodyText}"/>
                    </Border>
                    <Grid>
                <StackPanel x:Name="Step1Panel">
                    <TextBlock x:Name="Step1Title" Style="{StaticResource WzStepTitle}"/>
                    <TextBlock x:Name="Step1Hint" Style="{StaticResource WzStepHint}"/>
                    <StackPanel Margin="0,16,0,0">
                        <Border Style="{StaticResource WindowCard}" Margin="0,0,0,16">
                        <StackPanel Tag="card">
                        <Border Style="{StaticResource WzRow}">
                        <controls:FieldRowPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblId" Style="{StaticResource WzLabel}"/>
                            </StackPanel>
                            <TextBlock x:Name="HintId" Style="{StaticResource WzHint}"/>
                            <StackPanel x:Name="IdPathRow" Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock x:Name="IdPathPrefix" FontSize="{DynamicResource SetControlSize}" Foreground="{DynamicResource WindowFineText}"/>
                                <TextBlock x:Name="IdPathValue" Margin="5,0,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SetControlSize}" FontWeight="Medium" Foreground="{DynamicResource UiBodyText}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBox x:Name="FieldId" Style="{StaticResource WzInputMono}"/>
                            <TextBlock x:Name="ErrorId" Style="{StaticResource WzError}" Visibility="Collapsed"/>
                        </StackPanel>
                        </controls:FieldRowPanel>
                        </Border>
                        <Border Style="{StaticResource WzRow}">
                        <controls:FieldRowPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblDisplayName" Style="{StaticResource WzLabel}"/>
                            </StackPanel>
                            <TextBlock x:Name="HintDisplayName" Style="{StaticResource WzHint}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBox x:Name="FieldDisplayName" Style="{StaticResource WzInput}"/>
                            <TextBlock x:Name="ErrorDisplayName" Style="{StaticResource WzError}" Visibility="Collapsed"/>
                        </StackPanel>
                        </controls:FieldRowPanel>
                        </Border>
                        <Border Style="{StaticResource WzRow}">
                        <controls:FieldRowPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblAuthor" Style="{StaticResource WzLabel}"/>
                                <TextBlock x:Name="OptAuthor" Style="{StaticResource WzOptional}"/>
                            </StackPanel>
                            <TextBlock x:Name="HintAuthor" Style="{StaticResource WzHint}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBox x:Name="FieldAuthor" Style="{StaticResource WzInput}"/>
                        </StackPanel>
                        </controls:FieldRowPanel>
                        </Border>
                        <Border Style="{StaticResource WzRow}">
                        <controls:FieldRowPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblSubtitle" Style="{StaticResource WzLabel}"/>
                                <TextBlock x:Name="OptSubtitle" Style="{StaticResource WzOptional}"/>
                            </StackPanel>
                            <TextBlock x:Name="HintSubtitle" Style="{StaticResource WzHint}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBox x:Name="FieldSubtitle" Style="{StaticResource WzInput}"/>
                        </StackPanel>
                        </controls:FieldRowPanel>
                        </Border>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock x:Name="Step2Title" Style="{StaticResource WzStepTitle}"/>
                    <TextBlock x:Name="Step2Hint" Style="{StaticResource WzStepHint}"/>
                    <StackPanel Margin="0,16,0,0">
                        <Border Style="{StaticResource WindowCard}" Margin="0,0,0,16">
                        <StackPanel Tag="card">
                        <Border Style="{StaticResource WzRow}">
                        <controls:FieldRowPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblAccent" Style="{StaticResource WzLabel}"/>
                                <TextBlock x:Name="OptAccent" Style="{StaticResource WzOptional}"/>
                            </StackPanel>
                            <TextBlock x:Name="HintAccent" Style="{StaticResource WzHint}"/>
                        </StackPanel>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentSwatch" Width="34" Height="34" CornerRadius="7" Margin="0,0,8,0" BorderBrush="#2EFFFFFF" BorderThickness="1"/>
                                <TextBox x:Name="FieldAccent" Grid.Column="1" Style="{StaticResource WzInputMono}"/>
                            </Grid>
                            <TextBlock x:Name="ErrorAccent" Style="{StaticResource WzError}" Visibility="Collapsed"/>
                        </StackPanel>
                        </controls:FieldRowPanel>
                        </Border>
                        <Border Style="{StaticResource WzRow}">
                        <controls:FieldRowPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblIcon" Style="{StaticResource WzLabel}"/>
                                <TextBlock x:Name="OptIcon" Style="{StaticResource WzOptional}"/>
                            </StackPanel>
                            <TextBlock x:Name="HintIcon" Style="{StaticResource WzHint}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBox x:Name="FieldIcon" Style="{StaticResource WzInputMono}"/>
                            <TextBlock x:Name="ErrorIcon" Style="{StaticResource WzError}" Visibility="Collapsed"/>
                        </StackPanel>
                        </controls:FieldRowPanel>
                        </Border>
                        <Border Style="{StaticResource WzRow}">
                        <controls:FieldRowPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LblBanner" Style="{StaticResource WzLabel}"/>
                                <TextBlock x:Name="OptBanner" Style="{StaticResource WzOptional}"/>
                            </StackPanel>
                            <TextBlock x:Name="HintBanner" Style="{StaticResource WzHint}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBox x:Name="FieldBanner" Style="{StaticResource WzInputMono}"/>
                            <TextBlock x:Name="ErrorBanner" Style="{StaticResource WzError}" Visibility="Collapsed"/>
                        </StackPanel>
                        </controls:FieldRowPanel>
                        </Border>
                        <Border Style="{StaticResource WzNoteRow}">
                            <Border Style="{StaticResource WzNote}">
                                <TextBlock x:Name="ImagesUploadNote" Style="{StaticResource WzNoteText}"/>
                            </Border>
                        </Border>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock x:Name="Step3Title" Style="{StaticResource WzStepTitle}"/>
                    <TextBlock x:Name="Step3Hint" Style="{StaticResource WzStepHint}"/>
                    <StackPanel Margin="0,16,0,0">
