                            <Button x:Name="AddLinkButton" Style="{StaticResource WindowSecondaryButton}" MinWidth="112" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            <TextBox x:Name="FieldLinks" Visibility="Collapsed"/>
                        </StackPanel>
                        </controls:FieldRowPanel>
                        </Border>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Step6Panel" Visibility="Collapsed">
                    <TextBlock x:Name="Step6Title" Style="{StaticResource WzStepTitle}"/>
                    <TextBlock x:Name="Step6Hint" Style="{StaticResource WzStepHint}"/>
                    <StackPanel Margin="0,16,0,0">
                        <Border x:Name="MissingCard" Style="{StaticResource WindowCard}" Padding="16,14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="MissingTitle" FontSize="{DynamicResource WzLabelSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MissingFootnote" Style="{StaticResource WzHint}" Margin="0,4,0,0"/>
                            <WrapPanel x:Name="MissingPills" Margin="0,10,0,0"/>
                        </StackPanel>
                        </Border>
                        <Grid MinHeight="32" Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="JsonHeaderLabel" Style="{StaticResource WindowCardLabel}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="JsonPathText" Grid.Column="1" Style="{StaticResource WzHeadNote}"/>
                            <Button x:Name="CopyJsonButton" Grid.Column="3" Style="{StaticResource WindowSecondaryButton}" MinWidth="112"/>
                        </Grid>
                        <Border Style="{StaticResource WindowCard}" Margin="0,0,0,16" Background="{DynamicResource MpField}" Padding="16,14">
                            <TextBox x:Name="JsonPreview" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource WindowSoftText}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SetControlSize}" AcceptsReturn="True" TextWrapping="NoWrap" MaxHeight="312" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                        <Grid MinHeight="32" Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NextStepsTitle" Style="{StaticResource WindowCardLabel}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource WindowCard}" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="#992F7FE0" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="1" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SetCaptionSize}" FontWeight="SemiBold" Foreground="{DynamicResource UiInfoText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="NextStep0" Grid.Column="1" Margin="10,2,0,0" FontSize="{DynamicResource DialogBodySize}" Foreground="{DynamicResource WindowSoftText}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="#992F7FE0" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="2" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SetCaptionSize}" FontWeight="SemiBold" Foreground="{DynamicResource UiInfoText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="NextStep1" Grid.Column="1" Margin="10,2,0,0" FontSize="{DynamicResource DialogBodySize}" Foreground="{DynamicResource WindowSoftText}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="#992F7FE0" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="3" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SetCaptionSize}" FontWeight="SemiBold" Foreground="{DynamicResource UiInfoText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="NextStep2" Grid.Column="1" Margin="10,2,0,0" FontSize="{DynamicResource DialogBodySize}" Foreground="{DynamicResource WindowSoftText}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="#992F7FE0" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="4" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SetCaptionSize}" FontWeight="SemiBold" Foreground="{DynamicResource UiInfoText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="NextStep3" Grid.Column="1" Margin="10,2,0,0" FontSize="{DynamicResource DialogBodySize}" Foreground="{DynamicResource WindowSoftText}" TextWrapping="Wrap"/>
                            </Grid>
                            <WrapPanel Margin="0,2,0,0">
                                <Button x:Name="NextStepsLink" Style="{StaticResource WindowTextLink}" Margin="0,0,20,0"/>
                                <Button x:Name="NextStepsScriptLink" Style="{StaticResource WindowTextLink}"/>
                            </WrapPanel>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Height="56" Padding="16,0" Background="#B8080F1B"
                BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Style="{StaticResource WindowSecondaryButton}" MinWidth="112" VerticalAlignment="Center"/>
                <TextBlock x:Name="BlockText" Grid.Column="1" Margin="10,0" FontSize="{DynamicResource SetRowDescSize}"
                           Foreground="{DynamicResource WindowNoticeTitle}" TextAlignment="Right" TextWrapping="Wrap"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <Button x:Name="BackButton" Grid.Column="2" Style="{StaticResource WindowSecondaryButton}" MinWidth="112" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource WindowPrimaryButton}" MinWidth="140" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
