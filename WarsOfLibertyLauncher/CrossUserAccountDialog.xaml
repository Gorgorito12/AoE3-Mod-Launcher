<controls:BaseDialog x:Class="WarsOfLibertyLauncher.CrossUserAccountDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
                     Width="560"
                     Tone="Caution">
    <StackPanel>
        <!-- The two folders, each under its own caption: they mean different things, so an
             unlabelled stack would be unreadable. Selectable, so they can be copied by hand. -->
        <Border Style="{StaticResource DialogDetailBox}">
            <StackPanel>
                <TextBlock x:Name="CurrentLabel" Style="{StaticResource WindowFieldLabel}"
                           TextWrapping="Wrap"/>
                <TextBox x:Name="CurrentPathText" Style="{StaticResource DialogReadOnlyPath}"
                         Margin="0,5,0,0"/>
                <TextBlock x:Name="OtherLabel" Style="{StaticResource WindowFieldLabel}"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBox x:Name="OtherPathText" Style="{StaticResource DialogReadOnlyPath}"
                         Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="AutoStartText" Style="{StaticResource DialogHint}" Margin="0,12,0,0"/>
        <TextBlock x:Name="HowToText" Style="{StaticResource DialogHint}" Margin="0,8,0,0"/>
    </StackPanel>
</controls:BaseDialog>
