<Window x:Class="WarsOfLibertyLauncher.CrossUserAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBase}"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar x:Name="Chrome" Grid.Row="0"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>
    <StackPanel Grid.Row="1" Margin="24,20">

        <!-- Lead: account glyph + which account is running and which one is signed in. -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="&#xE77B;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="{StaticResource FontSizeHeading}"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Top"
                       Margin="0,0,14,0"/>
            <TextBlock Grid.Column="1"
                       x:Name="BodyText"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"/>
        </Grid>

        <!-- The two folders, each under its own caption: unlike the antivirus dialog's pair
             these mean different things, so an unlabelled stack would be unreadable. Consolas
             and selectable so they can be read and hand-copied if the clipboard button fails. -->
        <Border Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource MenuBorder}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}"
                Padding="{StaticResource CardPadding}"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="CurrentLabel"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="{StaticResource FontSizeCaption}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="CurrentPathText"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontFamily="Consolas"
                         FontSize="{StaticResource FontSizeCaption}"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"/>
                <TextBlock x:Name="OtherLabel"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="{StaticResource FontSizeCaption}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,4"/>
                <TextBox x:Name="OtherPathText"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontFamily="Consolas"
                         FontSize="{StaticResource FontSizeCaption}"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="AutoStartText"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="{StaticResource FontSizeCaption}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="HowToText"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="{StaticResource FontSizeCaption}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyButton"
                    Click="CopyButton_Click"
                    Style="{StaticResource SidebarPrimaryButton}"
                    Background="#3a3d44"
                    Padding="18,6"
                    MinWidth="130"
                    Margin="0,0,10,0"/>
            <Button x:Name="CloseButton"
                    Click="CloseButton_Click"
                    IsDefault="True"
                    Style="{StaticResource SidebarPrimaryButton}"
                    Padding="18,6"
                    MinWidth="130"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
