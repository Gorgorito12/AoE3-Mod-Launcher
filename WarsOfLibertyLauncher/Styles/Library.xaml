<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Library (design 68a, docs/design_base_launcher). Every state is on the control's own
         Background/BorderBrush, which the templates TemplateBind, so a derived style can restate it.
         The Mod* brushes are written by Services/ModTheme when the selected mod changes; these
         values are the launcher's blue, for a window that has not selected one yet. -->
    <SolidColorBrush x:Key="ModAccent"      Color="#2F7FE0"/>
    <SolidColorBrush x:Key="ModAccentText"  Color="#7DB2F0"/>
    <SolidColorBrush x:Key="ModOnAccent"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ModAccentFill"  Color="#21508A"/>
    <SolidColorBrush x:Key="ModAccentSoft"  Color="#292F7FE0"/>
    <SolidColorBrush x:Key="ModAccentLine"  Color="#8C2F7FE0"/>
    <SolidColorBrush x:Key="ModAccentRing"  Color="#992F7FE0"/>
    <SolidColorBrush x:Key="ModAccentGlow"  Color="#592F7FE0"/>
    <SolidColorBrush x:Key="ModAccentThumb" Color="#802F7FE0"/>
    <Color x:Key="ModAccentGlowColor">#2F7FE0</Color>
    <RadialGradientBrush x:Key="ModAccentWash" Center="1,0" GradientOrigin="1,0" RadiusX=".7" RadiusY=".7">
        <GradientStop Color="#472F7FE0" Offset="0"/>
        <GradientStop Color="#002F7FE0" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="ModTitleBar"    Color="#6B0B1422"/>

    <!-- The window of everything that is not one mod's (design 72): navy, lit by the action blue. -->
    <RadialGradientBrush x:Key="WindowGlowTop" Center=".92,-.12" GradientOrigin=".92,-.12" RadiusX=".9" RadiusY=".84">
        <GradientStop Color="#2E2F7FE0" Offset="0"/>
        <GradientStop Color="#002F7FE0" Offset=".65"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="WindowGlowBottom" Center="-.1,1.1" GradientOrigin="-.1,1.1" RadiusX=".72" RadiusY=".7">
        <GradientStop Color="#142F7FE0" Offset="0"/>
        <GradientStop Color="#002F7FE0" Offset=".7"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="WindowFooter" Color="#B8080F1B"/>
    <SolidColorBrush x:Key="WindowFooterRule" Color="#14FFFFFF"/>

    <SolidColorBrush x:Key="UiInfoText"     Color="#8CBCF5"/>
    <SolidColorBrush x:Key="LibraryWhite"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LibraryNavBg"   Color="#730A1321"/>   <!-- .45 -->
    <SolidColorBrush x:Key="LibraryControl" Color="#8C0A1321"/>   <!-- .55 -->
    <SolidColorBrush x:Key="LibraryGhost"   Color="#800A1321"/>   <!-- .50 -->
    <SolidColorBrush x:Key="LibraryCard"    Color="#A80A1321"/>   <!-- .66 -->
    <SolidColorBrush x:Key="LibraryTrack"   Color="#1FFFFFFF"/>   <!-- .12 -->
    <SolidColorBrush x:Key="LibraryBarTrack" Color="#1AFFFFFF"/>  <!-- .10 -->
    <SolidColorBrush x:Key="LibraryHover"   Color="#0FFFFFFF"/>   <!-- .06 -->
    <SolidColorBrush x:Key="LibraryMenuHover" Color="#14FFFFFF"/> <!-- .08 -->
    <SolidColorBrush x:Key="LibraryStarOff" Color="#59DCE7F5"/>   <!-- .35 -->
    <SolidColorBrush x:Key="LibraryChipRim" Color="#1FFFFFFF"/>   <!-- .12 -->
    <SolidColorBrush x:Key="LibraryFooterRule" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="LibraryMenuBg"  Color="#F50C1626"/>   <!-- .96 -->
    <SolidColorBrush x:Key="LibraryErrorRing" Color="#73F4900C"/> <!-- .45 -->
    <SolidColorBrush x:Key="LibraryErrorSoft" Color="#2EF4900C"/> <!-- .18 -->
    <SolidColorBrush x:Key="LibraryVersionText" Color="#C2F2C9"/>

    <Style x:Key="LibraryRow" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LibraryHover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LibraryRowSelected" TargetType="Button" BasedOn="{StaticResource LibraryRow}">
        <Setter Property="Background" Value="{DynamicResource ModAccentFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModAccentRing}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ModAccentFill}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LibraryStar" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource LibraryStarOff}"/>
        <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource UiFavorite}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LibraryStarOn" TargetType="Button" BasedOn="{StaticResource LibraryStar}">
        <Setter Property="Foreground" Value="{DynamicResource UiFavorite}"/>
    </Style>

    <!-- 34 high, radius 8: the sort and refresh. -->
    <!-- The picture viewer's round buttons (68a): close 40 px on white .08, arrows 48 px on .1.
         Glyphs, so their sizes are geometry and do not follow the text size. -->
    <Style x:Key="LibraryViewerButton" TargetType="Button">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse Fill="{TemplateBinding Background}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="0,0,0,3"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#33FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LibraryBarButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{DynamicResource LibraryControl}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GlassRimStrong}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LibraryPublishButton" TargetType="Button" BasedOn="{StaticResource LibraryBarButton}">
        <Setter Property="Background" Value="{DynamicResource MpAction}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MpAction}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,0"/>
    </Style>

    <Style x:Key="LibrarySmallButton" TargetType="Button" BasedOn="{StaticResource LibraryBarButton}">
        <Setter Property="Background" Value="{DynamicResource LibraryHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource UiSoftText}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- A filter: 30 high, radius 15. The selected one takes the mod's colour. -->
    <Style x:Key="LibraryPill" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,2,12,2"/>
        <Setter Property="Background" Value="{DynamicResource LibraryGhost}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource UiSoftText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GlassRimStrong}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LibraryPillOn" TargetType="Button" BasedOn="{StaticResource LibraryPill}">
        <Setter Property="Background" Value="{DynamicResource ModAccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModAccentLine}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModAccentText}"/>
    </Style>

    <!-- A community link: the same pill, without the margin of a filter. -->
    <Style x:Key="LibraryLinkPill" TargetType="Button" BasedOn="{StaticResource LibraryPill}">
        <Setter Property="Margin" Value="0,0,8,6"/>
        <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LibraryChipRim}"/>
    </Style>

    <!-- The one primary button of the view: 52 high, radius 10, in the mod's colour. Its glow is a
         sibling inside the template, never an Effect on the face: that would blur the caption. -->
    <Style x:Key="LibraryPrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="30,0"/>
        <Setter Property="Background" Value="{DynamicResource ModAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModOnAccent}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Halo"
                                CornerRadius="10"
                                Background="{DynamicResource ModAccentGlow}"
                                Margin="2,10,2,-10"
                                IsHitTestVisible="False">
                            <Border.Effect>
                                <BlurEffect Radius="24" RenderingBias="Performance"/>
                            </Border.Effect>
                            <Border.CacheMode>
                                <BitmapCache/>
                            </Border.CacheMode>
                        </Border>
                        <Border x:Name="Face"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Veil" Background="#FFFFFF" CornerRadius="10" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value=".08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0"/>
                            <Setter TargetName="Face" Property="Opacity" Value=".86"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Halo" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Face" Property="Opacity" Value=".5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 52 high, glass: Copia, Ajustes, Jugar sin actualizar, Ya lo tengo. -->
    <Style x:Key="LibraryGlassButton" TargetType="Button">
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Background" Value="{DynamicResource LibraryGhost}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRimStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#52FFFFFF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 32 high, radius 7: Pausar, Cancelar, Reintentar, the foot of a menu. -->
    <Style x:Key="LibraryCardButton" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="{DynamicResource LibraryHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRimStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#52FFFFFF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LibraryCardDanger" TargetType="Button" BasedOn="{StaticResource LibraryCardButton}">
        <Setter Property="Foreground" Value="#E8A0A0"/>
    </Style>

    <Style x:Key="LibraryCardPrimary" TargetType="Button" BasedOn="{StaticResource LibraryCardButton}">
        <Setter Property="Background" Value="{DynamicResource ModAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource ModOnAccent}"/>
    </Style>

    <Style x:Key="LibraryTextLink" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource ModAccentText}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LibraryThumb" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 8 px in the cover, 4 in a row of the list, 3 in the pill; the height is the caller's. -->
    <Style x:Key="LibraryProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{DynamicResource ModAccent}"/>
        <Setter Property="Background" Value="{DynamicResource LibraryBarTrack}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="4" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The download in the tabs row: 34 high, radius 17. -->
    <Style x:Key="LibraryDownloadPill" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{DynamicResource LibraryCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ModAccentLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="17"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Right click on a mod. There is no implicit menu style in the launcher, so a bare
         ContextMenu is a white OS menu: these styles are the whole of its look. -->
    <Style x:Key="LibraryMenu" TargetType="ContextMenu">
        <Setter Property="Width" Value="250"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource LibraryMenuBg}"
                            BorderBrush="#1FFFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="6">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LibraryMenuHeader" TargetType="MenuItem">
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <TextBlock Text="{TemplateBinding Header}"
                               Margin="10,6,10,4"
                               FontSize="{DynamicResource SetGroupLabelSize}"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource UiTextFaint}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LibraryMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Height="32" CornerRadius="7" Padding="10,0" Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Header}"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource DialogBodySize}"
                                       LineHeight="18.2"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="{DynamicResource SetDescSize}"
                                       Foreground="{DynamicResource WindowFineText}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value=".45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource LibraryMenuHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LibraryMenuSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4" Background="{DynamicResource WindowFooterRule}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GLOBAL DIALOGS (docs/design_base_launcher_2): the parts they all share.
         ============================================================ -->
    <SolidColorBrush x:Key="WindowMuted"      Color="#A8BCD2"/>
    <SolidColorBrush x:Key="WindowIncremental" Color="#9FD0F5"/>
    <SolidColorBrush x:Key="WindowCumulative" Color="#CDB6F5"/>
    <SolidColorBrush x:Key="WindowSoftText"   Color="#C3D2E5"/>
    <SolidColorBrush x:Key="WindowStrongText" Color="#F0F5FB"/>
    <SolidColorBrush x:Key="WindowCardRim"    Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="WindowDangerRim"  Color="#99C84A4A"/>
    <SolidColorBrush x:Key="WindowSafeFill"   Color="#1A4FD68A"/>
    <SolidColorBrush x:Key="WindowSafeTick"   Color="#4FD68A"/>
    <SolidColorBrush x:Key="WindowTickFill"   Color="#294FD68A"/>
    <SolidColorBrush x:Key="WindowFineText"   Color="#8C9CB1"/>
    <SolidColorBrush x:Key="WindowFieldRim"   Color="#3382AFFF"/>
    <SolidColorBrush x:Key="WindowCopied"     Color="#7FE0A8"/>
    <SolidColorBrush x:Key="WindowSecondary"  Color="#1A2C48"/>
    <SolidColorBrush x:Key="WindowSecondaryHover" Color="#213758"/>
    <SolidColorBrush x:Key="WindowSecondaryRim" Color="#3882AFFF"/>
    <SolidColorBrush x:Key="WindowPrimaryHover" Color="#4A93EC"/>
    <SolidColorBrush x:Key="WindowPrimaryText" Color="#FFFFFF"/>
    <Color x:Key="WindowPrimaryHalo">#2F7FE0</Color>
    <SolidColorBrush x:Key="WindowPlaceholder" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="WindowPlaceholderFaint" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="WindowNoticeFill"  Color="#1AF4900C"/>
    <SolidColorBrush x:Key="WindowNoticeRim"   Color="#73F4900C"/>
    <SolidColorBrush x:Key="WindowNoticeDot"   Color="#F4900C"/>
    <SolidColorBrush x:Key="WindowNoticeTitle" Color="#F5BD76"/>
    <SolidColorBrush x:Key="WindowNoticeBody"  Color="#DCC39A"/>
    <SolidColorBrush x:Key="WindowSpinnerTrack" Color="#4082AFFF"/>
    <SolidColorBrush x:Key="WindowSpinnerArc"  Color="#55ACEE"/>

    <Style x:Key="WindowHeadline" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource DialogHeadlineSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="WindowBody" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource DialogBodySize}"/>
        <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="WindowNotice" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WindowNoticeFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WindowNoticeRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="11,8"/>
    </Style>

