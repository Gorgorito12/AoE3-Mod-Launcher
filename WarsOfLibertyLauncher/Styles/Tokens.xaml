<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         GEOMETRY SCALE — semantic spacing / radius / icon-disc /
         button-padding tokens. Same idea + rules as the FontSize scale
         in App.xaml: one knob per role, StaticResource (app-lifetime
         constants), consumed by Buttons.xaml / Inputs.xaml and every
         Controls/*.xaml. New UI binds to a token; it must not hardcode
         a literal size.

         WHY A SEPARATE DICTIONARY MERGED FIRST (not inline in App.xaml):
         a `{StaticResource}` used INSIDE a ControlTemplate body in a
         merged dictionary (Buttons/Inputs) can only resolve resources in
         dictionaries merged BEFORE it — NOT App.xaml's inline resources
         (those are added after the MergedDictionaries block, so a
         template-body lookup never sees them and throws "resource not
         found" at load). The FontSize tokens get away with living inline
         because they're only referenced from Setters (deferred) + direct
         element attributes, never from a merged-dictionary template body.
         These geometry tokens ARE referenced from template bodies (button
         + input corner radii), so they must live here and be merged ahead
         of Buttons.xaml / Inputs.xaml. (Same reason Colors.xaml is merged
         first — its brushes resolve inside those templates too.)

         The window-size scaler (Controls/UiScale.cs) scales the RENDER via
         a transform, not these token VALUES, so StaticResource stays
         correct. Load-bearing exemptions that deliberately stay literal:
         the two-tone popup-rim radii (kept here as a paired set, outer =
         inner + 1, NOT folded into the Radius scale), the gold brand-popup
         rim, the hero subtree, Segoe MDL2 glyph / monogram sizes, and the
         intentional fixed widths (chat 380, lobby left 340, hero icon 64).
         See CLAUDE.md before changing any of those.
         ============================================================ -->

    <!-- Spacing (Thickness). 4px base grid. CardPadding is the dominant
         existing card padding (kept at 14,12 to avoid drift);
         SectionPadding is the header gutter. -->
    <Thickness x:Key="SpaceXs">4</Thickness>
    <Thickness x:Key="SpaceSm">8</Thickness>
    <Thickness x:Key="SpaceMd">12</Thickness>
    <Thickness x:Key="SpaceLg">16</Thickness>
    <Thickness x:Key="SpaceXl">24</Thickness>
    <Thickness x:Key="CardPadding">14,12</Thickness>
    <Thickness x:Key="SectionPadding">24,16</Thickness>

    <!-- Corner radius (CornerRadius). Sm = buttons/inputs/badges,
         Md = cards/panels/info boxes, Lg = prominent tiles. -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <!-- Extension of the scale for the multiplayer redesign (design handoff
         1a/1d/1e/1f). Its radius ladder is finer than Sm/Md/Lg: controls and
         fields at 7, rows and boxes at 8, panels at 9, and a full pill for
         chips. Named by ROLE rather than by size so a later retune moves every
         control together instead of hunting literals. -->
    <CornerRadius x:Key="RadiusControl">7</CornerRadius>
    <CornerRadius x:Key="RadiusRow">8</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">9</CornerRadius>
    <!-- Pill = HALF the control's height, NOT a huge number. The handoff writes
         `border-radius: 999px`, which is a CSS idiom: browsers clamp it to 50%. WPF
         does NOT clamp — it builds the geometry from the value as given, the corner
         arcs overlap, and the Border renders as a distorted ellipse that swallows its
         own content. This value therefore only fits a 26px-high control (the
         connection chip); a pill of another height needs its own half-height radius. -->
    <CornerRadius x:Key="RadiusPill">13</CornerRadius>

    <!-- Two-tone "punched-out" popup rim — NOT part of the scale. Outer
         MUST stay inner+1 (the 1px near-black band over the 2px bright
         inner line). See the popup-rim gotcha in CLAUDE.md. -->
    <CornerRadius x:Key="RadiusPopupInner">6</CornerRadius>
    <CornerRadius x:Key="RadiusPopupOuter">7</CornerRadius>
    <CornerRadius x:Key="RadiusPopupSubmenuInner">4</CornerRadius>
    <CornerRadius x:Key="RadiusPopupSubmenuOuter">5</CornerRadius>

    <!-- Icon-disc sizes (sys:Double for Width/Height) + paired radii
         (CornerRadius = size/2). Use the IconDisc* Border styles in
         Buttons.xaml so the radius can't drift from the size. Only for
         CIRCULAR discs — rounded squares (the 64px hero icon host) use a
         Radius* token instead. -->
    <sys:Double x:Key="DiscSizeSm">24</sys:Double>
    <sys:Double x:Key="DiscSizeMd">36</sys:Double>
    <sys:Double x:Key="DiscSizeXxl">72</sys:Double>
    <CornerRadius x:Key="DiscRadiusSm">12</CornerRadius>
    <CornerRadius x:Key="DiscRadiusMd">18</CornerRadius>
    <CornerRadius x:Key="DiscRadiusXxl">36</CornerRadius>

    <!-- Button padding (Thickness). The default family normalises the old
         7/8/9 vertical values to 8. -->
    <Thickness x:Key="BtnPadCompact">10,5</Thickness>
    <Thickness x:Key="BtnPadDefault">14,8</Thickness>
    <Thickness x:Key="BtnPadRow">14,10</Thickness>
    <Thickness x:Key="BtnPadRoomy">18,8</Thickness>
    <Thickness x:Key="BtnPadCta">14,14</Thickness>

    <!-- ============================================================
         TITLE BAR — the SINGLE source of truth for the global custom
         window chrome bar (Controls/TitleBar). Every window's title bar
         height, its WindowChrome CaptionHeight (set centrally in
         App.OnAnyWindowLoaded), and the min/max/close button geometry all
         read these. Don't hardcode a bar height or button size anywhere
         else — change it here once and every window follows.
         ============================================================ -->
    <!-- Bar height for SECONDARY windows (every dialog / popup / lobby / settings
         sheet). Slim 28px caption — the title now shrinks to fit the bar, NOT the
         other way around (the old "bar grows to hold a 24px title" rule is gone;
         see TitleBarTitleSize). 28 is DPI-clean: 28×1.25=35, 28×1.5=42 (whole
         pixels, no sub-pixel blur). Single global knob for the secondaries — every
         such window's bar follows it; never hardcode a height per window. The MAIN
         launcher header is the deliberate EXCEPTION and reads TitleBarHeightMain
         below. WindowChrome.CaptionHeight is matched per-window in
         App.ApplyWindowChrome (this token for secondaries, TitleBarHeightMain for
         MainWindow) so the whole bar stays the native drag/double-click region. -->
    <sys:Double x:Key="TitleBarHeight">28</sys:Double>
    <!-- Main launcher header height — the ONLY window off the slim secondary bar.
         MainWindow opts into this explicitly (Height + its CaptionHeight both read it)
         so the compact secondary bar never shrinks the main header.

         36 (was 46): the tabs moved back OUT of the bar into their own nav row
         (MainNavHeight below), leaving the title bar with just the brand, the version
         chip and the three chrome affordances beside the caption buttons.

         THIS TOKEN IS THE ONLY PLACE THAT HEIGHT MAY BE SET, and with two chrome rows
         it is load-bearing in a second way: App.ApplyWindowChrome reads it to set
         WindowChrome.CaptionHeight, and the caption region is *defined* as "the top N
         DIPs" — WindowChrome only consults IsHitTestVisibleInChrome inside it. Leave
         this at 46 while the bar renders at 36 and the top 10px of the NAV row stays
         caption: every tab would drag the window instead of switching tabs along its
         upper edge. No compile error, nothing visible to hint at it.

         36 is DPI-clean where 46 was not: ×1.25 = 45, ×1.5 = 54, whole pixels both. -->
    <sys:Double x:Key="TitleBarHeightMain">36</sys:Double>
    <!-- Nav row height — the strip under the title bar carrying the three main tabs and
         the player's status. MainWindow only; it is a plain content row, NOT part of the
         caption region, which is exactly why it gets its own knob instead of extending
         TitleBarHeightMain: growing that token would hand the nav row's top edge to the
         window-drag handler (see above).

         54 is the reference's value and is not DPI-clean at 125% (×1.25 = 67.5). The
         global UseLayoutRounding absorbs it, but the half pixel lands on the row's
         BOTTOM edge — where the 1px rule and the active tab's 2px underline sit — so 56
         (70 / 84) is the nearest clean value if either ever looks fuzzy on a real 125%
         display. -->
    <sys:Double x:Key="MainNavHeight">54</sys:Double>
    <!-- Caption-button footprint. Width 40 (down from the classic 46) to match the
         slimmer bar; height fills the bar so they read as one strip. 40 is DPI-clean
         (×1.25=50, ×1.5=60). The main header overrides back to 46 locally. -->
    <sys:Double x:Key="TitleBarButtonWidth">40</sys:Double>
    <!-- Segoe MDL2 glyph size for the min/max/restore/close icons — 8 to stay
         proportionate to the 28px bar (main header overrides back to 10). -->
    <sys:Double x:Key="TitleBarGlyphSize">8</sys:Double>
    <!-- Title text size — sized to sit centred in the 28px bar without clipping
         (gold DisplayFont). 16 (down from 24): the bar is the fixed dimension now
         and the title fits IT, the inverse of the old rule. Its OWN knob, still
         independent of TitleBarHeight. -->
    <sys:Double x:Key="TitleBarTitleSize">16</sys:Double>
    <!-- Left gutter before the icon/title; right side is flush with the
         buttons. -->
    <Thickness x:Key="TitleBarContentPadding">12,0,8,0</Thickness>

    <!-- MainWindow header geometry (the two-row reference). Side gutter of the nav
         row; the version chip beside the wordmark; the connection capsule's radius.

         The two radii are tokens rather than literals for the reason the house rule
         gives: a pill in WPF needs an EXPLICIT half-height radius, because CSS's
         `border-radius: 999px` is a clamped-to-50% idiom that WPF renders as a
         distorted ellipse. RadiusPill (13) belongs to the 26px chips elsewhere and is
         wrong for a 30px capsule. -->
    <Thickness x:Key="MainNavPadding">20,0</Thickness>
    <sys:Double x:Key="ChromeVersionSize">11</sys:Double>
    <CornerRadius x:Key="ChromeVersionRadius">3</CornerRadius>
    <sys:Double x:Key="ChromeCapsuleHeight">30</sys:Double>
    <CornerRadius x:Key="ChromeCapsuleRadius">15</CornerRadius>

    <!-- ============================================================
         SIDEBAR NAV RAIL — the settings/properties dialogs' left tab rail
         (SidebarNavButton). The rail column is `Width="Auto"` clamped to this
         [min,max] so it sizes to the WIDEST nav item (icon + text + padding +
         active stripe) instead of a hardcoded 200px that clipped long labels
         like "CATÁLOGO DE MODS". Min keeps the prior visual footprint; max
         stops a freakishly long label from eating the content area (the label
         then ellipsises via SidebarNavLabel). Single source — both dialogs
         read these, no per-dialog literal.
         ============================================================ -->
    <sys:Double x:Key="SidebarRailMinWidth">200</sys:Double>
    <sys:Double x:Key="SidebarRailMaxWidth">340</sys:Double>
    <!-- Nav-item text size (SidebarNavLabel). Its OWN knob, independent of the
         normal body text (FontSizeBody) and of the rail width: the rail grows
         to fit this, the text is never shrunk to fit the rail. 16 = the size
         the SidebarNavButton style was already designed around. -->
    <sys:Double x:Key="SidebarNavTextSize">16</sys:Double>

    <!-- MainWindow top-tab text size (NavTabButton: LIBRARY/WORKSHOP/
         MULTIPLAYER). Its OWN knob, independent of the title and the dialog-rail
         nav.

         13, the new header reference's value. It was briefly MpLabelSize (11.5) while
         the tabs lived INSIDE the title bar, where they had to fit a 46px strip beside
         everything else. Back in a row of their own they fit the type scale's
         documented floor again — so this is one deviation that closed itself. -->
    <sys:Double x:Key="NavTabTextSize">13</sys:Double>

    <!-- ============================================================
         MULTIPLAYER REDESIGN GEOMETRY (design handoff 1a/1d/1e/1f —
         docs/design_handoff_multiplayer_ui/README.md, "Alturas").

         The main title bar's own height is NOT here: it stays
         TitleBarHeightMain above, because WindowChrome.CaptionHeight is
         derived from that same token in App.ApplyWindowChrome. Giving the
         bar a second height knob is precisely how the visual bar and the
         native drag region drift apart — and that failure is silent: no
         compile error, no visual clue, the bottom strip of the bar just
         stops dragging the window.
         ============================================================ -->
    <!-- The multiplayer sub-tab strip (Salas / Amigos / Perfil / Historial). -->
    <sys:Double x:Key="MpSubBarHeight">48</sys:Double>
    <!-- Room row. A MINIMUM now, not a fixed height — MpRoomCard binds it to MinHeight.
         It was uniform by contract ("the row is ONE line with ellipsis, so its height must
         not depend on the content"), and that reading survived until the type sizes went to
         the 13 floor: the room NAME then truncated to "Sala de W…" in a narrow window,
         because it is the only element in that cell that yields. The name may now wrap to a
         second line, so short rows still measure exactly this and long ones grow past it.
         Raised 58 -> 64 with the type sizes; the value is unchanged by the wrap. -->
    <sys:Double x:Key="MpRoomRowHeight">64</sys:Double>
    <!-- Controls. Field = search / chat composer; FieldTall = a dialog's main
         text input; Control = a normal button; PrimaryButton = the one CTA. -->

    <!-- ===================================================================
         MULTIPLAYER TYPE SIZES — raised to the launcher's 13 floor.

         THE HISTORY MATTERS, because this reverses a decision recorded here twice.
         These sizes came from the design handoff (11.5 labels, 10.5 pills, 9.5 section
         captions) and sat BELOW the type scale's documented floor of 13 — a floor that
         exists because 10-11 px secondary text was reported unreadable at 125/150%
         scaling. Raising them was proposed and DECLINED TWICE on the maintainer's
         explicit call for fidelity to the reference, and that is what the previous
         version of this comment said.

         It was asked for a third time, from the other direction: "still looks small",
         about the surface as it shipped. Two things had already been tried and were not
         enough — the bottom three rungs of the text ramp were re-coloured to clear
         4.5:1 contrast (see .claude/rules/multiplayer.md) precisely so the sizes would
         not have to move, and UiScale's ceiling was raised to magnify the whole surface,
         which was rejected on sight as "gigante" (see CLAUDE.md's UiScale bullet).

         The anchor for landing on 13 is evidence already on screen: the community strip
         was raised to 13 on a separate call and has never drawn a complaint — it is the
         one part of this tab at the floor, and the one part nobody calls small.

         Still their own tokens, for the original reason: reversing this is six numbers,
         and they cannot leak into the app-wide scale.
         =================================================================== -->
    <sys:Double x:Key="MpLabelSize">13</sys:Double>
    <sys:Double x:Key="MpBodySize">13.5</sys:Double>
    <sys:Double x:Key="MpMetaSize">13</sys:Double>
    <sys:Double x:Key="MpPillSize">11.5</sys:Double>
    <sys:Double x:Key="MpMicroSize">11.5</sys:Double>
    <!-- The uppercase stat captions in the room header (was 9.5) and the values under
         them. The caption stays the smallest thing on the surface because it is
         letter-spaced uppercase, which reads a size larger than it measures. -->
    <sys:Double x:Key="MpSectionLabelSize">11</sys:Double>
    <sys:Double x:Key="MpStatValueSize">14</sys:Double>
    <!-- The room name in the lobby header: serif, the one display-type moment in
         this window. -->
    <sys:Double x:Key="MpRoomNameSize">16</sys:Double>
    <!-- The end-of-match card's two display sizes: the verdict, and the new rating in
         monospace beside it. Both are one-of-a-kind moments, which is why they sit above
         the rest of the multiplayer scale rather than inside it. -->
    <sys:Double x:Key="MpResultTitleSize">17</sys:Double>
    <sys:Double x:Key="MpRatingSize">22</sys:Double>
    <!-- The community-activity strip, and ONLY it. Its own three sizes because it is the
         first place in the tab to go to the type scale's documented 13 floor, on a call of
         its own — and the one whose size nobody has ever complained about, which is why it
         became the anchor when the REST of the tab was finally raised to 13 too (see the
         block above). Separate tokens so the two decisions stay separable: they were taken
         years apart in argument terms, and reversing either is its own number. -->
    <sys:Double x:Key="MpActivityTitleSize">11.5</sys:Double>
    <sys:Double x:Key="MpActivityBodySize">13</sys:Double>
    <sys:Double x:Key="MpActivityHeadlineSize">16</sys:Double>
    <sys:Double x:Key="MpFieldHeight">34</sys:Double>
    <sys:Double x:Key="MpFieldHeightTall">40</sys:Double>
    <sys:Double x:Key="MpControlHeight">30</sys:Double>
    <sys:Double x:Key="MpPrimaryButtonHeight">42</sys:Double>

</ResourceDictionary>
