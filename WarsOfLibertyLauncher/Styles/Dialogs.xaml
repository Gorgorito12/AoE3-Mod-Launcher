<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The small dialog (design 103). The chassis itself is Controls/BaseDialog. -->

    <SolidColorBrush x:Key="DialogToneInfoFill" Color="#2455ACEE"/>
    <SolidColorBrush x:Key="DialogToneInfoRing" Color="#8055ACEE"/>
    <SolidColorBrush x:Key="DialogToneInfoGlyph" Color="#55ACEE"/>
    <SolidColorBrush x:Key="DialogToneCautionFill" Color="#24F4900C"/>
    <SolidColorBrush x:Key="DialogToneCautionRing" Color="#80F4900C"/>
    <SolidColorBrush x:Key="DialogToneCautionGlyph" Color="#F5BD76"/>
    <SolidColorBrush x:Key="DialogToneDestructiveFill" Color="#29C84A4A"/>
    <SolidColorBrush x:Key="DialogToneDestructiveRing" Color="#8CC84A4A"/>
    <SolidColorBrush x:Key="DialogToneDestructiveGlyph" Color="#F0A6A6"/>
    <SolidColorBrush x:Key="DialogToneDoneFill" Color="#244FD68A"/>
    <SolidColorBrush x:Key="DialogToneDoneRing" Color="#804FD68A"/>
    <SolidColorBrush x:Key="DialogToneDoneGlyph" Color="#4FD68A"/>
    <SolidColorBrush x:Key="DialogPickSelected" Color="#292F7FE0"/>
    <SolidColorBrush x:Key="DialogPickHover" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="DialogPickBox" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="DialogPickBoxRing" Color="#4DFFFFFF"/>

    <Style x:Key="DialogHeadline" TargetType="TextBlock" BasedOn="{StaticResource WindowHeadline}">
        <Setter Property="FontSize" Value="{DynamicResource DialogSubheadSize}"/>
    </Style>

    <Style x:Key="DialogDetailBox" TargetType="Border" BasedOn="{StaticResource WindowField}">
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- A field: the box is the Border, the input inside is bare, so a counter or "Show" can sit
         in the same 36 px. Its ring answers to the focus of what is inside. -->
    <Style x:Key="DialogFieldBox" TargetType="Border">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="11,0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource MpField}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WindowFieldRim}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MpAction}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DialogBareText" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource UiTitleText}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource UiTitleText}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MpAction}"/>
        <Setter Property="FontSize" Value="{DynamicResource SetRowTitleSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                  Focusable="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogBarePassword" TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource UiTitleText}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource UiTitleText}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource MpAction}"/>
        <Setter Property="FontSize" Value="{DynamicResource SetRowTitleSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                  Focusable="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- What sits at the right end of a field: "22/80", in Consolas. -->
    <Style x:Key="DialogFieldAux" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- "Show", inside the field: a word that answers to the pointer. -->
    <!-- 103g: 8 px, on the tone of the launcher or the mod. The app-wide bar is the gold one. -->
    <Style x:Key="DialogProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="PART_Track" CornerRadius="4" Background="#1FFFFFFF">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                Background="{DynamicResource MpAction}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogFieldChip" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource UiTitleText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A path you can select but not edit: it looks like the detail box's text. -->
    <Style x:Key="DialogReadOnlyPath" TargetType="TextBox" BasedOn="{StaticResource DialogBareText}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="FontSize" Value="{DynamicResource SetRowDescSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
    </Style>

    <Style x:Key="DialogHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- A row of a list: 44 px, the whole of it is the checkbox, and one that cannot be chosen
         stays in view, dimmed, with its reason. A locked row is chosen, so it does not dim. -->
    <Style x:Key="DialogPickRow" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="Box" Grid.Column="1" Width="16" Height="16" CornerRadius="4"
                                    Margin="10,0,0,0" VerticalAlignment="Center" BorderThickness="1"
                                    Background="{DynamicResource DialogPickBox}"
                                    BorderBrush="{DynamicResource DialogPickBoxRing}">
                                <TextBlock x:Name="Tick" Text="&#x2713;" Visibility="Hidden" FontSize="11"
                                           FontWeight="Bold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DialogPickHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DialogPickSelected}"/>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource MpAction}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MpAction}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Row" Property="Opacity" Value=".5"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Every menu and popover (design 103n to 103p). The two implicit styles are what make a bare
         ContextMenu ours: without them it is a white Windows menu, on a TextBox as much as here. -->
    <Style TargetType="ContextMenu" BasedOn="{StaticResource LibraryMenu}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="200"/>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource LibraryMenuItem}"/>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
           BasedOn="{StaticResource LibraryMenuSeparator}"/>

    <!-- The two creation dialogs (88, 81): one segment of Controls/SegmentRow. Its colours are
         set by the row, since the selected one takes the colour of the mod being picked. -->
    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="FontSize" Value="{DynamicResource DialogBodySize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Hover" Background="#FFFFFF" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value=".06"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassFieldBox" TargetType="Border" BasedOn="{StaticResource DialogFieldBox}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="GlassPickButton" TargetType="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="8,0,12,0"/>
        <Setter Property="Background" Value="{DynamicResource MpField}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WindowSecondaryRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassSideButton" TargetType="Button" BasedOn="{StaticResource WindowSecondaryButton}">
        <Setter Property="FontSize" Value="{DynamicResource SetRowDescSize}"/>
    </Style>

    <Style x:Key="GlassChip" TargetType="Button">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Background" Value="#0FFFFFFF"/>
        <Setter Property="BorderBrush" Value="#24FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
        <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="13"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1FFFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="#29FFFFFF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="11">
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#FFFFFF"
                                 HorizontalAlignment="Left" Margin="3,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource MpAction}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="GlassRowTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource UiHeadText}"/>
    </Style>

    <Style x:Key="GlassRowBody" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource SetRowDescSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource UiMutedText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="GlassFigure" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="FontSize" Value="{DynamicResource DialogBodySize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource UiHeadText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GlassFigureWord" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{DynamicResource SetRowDescSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The row of a header popover: the same as a menu row, on a Button. -->
    <Style x:Key="MenuRowButton" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LibraryMenuHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MenuRowAux" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="FontSize" Value="{DynamicResource SetDescSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
