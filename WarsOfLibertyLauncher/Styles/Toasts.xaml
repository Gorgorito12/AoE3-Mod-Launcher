<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The floating notices (design 105, docs/design_avisos_flotantes).

        PICTOGRAMS: one open stroke each, in a 20 x 20 box, never filled. Controls/AppToast.cs draws
        them at 20 in the tile (stroke 1.7) and at 11 in a mod icon's badge (stroke 2.8), with round
        caps and joins: the "!" and "i" dots are zero-length segments that only the round cap makes
        visible. An icon is NEVER a character: a glyph is drawn black by Windows' symbol font and
        cannot take the tone (that is what the old "⚔" looked like).
    -->
    <Geometry x:Key="ToastIconSwords">M3.5 3.5l9.5 9.5M10.5 15.5l5-5M13 13l3.5 3.5M16.5 3.5L7 13M4.5 10.5l5 5M7 13l-3.5 3.5</Geometry>
    <Geometry x:Key="ToastIconCheck">M4.5 10.5l3.8 3.8 7.2-8.3</Geometry>
    <Geometry x:Key="ToastIconPlus">M10 4.5v11M4.5 10h11</Geometry>
    <Geometry x:Key="ToastIconStop">M6.5 6.5h7v7h-7z</Geometry>
    <Geometry x:Key="ToastIconClock">M10 3.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 0 0 0-13M10 6.8V10l2.3 1.6</Geometry>
    <Geometry x:Key="ToastIconWarn">M10 4.5v6.5M10 14.6v.4</Geometry>
    <Geometry x:Key="ToastIconInfo">M10 9v6.2M10 5.2v.4</Geometry>
    <Geometry x:Key="ToastIconOffline">M3.2 8.3a10 10 0 0 1 13.6 0M6 11.2a6 6 0 0 1 8 0M10 14.4v.3M4.2 3.6l11.6 13</Geometry>
    <Geometry x:Key="ToastIconUp">M10 16V4.5M5.5 9L10 4.5 14.5 9</Geometry>
    <Geometry x:Key="ToastIconDownload">M10 3.5v8.5M6.3 8.6L10 12.3l3.7-3.7M4.5 16h11</Geometry>
    <!-- The close cross, in a 12 x 12 box. -->
    <Geometry x:Key="ToastCloseGeometry">M2 2l8 8M10 2l-8 8</Geometry>

    <!--
        BUTTONS: 28 high, at least 84 wide, 12 of padding, radius 6, 12/600 (compact: the design
        draws 32 / 96 / 14 / 7 / 12.5). ONE coloured button
        per notice, decided by AppToast.ButtonKinds. State lives in each style's own triggers on
        the control's Background, never on a template part by name, so nothing can stomp it.
    -->
    <Style x:Key="ToastButtonSolid" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{DynamicResource ToastButtonSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource ToastSolidText}"/>
        <Setter Property="Background" Value="{DynamicResource ToastSolidBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ToastSolidRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ToastSolidHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Green: ONLY "Join". The rooms list's join colours, so the same action reads the same. -->
    <Style x:Key="ToastButtonJoin" TargetType="Button" BasedOn="{StaticResource ToastButtonSolid}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{DynamicResource RmJoinBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RmJoinRim}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RmJoinHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Blue: the notice asks you to act (See room, Accept, Open the assistant, Show in folder).
         Its glow is a blurred SIBLING under the face, never an Effect on it: an Effect over the
         caption would cost it ClearType. -->
    <Style x:Key="ToastButtonAction" TargetType="Button" BasedOn="{StaticResource ToastButtonSolid}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{DynamicResource MpAction}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Margin="4,6,4,-2" CornerRadius="6" Background="{DynamicResource ToastActionGlow}" IsHitTestVisible="False">
                            <Border.CacheMode>
                                <BitmapCache/>
                            </Border.CacheMode>
                            <Border.Effect>
                                <BlurEffect Radius="14"/>
                            </Border.Effect>
                        </Border>
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MpBlueHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource MpBluePressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The close button: 22 x 22, radius 6, a drawn cross 7.5 across; white .10 under the pointer. -->
    <Style x:Key="ToastCloseButton" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                        <Path Data="{DynamicResource ToastCloseGeometry}" Width="7.5" Height="7.5" Stretch="Uniform"
                              Stroke="{DynamicResource ToastCloseInk}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ToastCloseHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
