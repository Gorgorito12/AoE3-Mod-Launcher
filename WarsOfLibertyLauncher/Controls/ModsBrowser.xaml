<UserControl x:Class="WarsOfLibertyLauncher.Controls.ModsBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Compact button used for the filter chips. The selected chip
             gets an MpRowHighlight fill via code-behind so we don't
             need a trigger-heavy template for the four-state look.

             BasedOn={x:Type Button} pulls in the implicit Button style
             from Styles/Buttons.xaml — that's where the overlay-scrim
             hover template lives. Without BasedOn, this Style would
             fall back to the Aero default and the chip would paint a
             sky-blue gradient on hover. -->
        <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource MpSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="{DynamicResource WsLabelSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- The bottom 6 is the gap BETWEEN wrapped lines: the strip is a WrapPanel now
                 (see the filters row) and without it two lines would touch. The filters Grid
                 gave up the same 6 from its own bottom margin, so an unwrapped row measures
                 exactly what it always did. -->
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <!-- A community link: text, an arrow, and nothing else. These are external
             DESTINATIONS, not actions of this screen, and four bordered pills gave them
             the same weight as the button that adds the mod. Its own style rather than a
             change to ModLinkPill, which also dresses the support links in half a dozen
             dialogs and must not move. -->
        <Style x:Key="WsCommunityLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MpActionText}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource WsLabelSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Subtab buttons (My mods / Catalog). TERTIARY NEUTRAL recipe —
             same fix as the multiplayer SubTab: without an explicit
             ControlTemplate, WPF Aero default paints a sky-blue gradient
             on hover. Template binding the BorderBrush so the
             selected-state setter in code-behind still works. -->
        <Style x:Key="SubTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextMuted}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="2,6"/>
            <Setter Property="FontSize" Value="{DynamicResource WsBodySize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,22,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource FgHoverNeutral}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MpAppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================
             HEADER — three logical rows:
              1. Title + actions (search, refresh catalog, add local, ...)
              2. Subtabs (Mis mods / Catálogo)
              3. Filters + sort
             ============================================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource MpPanel}"
                BorderBrush="{DynamicResource MpRimSoft}"
                BorderThickness="0,0,0,1"
                Padding="24,16,24,0">
            <StackPanel>

                <!-- Row 1: title + actions. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The sub-tabs sit HERE, on the actions row, rather than owning a
                         row of their own below it. "Workshop" + its subtitle + the
                         sub-tabs + "Available mods (5)" was four heading levels before any
                         content; the handoff keeps two, these and the filters. -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="SubTabMyMods" Style="{StaticResource SubTab}"/>
                        <Button x:Name="SubTabCatalog" Style="{StaticResource SubTab}"/>
                    </StackPanel>

                    <!-- Collapsed, not deleted: kept in the tree so the code-behind that
                         fills these two still runs and their strings stay translated. -->
                    <StackPanel Grid.Column="0" Visibility="Collapsed">
                        <TextBlock x:Name="HeaderTitle"
                                   Foreground="{DynamicResource MpTextBody}"
                                   FontSize="{DynamicResource WsHeadingSize}"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="HeaderSubtitle"
                                   Foreground="{DynamicResource MpTextMuted}"
                                   FontSize="{DynamicResource WsBodySize}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Search. -->
                        <Border Background="{DynamicResource MpField}"
                                BorderBrush="{DynamicResource MpRimSoft}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="10,3"
                                Width="200"
                                Height="32"
                                Margin="0,0,10,0">
                            <Grid>
                                <!-- No italic: the placeholder and the text you type have to
                                     share a metric, or the line reflows the moment you start.
                                     It is the same defect as the padding below, in the font. -->
                                <TextBlock x:Name="SearchPlaceholderText"
                                           Foreground="{DynamicResource MpTextMuted}"
                                           FontSize="{DynamicResource WsBodySize}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <!-- Padding 0, like every other search box in the launcher: the
                                     containing Border already owns the inset (10,3), and the
                                     placeholder beside this has no margin at all. With 8,3 here
                                     the caret started 8px right of the placeholder's first
                                     glyph — the same bug as the chat composer, eight times
                                     larger, and nobody had reported it. -->
                                <TextBox x:Name="SearchBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         Foreground="{DynamicResource MpTextBody}"
                                         CaretBrush="{DynamicResource MpTextBody}"
                                         FontSize="{DynamicResource WsBodySize}"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Button x:Name="RefreshCatalogButton"
                                Background="{DynamicResource MpSurfaceAlt}"
                                Foreground="{DynamicResource MpTextBody}"
                                BorderBrush="{DynamicResource MpRimSoft}"
                                BorderThickness="1"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                FontSize="{DynamicResource WsBodySize}"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Height="36"/>

                        <!-- "Add local mod" used to sit here. Trying a mod.json now lives in
                             Settings → DEVELOPER, behind the developer-mode switch, together
                             with the packager tools — this header is for everyone, and an
                             author-only action was taking space from it. -->

                        <!-- Publish wizard — promoted out of the ⋮ overflow into a
                             first-class accent-outlined header button so modders can
                             find it. Outlined (not filled) keeps it visually distinct
                             from the blue "add to my mods" primary action. -->
                        <Button x:Name="PublishModButton"
                                Background="{DynamicResource MpAction}"
                                Foreground="White"
                                BorderBrush="{DynamicResource MpAction}"
                                BorderThickness="1"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                FontSize="{DynamicResource WsBodySize}"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Height="36"/>

                        <!-- Keeps the APP-wide FontSizeTitle while the rest of the
                             Workshop moved to the compact Ws* scale: this is the height of
                             a three-dot glyph, not a piece of text. -->
                        <Button x:Name="MoreMenuButton"
                                Background="Transparent"
                                Foreground="{DynamicResource MpTextBody}"
                                BorderBrush="{DynamicResource MpRimSoft}"
                                BorderThickness="1"
                                Padding="8,3"
                                FontSize="{DynamicResource FontSizeTitle}"
                                FontWeight="Bold"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Content="⋮">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MoreMenu"/>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Filters + sort. The bottom 6 (was 12) pairs with the 6 the filter
                     chips gained, so the row is unchanged while it fits on one line. -->
                <Grid Margin="0,14,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- A WrapPanel, and it is load-bearing rather than tidiness.

                         This Grid is `* | Auto`: the sort cluster on the right takes its
                         desired width FIRST, and whatever is in the star column is arranged at
                         ITS desired size and then clipped at the column edge — with the
                         cluster painting over the same pixels. Nothing here has TextTrimming
                         and a Button cannot ellipsise its own caption, so as a horizontal
                         StackPanel the chips had no way to give ground: they simply went under
                         the sort box. It is the same failure the rooms toolbar shipped with
                         (see TheRoomsTopBarFitsAtTheNarrowestWindow), in the same shape.

                         It was invisible because the whole Workshop used to sit under a
                         UiScale LayoutTransform that pinned its logical width at ~1100 px for
                         every window from 900 up. With that gone (see ModsBrowser.xaml.cs) the
                         row gets the real width: ~852 px at the 900-px minimum against ~846
                         needed — no slack at all, and none whatsoever once the text-size
                         setting is above 100 %.

                         Wrapping is the honest answer for a filter strip: the chips fall to a
                         second line instead of hiding under something. At normal widths the
                         row is byte-for-byte what it was — a WrapPanel that fits lays out
                         exactly like the StackPanel it replaces. -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Collapsed: five chips that each name what they filter do not
                             need a sixth word saying they are filters. Kept in the tree so
                             the code-behind that fills it still runs. -->
                        <TextBlock x:Name="FiltersLabel"
                                   Visibility="Collapsed"/>
                        <Button x:Name="FilterAll"          Style="{StaticResource FilterChip}"/>
                        <Button x:Name="FilterInstalled"    Style="{StaticResource FilterChip}"/>
                        <Button x:Name="FilterNotInstalled" Style="{StaticResource FilterChip}"/>
                        <Button x:Name="FilterUpdates"      Style="{StaticResource FilterChip}"/>
                        <Button x:Name="FilterCompatible"   Style="{StaticResource FilterChip}"/>
                    </WrapPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- The count rides here rather than sitting above the list as a
                             fourth heading. -->
                        <TextBlock x:Name="ListSummary"
                                   Foreground="{DynamicResource MpTextMuted}"
                                   FontSize="{DynamicResource WsLabelSize}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <TextBlock x:Name="SortLabel"
                                   Foreground="{DynamicResource MpTextMuted}"
                                   FontSize="{DynamicResource WsLabelSize}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ComboBox x:Name="SortBox"
                                  Style="{StaticResource SetCompactCombo}"
                                  Width="160"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================================================
             BODY — two columns:
              Left: scrollable list of compact mod rows.
              Right: persistent detail panel for the selected mod.
             Column widths are star-based so the layout shrinks down
             gracefully on narrow / non-maximised windows.
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58*"/>
                <ColumnDefinition Width="42*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: list. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,14,16,16">
                    <StackPanel>
                        <StackPanel x:Name="RowsPanel"/>
                        <TextBlock x:Name="EmptyText"
                                   Foreground="{DynamicResource MpTextMuted}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,40,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Right: detail panel. Always visible — empty state when no
                 row is selected. -->
            <Border Grid.Column="1"
                    Background="{DynamicResource MpPanel}"
                    BorderBrush="{DynamicResource MpRimSoft}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <!-- Empty state when no mod is selected. -->
                    <StackPanel x:Name="DetailEmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="280">
                        <TextBlock x:Name="DetailEmptyText"
                                   Foreground="{DynamicResource MpTextMuted}"
                                   FontSize="{DynamicResource WsBodySize}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Detail content. -->
                    <Grid x:Name="DetailContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Banner / hero. -->
                        <Border Grid.Row="0"
                                x:Name="DetailBanner"
                                Height="132"
                                CornerRadius="0">
                            <Grid>
                                <Image x:Name="DetailBannerImage"
                                       Stretch="UniformToFill"/>
                                <!-- Monogram overlay shown only when there's
                                     no real banner; otherwise the Image
                                     covers everything. -->
                                <!-- 64 px, radius 12, straddling the bottom edge of the
                                     cover. The 3 px border in the panel colour is the ring
                                     that cuts it out of the artwork: WPF has no inset
                                     box-shadow, and a BorderThickness draws INSIDE a Border,
                                     which is the same thing. -->
                                <Border x:Name="DetailMonogramHero"
                                        Width="64" Height="64"
                                        CornerRadius="12"
                                        BorderBrush="{DynamicResource MpPanel}"
                                        BorderThickness="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,20,-32">
                                    <!-- Geometry, not type: a single letter sized to FILL
                                         the tile behind it. -->
                                    <TextBlock x:Name="DetailMonogram"
                                               FontSize="{DynamicResource FontSizeDisplay}"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Body (scrollable). -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="20,44,20,20">
                            <StackPanel>
                                <!-- Auto|Auto|* — the badge hugs the name instead of
                                     flying to the far right edge of a 900 px panel, and the
                                     star column takes the slack. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailTitle"
                                               Grid.Column="0"
                                               Foreground="{DynamicResource MpTextHeading}"
                                               FontFamily="{DynamicResource DisplayFont}"
                                               FontSize="{DynamicResource WsHeadingSize}"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Border x:Name="DetailStateBadge"
                                            Grid.Column="1"
                                            CornerRadius="3"
                                            Padding="6,2"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailStateBadgeText"
                                                   FontSize="{DynamicResource WsBadgeSize}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <!-- autor · versión, on one line under the name. It used to
                                     be two cells of the metadata grid twenty rows further
                                     down, which is not where you look for it. -->
                                <TextBlock x:Name="DetailIdentityLine"
                                           Foreground="{DynamicResource MpTextMuted}"
                                           FontSize="{DynamicResource WsBodySize}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,12"/>

                                <TextBlock x:Name="DetailDescription"
                                           Foreground="{DynamicResource MpTextBody}"
                                           FontSize="{DynamicResource WsBodySize}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16"/>

                                <!-- Screenshot/GIF gallery: large viewer + a
                                     horizontal strip of clickable thumbnails.
                                     The whole section is hidden by code-behind
                                     when the mod ships no screenshots. -->
                                <StackPanel x:Name="DetailGallerySection"
                                            Margin="0,0,0,16"
                                            Visibility="Collapsed">
                                    <TextBlock x:Name="DetailGalleryTitle"
                                               Foreground="{DynamicResource MpTextMuted}"
                                               FontSize="{DynamicResource WsLabelSize}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource MpPanel}"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            Height="260"
                                            Margin="0,0,0,8">
                                        <Image x:Name="DetailGalleryViewer"
                                               Stretch="Uniform"
                                               Margin="6"/>
                                    </Border>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="DetailGalleryStrip"
                                                    Orientation="Horizontal"/>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- DETAILS, as a table with a fixed label column rather
                                     than two columns of stacked label-over-value pairs. Every
                                     row is built in code-behind so a field with no data is
                                     LEFT OUT instead of printing a dash — the same rule the
                                     gallery already follows. -->
                                <TextBlock x:Name="DetailMetaTitle"
                                           Foreground="{DynamicResource MpTextMuted}"
                                           FontSize="{DynamicResource WsLabelSize}"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,8"/>
                                <Border Background="{DynamicResource MpRowHighlight}"
                                        BorderBrush="{DynamicResource MpRimSoft}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <StackPanel x:Name="DetailMetaTable"/>
                                </Border>

                                <!-- Features list. Hidden when the mod
                                     doesn't expose a features field — for
                                     now this is the description.keys list
                                     repurposed as 'available languages'. -->
                                <TextBlock x:Name="DetailFeaturesTitle"
                                           Foreground="{DynamicResource MpTextMuted}"
                                           FontSize="{DynamicResource WsLabelSize}"
                                           FontWeight="SemiBold"
                                           Margin="0,16,0,6"
                                           Visibility="Collapsed"/>
                                <StackPanel x:Name="DetailFeaturesPanel"/>

                                <!-- Community links (Discord / ModDB / forum /
                                     …) declared by the mod's manifest. Built
                                     in code-behind so the whole block can be
                                     collapsed when a mod declares none — which
                                     is every built-in and every manifest that
                                     predates the field, so the panel is
                                     unchanged in the common case. -->
                                <TextBlock x:Name="DetailLinksTitle"
                                           Foreground="{DynamicResource MpTextMuted}"
                                           FontSize="{DynamicResource WsLabelSize}"
                                           FontWeight="SemiBold"
                                           Margin="0,16,0,6"
                                           Visibility="Collapsed"/>
                                <WrapPanel x:Name="DetailLinksPanel"
                                           Orientation="Horizontal"
                                           Visibility="Collapsed"/>

                                <!-- Compatibility banner. Shown only when a
                                     blocker (incompatible AoE3 version,
                                     missing dependency, …) applies — empty
                                     for now since we don't yet model that
                                     in ModProfile. -->
                                <Border x:Name="DetailCompatBanner"
                                        Background="{DynamicResource StatusIncompatibleBg}"
                                        BorderBrush="{DynamicResource StatusIncompatibleFg}"
                                        BorderThickness="0,0,0,0"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Padding="12,8"
                                        Margin="0,16,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="DetailCompatText"
                                               Foreground="{DynamicResource StatusIncompatibleFg}"
                                               FontSize="{DynamicResource WsLabelSize}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action bar pinned to the bottom. Primary +
                             secondary buttons are rebuilt by code-behind
                             per selection so the labels follow the row
                             status (Install / Update / Play / Repair / …). -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource MpRowHighlight}"
                                BorderBrush="{DynamicResource MpRimSoft}"
                                BorderThickness="0,1,0,0"
                                Padding="20,14">
                            <Grid>
                                <!-- Three columns since the "view mod page" button was
                                     removed: the official website is a pill in the
                                     community-links row now, so every external link
                                     sits in one place. -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DetailPrimaryButton"
                                        Grid.Column="0"
                                        Background="{DynamicResource MpAction}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="0,10"
                                        FontWeight="SemiBold"
                                        FontSize="{DynamicResource WsBodyStrongSize}"
                                        Cursor="Hand"
                                        Margin="0,0,8,0"/>
                                <!-- Removing from the collection lives here, not in
                                     the primary slot: it's the one destructive-looking
                                     action in the panel and shouldn't be the easiest
                                     button to hit. Collapsed unless the mod is in the
                                     collection. -->
                                <Button x:Name="DetailRemoveButton"
                                        Grid.Column="1"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource MpSurfaceAlt}"
                                        Foreground="{DynamicResource MpTextMuted}"
                                        BorderBrush="{DynamicResource MpRimSoft}"
                                        BorderThickness="1"
                                        Padding="12,10"
                                        FontSize="{DynamicResource WsBodySize}"
                                        Cursor="Hand"
                                        Margin="0,0,6,0"/>
                                <!-- App scale, same reason as MoreMenuButton: a glyph,
                                     not a word. -->
                                <Button x:Name="DetailMoreButton"
                                        Grid.Column="2"
                                        Background="Transparent"
                                        Foreground="{DynamicResource MpTextBody}"
                                        BorderBrush="{DynamicResource MpRimSoft}"
                                        BorderThickness="1"
                                        Padding="10,8"
                                        FontSize="{DynamicResource FontSizeTitle}"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Content="⋯">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="DetailMoreMenu"/>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
