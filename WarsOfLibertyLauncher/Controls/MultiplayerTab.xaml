<UserControl x:Class="WarsOfLibertyLauncher.Controls.MultiplayerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WarsOfLibertyLauncher.Controls">
    <UserControl.Resources>
        <!-- ONE margin and ONE gap for the whole tab (Services/Multiplayer/PageSpacing): M on the
             four sides of the content area, G between panels and between the community cards,
             12 below 1600 px of width and 16 from there. These hold the narrow values and are
             REWRITTEN by MultiplayerTab.ApplyPageSpacing when the width crosses the line, so
             every consumer reads them with DynamicResource. Nothing below carries a margin of
             its own that would add to them. -->
        <Thickness x:Key="MpPageGutter">12</Thickness>
        <Thickness x:Key="MpPageGutterSides">12,0,12,0</Thickness>
        <Thickness x:Key="MpPageGutterBanner">12,12,12,0</Thickness>
        <Thickness x:Key="MpPageGutterLeftPane">12,12,0,12</Thickness>
        <Thickness x:Key="MpPageGutterRightPane">0,12,12,12</Thickness>
        <GridLength x:Key="MpPanelGap">12</GridLength>
        <Thickness x:Key="MpPanelGapTop">0,12,0,0</Thickness>
        <!-- The padding inside each panel (Rooms, Community activity, Chat): 16 on all four sides. -->
        <Thickness x:Key="MpPanelPadding">16</Thickness>
        <!-- The gold focus ring belongs to the launcher's other surfaces. Here every
             field sits on navy, and the template's trigger targets its inner Border by
             name, so a field cannot opt out on its own — this is the only lever. -->
        <SolidColorBrush x:Key="TextBoxFocusBrush" Color="#2F7FE0"/>

        <!-- Subtab buttons (Rooms / Friends / Profile / History).
             TERTIARY BLUE recipe â€” dim gray when inactive, soft sky
             (FgHoverBlue) on hover, white + bold + blue underline
             when active (active state still set programmatically by
             UpdateSubtabHighlights via BorderBrush/Foreground).

             ControlTemplate is REQUIRED â€” without it WPF falls back
             to the Aero default which paints a sky-blue gradient
             on hover (the "muy blancos" bug). TemplateBinding the
             BorderBrush + BorderThickness so the code-behind active-
             state setters still work without re-templating. -->
        <!-- Sub-tab (design handoff 1a). A filled pill, not the old underline: the
             underline read as a second tab row stacked under the main one, and the
             reference distinguishes the two levels by shape instead. Idle is Medium
             weight and lifts to SemiBold + white when active. -->
        <!-- One option of the Profile's badge selector (docs/design_insignia_equipos, 51c): a
             32-px segment in a dark tray, the active one filled. Every state is a trigger on the
             STYLE, on Background/Foreground, which the template binds - never a TargetName setter,
             or a derived style could not override it. Disabled is a COLOUR, never an Opacity
             layer: Teams stays readable while it is locked, and its tooltip says why. -->
        <Style x:Key="MpBadgeSegment" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpNavTabIdle}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="{DynamicResource MpBodySize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MpTextPrimary}"/>
                </Trigger>
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Background" Value="{DynamicResource MpSegmentActiveBg}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpPillIdleText}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- 10, not 12. Four px a side is 8 px per tab, and this row had none to spare:
                 the toolbar beside it grew by the room-code field and there is no ellipsis on
                 either group, so the loser was CLASIFICACION getting painted over. Two tabs
                 have left since, so the row has slack again — that is not a reason to give
                 the padding back, and this style now dresses the profile window's pills too. -->
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E6EEF8"/>
                            </Trigger>
                            <!-- Active pill. UpdateSubtabHighlights sets Tag; it used to
                                 paint the underline via BorderBrush, so that code moved
                                 to the Tag as part of this change. -->
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource MpPillActiveBg}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The civilization strip over the community deck. Geometry is the prototype's:
             32 tall, 12 of side padding, radius 8, and the gap between pills carried as a
             margin so a WrapPanel can fold the row instead of growing past the page.

             The SELECTED pill drops its rim rather than thickening it - a pill that changed
             thickness would shift its own flag by a pixel the moment you chose it, the same
             rule the cards under it follow.

             Every state lives in this Style's OWN triggers, on properties the template
             TemplateBinds, and never in a TargetName setter - or MpCivPillMore below could
             not override any of them. That is the precedence trap Buttons.xaml documents,
             which left the gold and red hovers dead in fifteen dialogs. -->
        <Style x:Key="MpCivPill" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource MpPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextBody}"/>
            <Setter Property="FontSize" Value="{DynamicResource MpMetaSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <!-- Left, not Center: the flag leads the label and a centred
                                 presenter would float the pair inside a pill that is already
                                 sized to them. -->
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource MpRimMedium}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MpTextHeading}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource MpRimMedium}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MpTextHeading}"/>
                </Trigger>
                <!-- The open civilization. Set from code, like SubTab's, because which one is
                     open is per-render data and not something a trigger can know. -->
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Background" Value="{DynamicResource MpAction}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- "12 more" - the fold. No fill, so it reads as a way OUT of the row rather than as
             a thirteenth civilization sitting in it. -->
        <Style x:Key="MpCivPillMore" TargetType="Button" BasedOn="{StaticResource MpCivPill}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpActionText}"/>
        </Style>

        <!-- Right-aligned status pill (Connected / Reconnecting /
             Offline) shown in the top-right of the header. Pure
             cosmetic â€” UpdateConnectionStatus() fills the labels
             and the dot brush. -->
        <Style x:Key="HeaderStatChip" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="18,0,0,0"/>
        </Style>

        <!-- Room ROW (table row, NOT a floating card). A flush surface with
             a hairline bottom divider and a subtle hover tint — so the list
             reads as a clean table like the reference mockup, not a stack of
             gapped cards. The row body (title, mod chip, host, players, ping,
             status badge, action button) is built in code-behind by
             BuildRoomCard so all the load-bearing state logic (action caption,
             in-place ping, mod-installed gating) is preserved. Left inset =
             Padding.Left 14 + the list panel's 16 margin = 30, matched by the
             header strip's 30px left margin so columns line up under the labels.
             (That 16 is a margin inside RoomsListScroll, whose overlaid bar takes
             no width, so the rows keep the same inset whether it shows or not.) -->
        <!-- Room ROW (design handoff 1a). Separated rounded rows with a rim, not the
             flush table rows with a hairline divider this used to be. The reference
             gives every row the same height because it is one line with ellipsis, and
             that held until the type sizes went up to the 13 floor: the room NAME then
             started truncating to "Sala de W…" in a narrow window, because it is the
             only element in the cell that yields (the chips beside it never shrink, by
             design — see BuildRoomChip). So the name may now wrap to a SECOND line and
             the height is a MINIMUM rather than a fixed value: short names keep exactly
             the row they had, long ones grow. The uniform-block reading is what that
             costs, and it was given up deliberately. Own-room rows are lifted by
             BuildRoomCard, which sets the brighter fill and rim locally — a Style trigger
             can't express "this is mine", since that is per-row data rather than a
             control state. -->
        <!-- The community-activity cards. The design handoff asks for three identical
             boxes (docs/design_handoff_multiplayer_ui, #12213a / radius 8 / padding 12-13),
             and every value it names already exists as a token: MpPanel IS that fill and
             RadiusRow IS that 8. Deliberately NOT BasedOn MpRoomCard, which carries a
             MinHeight and a hover trigger that a static info card has no use for. -->
        <!-- A ghost chip that STATES the scope of a table rather than changing it (the
             Clasificación header's mod and time-window pair). It is a Border and not a
             Button on purpose: /stats/community accepts neither a mod nor a window, so a
             control here would be a filter that filters nothing, and looking like one is
             most of how that lie would be told. -->
        <Style x:Key="MpScopeChip" TargetType="Border">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimMedium}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="MpScopeChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource MpMetaSize}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextMuted}"/>
        </Style>

        <!-- The community block's three cards (design 60a): a step lighter than the block, a
             thin rim, radius 9, 12 top and bottom and 16 at the sides. They FILL their row — its
             height is the layout's decision — and each shows as much as fits inside it. -->
        <Style x:Key="MpActivityCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MpActivityInnerCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimFaint}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <!-- The room list's own scroller (design handoff turns 38-39). The bar is OVERLAID in
             the 8 px the element borrows from the gutter (Margin 0,0,-8,0 on RoomsListScroll),
             so the content keeps the column's full width whether the bar shows or not — which
             is what keeps every row under its column header. A bar that took its own column
             would shift the rows' right edge by its width the moment a ninth room appeared,
             and the headers above it would no longer line up. -->
        <Style x:Key="MpOverlayScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="2" Background="{DynamicResource MpListScrollThumb}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MpOverlayScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Margin="0,0,8,0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource MpOverlayScrollBar}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,2,0"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The chat's fold button and the folded rail's three buttons (design 57a/57c): a small
             square with a thin rim. The state lives in the Style's own trigger, on Background,
             never on a TargetName, so a derived style can still override it. -->
        <Style x:Key="MpRailButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource MpRankMutedText}"/>
            <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource MpRankNameSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MpRowHighlight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MpRoomCard" TargetType="Border">
            <!-- Design 57a: a row in the list's card is one step lighter than the card itself;
                 on the card's own fill it would show only as its rim. -->
            <Setter Property="Background" Value="{DynamicResource MpRoomRowBgInCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimFaint}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}"/>
            <Setter Property="MinHeight" Value="{StaticResource MpRoomRowHeight}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <!-- Vertical padding is what makes the minimum work. With 12,0 the content
                 floated inside a height fixed by decree; a two-line name measures 59,
                 which still fits under the 64 minimum, so the row would not grow and the
                 text would sit flush against both edges. 10 top and bottom leaves the
                 one-line row at exactly 64 and lets the two-line one grow to 79 with the
                 same breathing room it has today. -->
            <Setter Property="Padding" Value="12,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MpRoomRowHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The COMPACT layout's room row (design handoff turns 38-39): 54 instead of 58, the name
             on ONE line. Still a MinHeight rather than a Height, for the reason MpRoomCard gives:
             at 125 % text the content measures more, and a fixed height would clip it in silence.
             Only plain setters, so the base hover trigger is inherited untouched. -->
        <Style x:Key="MpRoomCardCompact" TargetType="Border" BasedOn="{StaticResource MpRoomCard}">
            <Setter Property="MinHeight" Value="{StaticResource MpRoomRowHeightCompact}"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>

        <!-- Quick-reply pill above the chat composer (design handoff 1a). Clicking one
             FILLS the box rather than sending: the three canned lines are openers, and
             one that fired on a single click would be a way to spam the room by
             accident. CornerRadius is half the height — the reference writes
             `border-radius:999px`, which is a CSS idiom WPF renders as a distorted
             ellipse (see RadiusPill). -->
        <Style x:Key="MpQuickReply" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource MpQuickReplyBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource MpActionText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{DynamicResource MpMicroSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable, sortable column header. Transparent button that shows
             the column label + a sort arrow (set in code-behind); brightens on
             hover. Left-aligned so the label sits flush over its column. Zero
             left padding keeps the ROOM label aligned with the 30px row inset. -->
        <Style x:Key="MpColHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- x:Name="TabRootGrid" — host for MpAlertOverlay notice/confirm cards
         (the themed replacement for MessageBox on the join / create / mod
         error paths that fire from the tab, outside a lobby window). -->
    <!-- Flat, not the navy GRADIENT this used to carry (#0E1B2E → #07111F). The
         gradient predates the design handoff and bottomed out darker than the room
         window's own background, so the tab and the room read as two different shades
         of the same idea. The reference is one flat colour across every multiplayer
         surface, which is what makes them look like one screen. -->
    <Grid x:Name="TabRootGrid" Background="{DynamicResource MpAppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- Header (subtabs + status bar) -->
            <RowDefinition Height="*"/>        <!-- Active view -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             Header: subtabs on the left, connection-status pill on
             the right. The status pill replaces the older "chat-line"
             approach where disconnect/reconnect events were dumped
             into the room chat â€” those now live here, where the user
             expects to look for them.
             ============================================================ -->
        <!-- BAR 2 (design handoff 1a). Was a transparent strip carrying the sub-tabs
             plus a right-hand cluster of connection status, player and room counts and
             a NAT badge. All of that restated something shown elsewhere — the
             connection state is now the title-bar chip, and the counts already appear
             in the right-hand panel — so per the reference this bar holds only
             navigation and the two room actions, which came up from the account row
             below it. -->
        <Border Grid.Row="0"
                x:Name="SubBar"
                Height="{StaticResource MpSubBarHeight}"
                Background="{DynamicResource MpPanel}"
                BorderBrush="{DynamicResource MpRimSoft}"
                BorderThickness="0,0,0,1"
                Padding="{DynamicResource MpPageGutterSides}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid>
                        <Button x:Name="SubtabRooms" Click="SubtabRooms_Click" Style="{StaticResource SubTab}"/>
                        <!-- "New room created" dot: shown via SetNewRoomIndicator(true)
                             from MainWindow's poll, cleared when this subtab opens. -->
                        <Ellipse x:Name="RoomsSubtabDot"
                                 Width="7" Height="7"
                                 Fill="#E5484D"
                                 Stroke="{DynamicResource MpPanel}"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,4,4,0"
                                 IsHitTestVisible="False"
                                 Visibility="Collapsed"/>
                    </Grid>
                    <!-- THREE tabs, and the two that left did so for different reasons.
                         PERFIL (with the match history as its last section) moved to
                         ProfileWindow, opened from the account block in the nav bar.
                         AMIGOS was DELETED: its view was five lines holding one
                         hardcoded, unlocalized "Friends — coming soon" — stored
                         double-encoded, so it rendered on screen as "â€”" — with no
                         endpoint, DTO, timer or websocket frame behind it. Relocating
                         it would have moved nothing, and the repo's own rule about
                         «Revancha» applies: a button that looks like a feature and does
                         nothing is worse than its absence. When Friends exists it goes
                         into ProfileWindow as a second section, not back here. -->
                    <!-- TORNEOS. It sits where AMIGOS used to, and unlike AMIGOS it has an
                         endpoint, a DTO, a websocket frame and a bracket behind it — which is
                         the bar the comment above sets for a pill existing at all. -->
                    <Button x:Name="SubtabTournaments" Click="SubtabTournaments_Click" Style="{StaticResource SubTab}"/>
                    <Button x:Name="SubtabRanking" Click="SubtabRanking_Click" Style="{StaticResource SubTab}"/>
                    <Button x:Name="SubtabStats" Click="SubtabStats_Click" Style="{StaticResource SubTab}"/>
                    <!-- No "Your profile" door here. One shipped briefly and was removed at the
                         maintainer's request: the profile opens from the account menu (your
                         name, top right), which is where every other client puts it. -->
                </StackPanel>

                <!-- Room actions, moved up from the account row below (which the
                     reference deletes: the identity went to the title bar).

                     THREE controls, per design handoff turn 36. The room-code field and its
                     send button are gone (a code is pasted into the search, which offers a
                     "Join room XXXXXXXX" row — see RoomCodeQuery), Refresh is an icon, and
                     "Help connecting" moved into the Connected ▾ dropdown in the header,
                     beside the Radmin IP it is about. -->
                <StackPanel Grid.Column="1"
                            x:Name="RoomsToolCluster"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Search. Filters the list ALREADY in hand, so typing costs no
                         request. WPF's TextBox has no placeholder, hence the TextBlock
                         behind it, hidden on the first character. 300 wide, the handoff's
                         value: the placeholder now also says a code can be pasted, and the
                         width the old code field and the Radmin button used is free. -->
                    <Border x:Name="RoomSearchField"
                            Height="32"
                            Width="300"
                            Margin="0,0,10,0"
                            Padding="11,0"
                            CornerRadius="{StaticResource RadiusControl}"
                            Background="{DynamicResource MpField}"
                            BorderBrush="{DynamicResource MpRimField}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="{DynamicResource MpMetaSize}"
                                       Foreground="#7E93AF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"/>
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="RoomSearchPlaceholder"
                                           IsHitTestVisible="False"
                                           Foreground="#6D829D"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="{DynamicResource MpMetaSize}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="RoomSearchBox"
                                         TextChanged="RoomSearchBox_TextChanged"
                                         KeyDown="RoomSearchBox_KeyDown"
                                         MaxLength="64"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         Foreground="{DynamicResource MpTextPrimary}"
                                         CaretBrush="{DynamicResource MpTextPrimary}"
                                         FontFamily="{DynamicResource BodyFont}"
                                         FontSize="{DynamicResource MpMetaSize}"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- FontSize is set LOCALLY on both, and it is a FIX rather than a
                         preference: MpSecondaryButton and MpPrimaryButton set FontSizeBody (14),
                         the app-wide reading size, while everything else in this bar runs on the
                         multiplayer scale. See TheRoomsTopBarFitsAtTheNarrowestWindow.

                         Refresh is an ICON now (handoff turn 36), 32x32, with its caption on the
                         tooltip — the same shape the chat composer's send button already uses.
                         Its content is set in ApplyStrings so the element stays named. -->
                    <Button x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            Style="{StaticResource MpSecondaryButton}"
                            FontSize="{DynamicResource MpBodySize}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,10,0"/>
                    <Button x:Name="CreateRoomButton"
                            Click="CreateRoomButton_Click"
                            Style="{StaticResource MpPrimaryButton}"
                            FontSize="{DynamicResource MpLabelSize}"
                            Height="32"
                            Padding="15,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             ROOMS view: sign-in gate / room list / current-room panel.
             Only one of the three groups is visible at a time, driven
             from code-behind by RefreshFromSession().
             ============================================================ -->
        <Grid Grid.Row="1" x:Name="RoomsView">

            <!-- Browser (signed in, no current lobby). Top toolbar:
                 user chip on the left, Refresh + Create room on the
                 right. Below: table header row, then either the
                 list of rooms or the empty-state illustration. -->
            <Grid x:Name="BrowserPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Radmin banner -->
                    <RowDefinition Height="Auto"/>   <!-- toolbar -->
                    <RowDefinition Height="*"/>      <!-- rooms (left) + global chat (right) -->
                </Grid.RowDefinitions>

                <!-- Radmin VPN banner. Three live states driven by
                     RadminVpnService.GetStatus():
                       * NotInstalled  â†’ red warning + "Install" button
                       * NotConnected  â†’ blue info + "Open Radmin" button
                       * Connected     â†’ green check + network-name copier
                                         + numbered "how to join" instructions
                     Layout: a 3-row Grid. Row 0 is always-on (icon, title
                     line, primary button). Rows 1 & 2 are the network-name
                     panel and the numbered steps, both shown only in the
                     Connected state so they don't waste vertical space when
                     the user can't act on them yet. Colours come from
                     code-behind. Polls every 3 s while mounted. -->
                <Border Grid.Row="0"
                        x:Name="RadminBanner"
                        x:FieldModifier="private"
                        Background="{DynamicResource MpPanel}"
                        BorderBrush="{DynamicResource MpRimSoft}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Margin="{DynamicResource MpPageGutterBanner}"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>    <!-- title + primary button -->
                            <RowDefinition Height="Auto"/>    <!-- network-name copier -->
                            <RowDefinition Height="Auto"/>    <!-- numbered instructions -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status icon. Glyph + colour are set by
                             RefreshRadminBanner() in code-behind. -->
                        <Border Grid.Row="0" Grid.Column="0"
                                x:Name="RadminStatusIcon"
                                Width="{StaticResource DiscSizeSm}" Height="{StaticResource DiscSizeSm}"
                                CornerRadius="{StaticResource DiscRadiusSm}"
                                Background="{DynamicResource MpEventBg}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <TextBlock x:Name="RadminStatusGlyph"
                                       Text="i"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title + body -->
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="RadminBannerTitle"
                                       Foreground="{DynamicResource MpTextPrimary}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="RadminBannerBody"
                                       Foreground="{DynamicResource MpTextMuted}"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Primary actions: [Show steps] opens the
                             guided assistant overlay; [Install /
                             Open Radmin] is the legacy one-click
                             quick action. Stacked horizontally so a
                             power user can hit "Open Radmin" without
                             going through the tutorial. -->
                        <StackPanel Grid.Row="0" Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button x:Name="RadminShowStepsButton"
                                    Click="RadminShowStepsButton_Click"
                                    Style="{StaticResource MpSecondaryButton}"
                                    Padding="12,6"
                                    Margin="0,0,6,0"
                                    FontSize="{DynamicResource FontSizeCaption}"/>
                            <Button x:Name="RadminPrimaryButton"
                                    Click="RadminPrimaryButton_Click"
                                    Style="{StaticResource MpSecondaryButton}"
                                    Padding="12,6"
                                    FontSize="{DynamicResource FontSizeCaption}"/>
                        </StackPanel>

                        <!-- (Rows 1 and 2 of this banner used to carry a network-name
                             copier and a numbered step-by-step guide. Both moved into
                             RadminAssistantWindow in May and were left behind here as
                             markup nothing ever showed: no code path set them Visible,
                             RadminInstructionsText.Text was never assigned at all, and the
                             copy button's handler had become unreachable. Removed rather
                             than left Collapsed — a control nobody can reach reads as a
                             feature that exists, and this one had a comment claiming
                             RefreshRadminBanner filled it.) -->
                    </Grid>
                </Border>


                <!-- Row 2: two-column content — active rooms (left) +
                     persistent global chat (right). The rooms table and
                     the chat panel each live in their own card. -->
                <!-- x:Names on the grid and its gutter because the COMPACT layout (design handoff
                     turn 36, MultiplayerTab.SetCompactLayout) retunes them: 12 of margin and gutter
                     instead of 24/16. The values written here are the WIDE layout's, and the code
                     caches them the first time it switches, so wide is always restored from this
                     file. The side column's width is NOT the compact switch's: it follows the
                     page's width and the fold (ApplyChatWidth, design 57). -->
                <Grid Grid.Row="2" x:Name="RoomsContentGrid" Margin="{DynamicResource MpPageGutter}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition x:Name="RoomsGutterColumn" Width="{DynamicResource MpPanelGap}"/>     <!-- gutter -->
                        <!-- Chat + Players (design 57): a FIXED 280 px below 1600 px of page width
                             and 320 from there, or the 44-px rail when folded — set by
                             ApplyChatWidth from RoomsActivityLayout.ChatWidth. It used to be a
                             share of the width, which made it ~390 px on a laptop and 12 % of a
                             maximised window. The tab caption is "Chat ● N" now, not
                             "Chat global ● N", so two tabs and the fold button fit in 280. -->
                        <ColumnDefinition x:Name="RoomsSideColumn" Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===================== LEFT: active rooms ===================== -->
                    <!-- The room list is a CARD (design 57a, the maintainer's call): the panel's
                         fill and a thin rim, radius 10, holding the title, the column headings
                         and the rows — which are a step lighter than the card. For a while it was
                         bare on the tab background, and with the highlights and the activity bar
                         now cards of their own under it, a bare list read as the odd one out. No
                         glow: an Effect on an ancestor of text kills ClearType. -->
                    <!-- THE LEFT COLUMN IS THREE ROWS — the room list, the community panel and,
                         LAST, the month's highlights (the maintainer's call: 57a draws the strip
                         above the panel, and it read as part of the list) — and the height goes
                         to them BY PRIORITY, which is a rule about heights, not order (design
                         57b; MultiplayerTab.ApplyActivityLayout, rule in
                         Services/Multiplayer/RoomsActivityLayout.Plan):

                           1. the rooms keep at least four rows (all of them when fewer; with none,
                              the list is only as tall as its notice and the spare height goes to
                              the bottom);
                           2. the highlights, a 40-px strip, when they fit;
                           3. the activity: the three 248-px cards when they fit under the list,
                              the 40-px bar when they do not — and when the player has asked for
                              the cards and they do not fit, the cards OVER the bottom of the list
                              (ActivityOverlayHost), with the bar still in its row.

                         Whatever is left goes to the list, which scrolls inside RoomsListScroll.
                         Turn 38a let the panel grow into whatever a short list left over; turn
                         40 took that back, because the rooms have priority.

                         It used to be ONE scrolling page (RoomsPageScroll) with the community
                         block under the rows, and before that three rows dividing a fixed
                         height. Both had the same flaw seen from opposite sides: either the
                         list or the block was the thing that lost. Now neither block is ever
                         hidden, and neither is ever drawn on top of the other — the panel has
                         a row of its own and the list a scroller of its own.

                         Only the ROWS scroll: the section title and the column header stay
                         put above them, and the overlaid scroll bar (MpOverlayScrollViewer)
                         takes no width from the rows, so they stay under their headers. -->
                    <Grid x:Name="RoomsLeftColumn" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="RoomsRow" Height="*"/>
                        <RowDefinition x:Name="ActivityRow" Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="RoomsBlock" Grid.Row="0"
                            Background="{DynamicResource MpPanel}"
                            BorderBrush="{DynamicResource MpRimFaint}"
                            BorderThickness="1"
                            Padding="{DynamicResource MpPanelPadding}"
                            CornerRadius="{StaticResource RadiusLg}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- section title -->
                                <RowDefinition Height="Auto"/>   <!-- table header -->
                                <RowDefinition Height="*"/>      <!-- rows / empty / error -->
                            </Grid.RowDefinitions>

                            <!-- Section title: people glyph + "Salas activas"
                                 on the left, "last updated" timestamp on the
                                 right (set by UpdateRoomsUpdatedLabel). -->
                            <!-- 57a: 12 / 16 / 8 inside the card, the title at 15. -->
                            <Grid Grid.Row="0" x:Name="RoomsSectionHeader" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <!-- No emoji before the title in the reference. -->
                                    <TextBlock x:Name="RoomsSectionTitle"
                                               Foreground="{DynamicResource MpTextHeading}"
                                               FontSize="{DynamicResource FontSizeBodyStrong}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <!-- Count pill. Collapsed at zero: "Active rooms 0"
                                         beside an empty list says the same thing twice. -->
                                    <Border x:Name="RoomsCountPill"
                                            Visibility="Collapsed"
                                            Margin="9,0,0,0"
                                            Padding="7,3"
                                            CornerRadius="10"
                                            Background="#12FFFFFF"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="RoomsCountPillText"
                                                   Foreground="{DynamicResource MpTextSecondary}"
                                                   FontSize="{DynamicResource MpLabelSize}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="RoomsUpdatedText"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MpTextMuted}"
                                           FontSize="{DynamicResource MpLabelSize}"/>
                            </Grid>

                            <!-- Column headers for the room list. The header and the rows
                                 (BuildRoomCard) are NOT kept in sync by hand — they both read
                                 the one list in Services/RoomsTableLayout, applied here by
                                 ApplyRoomColumns. The old "mirror these EXACT column defs"
                                 lockstep rule is gone, and so are the MOD and STATUS columns
                                 it described.

                                 The 23-px side margin matches each row's content inset (the
                                 list's 10 + the row's border 1 + its padding 12) so the columns
                                 line up under the labels. The band is hidden while the list is
                                 empty: 56a's notice sits straight under the title. There is no scrollbar
                                 compensation and there must not be one: this strip sits ABOVE
                                 the rows' scroller (RoomsListScroll), and that scroller's bar
                                 is overlaid in the gutter beside the rows, so the rows never
                                 lose width to it. The old SyncHeaderScrollbarGutter solved the
                                 same problem the other way round, by moving the header; the
                                 overlay makes it unnecessary.

                                 ROOM/PLAYERS/PING are clickable sort buttons (label + arrow,
                                 arrows set by UpdateSortArrows); HOST and ACTION are plain
                                 labels. Widths come from RoomsTableLayout: fixed pixels for
                                 every column except ROOM, which is the reference's `1fr` and
                                 absorbs the slack. -->
                            <Border Grid.Row="1"
                                    x:Name="RoomsHeaderBand"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MpRimFaint}"
                                    BorderThickness="0,0,0,1">
                            <!-- ClipToBounds: a Grid cell does NOT clip, so without this a
                                 header that outgrows its share draws straight over the next
                                 column instead of being cut. Belt and braces behind the
                                 bounded layouts below. -->
                            <Grid x:Name="RoomsHeaderStrip" Margin="13,0,13,8" ClipToBounds="True">
                                <!-- Design-time placeholder ONLY — ApplyRoomColumns rebuilds
                                     these from Services/RoomsTableLayout at the first layout
                                     pass, and re-indexes the labels below with them.

                                     It mirrors RoomsTableLayout.All exactly (Room 1fr, Host
                                     208, Players 88, Ping 66, Action 96) on purpose. It used
                                     to be a stale SEVEN-column set carrying two columns that
                                     no longer exist, and when ApplyRoomColumns took an early
                                     return this placeholder was what shipped: every row drew
                                     ~500px right of its own heading. A placeholder that
                                     matches reality cannot cause that again. -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="208"/>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <!-- Label in the * column, sort arrow in Auto. These used to be
                                     a horizontal StackPanel, which measures its children with
                                     INFINITE width — so the CharacterEllipsis below never fired
                                     and a long label (Spanish JUGADORES, ANFITRIÓN) overflowed
                                     onto the next column instead of being trimmed. -->
                                <Button x:Name="ColButtonRoom" Grid.Column="0" Style="{StaticResource MpColHeaderButton}" Tag="Room" Click="RoomHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="ColHeaderRoom" Foreground="{DynamicResource MpTextLabel}" FontSize="{DynamicResource MpPillSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="SortArrowRoom" Text="⇅" Foreground="{DynamicResource MpTextLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <!-- ANFITRIÓN is a plain label, not a sort button: the reference
                                     keeps ordering on SALA, JUGADORES and PING only, and says the
                                     decorative double arrows on columns nobody sorts go away. A
                                     header that offers an order the list does not need is one more
                                     thing to try before realising it changed nothing. -->
                                <TextBlock Grid.Column="1" x:Name="ColHeaderHost"
                                           Foreground="{DynamicResource MpTextLabel}"
                                           FontSize="{DynamicResource MpPillSize}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Margin="0,0,4,0"/>
                                <Button x:Name="ColButtonPlayers" Grid.Column="2" Style="{StaticResource MpColHeaderButton}" Tag="Players" Click="RoomHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="ColHeaderPlayers" Foreground="{DynamicResource MpTextLabel}" FontSize="{DynamicResource MpPillSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="SortArrowPlayers" Text="⇅" Foreground="{DynamicResource MpTextLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="ColButtonPing" Grid.Column="3" Style="{StaticResource MpColHeaderButton}" Tag="Ping" Click="RoomHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="ColHeaderPing" Foreground="{DynamicResource MpTextLabel}" FontSize="{DynamicResource MpPillSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="SortArrowPing" Text="⇅" Foreground="{DynamicResource MpTextLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <TextBlock Grid.Column="4" x:Name="ColHeaderAction"
                                           Foreground="{DynamicResource MpTextLabel}"
                                           FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            </Border>

                <!-- Cards OR empty-state, inside the list's OWN scroller (design handoff
                     turns 38-39). Only the rows scroll; the title and the column header stay
                     above them. HorizontalScrollBarVisibility=Disabled is LOAD-BEARING: with
                     Auto the rows would be measured at INFINITE width and the table would run
                     off the edge instead of dropping a column. Margin -8 on the right is the
                     gutter the overlaid bar is drawn in (MpOverlayScrollViewer), so the rows
                     keep the column's full width.

                     The 10-px inset of RoomsListPanel is LOAD-BEARING: 10 here plus each row's
                     own 1 + 12 makes the 23 the header strip is inset by, which is what puts the
                     columns under their labels (57a: the rows sit 8 / 10 inside the card).

                     MinHeight keeps the block from reading as a sliver under the header when
                     the list is empty or errored - both of those states are one line. -->
                <ScrollViewer x:Name="RoomsListScroll"
                              Grid.Row="2"
                              Margin="0,0,-8,0"
                              Style="{StaticResource MpOverlayScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="72">
                    <StackPanel x:Name="RoomsListPanel" Margin="0,8,0,0"/>

                    <!-- Error state (design handoff 1a): "una línea ámbar con reintentar",
                         not the red bordered box this used to be. A failed refresh is a
                         transient network hiccup, and the red box read like the room list
                         itself had broken; amber says try again, and now there is something
                         to press that does. -->
                    <StackPanel x:Name="RoomsErrorBox"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="13,14,13,0"
                                Visibility="Collapsed">
                        <TextBlock x:Name="RoomsErrorText"
                                   Foreground="{DynamicResource MpCautionText}"
                                   FontSize="{DynamicResource MpLabelSize}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="RoomsErrorRetry"
                                Style="{StaticResource MpLinkButton}"
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                Click="RoomsErrorRetry_Click"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>

                <!-- Empty state (61b): CENTRED in the rooms card, which always fills the space above
                     the community block now — "No rooms right now", the hour more people play when
                     it is known, and "+ Create room". It used to be 56a's compact notice at the top
                     of a list that shrank to it, which left a huge gap under the block on a big
                     screen. Outside the scroller on purpose: a ScrollViewer measures its content
                     with infinite height, so nothing inside it can be centred. -->
                <StackPanel x:Name="RoomsEmptyState"
                            Grid.Row="1" Grid.RowSpan="2"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="20">
                    <TextBlock x:Name="EmptyTitleText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource MpTextHeading}"
                               FontSize="{DynamicResource MpActivityHeadlineSize}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="EmptyBodyText"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource MpTextMuted}"
                               FontSize="{DynamicResource MpBodySize}"
                               TextWrapping="Wrap"/>
                    <Button x:Name="EmptyCreateButton"
                            Margin="0,14,0,0"
                            Height="34"
                            Padding="16,0"
                            HorizontalAlignment="Center"
                            FontSize="{DynamicResource MpMetaSize}"
                            Style="{StaticResource MpPrimaryButton}"
                            Click="CreateRoomButton_Click"/>
                </StackPanel>

                            <!-- No footer. It read "Showing N rooms" over a 1-px rule and 22 px
                                 of padding, to repeat the count already in the pill beside the
                                 title - and at zero, where the pill hides, the empty state says
                                 it in words. On a short window that band came out of the list,
                                 which is the reason the tab exists. The rule it drew is not
                                 missed either: ActivityStrip carries its own top border. -->
                        </Grid>
                    </Border>


                    <!-- The activity cards laid OVER the bottom of the list (design 57a), used only
                         when the player asked for them and they do not fit under it; ActivityStrip
                         (the cards alone) is moved in here by ApplyActivityLayout and back out
                         after, while the block stays folded in its row. Opaque, so the rows
                         underneath never show through, and the shadow is a SIBLING underlay — an
                         Effect on an ancestor of text would kill ClearType on every glyph. -->
                    <Grid x:Name="ActivityOverlayHost"
                          Grid.Row="0"
                          Panel.ZIndex="10"
                          VerticalAlignment="Bottom"
                          Margin="16,0,16,16"
                          Visibility="Collapsed">
                        <!-- Cached: an empty shadow, so its blur is worked out once rather than on
                             every frame drawn behind it. -->
                        <Border CornerRadius="{StaticResource RadiusLg}"
                                Background="{DynamicResource MpAppBg}">
                            <Border.CacheMode>
                                <BitmapCache/>
                            </Border.CacheMode>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270"
                                                  Opacity="0.55" Color="Black"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ActivityOverlayCard"
                                Padding="{DynamicResource MpPanelPadding}"
                                CornerRadius="{StaticResource RadiusLg}"
                                Background="{DynamicResource MpAppBg}"
                                BorderBrush="{DynamicResource MpRimStrong}"
                                BorderThickness="1"/>
                    </Grid>

                    <!-- COMMUNITY ACTIVITY as ONE block, ANCHORED AT THE BOTTOM of the column (designs
                         60 and 61). The rooms row above is always the star, so this row sits on the
                         column's bottom edge whatever the list holds; its height is
                         ApplyActivityLayout's decision (about a third of the column).

                           header line (61): title · the facts, each «LABEL value» on ONE line ·
                                             "See September" · "Hide ▾" / "Show ▴"
                           the three cards (open only)

                         The facts sit in a FitRowPanel: when they do not fit, whole facts are
                         dropped from the end (Most played first) and the line never wraps. Folded,
                         the block is its header line alone. -->
                    <Grid x:Name="ActivityHost" Grid.Row="1" Margin="{DynamicResource MpPanelGapTop}" Visibility="Collapsed">
                    <Border x:Name="ActivityBlock"
                            Padding="{DynamicResource MpPanelPadding}"
                            CornerRadius="{StaticResource RadiusLg}"
                            Background="{DynamicResource MpPanel}"
                            BorderBrush="{DynamicResource MpRimFaint}"
                            BorderThickness="1">
                        <Grid x:Name="ActivityBlockGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- The header line, 28 px: nothing in it wraps. -->
                            <Grid x:Name="ActivityHeader" Grid.Row="0" Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ActivityStripTitle"
                                           Grid.Column="0"
                                           Margin="0,0,14,0"
                                           Foreground="{DynamicResource MpTextHeading}"
                                           FontSize="{DynamicResource MpActivityHeadlineSize}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <local:FitRowPanel x:Name="ActivityFacts"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Stretch"/>
                                <Button x:Name="ActivityFactsMonthLink"
                                        Grid.Column="2"
                                        Style="{StaticResource MpLinkButton}"
                                        FontSize="{DynamicResource MpMetaSize}"
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Click="ActivityFactsMonthLink_Click"/>
                                <!-- A text link: "Hide ▾" open, "Show ▴" folded (61). -->
                                <Button x:Name="ActivityToggle"
                                        Grid.Column="3"
                                        Style="{StaticResource MpLinkButton}"
                                        FontSize="{DynamicResource MpMetaSize}"
                                        VerticalAlignment="Center"
                                        Click="ActivityToggle_Click"/>
                            </Grid>
                            <!-- The three cards (61: 1 : 2 : 1.3, 10 apart), side by side and in
                                 the handoff's order: peak hours, community matches, ranking. Each
                                 hides itself when its data is missing, and THE COLUMN AND ITS GAP
                                 GO WITH IT (LayOutActivityColumns): a star column keeps its share
                                 whatever its child does. The cards FILL their row and show as much
                                 as fits (FitStackPanel): never a match or a ranking row cut in
                                 half. -->
                            <Border x:Name="ActivityStrip"
                                    Grid.Row="1"
                                    Margin="{DynamicResource MpPanelGapTop}"
                                    Visibility="Collapsed"
                                    Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ActivityColPeak" Width="*"/>
                                    <ColumnDefinition x:Name="ActivityGapLeft" Width="{DynamicResource MpPanelGap}"/>
                                    <ColumnDefinition x:Name="ActivityColRecent" Width="2*"/>
                                    <ColumnDefinition x:Name="ActivityGapRight" Width="{DynamicResource MpPanelGap}"/>
                                    <ColumnDefinition x:Name="ActivityColMiddle" Width="1.3*"/>
                                </Grid.ColumnDefinitions>

                                <!-- PEAK HOURS: title, then the bars taking the card's spare height
                                     (at least 44 px on a laptop, more as the page widens — 61),
                                     their axis, and the sentence that names the window and the
                                     sample it rests on. The gaps follow the page
                                     (ApplyActivityFluid). -->
                                <Border x:Name="ActivityPeakCard"
                                        Grid.Column="0"
                                        Style="{StaticResource MpActivityCard}"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="ActivityPeakTitle"
                                                   Grid.Row="0"
                                                   Foreground="{DynamicResource MpTextLabel}"
                                                   FontSize="{DynamicResource MpMicroSize}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Shown INSTEAD of the bars when the payload could
                                             not be read. Never for a quiet community: too few
                                             rooms hides the whole card, because that is a fact
                                             about the players and not a fault. -->
                                        <TextBlock x:Name="ActivityPeakNotice"
                                                   Grid.Row="1"
                                                   Visibility="Collapsed"
                                                   Margin="0,9,0,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource MpTextGhost}"
                                                   FontSize="{DynamicResource MpMetaSize}"
                                                   TextWrapping="Wrap"/>
                                        <!-- One bar per hour, stretched to the card's width.
                                             Each bar is a two-row cell drawn by DrawPeakBars, so
                                             it scales with this grid's height. -->
                                        <UniformGrid x:Name="ActivityPeakBars"
                                                     Grid.Row="1"
                                                     Rows="1" Columns="24"
                                                     MinHeight="44"/>
                                        <!-- 0h / 12h / 23h. Three labels on one row, never one
                                             per bar: at ~8 px a column a per-bar label clipped
                                             mid-glyph ("0("), which is why the last axis went. -->
                                        <Grid x:Name="ActivityPeakAxis" Grid.Row="2" Margin="0,5,0,0">
                                            <TextBlock x:Name="ActivityPeakAxisStart"
                                                       HorizontalAlignment="Left"
                                                       Foreground="{DynamicResource MpPeakAxisText}"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="{DynamicResource MpSectionLabelSize}"/>
                                            <TextBlock x:Name="ActivityPeakAxisMiddle"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MpPeakAxisText}"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="{DynamicResource MpSectionLabelSize}"/>
                                            <TextBlock x:Name="ActivityPeakAxisEnd"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource MpPeakAxisText}"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       FontSize="{DynamicResource MpSectionLabelSize}"/>
                                        </Grid>
                                        <!-- WRAPS, never trims (turn 40): the hours are the
                                             answer and the ellipsis was eating them. Capped at two
                                             lines by TightenActivityLines. -->
                                        <TextBlock x:Name="ActivityPeakLine"
                                                   Grid.Row="3"
                                                   Margin="0,5,0,0"
                                                   Foreground="{DynamicResource MpTextBody}"
                                                   FontSize="{DynamicResource MpBodySize}"
                                                   TextWrapping="Wrap"/>
                                        <!-- The sample size and the window it covers: the
                                             window travels WITH its figure, or a card that
                                             hardcoded "30 days" starts lying the day that
                                             constant moves. -->
                                        <TextBlock x:Name="ActivityPeakSubtitle"
                                                   Grid.Row="4"
                                                   Margin="0,5,0,0"
                                                   Foreground="{DynamicResource MpTextDim}"
                                                   FontSize="{DynamicResource MpPillSize}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <!-- COMMUNITY MATCHES: ONE line per match (61), as many whole rows as
                                     the card's height holds. -->
                                <Border x:Name="ActivityRecentCard"
                                        Grid.Column="2"
                                        Padding="14,10,14,4"
                                        Style="{StaticResource MpActivityCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ActivityRecentTitle"
                                                       Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MpTextLabel}"
                                                       FontSize="{DynamicResource MpMicroSize}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button x:Name="ActivityRecentSeeAll"
                                                    Grid.Column="1"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource MpLinkButton}"
                                                    FontSize="{DynamicResource MpFigureSize}"
                                                    Click="ActivityRecentSeeAll_Click"/>
                                        </Grid>
                                        <local:FitStackPanel x:Name="ActivityRecentList"
                                                             Grid.Row="1"
                                                             Margin="0,2,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- RANKING: the top five, rows of 26 to 40 px as the page widens
                                     (61), each with a small rank badge and its age banner (47a). -->
                                <Border x:Name="ActivityMiddleCard"
                                        Grid.Column="4"
                                        Style="{StaticResource MpActivityCard}"
                                        Visibility="Collapsed">
                                    <Grid x:Name="ActivityRankingCard"
                                          Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ActivityRankingTitle"
                                                       Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MpTextLabel}"
                                                       FontSize="{DynamicResource MpMicroSize}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button x:Name="ActivityRankingSeeAll"
                                                    Grid.Column="1"
                                                    Style="{StaticResource MpLinkButton}"
                                                    FontSize="{DynamicResource MpFigureSize}"
                                                    Click="ActivityRankingSeeAll_Click"/>
                                        </Grid>
                                        <Grid Grid.Row="1">
                                            <local:FitStackPanel x:Name="ActivityRankingList"
                                                                 Margin="0,6,0,0"
                                                                 Spacing="4"/>
                                            <!-- Shown INSTEAD of the table while nobody
                                                 qualifies: saying what it takes to enter is more
                                                 use than a blank card. -->
                                            <TextBlock x:Name="ActivityRankingEmpty"
                                                       Visibility="Collapsed"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource MpTextDim}"
                                                       FontSize="{DynamicResource MpMetaSize}"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    </Grid>
                    </Grid>
                    <!-- /LEFT card -->

                    <!-- ===================== RIGHT: chat / players, as TABS =====================
                         The two used to be stacked cards splitting this column in half. The
                         reference gives them one card and two tabs, which is what hands the
                         chat the other half's ~300px: a chat you have to scroll three
                         messages at a time is the thing the split was costing. -->
                    <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- FLAT panel: the reference's fill and a thin inner rim, and no
                         glow. The DropShadowEffect underlay it replaces was a two-Border
                         trick — the shadow had to sit on a sibling because an Effect on
                         the content card kills ClearType on every glyph inside it. With
                         the glow gone the trick goes too, and one Border does the job. -->
                    <Border Grid.Row="0"
                            x:Name="ChatPanelCard"
                            Background="{DynamicResource MpPanel}"
                            BorderBrush="{DynamicResource MpRimSoft}"
                            BorderThickness="1"
                            Padding="{DynamicResource MpPanelPadding}"
                            CornerRadius="{StaticResource RadiusLg}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- title -->
                                <RowDefinition Height="Auto"/>   <!-- channel + presence -->
                                <RowDefinition Height="*"/>      <!-- messages -->
                                <RowDefinition Height="Auto"/>   <!-- input -->
                            </Grid.RowDefinitions>

                            <!-- Panel tabs. GlobalChatHeaderText and PlayersPanelTitle keep
                                 their names and their localized captions — they are the tab
                                 labels now, so every existing writer (presence count, player
                                 count) still lands in the right place. -->
                            <!-- The two tabs SPLIT the panel width evenly and centre their
                                 captions, per the reference — a Grid of two star columns
                                 rather than a StackPanel, which would size each to its own
                                 caption and leave them huddled on the left. Even halves
                                 also keep the boundary still while the presence and player
                                 counts change. -->
                            <!-- Design 57a: the two tabs, and "»" at the end, which folds the
                                 chat to its 44-px rail. -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PanelTabChat"
                                        Grid.Column="0"
                                        Margin="0,0,2,0"
                                        Click="PanelTab_Click"
                                        Style="{StaticResource SubTab}">
                                    <!-- A Grid, NOT a horizontal StackPanel: a StackPanel
                                         measures its children with INFINITE width, so the
                                         title's ellipsis never fires and the caption grows
                                         straight past its half of the strip — centred, so it
                                         was cut at BOTH ends ("t global · 1 conecta"). The
                                         title takes the star column and trims; the dot and
                                         the count are Auto and always survive. -->
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="GlobalChatHeaderText"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Ellipse Grid.Column="1" Width="6" Height="6"
                                                 Fill="{DynamicResource MpOk}"
                                                 VerticalAlignment="Center"
                                                 Margin="7,0,5,0"/>
                                        <TextBlock Grid.Column="2" x:Name="GlobalChatPresenceText"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="PanelTabPlayers"
                                        Grid.Column="1"
                                        Margin="2,0,0,0"
                                        Click="PanelTab_Click"
                                        Style="{StaticResource SubTab}">
                                    <TextBlock x:Name="PlayersPanelTitle"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="ChatFoldButton"
                                        Grid.Column="2"
                                        Width="26" Height="26"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="»"
                                        Style="{StaticResource MpRailButton}"
                                        Click="ChatFoldButton_Click"/>
                            </Grid>

                            <!-- Thin divider under the merged header. -->
                            <Border Grid.Row="1"
                                    Height="1"
                                    Background="{DynamicResource MpRimFaint}"/>

                            <!-- Chat body and players list share this cell and are
                                 toggled by PanelTab_Click. Two siblings rather than one
                                 swapped child, so the chat's scroll position survives a
                                 trip to the players tab and back. -->
                            <Grid Grid.Row="2" x:Name="PanelChatBody">
                                <ScrollViewer x:Name="GlobalChatScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0">
                                    <StackPanel x:Name="GlobalChatPanel"/>
                                </ScrollViewer>
                                <TextBlock x:Name="GlobalChatEmptyHint"
                                           Foreground="{DynamicResource MpTextMuted}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="18"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>

                            <ScrollViewer Grid.Row="2"
                                          x:Name="PlayersScroll"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="0,4,0,4">
                                <StackPanel x:Name="PlayersPanel"/>
                            </ScrollViewer>

                            <!-- Composer: text box + Send. Hidden with the chat — a
                                 message box under a list of players would have nowhere
                                 to send to. -->
                            <Border Grid.Row="3" x:Name="PanelChatComposer"
                                    BorderBrush="{DynamicResource MpRimFaint}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,8,0,0">
                                <StackPanel>
                                    <!-- Quick replies. Openers for a quiet channel —
                                         they fill the box, they don't send. -->
                                    <StackPanel x:Name="QuickReplies"
                                                Orientation="Horizontal"
                                                Margin="2,0,2,7">
                                        <Button x:Name="QuickReplyAnyone" Click="QuickReply_Click" Style="{StaticResource MpQuickReply}"/>
                                        <Button x:Name="QuickReplyGg" Click="QuickReply_Click" Style="{StaticResource MpQuickReply}"/>
                                        <Button x:Name="QuickReplyMinute" Click="QuickReply_Click" Style="{StaticResource MpQuickReply}"/>
                                    </StackPanel>
                                    <!-- Throttle / slow-mode hint: shown when the
                                         server drops a message, cleared on next keystroke. -->
                                    <TextBlock x:Name="GlobalChatNotice"
                                               Foreground="{DynamicResource MpStatusReconnect}"
                                               FontSize="{DynamicResource FontSizeCaption}"
                                               TextWrapping="Wrap"
                                               Margin="2,0,2,6"
                                               Visibility="Collapsed"/>
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <!-- Padding 11, NOT 10: the caret lands at
                                             BorderThickness.Left + Padding.Left, and this box
                                             inherits the implicit style's 1px border. 1 + 11 = 12
                                             is what the placeholder's Margin below is set to, so
                                             the two finally start at the same pixel. With 10 the
                                             caret sat 1px inside the placeholder's first glyph.
                                             Its twin, LobbyWindow's ChatInputBox, already does
                                             exactly this — the arithmetic is copied from it.

                                             The brushes are copied from that twin too. This was
                                             the ONE field in multiplayer still wearing the global
                                             default (BgNeutral #2A323A with a gold focus ring),
                                             which is a warm grey box on a navy panel. -->
                                        <TextBox x:Name="GlobalChatInput"
                                                 MaxLength="500"
                                                 MinHeight="32"
                                                 Background="{DynamicResource MpField}"
                                                 Foreground="{DynamicResource MpTextPrimary}"
                                                 CaretBrush="{DynamicResource MpActionText}"
                                                 BorderBrush="{DynamicResource MpRimField}"
                                                 BorderThickness="1"
                                                 Padding="11,0"
                                                 FontSize="{DynamicResource MpBodySize}"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="GlobalChatInput_TextChanged"
                                                 KeyDown="GlobalChatInput_KeyDown"/>
                                        <!-- SAME FontSize as the TextBox above, and that matters
                                             more than the pixel: the placeholder used to render at
                                             13 while typed text came out at 14 (inherited), so the
                                             two never shared a glyph advance and the text visibly
                                             jumped the moment you started typing. -->
                                        <TextBlock x:Name="GlobalChatPlaceholder"
                                                   Foreground="{DynamicResource MpTextMuted}"
                                                   FontSize="{DynamicResource MpBodySize}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                    <!-- Send: compact icon button (paper-plane
                                         glyph). Localized caption lives on the
                                         ToolTip now (set in ApplyStrings). -->
                                    <Button x:Name="GlobalChatSendButton"
                                            Grid.Column="1"
                                            Click="GlobalChatSendButton_Click"
                                            Style="{StaticResource MpPrimaryButton}"
                                            Width="34"
                                            Height="32"
                                            Padding="0">
                                        <TextBlock Text="&#xE724;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- The FOLDED chat (design 57c): a 44-px rail. From the top: unfold, the chat
                         with its unread count, and the players connected. Any of them unfolds the
                         chat — the last two on their own tab. Shown instead of ChatPanelCard while
                         LauncherConfig.RoomsChatFolded is set. -->
                    <Border x:Name="ChatRail"
                            Grid.Row="0"
                            Visibility="Collapsed"
                            Background="{DynamicResource MpPanel}"
                            BorderBrush="{DynamicResource MpRimSoft}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,10">
                            <Button x:Name="ChatRailUnfoldButton"
                                    Content="«"
                                    Style="{StaticResource MpRailButton}"
                                    Click="ChatRailUnfoldButton_Click"/>
                            <!-- The unread badge hangs off the button's top-right corner, as drawn;
                                 a Grid does not clip, so the negative margin shows. -->
                            <Grid Margin="0,12,0,0">
                                <Button x:Name="ChatRailChatButton"
                                        Background="{DynamicResource MpRailChatBg}"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource UiTextStrong}"
                                        Style="{StaticResource MpRailButton}"
                                        Click="ChatRailChatButton_Click">
                                    <TextBlock Text="&#xE8BD;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                                <Border x:Name="ChatRailUnreadBadge"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        MinWidth="16" Height="16"
                                        Padding="4,0"
                                        Margin="0,-5,-6,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        CornerRadius="8"
                                        Background="{DynamicResource MpAction}">
                                    <TextBlock x:Name="ChatRailUnreadText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource MpSectionLabelSize}"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                            <Button x:Name="ChatRailPlayersButton"
                                    Margin="0,12,0,0"
                                    BorderBrush="{DynamicResource MpRimMedium}"
                                    Foreground="{DynamicResource MpNavTabIdle}"
                                    Style="{StaticResource MpRailButton}"
                                    Click="ChatRailPlayersButton_Click">
                                <TextBlock x:Name="ChatRailPlayersText"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="{DynamicResource MpHistoryMetaSize}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    </Grid>
                    <!-- /RIGHT chat + players -->
                </Grid>
            </Grid>


            <!-- The lobby UI that used to live here as a non-modal
                 floating popup (Canvas + RoomPopupCard Border + 600 lines
                 of content) has moved to LobbyWindow.xaml. It is now a
                 real top-level Window opened from MultiplayerTab.xaml.cs
                 via OpenLobbyWindow() — see the comment block above that
                 method. The browser stays here, fully visible while the
                 lobby is open since the Window does not overlay it. -->
        </Grid>                 <!-- x:Name="RoomsView" -->

        <!-- Profile / History / Friends subviews.

             This used to be four bare TextBlocks on an empty background, with "0 % wins"
             printed as a headline for a player who had lost their single decided match. The
             rating is the number the page is about, so it is the biggest thing on it; the
             record is stated as W-L; and the percentage does not appear at all until it is
             based on enough matches to mean something (see RenderProfileTab). -->
        <!-- TORNEOS. Two panes: the list on the left, whatever is selected on the right.
             The bracket scrolls HORIZONTALLY inside its own viewer — a sixteen-entrant
             bracket is four columns wide and the page must not grow a sideways scrollbar
             of its own. -->
        <Grid Grid.Row="1" x:Name="TournamentsView" Visibility="Collapsed">
            <!-- The tab's one margin and one gap (PageSpacing): the list pane takes the margin
                 on its left, the detail pane on its right, and the gap column sits between. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition x:Name="TournamentsGapColumn" Width="{DynamicResource MpPanelGap}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: the list, plus the one button that creates one. -->
            <Grid Grid.Column="0" x:Name="TournamentsListPane" Margin="{DynamicResource MpPageGutterLeftPane}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TournamentsTitleText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="{DynamicResource MpPageTitleSize}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MpTextHeading}"/>
                    <!-- The same button "+ Crear sala" is, and for the same reason: this is the one
                 thing on the panel that CREATES something. It wore MpLinkButton, whose own
                         comment says it exists for the join affordance INSIDE a chat card, where a
                         real button would outweigh the message it belongs to - transparent, zero
                         padding, no margin, and an underline as its only hover. On a heading row that
                         leaves a 70x15 hit target of bare glyphs beside a 17px bold title, and it was
                         reported as practically invisible.
                         The local FontSize is NOT optional: the Mp* styles ship FontSizeBody 14 and
                         this surface runs on the multiplayer scale - see the note on the rooms bar
                         above for why that button overrides it too. -->
                    <Button x:Name="TournamentCreateButton"
                            Grid.Column="1"
                            Click="TournamentCreate_Click"
                            Style="{StaticResource MpPrimaryButton}"
                            FontSize="{DynamicResource MpLabelSize}"
                            Height="32"
                            Padding="12,0"
                            VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TournamentsListPanel"/>
                </ScrollViewer>
            </Grid>

            <!-- RIGHT: the selected tournament. Everything in here is built in code, so
                 DialogXamlTests exercises it by calling the builder rather than by
                 parsing this file. -->
            <ScrollViewer Grid.Column="2" x:Name="TournamentsDetailPane" Margin="{DynamicResource MpPageGutterRightPane}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <!-- CAPPED AT THE VIEWPORT, and this is load-bearing. Everything in here is
                     built in code, and two of those children ask for more width than the
                     window has: the bracket is four 260px columns whatever the window does,
                     and the entrant table has a maximum of its own. A StackPanel takes the
                     widest child as its own width, and this viewer does not scroll sideways
                     - so the surplus was silently clipped, and anything that had been laid
                     out against that surplus went with it. The tournament header's "it is
                     your turn" capsule was measured, sized, visible and absent from the
                     screen for exactly this reason.

                     With the cap, the bracket gets a finite width and scrolls inside its own
                     viewer, which is what it was always meant to do. -->
                <StackPanel x:Name="TournamentDetailPanel"
                            MaxWidth="{Binding ViewportWidth,
                                       RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
            </ScrollViewer>
        </Grid>

        <!-- STATISTICS. The full tables, which is what a modder scans; the ranking page's
             right-hand column shows only the top of each. It is a subtab and not a settings
             page because it is community data, not a preference, and it lives under
             MULTIPLAYER because that is where the data comes from.

             It SCROLLS, unlike the ranking page — there is no pinned row here to make
             page-level scrolling meaningless, and the tables can run to a hundred rows. -->
        <Grid Grid.Row="1" x:Name="StatsView" Visibility="Collapsed">
            <!-- Named so a repaint can put the page back where the reader left it. Four
                 payloads land in the background and the card names land after them, and every
                 one of them rebuilds this whole panel. -->
            <ScrollViewer x:Name="StatsScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="StatsPage" Margin="{DynamicResource MpPageGutter}" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="StatsDemoBanner"
                               Visibility="Collapsed"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               FontStyle="Italic"
                               FontSize="{DynamicResource MpLabelSize}"
                               Foreground="{DynamicResource MpCautionText}"/>

                    <!-- The head of the page. TWO counts and not one sentence: it used to
                         read "0 civilizations, over 0 rated matches" directly above a list
                         that added up to twenty-seven matches, which is two different
                         questions compressed into one phrase that answers neither. The
                         civilizations now report their own state in their own card. -->
                    <StackPanel>
                        <TextBlock x:Name="StatsTitleText"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="{DynamicResource MpTournamentNameSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MpTextHeading}"/>
                        <TextBlock x:Name="StatsCountsText"
                                   Margin="0,5,0,0"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="{DynamicResource MpFigureSize}"
                                   Foreground="{DynamicResource MpTextMuted}"/>
                    </StackPanel>

                    <!-- WHICH MOD these figures are about.
                         It replaced a "whole community / only mine" pair, which was the wrong
                         axis: this is a community page and the player's own numbers live on
                         Profile. The mod is the axis that mattered, and not as a nicety —
                         civilizations, matchups and decks are grouped by mod on the server,
                         and drawing every row put two mods in one table with nothing saying
                         so.

                         ITS OWN ROW, and it WRAPS. It sat beside the title for one build and
                         with five mods installed it squeezed the counts beside it until
                         "last 30 days" was clipped off the end — a picker that eats the
                         figures it scopes. Filled from code: one icon-and-name chip per
                         installed mod, Wars of Liberty first. -->
                    <!-- Mod on the left, ladder on the right, and the two WRAP against each
                         other: the page is one mod BY one mode, and with five mods installed
                         a single row would push the mode switch off the edge. The mode capsule
                         is collapsed entirely when the server has no team matches for this mod
                         - a switch whose other side can only be empty is not a choice. -->
                    <WrapPanel Margin="0,11,0,0" HorizontalAlignment="Left">
                        <Border Padding="3"
                                Margin="0,0,8,4"
                                CornerRadius="{StaticResource RadiusRow}"
                                Background="{DynamicResource MpPanel}">
                            <WrapPanel x:Name="StatsModPicker" Orientation="Horizontal"/>
                        </Border>

                        <Border x:Name="StatsModeScope"
                                Padding="3"
                                Margin="0,0,0,4"
                                Visibility="Collapsed"
                                CornerRadius="{StaticResource RadiusRow}"
                                Background="{DynamicResource MpPanel}">
                            <StackPanel x:Name="StatsModePicker" Orientation="Horizontal"/>
                        </Border>
                    </WrapPanel>

                    <!-- Two columns. The reference gives the left one 592px and the right one
                         404; at the width this window actually has, that is more than there
                         is, so the left one flexes and the right keeps a fixed measure. Both
                         are filled from code, like the bracket and for the same reason. -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="StatsLeftColumn" Grid.Column="0"/>
                        <StackPanel x:Name="StatsRightColumn" Grid.Column="2" Width="310"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ProfileView moved to ProfileWindow.xaml — the page is unchanged, only its
             frame is. MultiplayerTab still BUILDS it (RenderProfileTab and the couple
             of dozen builders below are bound to the session, the standing cache, the
             history rows and the deck caches), it just renders into the window's
             ProfileBody now. See the header of ProfileWindow.xaml for why it left. -->

        <!-- (The History subtab lived here and is gone. Its list is a SECTION of the
             Profile now — see BuildProfileHistory. The two pages said the same four things:
             History's summary cells were the rating, the decided record, the "didn't count"
             count and the most-played map, every one of which the Profile already shows, and
             the Profile's "Latest matches" block was a three-row excerpt of History's own
             list. One page, one set of numbers.) -->

        <!-- The full ladder. The community strip on the Rooms subtab keeps showing a few places
             as a summary; this is where all of them live, because a strip that grew with the
             league would push the rooms list off the screen the week it filled. Two ladders
             share one table and one payload — see RenderRanking.

             DESIGN 59: THE PAGE FILLS THE WINDOW AND SHARES IT 60/40. The table and the match
             list beside it are CSS's flex: 3 1 640px and flex: 2 1 340px with a 14-px gap
             (RankingTableLayout.Split, applied in RankingPage_SizeChanged), so the list is never
             squeezed into a corner on a big monitor and the table never takes a metre it has no
             use for. Inside the table every column grows in proportion, the bar stops at 300 px,
             and the gap, the row heights and the type grow a little with the width
             (RankingTableLayout.Fluid). Read that file before touching any width here.

             Before 59 the surplus went to ONE column — the name, then the ELO — and either way
             something ended up a metre from the name it belonged to: on a 2560-px window the bar
             was ~1350 px long and V-D and % sat at the far edge, while "Latest matches" was
             squeezed into a fixed 440 px. -->
        <Grid Grid.Row="1" x:Name="RankingView" Visibility="Collapsed">
            <!-- The PAGE does not scroll; the table inside the card does. That is what makes
                 "your row pinned to the foot" mean anything — pinning inside a page that
                 scrolls as a whole would just be appending a duplicate row at the end. It also
                 keeps the footnote, which explains the entry rule, on screen at every height.

                 The page's margin is design 59's frame padding (16 / 14): a "cqw" of its
                 clamp() sizes is a hundredth of THIS grid's width. -->
            <Grid x:Name="RankingPage"
                  Margin="{DynamicResource MpPageGutter}" HorizontalAlignment="Stretch"
                  SizeChanged="RankingPage_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- The third row is only used below ~1000 px, where the match list goes
                         under the table (RankingTableLayout.Split); it is 0 the rest of the time. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="RankingTableRow" Height="*"/>
                        <RowDefinition x:Name="RankingStackedRow" Height="0"/>
                    </Grid.RowDefinitions>

                    <!-- One row across BOTH cards (59): the title, the 1v1 / Teams capsule, and
                         at the right the size of the table — "12 ranked · 3 in placement" — and
                         the rank guide. -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="2,0,2,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RankingTitleText"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="{DynamicResource MpPageTitleSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MpTextHeading}"/>
                        <!-- The 1v1 / Equipos pair, in a capsule: one either-or, not two labels. -->
                        <Border Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="3"
                                VerticalAlignment="Center"
                                CornerRadius="{StaticResource RadiusRow}"
                                Background="{DynamicResource MpPanel}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RankingModeSolo" Click="RankingModeSolo_Click"
                                        Style="{StaticResource SubTab}"/>
                                <Button x:Name="RankingModeTeam" Click="RankingModeTeam_Click"
                                        Style="{StaticResource SubTab}"/>
                                <!-- The month's highlights in depth: the top five of each,
                                     over the whole page (no handoff covers this view). -->
                                <Button x:Name="RankingModeHighlights" Click="RankingModeHighlights_Click"
                                        Style="{StaticResource SubTab}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="RankingSubtitleText"
                                   Grid.Column="2"
                                   Margin="12,0,12,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource MpMetaSize}"
                                   Foreground="{DynamicResource MpTextMuted}"/>
                        <!-- The preview chip (while a preview owns the data) and the rank guide —
                             a SECONDARY BUTTON, never a pill (46b.1). -->
                        <StackPanel x:Name="RankingScopeChips"
                                    Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <!-- Highlights only: this month or the last one. -->
                            <Border x:Name="RankingMonthCapsule"
                                    Margin="0,0,10,0"
                                    Padding="3"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    CornerRadius="{StaticResource RadiusRow}"
                                    Background="{DynamicResource MpPanel}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RankingMonthCurrent" Click="RankingMonthCurrent_Click"
                                            Style="{StaticResource SubTab}"/>
                                    <Button x:Name="RankingMonthPrevious" Click="RankingMonthPrevious_Click"
                                            Style="{StaticResource SubTab}"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="RankGuideLink"
                                    Style="{StaticResource MpSecondaryButton}"
                                    FontSize="{DynamicResource MpMetaSize}"
                                    Height="30"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Click="RankGuideLink_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- The table: ONE card holding the column headings, the rows, the viewer's
                         own row pinned to the foot when it is out of sight, and — design 59 — the
                         footnote, which used to float under the card at the window's edge. -->
                    <Border x:Name="RankingTableCard"
                            Grid.Row="1"
                            VerticalAlignment="Top"
                            CornerRadius="{StaticResource RadiusLg}"
                            Background="{DynamicResource MpPanel}"
                            BorderBrush="{DynamicResource MpRimFaint}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Column headings, outside the scroller so they stay put. -->
                            <Grid x:Name="RankingHeaderHost" Grid.Row="0"/>
                            <ScrollViewer x:Name="RankingRowsScroll"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          ScrollChanged="RankingRowsScroll_ScrollChanged">
                                <StackPanel x:Name="RankingBody" SizeChanged="RankingBody_SizeChanged"/>
                            </ScrollViewer>
                            <!-- The viewer's own row, shown only while their real row is
                                 scrolled out of sight. Collapsed the rest of the time, so a
                                 player who can see themselves is not shown twice. -->
                            <Grid x:Name="RankingPinnedRow"
                                  Grid.Row="2"
                                  Visibility="Collapsed"/>
                            <!-- The footnote, on the page's own background like the handoff
                                 draws it. Its bottom corners follow the card's, one pixel in. -->
                            <Border Grid.Row="3"
                                    Padding="16,10,16,10"
                                    CornerRadius="0,0,9,9"
                                    Background="{DynamicResource MpAppBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RankingFootnoteText"
                                               Grid.Column="0"
                                               Margin="0,0,14,0"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource MpHistoryMetaSize}"
                                               Foreground="{DynamicResource MpTextFaint}"/>
                                    <Button x:Name="RankingEloHelpButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            FontSize="{DynamicResource MpHistoryMetaSize}"
                                            Click="RankingEloHelpButton_Click"
                                            Style="{StaticResource MpLinkButton}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- The community's last matches, beside the ladder: who beat whom, on
                         which map, with which civilization — each name with its flag. Its width
                         is set from code (RankingTableLayout.Split): 40 % of the page, never a
                         fixed number. Collapsed while the payload has no matches. Top-aligned
                         like the table, so a short list is a short card; it scrolls inside
                         itself for the same reason the ladder does. -->
                    <Border x:Name="RankingHistoryCard"
                            Grid.Row="1" Grid.Column="1"
                            Margin="14,0,0,0"
                            Padding="16,12,16,4"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            CornerRadius="{StaticResource RadiusLg}"
                            Background="{DynamicResource MpPanel}"
                            BorderBrush="{DynamicResource MpRimFaint}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="RankingHistoryTitle"
                                       Grid.Row="0"
                                       FontSize="{DynamicResource MpPillSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MpTextLabel}"/>
                            <!-- Margin -8 on the right is the gutter the overlaid bar is drawn
                                 in, so the rows keep the card's full width. -->
                            <ScrollViewer x:Name="RankingHistoryScroll"
                                          Grid.Row="1"
                                          Margin="0,8,-8,0"
                                          Style="{StaticResource MpOverlayScrollViewer}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="RankingHistoryList"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- HIGHLIGHTS (the third option of the selector): one card per highlight with
                         its top five, in a grid as wide as the page — a column per ~380 px. Built
                         in code (RenderRankingHighlights); the table and the match list are
                         collapsed while it shows. It scrolls, unlike the table's page. -->
                    <ScrollViewer x:Name="RankingHighlightsView"
                                  Grid.Row="1" Grid.ColumnSpan="2"
                                  Visibility="Collapsed"
                                  Style="{StaticResource MpOverlayScrollViewer}"
                                  Margin="0,0,-8,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RankingHighlightsBody"/>
                    </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================================================
             THE SIGNED-OUT GATE, and it belongs to the TAB rather than to
             a page of it. It used to be declared inside RoomsView, which
             made Salas the only subtab that could ever show it: the other
             three collapse RoomsView along with the gate inside it, so
             each of them improvised a sign-out state of its own. Torneos
             printed a grey line in the corner of a page it had gone ahead
             and built, with no sign-in button anywhere on it; Clasificación
             claimed "there is no ranking to show yet", which is a statement
             about the server made out of a request that was never sent
             (RefreshStatsForMod returns on its first line without a
             session); Estadísticas drew a mod picker over empty tables.

             DECLARED LAST on purpose. A Grid paints its children in the
             order they are written, so being last is what puts the gate
             over whichever view is behind it. Every view is also COLLAPSED
             while it is up (see ShowSubtabView) rather than merely covered:
             painted over is not hidden, and half a ladder showing under a
             sign-in button is worse than either page on its own.

             Visibility="Collapsed" at rest. Inside RoomsView it could be
             born visible, because Salas is the default page; as a child of
             the root, born visible is a flash over any of the four.
             ============================================================ -->
        <StackPanel Grid.Row="1"
                    x:Name="SignInPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="480"
                    Visibility="Collapsed">
            <TextBlock x:Name="SignInTitleText"
                       Foreground="{DynamicResource MpTextPrimary}"
                       FontSize="{DynamicResource FontSizeHeading}"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="SignInBodyText"
                       Foreground="{DynamicResource MpTextMuted}"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,12,0,18"/>
            <Button x:Name="SignInButton"
                    Click="SignInButton_Click"
                    Style="{StaticResource MpPrimaryButton}"
                    HorizontalAlignment="Center"
                    Padding="20,10"
                    MinWidth="220"/>
            <TextBlock x:Name="SignInErrorText"
                       Foreground="{DynamicResource MpStatusOffline}"
                       FontSize="{DynamicResource FontSizeCaption}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,12,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- ============================================================
             THE UPDATE GATE: multiplayer is closed while a newer launcher
             release is pending. Declared LAST, after the signed-out gate,
             for the same reason that one is declared after the views: a
             Grid paints in declaration order, and this must sit over
             everything — the four views AND the sign-in panel, because an
             old build has nothing to sign in for. Spans both rows so the
             subtab strip is covered too: a reachable Ranking subtab under
             a notice saying multiplayer is closed is a contradiction.

             Opaque on purpose (MpAppBg, not a scrim): "painted over is not
             hidden", and a half-visible room list under an update button
             invites a click that goes nowhere. Toggled from
             SetLauncherUpdateGate; see Services/LauncherUpdateGate.
             ============================================================ -->
        <Grid x:Name="UpdateGateOverlay"
              Grid.Row="0" Grid.RowSpan="2"
              Background="{DynamicResource MpAppBg}"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520">
                <TextBlock Text="&#x21BB;"
                           Foreground="{DynamicResource MpTextMuted}"
                           FontSize="40"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock x:Name="UpdateGateTitleText"
                           Foreground="{DynamicResource MpTextPrimary}"
                           FontSize="{DynamicResource FontSizeHeading}"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="UpdateGateBodyText"
                           Foreground="{DynamicResource MpTextMuted}"
                           FontSize="{DynamicResource FontSizeBody}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,18"/>
                <Button x:Name="UpdateGateButton"
                        Click="UpdateGateButton_Click"
                        Style="{StaticResource MpPrimaryButton}"
                        HorizontalAlignment="Center"
                        Padding="20,10"
                        MinWidth="220"/>
                <TextBlock x:Name="UpdateGateNoteText"
                           Foreground="{DynamicResource MpTextMuted}"
                           FontSize="{DynamicResource FontSizeCaption}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
