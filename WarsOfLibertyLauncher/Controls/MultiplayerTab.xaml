<UserControl x:Class="WarsOfLibertyLauncher.Controls.MultiplayerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Subtab buttons (Rooms / Friends / Profile / History).
             TERTIARY BLUE recipe â€” dim gray when inactive, soft sky
             (FgHoverBlue) on hover, white + bold + blue underline
             when active (active state still set programmatically by
             UpdateSubtabHighlights via BorderBrush/Foreground).

             ControlTemplate is REQUIRED â€” without it WPF falls back
             to the Aero default which paints a sky-blue gradient
             on hover (the "muy blancos" bug). TemplateBinding the
             BorderBrush + BorderThickness so the code-behind active-
             state setters still work without re-templating. -->
        <!-- Sub-tab (design handoff 1a). A filled pill, not the old underline: the
             underline read as a second tab row stacked under the main one, and the
             reference distinguishes the two levels by shape instead. Idle is Medium
             weight and lifts to SemiBold + white when active. -->
        <Style x:Key="SubTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpPillIdleText}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E6EEF8"/>
                            </Trigger>
                            <!-- Active pill. UpdateSubtabHighlights sets Tag; it used to
                                 paint the underline via BorderBrush, so that code moved
                                 to the Tag as part of this change. -->
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource MpPillActiveBg}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-aligned status pill (Connected / Reconnecting /
             Offline) shown in the top-right of the header. Pure
             cosmetic â€” UpdateConnectionStatus() fills the labels
             and the dot brush. -->
        <Style x:Key="HeaderStatChip" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="18,0,0,0"/>
        </Style>

        <!-- Room ROW (table row, NOT a floating card). A flush surface with
             a hairline bottom divider and a subtle hover tint — so the list
             reads as a clean table like the reference mockup, not a stack of
             gapped cards. The row body (title, mod chip, host, players, ping,
             status badge, action button) is built in code-behind by
             BuildRoomCard so all the load-bearing state logic (action caption,
             in-place ping, mod-installed gating) is preserved. Left inset =
             Padding.Left 14 + ScrollViewer pad 16 = 30, matched by the header
             strip's 30px left margin so columns line up under the labels. -->
        <!-- Room ROW (design handoff 1a). Separated rounded rows with a rim, not the
             flush table rows with a hairline divider this used to be. The reference
             gives every row the SAME uniform height because it is one line with
             ellipsis: nothing in it may wrap, or the rows stop scanning as a column of
             equal blocks. Own-room rows are lifted by BuildRoomCard, which sets the
             brighter fill and rim locally — a Style trigger can't express "this is
             mine", since that is per-row data rather than a control state. -->
        <Style x:Key="MpRoomCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MpPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimFaint}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}"/>
            <Setter Property="Height" Value="{StaticResource MpRoomRowHeight}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MpRoomRowHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Quick-reply pill above the chat composer (design handoff 1a). Clicking one
             FILLS the box rather than sending: the three canned lines are openers, and
             one that fired on a single click would be a way to spam the room by
             accident. CornerRadius is half the height — the reference writes
             `border-radius:999px`, which is a CSS idiom WPF renders as a distorted
             ellipse (see RadiusPill). -->
        <Style x:Key="MpQuickReply" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource MpQuickReplyBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource MpActionText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource MpMicroSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable, sortable column header. Transparent button that shows
             the column label + a sort arrow (set in code-behind); brightens on
             hover. Left-aligned so the label sits flush over its column. Zero
             left padding keeps the ROOM label aligned with the 30px row inset. -->
        <Style x:Key="MpColHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- x:Name="TabRootGrid" — host for MpAlertOverlay notice/confirm cards
         (the themed replacement for MessageBox on the join / create / mod
         error paths that fire from the tab, outside a lobby window). -->
    <Grid x:Name="TabRootGrid" Background="{DynamicResource MpTabBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- Header (subtabs + status bar) -->
            <RowDefinition Height="*"/>        <!-- Active view -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             Header: subtabs on the left, connection-status pill on
             the right. The status pill replaces the older "chat-line"
             approach where disconnect/reconnect events were dumped
             into the room chat â€” those now live here, where the user
             expects to look for them.
             ============================================================ -->
        <!-- BAR 2 (design handoff 1a). Was a transparent strip carrying the sub-tabs
             plus a right-hand cluster of connection status, player and room counts and
             a NAT badge. All of that restated something shown elsewhere — the
             connection state is now the title-bar chip, and the counts already appear
             in the right-hand panel — so per the reference this bar holds only
             navigation and the two room actions, which came up from the account row
             below it. -->
        <Border Grid.Row="0"
                Height="{StaticResource MpSubBarHeight}"
                Background="{DynamicResource MpPanel}"
                BorderBrush="{DynamicResource MpRimSoft}"
                BorderThickness="0,0,0,1"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid>
                        <Button x:Name="SubtabRooms" Click="SubtabRooms_Click" Style="{StaticResource SubTab}"/>
                        <!-- "New room created" dot: shown via SetNewRoomIndicator(true)
                             from MainWindow's poll, cleared when this subtab opens. -->
                        <Ellipse x:Name="RoomsSubtabDot"
                                 Width="7" Height="7"
                                 Fill="#E5484D"
                                 Stroke="{DynamicResource MpSurface}"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,4,4,0"
                                 IsHitTestVisible="False"
                                 Visibility="Collapsed"/>
                    </Grid>
                    <Button x:Name="SubtabFriends" Click="SubtabFriends_Click" Style="{StaticResource SubTab}"/>
                    <Button x:Name="SubtabProfile" Click="SubtabProfile_Click" Style="{StaticResource SubTab}"/>
                    <Button x:Name="SubtabHistory" Click="SubtabHistory_Click" Style="{StaticResource SubTab}"/>
                </StackPanel>

                <!-- Room actions, moved up from the account row below (which the
                     reference deletes: the identity went to the title bar). -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Search. Filters the list ALREADY in hand, so typing costs no
                         request. WPF's TextBox has no placeholder, hence the TextBlock
                         behind it, hidden on the first character. -->
                    <Border Height="32"
                            Width="230"
                            Margin="0,0,16,0"
                            Padding="11,0"
                            CornerRadius="{StaticResource RadiusControl}"
                            Background="{DynamicResource MpField}"
                            BorderBrush="{DynamicResource MpRimField}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="#7E93AF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"/>
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="RoomSearchPlaceholder"
                                           IsHitTestVisible="False"
                                           Foreground="#6D829D"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="RoomSearchBox"
                                         TextChanged="RoomSearchBox_TextChanged"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         Foreground="{DynamicResource MpTextPrimary}"
                                         CaretBrush="{DynamicResource MpTextPrimary}"
                                         FontFamily="{DynamicResource BodyFont}"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Button x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            Style="{StaticResource MpSecondaryButton}"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,16,0"/>
                    <Button x:Name="CreateRoomButton"
                            Click="CreateRoomButton_Click"
                            Style="{StaticResource MpPrimaryButton}"
                            Height="32"
                            Padding="15,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             ROOMS view: sign-in gate / room list / current-room panel.
             Only one of the three groups is visible at a time, driven
             from code-behind by RefreshFromSession().
             ============================================================ -->
        <Grid Grid.Row="1" x:Name="RoomsView">

            <!-- Signed-out gate. -->
            <StackPanel x:Name="SignInPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="480">
                <TextBlock x:Name="SignInTitleText"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="{StaticResource FontSizeHeading}"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SignInBodyText"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="{StaticResource FontSizeBody}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,18"/>
                <Button x:Name="SignInButton"
                        Click="SignInButton_Click"
                        Style="{StaticResource MpPrimaryButton}"
                        HorizontalAlignment="Center"
                        Padding="20,10"
                        MinWidth="220"/>
                <TextBlock x:Name="SignInErrorText"
                           Foreground="{DynamicResource MpStatusOffline}"
                           FontSize="{StaticResource FontSizeCaption}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Browser (signed in, no current lobby). Top toolbar:
                 user chip on the left, Refresh + Create room on the
                 right. Below: table header row, then either the
                 list of rooms or the empty-state illustration. -->
            <Grid x:Name="BrowserPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Radmin banner -->
                    <RowDefinition Height="Auto"/>   <!-- toolbar -->
                    <RowDefinition Height="*"/>      <!-- rooms (left) + global chat (right) -->
                </Grid.RowDefinitions>

                <!-- Radmin VPN banner. Three live states driven by
                     RadminVpnService.GetStatus():
                       * NotInstalled  â†’ red warning + "Install" button
                       * NotConnected  â†’ blue info + "Open Radmin" button
                       * Connected     â†’ green check + network-name copier
                                         + numbered "how to join" instructions
                     Layout: a 3-row Grid. Row 0 is always-on (icon, title
                     line, primary button). Rows 1 & 2 are the network-name
                     panel and the numbered steps, both shown only in the
                     Connected state so they don't waste vertical space when
                     the user can't act on them yet. Colours come from
                     code-behind. Polls every 3 s while mounted. -->
                <Border Grid.Row="0"
                        x:Name="RadminBanner"
                        x:FieldModifier="private"
                        Background="#1f2c3d"
                        BorderBrush="#3a5a8c"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}"
                        Margin="24,12,24,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>    <!-- title + primary button -->
                            <RowDefinition Height="Auto"/>    <!-- network-name copier -->
                            <RowDefinition Height="Auto"/>    <!-- numbered instructions -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status icon. Glyph + colour are set by
                             RefreshRadminBanner() in code-behind. -->
                        <Border Grid.Row="0" Grid.Column="0"
                                x:Name="RadminStatusIcon"
                                Width="{StaticResource DiscSizeSm}" Height="{StaticResource DiscSizeSm}"
                                CornerRadius="{StaticResource DiscRadiusSm}"
                                Background="#3a5a8c"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <TextBlock x:Name="RadminStatusGlyph"
                                       Text="i"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title + body -->
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="RadminBannerTitle"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="RadminBannerBody"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Primary actions: [Show steps] opens the
                             guided assistant overlay; [Install /
                             Open Radmin] is the legacy one-click
                             quick action. Stacked horizontally so a
                             power user can hit "Open Radmin" without
                             going through the tutorial. -->
                        <StackPanel Grid.Row="0" Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button x:Name="RadminShowStepsButton"
                                    Click="RadminShowStepsButton_Click"
                                    Style="{StaticResource MpSecondaryButton}"
                                    Padding="12,6"
                                    Margin="0,0,6,0"
                                    FontSize="{StaticResource FontSizeCaption}"/>
                            <Button x:Name="RadminPrimaryButton"
                                    Click="RadminPrimaryButton_Click"
                                    Style="{StaticResource MpSecondaryButton}"
                                    Padding="12,6"
                                    FontSize="{StaticResource FontSizeCaption}"/>
                        </StackPanel>

                        <!-- Network-name copier. A read-only TextBox so
                             the name can be selected and inspected
                             visually, paired with a "Copy" button that
                             pushes it to the clipboard without needing
                             to open Radmin first. Only shown in the
                             Connected state. -->
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                x:Name="RadminNetworkNamePanel"
                                Background="#15282a"
                                BorderBrush="#3a8c5a"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Margin="0,10,0,0"
                                Padding="8,6"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         x:Name="RadminNetworkNameBox"
                                         Text="Age of Empires III: The Asian Dynasties"
                                         IsReadOnly="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="Consolas, Courier New, monospace"
                                         FontSize="{StaticResource FontSizeCaption}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1"
                                        x:Name="RadminCopyNameButton"
                                        Click="RadminCopyNameButton_Click"
                                        Style="{StaticResource MpSecondaryButton}"
                                        Padding="10,4"
                                        Margin="8,0,0,0"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        MinWidth="100"/>
                            </Grid>
                        </Border>

                        <!-- Numbered step-by-step instructions. Static
                             text set by RefreshRadminBanner() so it
                             follows the language switch. Only shown in
                             the Connected state. -->
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                   x:Name="RadminInstructionsText"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>


                <!-- Row 2: two-column content — active rooms (left) +
                     persistent global chat (right). The rooms table and
                     the chat panel each live in their own card. -->
                <Grid Grid.Row="2" Margin="24,2,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>     <!-- gutter -->
                        <!-- Global chat + Players ≈22-24%. Flexible: shrinks to 280,
                             caps at 300 (narrowed from 320-360 so the rooms table
                             gets more room). -->
                        <ColumnDefinition Width="*" MinWidth="280" MaxWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===================== LEFT: active rooms ===================== -->
                    <!-- Wrapper: glow underlay (Effect, no children) BEHIND the
                         real content card (no Effect → text stays ClearType-crisp). -->
                    <Grid Grid.Column="0">
                    <!-- Row 0 is the rooms card (glow underlay + content, stacked);
                         row 1 is the activity strip below it. Without these the strip
                         would land in the same cell as the card and paint over it. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{DynamicResource MpSurface}"
                            CornerRadius="{StaticResource RadiusLg}"
                            Margin="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#3A6BD0" BlurRadius="18" ShadowDepth="0" Opacity="0.28"/>
                        </Border.Effect>
                    </Border>
                    <Border Grid.Row="0"
                            Background="{DynamicResource MpSurface}"
                            BorderBrush="{DynamicResource MpCardBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- section title -->
                                <RowDefinition Height="Auto"/>   <!-- table header -->
                                <RowDefinition Height="*"/>      <!-- rows / empty / error -->
                                <RowDefinition Height="Auto"/>   <!-- footer: "Showing N rooms" -->
                            </Grid.RowDefinitions>

                            <!-- Section title: people glyph + "Salas activas"
                                 on the left, "last updated" timestamp on the
                                 right (set by UpdateRoomsUpdatedLabel). -->
                            <Grid Grid.Row="0" Margin="20,16,20,12">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="👥"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0"/>
                                    <TextBlock x:Name="RoomsSectionTitle"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="RoomsUpdatedText"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="{StaticResource FontSizeCaption}"/>
                            </Grid>

                            <!-- Column headers for the room list. The rows
                                 (BuildRoomCard) mirror these EXACT 7 column defs,
                                 and the 30px side margin matches each row's
                                 content inset (ScrollViewer pad 16 + row padding
                                 14; the row has no side border) so the columns
                                 line up under the labels. Keep the two grids in
                                 sync (lockstep invariant). Columns 0-5 are
                                 clickable/sortable buttons (label + sort arrow,
                                 arrows set by UpdateSortArrows); ACTION (6) is a
                                 plain centered label. Columns are STAR-sized with
                                 Min/Max so the row never overflows a narrow
                                 window (horizontal scroll is disabled); ROOM has
                                 no MaxWidth so it absorbs slack (no empty band).
                                 The right margin is bumped by the scrollbar width
                                 at runtime (SyncHeaderScrollbarGutter) so the
                                 header tracks the rows when the vbar shows. -->
                            <Border Grid.Row="1"
                                    Background="#0C1626"
                                    BorderBrush="{DynamicResource MpDivider}"
                                    BorderThickness="0,0,0,1">
                            <!-- ClipToBounds: a Grid cell does NOT clip, so without this a
                                 header that outgrows its share draws straight over the next
                                 column instead of being cut. Belt and braces behind the
                                 bounded layouts below. -->
                            <Grid x:Name="RoomsHeaderStrip" Margin="30,7,30,7" ClipToBounds="True">
                                <!-- The columns are built at runtime from
                                     Services/RoomsTableLayout.All, which BuildRoomCard reads
                                     too — one list, so the header and the rows cannot drift
                                     apart and misalign the table. These seven are only the
                                     design-time placeholder so the strip looks right in the
                                     designer; ApplyRoomColumns replaces them. -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*" MinWidth="120"/>
                                    <ColumnDefinition Width="1.05*" MinWidth="58"/>
                                    <ColumnDefinition Width="1.35*" MinWidth="66"/>
                                    <ColumnDefinition Width="0.62*" MinWidth="46"/>
                                    <ColumnDefinition Width="0.62*" MinWidth="48"/>
                                    <ColumnDefinition Width="0.9*" MinWidth="60"/>
                                    <ColumnDefinition Width="0.95*" MinWidth="100"/>
                                </Grid.ColumnDefinitions>
                                <!-- Label in the * column, sort arrow in Auto. These used to be
                                     a horizontal StackPanel, which measures its children with
                                     INFINITE width — so the CharacterEllipsis below never fired
                                     and a long label (Spanish JUGADORES, ANFITRIÓN) overflowed
                                     onto the next column instead of being trimmed. -->
                                <Button x:Name="ColButtonRoom" Grid.Column="0" Style="{StaticResource MpColHeaderButton}" Tag="Room" Click="RoomHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="ColHeaderRoom" Foreground="{DynamicResource MpTextLabel}" FontSize="{StaticResource MpPillSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="SortArrowRoom" Text="⇅" Foreground="{DynamicResource MpTextLabel}" FontSize="{StaticResource FontSizeCaption}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="ColButtonHost" Grid.Column="2" Style="{StaticResource MpColHeaderButton}" Tag="Host" Click="RoomHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="ColHeaderHost" Foreground="{DynamicResource MpTextLabel}" FontSize="{StaticResource MpPillSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="SortArrowHost" Text="⇅" Foreground="{DynamicResource MpTextLabel}" FontSize="{StaticResource FontSizeCaption}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="ColButtonPlayers" Grid.Column="3" Style="{StaticResource MpColHeaderButton}" Tag="Players" Click="RoomHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="ColHeaderPlayers" Foreground="{DynamicResource MpTextLabel}" FontSize="{StaticResource MpPillSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="SortArrowPlayers" Text="⇅" Foreground="{DynamicResource MpTextLabel}" FontSize="{StaticResource FontSizeCaption}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="ColButtonPing" Grid.Column="4" Style="{StaticResource MpColHeaderButton}" Tag="Ping" Click="RoomHeader_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="ColHeaderPing" Foreground="{DynamicResource MpTextLabel}" FontSize="{StaticResource MpPillSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="SortArrowPing" Text="⇅" Foreground="{DynamicResource MpTextLabel}" FontSize="{StaticResource FontSizeCaption}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <TextBlock Grid.Column="6" x:Name="ColHeaderAction"
                                           Foreground="{DynamicResource MpTextLabel}"
                                           FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            </Border>

                <!-- Cards OR empty-state. ScrollViewer keeps it scannable
                     when many rooms exist; RoomsListPanel is a StackPanel so
                     each card stretches edge-to-edge (full-width list rows). -->
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="RoomsListScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,10,16,10">
                        <StackPanel x:Name="RoomsListPanel"/>
                    </ScrollViewer>

                    <!-- Empty-state card. Visibility is toggled by
                         RefreshLobbiesAsync() â€” hidden by default,
                         shown when /lobbies returns zero. Visible
                         over the scroll so it sits centered. -->
                    <Border x:Name="RoomsEmptyState"
                            Background="Transparent"
                            BorderBrush="{DynamicResource MpDivider}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Margin="40,30,40,30"
                            Padding="40,40"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <!-- Simple SVG-style illustration: a
                                 pair of crossed flags + a drum.
                                 Pure Path geometry so no asset
                                 file is needed and it tints with
                                 the foreground colour. -->
                            <Viewbox Width="96" Height="96" Margin="0,0,0,18">
                                <Canvas Width="64" Height="64">
                                    <!-- Left flag staff + flag -->
                                    <Path Stroke="{DynamicResource TextSecondary}"
                                          StrokeThickness="1.5"
                                          Fill="{DynamicResource MpSurfaceAlt}"
                                          Data="M 20 4 L 20 50"/>
                                    <Path Stroke="{DynamicResource TextSecondary}"
                                          StrokeThickness="1.2"
                                          Fill="{DynamicResource MpSurfaceAlt}"
                                          Data="M 20 6 L 32 10 L 20 16 Z"/>
                                    <!-- Right flag -->
                                    <Path Stroke="{DynamicResource TextSecondary}"
                                          StrokeThickness="1.5"
                                          Fill="{DynamicResource MpSurfaceAlt}"
                                          Data="M 44 4 L 44 50"/>
                                    <Path Stroke="{DynamicResource TextSecondary}"
                                          StrokeThickness="1.2"
                                          Fill="{DynamicResource MpSurfaceAlt}"
                                          Data="M 44 6 L 56 10 L 44 16 Z"/>
                                    <!-- Drum body -->
                                    <Ellipse Stroke="{DynamicResource TextSecondary}"
                                             StrokeThickness="1.6"
                                             Fill="{DynamicResource MpSurfaceAlt}"
                                             Canvas.Left="18" Canvas.Top="36"
                                             Width="28" Height="22"/>
                                    <Ellipse Stroke="{DynamicResource TextSecondary}"
                                             StrokeThickness="1.4"
                                             Fill="{DynamicResource MpSurface}"
                                             Canvas.Left="18" Canvas.Top="32"
                                             Width="28" Height="8"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="EmptyTitleText"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="{StaticResource FontSizeSubtitle}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyBodyText"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Margin="0,6,0,18"
                                       HorizontalAlignment="Center"/>
                            <Button x:Name="EmptyCreateButton"
                                    Click="CreateRoomButton_Click"
                                    Style="{StaticResource MpOutlineBlueButton}"
                                    MinWidth="170"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Errors box (network/API). Shown when
                         RefreshLobbiesAsync throws â€” populated by
                         setting RoomsErrorText.Text + visibility. -->
                    <Border x:Name="RoomsErrorBox"
                            VerticalAlignment="Top"
                            Margin="24,12,24,0"
                            Padding="14,10"
                            Background="{DynamicResource StatusErrorBg}"
                            BorderBrush="{DynamicResource MpStatusOffline}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="RoomsErrorText"
                                   Foreground="{DynamicResource MpStatusOffline}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>

                            <!-- Footer: room count (no pagination — the list
                                 scrolls). Left inset matches the header/rows
                                 (30px). -->
                            <Border Grid.Row="3"
                                    BorderBrush="{DynamicResource MpDivider}"
                                    BorderThickness="0,1,0,0"
                                    Padding="30,10,30,12">
                                <TextBlock x:Name="RoomsShowingCount"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- COMMUNITY ACTIVITY (design handoff 1a). Sits under the list so
                         the screen doesn't read as empty when only one room exists —
                         which is what it replaces, a half-screen illustration.

                         ⚠ The reference gives this strip THREE cards. Only this one is
                         built, because the other two have no data to build from: PEAK
                         HOURS needs activity bucketed by time of day and RANKING needs a
                         top-N by rating, and the backend exposes neither — matches/elo
                         is per-user, not a leaderboard. Faking either would break the
                         handoff's own "don't invent backend fields" rule, so they wait
                         for the endpoints. -->
                    <Border x:Name="ActivityStrip"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Margin="0,10,0,0"
                            Padding="13,12"
                            Background="{DynamicResource MpPanel}"
                            BorderBrush="{DynamicResource MpRimFaint}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusRow}">
                        <StackPanel>
                            <TextBlock x:Name="ActivityRecentTitle"
                                       Foreground="{DynamicResource MpTextLabel}"
                                       FontSize="{StaticResource MpPillSize}"
                                       FontWeight="SemiBold"/>
                            <StackPanel x:Name="ActivityRecentList" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                    <!-- /LEFT card -->

                    <!-- ===================== RIGHT: chat / players, as TABS =====================
                         The two used to be stacked cards splitting this column in half. The
                         reference gives them one card and two tabs, which is what hands the
                         chat the other half's ~300px: a chat you have to scroll three
                         messages at a time is the thing the split was costing. -->
                    <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{DynamicResource MpSurface}"
                            CornerRadius="{StaticResource RadiusLg}"
                            Margin="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#3A6BD0" BlurRadius="18" ShadowDepth="0" Opacity="0.28"/>
                        </Border.Effect>
                    </Border>
                    <Border Grid.Row="0"
                            Background="{DynamicResource MpSurface}"
                            BorderBrush="{DynamicResource MpCardBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- title -->
                                <RowDefinition Height="Auto"/>   <!-- channel + presence -->
                                <RowDefinition Height="*"/>      <!-- messages -->
                                <RowDefinition Height="Auto"/>   <!-- input -->
                            </Grid.RowDefinitions>

                            <!-- Panel tabs. GlobalChatHeaderText and PlayersPanelTitle keep
                                 their names and their localized captions — they are the tab
                                 labels now, so every existing writer (presence count, player
                                 count) still lands in the right place. -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Margin="8,6,8,4"
                                        VerticalAlignment="Center">
                                <Button x:Name="PanelTabChat"
                                        Click="PanelTab_Click"
                                        Style="{StaticResource SubTab}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="GlobalChatHeaderText" VerticalAlignment="Center"/>
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{DynamicResource MpOk}"
                                                 VerticalAlignment="Center"
                                                 Margin="7,0,5,0"/>
                                        <TextBlock x:Name="GlobalChatPresenceText" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PanelTabPlayers"
                                        Click="PanelTab_Click"
                                        Style="{StaticResource SubTab}">
                                    <TextBlock x:Name="PlayersPanelTitle" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- Thin divider under the merged header. -->
                            <Border Grid.Row="1"
                                    Height="1"
                                    Background="{DynamicResource MpDivider}"
                                    Margin="14,0,14,0"/>

                            <!-- Chat body and players list share this cell and are
                                 toggled by PanelTab_Click. Two siblings rather than one
                                 swapped child, so the chat's scroll position survives a
                                 trip to the players tab and back. -->
                            <Grid Grid.Row="2" x:Name="PanelChatBody">
                                <ScrollViewer x:Name="GlobalChatScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="10,0,10,0">
                                    <StackPanel x:Name="GlobalChatPanel"/>
                                </ScrollViewer>
                                <TextBlock x:Name="GlobalChatEmptyHint"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="18"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>

                            <ScrollViewer Grid.Row="2"
                                          x:Name="PlayersScroll"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="10,4,10,4">
                                <StackPanel x:Name="PlayersPanel"/>
                            </ScrollViewer>

                            <!-- Composer: text box + Send. Hidden with the chat — a
                                 message box under a list of players would have nowhere
                                 to send to. -->
                            <Border Grid.Row="3" x:Name="PanelChatComposer"
                                    BorderBrush="{DynamicResource MpDivider}"
                                    BorderThickness="0,1,0,0"
                                    Padding="10,6">
                                <StackPanel>
                                    <!-- Quick replies. Openers for a quiet channel —
                                         they fill the box, they don't send. -->
                                    <StackPanel x:Name="QuickReplies"
                                                Orientation="Horizontal"
                                                Margin="2,0,2,7">
                                        <Button x:Name="QuickReplyAnyone" Click="QuickReply_Click" Style="{StaticResource MpQuickReply}"/>
                                        <Button x:Name="QuickReplyGg" Click="QuickReply_Click" Style="{StaticResource MpQuickReply}"/>
                                        <Button x:Name="QuickReplyMinute" Click="QuickReply_Click" Style="{StaticResource MpQuickReply}"/>
                                    </StackPanel>
                                    <!-- Throttle / slow-mode hint: shown when the
                                         server drops a message, cleared on next keystroke. -->
                                    <TextBlock x:Name="GlobalChatNotice"
                                               Foreground="{DynamicResource MpStatusReconnect}"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               TextWrapping="Wrap"
                                               Margin="2,0,2,6"
                                               Visibility="Collapsed"/>
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <TextBox x:Name="GlobalChatInput"
                                                 MaxLength="500"
                                                 MinHeight="32"
                                                 Padding="10,0,0,0"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="GlobalChatInput_TextChanged"
                                                 KeyDown="GlobalChatInput_KeyDown"/>
                                        <TextBlock x:Name="GlobalChatPlaceholder"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>
                                    <!-- Send: compact icon button (paper-plane
                                         glyph). Localized caption lives on the
                                         ToolTip now (set in ApplyStrings). -->
                                    <Button x:Name="GlobalChatSendButton"
                                            Grid.Column="1"
                                            Click="GlobalChatSendButton_Click"
                                            Style="{StaticResource MpPrimaryButton}"
                                            Width="34"
                                            Height="32"
                                            Padding="0">
                                        <TextBlock Text="&#xE724;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    </Grid>
                    <!-- /RIGHT chat + players -->
                </Grid>
            </Grid>


            <!-- The lobby UI that used to live here as a non-modal
                 floating popup (Canvas + RoomPopupCard Border + 600 lines
                 of content) has moved to LobbyWindow.xaml. It is now a
                 real top-level Window opened from MultiplayerTab.xaml.cs
                 via OpenLobbyWindow() — see the comment block above that
                 method. The browser stays here, fully visible while the
                 lobby is open since the Window does not overlay it. -->
        </Grid>                 <!-- x:Name="RoomsView" -->

        <!-- Profile / History / Friends subviews. -->
        <Grid Grid.Row="1" x:Name="ProfileView" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock x:Name="ProfileNameText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="ProfileLoginText"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="0,2,0,16"/>
                    <TextBlock x:Name="ProfileEloText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="{StaticResource FontSizeBodyStrong}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="ProfileGamesText"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="{StaticResource FontSizeBody}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" x:Name="HistoryView" Visibility="Collapsed">
            <TextBlock Text="History â€” coming soon"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"/>
        </Grid>

        <Grid Grid.Row="1" x:Name="FriendsView" Visibility="Collapsed">
            <TextBlock Text="Friends â€” coming soon"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontStyle="Italic"/>
        </Grid>

    </Grid>
</UserControl>
