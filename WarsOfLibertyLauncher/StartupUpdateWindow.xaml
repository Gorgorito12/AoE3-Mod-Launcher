<controls:BaseDialog x:Class="WarsOfLibertyLauncher.StartupUpdateWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
                     Width="460"
                     WindowStartupLocation="CenterScreen"
                     ShowInTaskbar="True">
    <StackPanel x:Name="ProgressBlock">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressLabelText" Style="{StaticResource WindowBody}"
                       Foreground="{DynamicResource WindowMuted}"
                       FontSize="{DynamicResource SetRowDescSize}"/>
            <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Margin="10,0,0,0"
                       Style="{StaticResource DialogFieldAux}"
                       Foreground="{DynamicResource UiBodyText}"
                       FontSize="{DynamicResource DialogBodySize}" FontWeight="SemiBold"/>
        </Grid>
        <ProgressBar x:Name="DownloadProgress" Style="{StaticResource DialogProgress}"
                     Minimum="0" Maximum="100" Value="0"/>
    </StackPanel>
</controls:BaseDialog>
