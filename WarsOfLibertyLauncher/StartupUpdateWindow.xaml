<Window x:Class="WarsOfLibertyLauncher.StartupUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBase}"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
            <Setter Property="Height" Value="10"/>
        </Style>
    </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar x:Name="Chrome" Grid.Row="0"
                       ShowMinimize="True" ShowMaximize="False" ShowClose="True"/>
    <StackPanel Grid.Row="1" Margin="24,20">
        <TextBlock x:Name="HeaderText"
                   FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,6"/>
        <TextBlock x:Name="BodyText"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18"/>

        <Grid Margin="0,0,0,4">
            <TextBlock x:Name="ProgressLabelText"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="ProgressPercentText"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Right"/>
        </Grid>
        <ProgressBar x:Name="DownloadProgress"
                     Minimum="0" Maximum="100" Value="0"
                     Margin="0,0,0,4"/>

        <Grid Margin="0,0,0,18">
            <TextBlock x:Name="SpeedText"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBlock x:Name="EtaText"
                       FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Right"/>
        </Grid>

        <Button x:Name="SkipButton"
                Click="SkipButton_Click"
                HorizontalAlignment="Right"
                Style="{StaticResource DialogButton}"
                MinWidth="140"/>
    </StackPanel>
  </Grid>
</Window>
