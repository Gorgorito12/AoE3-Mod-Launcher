<Window x:Class="WarsOfLibertyLauncher.MatchWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Match"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpPanel}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">
    <!--
        What the person RUNNING a tournament sees of a match being played.

        This is not LobbyWindow and must not become it. LobbyWindow is the room you are IN:
        Ready, Start, Leave, the Record Game card, the peer pings, the Radmin address and the
        abandonment warning are all there because you are about to play. Somebody supervising
        is not a member and none of that is theirs. What they need is who is in, what state the
        match is in, what is being said, and the result when it lands.

        PREVIEW SURFACE. The server refuses this three times over - a lobby in `in_game`
        rejects every join before it looks at seats or roles, a lobby bound to a bracket slot
        admits only that slot's entrants with no owner exemption, and tournament rooms are
        created with zero spectator slots. So the footer says so, in the window, rather than
        only in a commit message.
    -->
    <Border BorderBrush="{DynamicResource MpRimSoft}" BorderThickness="1">
        <!-- Named because MpAlertOverlay hosts itself on a Grid, and the inert notice this
             window's chat box raises has to land somewhere. -->
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                               Background="{DynamicResource MpTitleBar}"
                               ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

            <StackPanel Grid.Row="1" Margin="18,16,18,16">

                <!-- WHICH MATCH. An organiser arrives from the bracket, not from the room
                     list, so the first thing said is which bracket slot this is. -->
                <TextBlock x:Name="MatchLabel"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           FontSize="{DynamicResource MpLabelSize}"
                           Foreground="{DynamicResource MpTextMuted}"/>

                <TextBlock x:Name="RoomTitleText"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"
                           FontFamily="{DynamicResource DisplayFont}"
                           FontWeight="Bold"
                           FontSize="{DynamicResource MpPageTitleSize}"
                           Foreground="{DynamicResource MpTextHeading}"/>

                <!-- State, on its own line: a green dot and how long it has been going. The
                     same vocabulary the bracket card uses, so arriving here confirms rather
                     than re-describes. -->
                <StackPanel x:Name="StateRow" Orientation="Horizontal" Margin="0,7,0,0">
                    <Border x:Name="StateDot"
                            Width="6" Height="6"
                            CornerRadius="3"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MpOk}"/>
                    <TextBlock x:Name="StateText"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource MpLabelSize}"
                               Foreground="{DynamicResource MpOkText}"/>
                    <TextBlock x:Name="ModText"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="{DynamicResource MpLabelSize}"
                               Foreground="{DynamicResource MpTextGhost}"/>
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <!-- The roster is two names in a 1v1 and six in a 3v3; the chat is the
                         half that wants room. Weighted rather than even for that reason. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- WHO IS IN. Rendered from the room's roster, grouped by the side the
                         bracket froze - an organiser checking a dispute needs to see that the
                         people in the room are the people the bracket says. -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="RosterLabel"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource MpLabelSize}"
                                   Foreground="{DynamicResource MpTextMuted}"/>
                        <StackPanel x:Name="RosterPanel" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Margin="16,0"
                            Background="{DynamicResource MpRimFaint}"/>

                    <!-- WHAT IS BEING SAID. With its box, because an organiser who can see a
                         dispute and cannot say anything is not refereeing. -->
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="ChatLabel"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource MpLabelSize}"
                                   Foreground="{DynamicResource MpTextMuted}"/>
                        <Border Margin="0,8,0,0"
                                Height="184"
                                CornerRadius="{StaticResource RadiusRow}"
                                Background="{DynamicResource MpAppBg}"
                                BorderBrush="{DynamicResource MpRimSoft}"
                                BorderThickness="1">
                            <ScrollViewer x:Name="ChatScroll"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="10,8">
                                <StackPanel x:Name="ChatPanel"/>
                            </ScrollViewer>
                        </Border>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Height="32"
                                    CornerRadius="{StaticResource RadiusRow}"
                                    Background="{DynamicResource MpField}"
                                    BorderBrush="{DynamicResource MpRimSoft}"
                                    BorderThickness="1">
                                <TextBox x:Name="ChatInputBox"
                                         VerticalAlignment="Center"
                                         Margin="10,0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource MpTextPrimary}"
                                         FontSize="{DynamicResource MpLabelSize}"/>
                            </Border>
                            <Button Grid.Column="1"
                                    x:Name="ChatSendButton"
                                    Margin="8,0,0,0"
                                    MinWidth="76"
                                    Height="32"
                                    Style="{StaticResource MpPrimaryButton}"
                                    Click="ChatSendButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- The result, once there is one. Collapsed until then rather than showing
                     an empty slot, which would read as a result nobody could see. -->
                <Border x:Name="ResultBox"
                        Visibility="Collapsed"
                        Margin="0,16,0,0"
                        Padding="11,9"
                        CornerRadius="{StaticResource RadiusControl}"
                        Background="{DynamicResource MpActionSoftBg}">
                    <TextBlock x:Name="ResultText"
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="{DynamicResource MpPillSize}"
                               Foreground="{DynamicResource MpActionText}"/>
                </Border>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="{DynamicResource MpRowHighlight}"
                    BorderBrush="{DynamicResource MpRimSoft}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Says what this is, IN the window. A preview that only admits to being
                         one in a commit message is a preview somebody will screenshot as a
                         promise. -->
                    <TextBlock Grid.Column="0"
                               x:Name="PreviewNote"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               FontSize="{DynamicResource MpPillSize}"
                               Foreground="{DynamicResource MpTextGhost}"/>
                    <Button Grid.Column="1"
                            x:Name="CloseBtn"
                            MinWidth="100"
                            Style="{StaticResource MpPrimaryButton}"
                            Click="CloseBtn_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
