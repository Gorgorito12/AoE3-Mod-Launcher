<Window x:Class="WarsOfLibertyLauncher.MatchWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Watching a match"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="False">
    <!--
        What the person RUNNING a tournament sees of a match (design 99).

        This is not LobbyWindow and must not become it. LobbyWindow is the room you are IN:
        Ready, Start, Leave, the Record Game card, the peer pings, the Radmin address and the
        abandonment warning are all there because you are about to play. Somebody supervising
        is not a member and none of that is theirs. What they need is who is in, what state the
        match is in, what is being said, and the result when it lands.

        PREVIEW SURFACE. The server refuses this three times over - a lobby in `in_game`
        rejects every join before it looks at seats or roles, a lobby bound to a bracket slot
        admits only that slot's entrants with no owner exemption, and tournament rooms are
        created with zero spectator slots. So the chat is read-only and the window says why.
    -->
    <Window.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource GlassPanel}"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SetCaptionSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SetCaptionSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource UiTextFaint}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                           ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

        <StackPanel Grid.Row="1" Margin="22,22,22,18">

            <!-- WHICH MATCH. An organiser arrives from the bracket, not from the room list, so
                 the first thing said is which bracket slot this is. -->
            <TextBlock x:Name="MatchLabel"
                       FontSize="{DynamicResource SetCaptionSize}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource ModAccentText}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="RoomTitleText"
                       Margin="0,7,0,0"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource DisplayFont}"
                       FontSize="{DynamicResource SetPageTitleSize}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource WindowStrongText}"/>

            <WrapPanel Margin="0,9,0,0">
                <Border x:Name="StateRow" Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="6" Height="6" Margin="0,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StateText" Style="{StaticResource ChipText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="#E6C06A"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="FormatText" Style="{StaticResource ChipText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="11" Height="11" Margin="0,0,6,0" Fill="#7EE08B"
                              Data="M1,1 H6 L11,6 L6,11 L1,6 Z" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ModText" Style="{StaticResource ChipText}"/>
                        <TextBlock x:Name="ModVersionText" Style="{StaticResource ChipText}"
                                   FontFamily="Consolas, Courier New, monospace"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Only with a result: an empty box would read as one the organiser cannot see. -->
            <Border x:Name="ResultBox" Style="{StaticResource WindowCard}"
                    BorderBrush="#5C4FD68A" Padding="13,11" Margin="0,14,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ResultLabel" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Grid.Column="1" x:Name="ResultWhen"
                               FontSize="{DynamicResource SetDescSize}"
                               Foreground="{DynamicResource WindowFineText}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="1" x:Name="ResultText"
                               FontSize="{DynamicResource SetBodySize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WindowStrongText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,4,14,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResultScore"
                               FontFamily="Consolas, Courier New, monospace"
                               FontSize="{DynamicResource SetSectionTitleSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WindowCopied}"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="ResultSub"
                               FontSize="{DynamicResource SetRowDescSize}"
                               Foreground="{DynamicResource WindowMuted}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource WindowCard}" BorderBrush="#1AFFFFFF" Padding="13,11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RosterLabel" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="RosterCount"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="{DynamicResource SetControlSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WindowMuted}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="RosterPanel"/>
                        <TextBlock x:Name="RosterNote"
                                   FontSize="{DynamicResource SetControlSize}"
                                   Foreground="{DynamicResource WindowFineText}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WindowCard}" BorderBrush="#1AFFFFFF">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource WindowFooterRule}" BorderThickness="0,0,0,1"
                                Padding="13,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ChatLabel" Style="{StaticResource SectionLabel}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                <Border Grid.Column="1" x:Name="ReadOnlyChip" Height="22" Padding="8,0"
                                        CornerRadius="11" Background="#0FFFFFFF"
                                        BorderBrush="#24FFFFFF" BorderThickness="1" Cursor="Help">
                                    <TextBlock x:Name="ReadOnlyText"
                                               FontSize="{DynamicResource SetGroupLabelSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WindowMuted}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" x:Name="ChatScroll" Padding="0"
                                      Height="184"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ChatPanel" Margin="13,12,13,3"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource GlassFooter}"
                BorderBrush="{DynamicResource WindowFooterRule}"
                BorderThickness="0,1,0,0"
                Padding="22,12,22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PreviewNote"
                           FontSize="{DynamicResource SetControlSize}"
                           Foreground="{DynamicResource WindowFineText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <Button Grid.Column="1" x:Name="DecideBtn"
                        Style="{StaticResource WindowSecondaryButton}"
                        MinWidth="0" Margin="0,0,10,0" Click="DecideBtn_Click"/>
                <Button Grid.Column="2" x:Name="CloseBtn"
                        Style="{StaticResource WindowPrimaryButton}"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
