<Window x:Class="WarsOfLibertyLauncher.CreateLobbyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Create room"
        Width="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="False">
    <!-- Design 88, the twin of the new-tournament window: the window of the chosen mod, two columns
         of glass cards under the room type, and Cancel beside the one primary button. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Star, not Auto: with SizeToContent this still measures to the content, and once
                 MaxHeight clamps the window it is the row that gives, so the footer stays on screen. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                           PlainTitle="True" TitleSize="13"
                           ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel Margin="22,20,22,0">

                <!-- The type goes first and on one row: 1v1 is already a competitive room. -->
                <Border x:Name="KindCard" Style="{DynamicResource WindowCard}" Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="KindLabel" Style="{DynamicResource WindowCardLabel}"/>
                        <controls:SegmentRow x:Name="KindRow" SegmentHeight="46" Margin="0,8,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="KindDot" Width="7" Height="7" Fill="#E6C06A" Margin="0,5,8,0"
                                     VerticalAlignment="Top" Visibility="Collapsed"/>
                            <TextBlock x:Name="KindHint" Grid.Column="1" Style="{DynamicResource GlassHint}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid x:Name="Columns" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="LeftColumn">
                        <Border x:Name="ModCard" Style="{DynamicResource WindowCard}" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="ModLabel" Style="{DynamicResource WindowCardLabel}"/>
                                <Button x:Name="ModPickButton" Style="{DynamicResource GlassPickButton}" Margin="0,7,0,0"
                                        Click="ModPickButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource WindowSecondary}">
                                            <Border x:Name="ModIconHost" CornerRadius="6"/>
                                        </Border>
                                        <TextBlock x:Name="ModNameText" Grid.Column="1" Margin="10,0"
                                                   FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource UiHeadText}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ModChevron" Grid.Column="2" Text="&#x25BE;"
                                                   FontSize="{DynamicResource SetCaptionSize}"
                                                   Foreground="{DynamicResource UiMutedText}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <StackPanel x:Name="CopyRow" Visibility="Collapsed" Margin="0,14,0,0">
                                    <TextBlock x:Name="CopyLabel" Style="{DynamicResource WindowCardLabel}"/>
                                    <WrapPanel x:Name="CopyPills" Margin="0,7,-6,-6"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse x:Name="FingerprintDot" Width="7" Height="7" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FingerprintText" Margin="7,0,0,0" VerticalAlignment="Center"
                                               FontSize="{DynamicResource SetControlSize}"/>
                                </StackPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TitleLabel" Style="{DynamicResource WindowCardLabel}"/>
                                    <TextBlock x:Name="TitleCounter" Grid.Column="1"
                                               FontFamily="Consolas, Courier New, monospace"
                                               FontSize="{DynamicResource SetCaptionSize}"
                                               Foreground="{DynamicResource WindowFineText}"/>
                                </Grid>
                                <Border x:Name="TitleField" Style="{DynamicResource GlassFieldBox}" Margin="0,7,0,0">
                                    <Grid>
                                        <TextBox x:Name="RoomTitleBox" Style="{DynamicResource DialogBareText}" MaxLength="64"
                                                 FontSize="{DynamicResource FontSizeBody}"
                                                 TextChanged="RoomTitleBox_TextChanged"/>
                                        <TextBlock x:Name="TitlePlaceholder" IsHitTestVisible="False" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   Foreground="{DynamicResource WindowFineText}"/>
                                    </Grid>
                                </Border>
                                <WrapPanel x:Name="SuggestRow" Margin="0,7,-6,-6">
                                    <Button x:Name="Suggest1" Style="{DynamicResource GlassChip}" Click="Suggest_Click"/>
                                    <Button x:Name="Suggest2" Style="{DynamicResource GlassChip}" Click="Suggest_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PasswordCard" Style="{DynamicResource WindowCard}" Padding="16,14" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock x:Name="PrivateTitleText" Style="{DynamicResource GlassRowTitle}"/>
                                        <TextBlock x:Name="PrivateHint" Style="{DynamicResource GlassRowBody}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="PrivateRoomCheck" Grid.Column="1" Style="{DynamicResource GlassToggle}"
                                                  Checked="PrivateRoomCheck_Changed" Unchecked="PrivateRoomCheck_Changed"/>
                                </Grid>
                                <Grid x:Name="PasswordRow" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{DynamicResource GlassFieldBox}">
                                        <Grid>
                                            <PasswordBox x:Name="PasswordBox" Style="{DynamicResource DialogBarePassword}"
                                                         FontFamily="Consolas, Courier New, monospace"
                                                         FontSize="{DynamicResource FontSizeBody}"
                                                         PasswordChanged="PasswordBox_PasswordChanged"/>
                                            <TextBox x:Name="PasswordPlainBox" Style="{DynamicResource DialogBareText}"
                                                     FontFamily="Consolas, Courier New, monospace"
                                                     FontSize="{DynamicResource FontSizeBody}"
                                                     Visibility="Collapsed" TextChanged="PasswordPlainBox_TextChanged"/>
                                            <TextBlock x:Name="PasswordPlaceholder" IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas, Courier New, monospace"
                                                       FontSize="{DynamicResource FontSizeBody}"
                                                       Foreground="{DynamicResource WindowFineText}"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="PasswordRevealButton" Grid.Column="2" Height="40" MinWidth="0" Padding="12,0"
                                            Style="{DynamicResource GlassSideButton}" Click="PasswordReveal_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="RightColumn" Grid.Column="2">
                        <Border x:Name="SeatsCard" Style="{DynamicResource WindowCard}" Padding="16,14">
                            <StackPanel>
                                <StackPanel x:Name="MaxPlayersBlock" Margin="0,0,0,14">
                                    <TextBlock x:Name="MaxPlayersLabel" Style="{DynamicResource WindowCardLabel}"/>
                                    <controls:SegmentRow x:Name="MaxPlayersRow" Gap="4" Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="ObserversBlock" Margin="0,0,0,14">
                                    <TextBlock x:Name="ObserversLabel" Style="{DynamicResource WindowCardLabel}"/>
                                    <controls:SegmentRow x:Name="ObserversRow" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="ObserversHint" Style="{DynamicResource GlassHint}" Margin="0,7,0,0"/>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource WindowFooterRule}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SummaryPlayers" Style="{DynamicResource GlassFigure}"/>
                                        <TextBlock x:Name="SummaryPlayersWord" Style="{DynamicResource GlassFigureWord}"/>
                                        <StackPanel x:Name="SummaryObserversBlock" Orientation="Horizontal">
                                            <TextBlock Text="&#xB7;" Margin="8,0,0,0" Foreground="#61779A"
                                                       FontSize="{DynamicResource SetRowDescSize}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SummaryObservers" Style="{DynamicResource GlassFigure}" Margin="8,0,0,0"/>
                                            <TextBlock x:Name="SummaryObserversWord" Style="{DynamicResource GlassFigureWord}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NetCard" Style="{DynamicResource WindowCard}" Padding="16,14" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="NetDot" Width="8" Height="8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NetTitle" Style="{DynamicResource GlassRowTitle}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="NetBody" Style="{DynamicResource GlassRowBody}" Margin="0,8,0,0"/>
                                <Button x:Name="NetHelpButton" Style="{DynamicResource GlassSideButton}" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" MinWidth="0" Padding="12,0" Click="NetHelpButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="22,18,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Style="{DynamicResource GlassRowBody}" Foreground="{DynamicResource UiErrorText}"
                       Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Grid.Column="1" Style="{DynamicResource WindowSecondaryButton}"
                    MinWidth="112" FontSize="{DynamicResource DialogBodySize}" IsCancel="True" Click="CancelButton_Click"/>
            <Button x:Name="CreateButton" Grid.Column="2" Style="{DynamicResource WindowPrimaryButton}"
                    MinWidth="136" Padding="16,0" Margin="8,0,0,0" FontSize="{DynamicResource DialogBodySize}"
                    ToolTipService.ShowOnDisabled="True" IsDefault="True" Click="CreateButton_Click"/>
        </Grid>
    </Grid>
</Window>
