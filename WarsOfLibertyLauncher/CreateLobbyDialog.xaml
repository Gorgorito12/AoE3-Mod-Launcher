<Window x:Class="WarsOfLibertyLauncher.CreateLobbyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WarsOfLibertyLauncher"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Create a room"
        Width="596"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpPanel}"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Resolves a ModProfile (the mod ComboBoxItem's Tag) to its icon
             brush for the dropdown items. -->
        <local:ModProfileIconBrushConverter x:Key="ModProfileIconConv"/>

        <!-- Uppercase section caption. 600/11 with letter-spacing in the reference;
             WPF's TextBlock has no letter-spacing at all, so the tracking is the one
             thing here that cannot be reproduced (documented deviation, same as 1a). -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MpTextMuted}"/>
            <Setter Property="FontSize" Value="{StaticResource MpLabelSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- A ComboBox with NO chrome of its own: it is stretched over the mod card so
             that clicking the card opens the list, and the card underneath draws
             everything the user sees. The popup still anchors to the control, which is
             why this is a transparent ComboBox rather than a Button plus a hand-built
             popup. -->
        <Style x:Key="InvisiblePicker" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Background="Transparent">
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource MpField}"
                                        BorderBrush="{DynamicResource MpRimStrong}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusRow}"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ModCombo dropdown items: mod ICON disc + name. The item Content is the mod
             NAME string; the icon is bound from the item's Tag (the ModProfile). -->
        <Style x:Key="ModComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22"
                                        CornerRadius="6"
                                        Margin="0,0,9,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ModProfileIconConv}}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource MpRowHighlight}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource MpActionSoftBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The room-title field: 40 tall, radius 8, and a 2 px blue ring on focus
             (the reference draws it focused, because it is where the dialog starts). -->
        <Style x:Key="MpTitleField" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource MpField}"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource MpActionText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusRow}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource MpActionRim}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title suggestion pill. Half-height radius, never the CSS 999 idiom, which
             WPF renders as a distorted ellipse. -->
        <Style x:Key="MpSuggestPill" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource MpQuickReplyBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource MpActionText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource MpLabelSize}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource MpActionSoftBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One segment of the max-players row. The active one is a solid blue fill;
             the rest are a rim only. Set through Tag, so the row can be rebuilt from
             code without touching brushes. -->
        <Style x:Key="MpSegment" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimMedium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource MpMetaSize}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="seg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="{DynamicResource MpRowHighlight}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="seg" Property="Background" Value="{DynamicResource MpAction}"/>
                                <Setter TargetName="seg" Property="BorderBrush" Value="{DynamicResource MpAction}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The private-room checkbox. Its content is a two-line block, so the box is
             top-aligned rather than centred on a single line of text. -->
        <Style x:Key="MpPrivateCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="checkBorder"
                                    Grid.Column="0"
                                    Width="18" Height="18"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource MpPrivateFieldRim}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <Path x:Name="checkMark"
                                      Data="M 3 8 L 6.5 11.5 L 13 4"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBorder" Property="Background" Value="{DynamicResource MpPrivate}"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="{DynamicResource MpPrivate}"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="{DynamicResource MpPrivate}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The password pair. Both are chromeless: the row's Border is the field. -->
        <Style x:Key="MpPrivateField" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpPrivateText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource MpPrivateText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource MpBodySize}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Focusable="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MpPrivateFieldText" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpPrivateText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource MpPrivateText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource MpBodySize}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MpRevealLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpPrivateSub}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource MpLabelSize}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="content" Property="TextBlock.TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Footer buttons: 36 tall, radius 7. Ghost cancel, solid create. -->
        <Style x:Key="MpFooterGhost" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource MpBodySize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- NO hover setter here, and that is the whole point. This template
                                 is inherited (MpFooterPrimary is BasedOn this style), and a
                                 ControlTemplate trigger that paints a template element BY NAME
                                 is unreachable from any derived style — so a colour hardcoded
                                 here is imposed on every descendant with no way out. It used to
                                 set b.Background to MpRowHighlight, which is right for a
                                 TRANSPARENT ghost and an APAGÓN for the filled primary: hovering
                                 Create replaced its blue with #16263E, exactly when the user was
                                 about to click it. Hover now lives in each Style's own triggers,
                                 on the BUTTON's Background, which reaches the Border through the
                                 TemplateBinding above. -->
                            <!-- While busy, the state is said with the WORD, not with opacity.
                                 This went through 0.45 opacity (both buttons dissolved into the
                                 navy footer) and then a two-step drop to MpTextFaint + a rim at
                                 9% alpha, which still read as "the interface ate them" — and it
                                 is reported as such, twice. The shape now stays put: the rim
                                 keeps its normal strength so the button is still visibly THERE,
                                 and only the text steps down ONE notch of the ramp. The moment
                                 these go inert is the moment the user has pressed Create and is
                                 waiting to learn whether the click registered; receding is the
                                 opposite of the message. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MpTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Transparent at rest, so a subtle lift is the correct hover here. Declared on
                     the Button's own Background so a derived style can replace it — see the
                     template comment above. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MpRowHighlight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MpFooterPrimary" TargetType="Button" BasedOn="{StaticResource MpFooterGhost}">
            <Setter Property="Background" Value="{DynamicResource MpAction}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpAction}"/>
            <Setter Property="Padding" Value="22,0"/>
            <Style.Triggers>
                <!-- A FILLED button darkens on hover; it does not go grey. These two come after
                     the ghost's own hover trigger in the merged BasedOn chain, so they are the
                     ones that land. Same pair MpPrimaryButton and MpRoomActionPrimary already
                     use for an MpAction fill — reused rather than reinvented. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MpBlueHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MpBlueHover}"/>
                </Trigger>
                <!-- Press feedback exists because this whole complaint started as "I can't tell
                     whether the click registered". Answering the press is the most direct
                     possible reply to that. -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MpBluePressed}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MpBluePressed}"/>
                </Trigger>
                <!-- Unchanged while busy — fill, edge AND text. It is still the button you
                     pressed and it now reads "Creating…", so the caption already carries the
                     state; dimming it on top of that only subtracts. Style triggers outrank
                     template triggers in WPF, which is what lets this beat the inherited ghost
                     treatment (whose own disabled trigger would grey the text). -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MpAction}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The copy picker keeps an ordinary combo look: it is a rare row and does not
             carry the mod card's identity treatment. -->
        <Style x:Key="MpFormCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource MpField}"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Height" Value="{StaticResource MpFieldHeight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource RadiusControl}"/>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <TextBlock x:Name="Caret"
                                       Text="▾"
                                       Foreground="{DynamicResource MpChevron}"
                                       FontSize="{StaticResource MpMicroSize}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource MpField}"
                                        BorderBrush="{DynamicResource MpRimStrong}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusControl}"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="240">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource MpTextPrimary}"/>
                        <Setter Property="Padding" Value="12,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource MpRowHighlight}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource MpActionSoftBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer chrome: opaque window surface. The global TitleBar + WindowChrome drag +
         rounded corners are applied centrally in App.OnAnyWindowLoaded; here we keep a
         thin 1 px frame. -->
    <Border Background="{DynamicResource MpPanel}"
            BorderBrush="{DynamicResource MpRimSoft}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>     <!-- Title bar -->
                <!-- Star, not Auto. With SizeToContent="Height" this still measures to the
                     content's natural height, but once MaxHeight clamps the window (see the
                     constructor) it is the row that gives, so the ScrollViewer inside takes
                     over and the FOOTER cannot be pushed off the screen. -->
                <RowDefinition Height="*"/>        <!-- Body (scrolls when clamped) -->
                <RowDefinition Height="Auto"/>     <!-- Footer -->
            </Grid.RowDefinitions>

            <controls:TitleBar Grid.Row="0"
                               x:Name="TitleBarControl"
                               Background="{DynamicResource MpTitleBar}"
                               ShowMinimize="False"
                               ShowMaximize="False"
                               ShowClose="True"/>

            <!-- Body. 18 px padding, the reference's dialog spacing. Wrapped in a
                 ScrollViewer because this form keeps growing — the Record Game notice is
                 permanent, and the Radmin warning, the password row, the copy row and the
                 error line all pile on top of it. Without somewhere to scroll, a tall
                 enough form simply pushes its own footer past the bottom of the screen. -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0">
            <StackPanel Margin="18,4,18,18">

                <!-- MOD. The card carries the mod's identity AND its fingerprint state.
                     The fingerprint used to live behind an "Advanced details" toggle; it
                     is the usual reason another player cannot join, so hiding it meant
                     the one fact worth checking was the one nobody saw.

                     ModCombo is stretched transparently over the whole card, so the card
                     IS the picker: clicking anywhere opens the list and the popup anchors
                     to the card. Collapsed for a single installed mod, where there is
                     nothing to pick. -->
                <TextBlock x:Name="ModLabel" Style="{StaticResource SectionLabel}"/>
                <Border Margin="0,8,0,0"
                        Padding="12,10"
                        CornerRadius="{StaticResource RadiusRow}"
                        Background="{DynamicResource MpField}"
                        BorderBrush="{DynamicResource MpRimStrong}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                x:Name="ModIconHost"
                                Width="26" Height="26"
                                CornerRadius="6"
                                Background="{DynamicResource MpEventBg}"
                                VerticalAlignment="Center"
                                Margin="0,0,11,0">
                            <TextBlock x:Name="ModIconEmoji"
                                       Text="🎮"
                                       FontSize="{StaticResource MpBodySize}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ModNameText"
                                       Foreground="{DynamicResource MpTextPrimary}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse x:Name="FingerprintDot"
                                         Width="5" Height="5"
                                         Fill="{DynamicResource MpOk}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="FingerprintText"
                                           Foreground="{DynamicResource MpOkText}"
                                           FontSize="{StaticResource MpPillSize}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   x:Name="ModChevron"
                                   Text="▾"
                                   Foreground="{DynamicResource MpChevron}"
                                   FontSize="{StaticResource MpMicroSize}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <ComboBox Grid.Column="0" Grid.ColumnSpan="3"
                                  x:Name="ModCombo"
                                  Style="{StaticResource InvisiblePicker}"
                                  ItemContainerStyle="{StaticResource ModComboItem}"
                                  SelectionChanged="ModCombo_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- Which installed COPY the room uses. Collapsed unless the mod has 2+
                     copies. Interactive only for the active dashboard mod (picking a copy
                     rotates the active copy, which is what multiplayer launches and
                     fingerprints); display-only otherwise. -->
                <StackPanel x:Name="CopyRow" Visibility="Collapsed" Margin="0,16,0,0">
                    <TextBlock x:Name="CopyLabel" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="CopyCombo"
                              Style="{StaticResource MpFormCombo}"
                              Margin="0,8,0,0"
                              SelectionChanged="CopyCombo_SelectionChanged"/>
                    <TextBlock x:Name="CopyHint"
                               Foreground="{DynamicResource MpTextFaint}"
                               FontSize="{StaticResource MpLabelSize}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- TÍTULO, with the counter on the label's own line, right-aligned. -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Name="TitleLabel"
                               Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Bottom"/>
                    <TextBlock Grid.Column="1"
                               x:Name="TitleCounter"
                               Foreground="{DynamicResource MpTextDim}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource MpLabelSize}"
                               VerticalAlignment="Bottom"/>
                </Grid>
                <TextBox x:Name="RoomTitleBox"
                         Style="{StaticResource MpTitleField}"
                         MaxLength="64"
                         TextChanged="RoomTitleBox_TextChanged"
                         Margin="0,8,0,0"/>
                <!-- Suggestions APPEND to the title rather than replacing it: they are
                     things a host announces about the match, not titles of their own. -->
                <StackPanel x:Name="SuggestRow" Orientation="Horizontal" Margin="0,9,0,0">
                    <Button x:Name="Suggest1" Style="{StaticResource MpSuggestPill}" Click="Suggest_Click"/>
                    <Button x:Name="Suggest2" Style="{StaticResource MpSuggestPill}" Click="Suggest_Click"/>
                    <Button x:Name="Suggest3" Style="{StaticResource MpSuggestPill}" Click="Suggest_Click"/>
                </StackPanel>

                <!-- JUGADORES MÁXIMOS: a segmented row, not a dropdown. Eight options that
                     all fit on one line cost one click here and two in a combo, and the
                     whole range is readable without opening anything. Built in code so
                     the server's cap can disable the ones above it. -->
                <TextBlock x:Name="MaxPlayersLabel" Style="{StaticResource SectionLabel}" Margin="0,18,0,0"/>
                <UniformGrid x:Name="MaxPlayersRow" Rows="1" Margin="0,8,0,0"/>

                <!-- Sala privada. The explanation lives INSIDE the box, and the password
                     field only exists once the box is ticked — it used to sit there
                     permanently disabled beside a paragraph, which reads as broken. -->
                <Border x:Name="PrivateBox"
                        Margin="0,18,0,0"
                        Padding="12,11"
                        CornerRadius="{StaticResource RadiusRow}"
                        Background="{DynamicResource MpPrivateSoftBg}"
                        BorderBrush="{DynamicResource MpPrivateRim}"
                        BorderThickness="1">
                    <CheckBox x:Name="PrivateRoomCheck"
                              Style="{StaticResource MpPrivateCheck}"
                              Checked="PrivateRoomCheck_Changed"
                              Unchecked="PrivateRoomCheck_Changed">
                        <StackPanel>
                            <TextBlock x:Name="PrivateTitleText"
                                       Foreground="{DynamicResource MpPrivateTitle}"
                                       FontSize="{StaticResource MpBodySize}"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="PrivateHint"
                                       Foreground="{DynamicResource MpPrivateSub}"
                                       FontSize="{StaticResource MpLabelSize}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border x:Name="PasswordRow"
                        Visibility="Collapsed"
                        Height="38"
                        Margin="0,9,0,0"
                        Padding="12,0"
                        CornerRadius="{StaticResource RadiusRow}"
                        Background="{DynamicResource MpField}"
                        BorderBrush="{DynamicResource MpPrivateFieldRim}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Two controls, one value: a PasswordBox cannot reveal its own
                             text, so "Mostrar" swaps in a plain TextBox. The PasswordBox
                             stays the source of truth — see SyncPasswordControls. -->
                        <PasswordBox Grid.Column="0"
                                     x:Name="PasswordBox"
                                     Style="{StaticResource MpPrivateField}"
                                     MaxLength="50"/>
                        <TextBox Grid.Column="0"
                                 x:Name="PasswordPlainBox"
                                 Style="{StaticResource MpPrivateFieldText}"
                                 MaxLength="50"
                                 Visibility="Collapsed"/>
                        <Button Grid.Column="1"
                                x:Name="PasswordRevealButton"
                                Style="{StaticResource MpRevealLink}"
                                Click="PasswordReveal_Click"/>
                    </Grid>
                </Border>

                <!-- Recording warning. Here, BEFORE the match: once it is over there is
                     nothing left to fix, and this is the most common reason a match that
                     was actually played ends up counting for nobody. -->
                <Border Margin="0,16,0,0"
                        Padding="12,11"
                        CornerRadius="{StaticResource RadiusRow}"
                        Background="{DynamicResource MpCautionBg}"
                        BorderBrush="{DynamicResource MpCautionRim}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="⚠"
                                   Foreground="{DynamicResource MpCaution}"
                                   FontSize="{StaticResource MpMetaSize}"
                                   VerticalAlignment="Top"
                                   Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="RecordWarnText"
                                   Foreground="{DynamicResource MpCautionText}"
                                   FontSize="{StaticResource MpLabelSize}"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Non-blocking heads-up: Radmin VPN not recognised active. The room can
                     still be created and joined; only actual play needs the tunnel. -->
                <TextBlock x:Name="RadminWarning"
                           Foreground="{DynamicResource MpCautionText}"
                           FontSize="{StaticResource MpLabelSize}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
            </ScrollViewer>

            <!-- Footer: what happens when you press Create, then the two actions. The
                 server's error lands HERE, under the button that caused it — it used to
                 render in the middle of the form, far from the Create the user pressed. -->
            <Border Grid.Row="2"
                    Background="{DynamicResource MpAppBg}"
                    BorderBrush="{DynamicResource MpRimFaint}"
                    BorderThickness="0,1,0,0"
                    Padding="18,13">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Name="AnnounceNote"
                                   Foreground="{DynamicResource MpTextFaint}"
                                   FontSize="{StaticResource MpLabelSize}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Button Grid.Column="1"
                                x:Name="CancelButton"
                                Click="CancelButton_Click"
                                Style="{StaticResource MpFooterGhost}"
                                Margin="0,0,10,0"/>
                        <Button Grid.Column="2"
                                x:Name="CreateButton"
                                Click="CreateButton_Click"
                                Style="{StaticResource MpFooterPrimary}"/>
                    </Grid>
                    <TextBlock x:Name="ErrorText"
                               Foreground="{DynamicResource MpDestructiveText}"
                               FontSize="{StaticResource MpLabelSize}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
