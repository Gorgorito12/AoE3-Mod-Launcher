<Window x:Class="WarsOfLibertyLauncher.LauncherUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ChipTag" TargetType="Path">
            <Setter Property="Data" Value="M1.5 8.6 V2.2 C1.5 1.8 1.8 1.5 2.2 1.5 H8.6 L14.6 7.5 C14.9 7.8 14.9 8.2 14.6 8.5 L8.9 14.2 C8.6 14.5 8.2 14.5 7.9 14.2 Z M6.2 5 A1.2 1.2 0 1 1 3.8 5 A1.2 1.2 0 1 1 6.2 5 Z"/>
            <Setter Property="Stroke" Value="#7EE08B"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style x:Key="VersionChip" TargetType="Border">
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="{DynamicResource LibraryControl}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowCardRim}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource SetCaptionSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                       TitleIcon="pack://application:,,,/Aoe3ModLauncher;component/AppIcon.png"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

    <StackPanel Grid.Row="1" Margin="22,22,22,20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="FailMark" Width="30" Height="30" CornerRadius="8"
                    VerticalAlignment="Top" Margin="0,0,13,0"
                    Background="#33F4900C" BorderBrush="#80F4900C" BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock Text="!" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource WindowNoticeTitle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeaderText" Style="{StaticResource WindowHeadline}"/>

                <WrapPanel Margin="0,8,0,0">
                    <Border Style="{StaticResource VersionChip}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Style="{StaticResource ChipTag}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="CurrentVersionText" Style="{StaticResource ChipText}"
                                       Foreground="{DynamicResource WindowSoftText}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="&#x2192;" FontSize="{DynamicResource DialogBodySize}"
                               Foreground="{DynamicResource WindowFineText}"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <Border Style="{StaticResource VersionChip}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Style="{StaticResource ChipTag}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="LatestVersionText" Style="{StaticResource ChipText}"
                                       Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="DownloadSizeText"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="{DynamicResource SetControlSize}"
                               Foreground="{DynamicResource WindowMuted}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </WrapPanel>

                <TextBlock x:Name="BodyText" Style="{StaticResource WindowBody}"
                           Margin="0,10,0,0" Visibility="Collapsed"/>
                <Border x:Name="FolderBox" Style="{StaticResource WindowField}"
                        Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="FolderText" Style="{StaticResource WindowPath}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- The notes, in the player's language and with their format. -->
        <Border x:Name="ReleaseNotesSection" Style="{StaticResource WindowCard}"
                Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="16,11,16,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ReleaseNotesHeader" Style="{StaticResource WindowCardLabel}"
                               Margin="0" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="SeeOnGitHubLink"
                            Style="{StaticResource WindowTextLink}"
                            Click="OpenReleasePageButton_Click"/>
                </Grid>
                <ScrollViewer Grid.Row="1" MaxHeight="196" Padding="0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ReleaseNotesBody" Margin="16,0,6,14"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- The note is only an address: a button, not a line to retype. -->
        <Border x:Name="ReleaseLinkSection" Style="{StaticResource WindowCard}"
                Padding="16,12,12,12" Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ReleaseLinkHeader" Style="{StaticResource WindowCardLabel}"
                               Margin="0"/>
                    <TextBlock x:Name="ReleaseLinkBody"
                               FontSize="{DynamicResource SetRowDescSize}"
                               Foreground="{DynamicResource WindowSoftText}"
                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="SeeNotesButton"
                        Style="{StaticResource WindowSecondaryButton}"
                        VerticalAlignment="Center" Click="SeeNotesButton_Click"/>
            </Grid>
        </Border>

        <Border x:Name="LowSpaceNotice" Style="{StaticResource WindowNotice}"
                Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource WindowNoticeMark}">
                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="LowSpaceText"
                           Style="{StaticResource WindowBody}"
                           Foreground="{DynamicResource WindowNoticeTitle}"
                           Margin="10,1,0,0"/>
            </Grid>
        </Border>

        <Border x:Name="ProgressCard" Style="{StaticResource WindowCard}"
                Padding="16,14" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressPercentText"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="{DynamicResource ProfileStreakBestSize}"
                               FontWeight="SemiBold" Foreground="#FFFFFF"
                               Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="ProgressBytesText"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="{DynamicResource SetRowDescSize}"
                               Foreground="{DynamicResource WindowSoftText}"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </Grid>
                <ProgressBar x:Name="DownloadProgress" Height="8" Margin="0,10,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="{DynamicResource MpAction}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="#1FFFFFFF" CornerRadius="4"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SpeedText" FontSize="{DynamicResource SetControlSize}"
                               Foreground="{DynamicResource WindowMuted}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" x:Name="EtaText"
                               FontSize="{DynamicResource SetControlSize}"
                               Foreground="{DynamicResource WindowMuted}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border x:Name="ReadyNotice" CornerRadius="8" Padding="12,10" Margin="0,14,0,0"
                Background="{DynamicResource WindowSafeFill}"
                BorderBrush="#594FD68A" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top"
                        Background="{DynamicResource WindowSafeTick}">
                    <TextBlock Text="&#x2713;" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="ReadyText" Style="{StaticResource WindowBody}"
                           Margin="10,1,0,0"/>
            </Grid>
        </Border>

        <Border x:Name="InMatchNotice" Style="{StaticResource WindowNotice}"
                Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource WindowNoticeMark}">
                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="InMatchText" Style="{StaticResource WindowBody}"
                           Foreground="{DynamicResource WindowNoticeTitle}" Margin="10,1,0,0"/>
            </Grid>
        </Border>

        <Border x:Name="ModBusyNotice" Style="{StaticResource WindowNotice}"
                Margin="0,14,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource WindowNoticeMark}">
                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="ModBusyText" Style="{StaticResource WindowBody}"
                           Foreground="{DynamicResource WindowNoticeTitle}" Margin="10,1,0,0"/>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SecondaryButton" Style="{StaticResource WindowSecondaryButton}"
                    MinWidth="112" Click="SecondaryButton_Click"/>
            <Button x:Name="OpenReleasePageButton" Style="{StaticResource WindowSecondaryButton}"
                    MinWidth="112" Margin="8,0,0,0" Visibility="Collapsed"
                    Click="OpenReleasePageButton_Click"/>
            <Button x:Name="ActionButton" Style="{StaticResource WindowPrimaryButton}"
                    MinWidth="136" Margin="8,0,0,0" IsDefault="True"
                    Click="ActionButton_Click"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
