<Window x:Class="WarsOfLibertyLauncher.BackgroundConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBase}"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- ShowClose stays TRUE and the X means NO. A consent dialog with no way out is
         not a question, and a dismissal must never be read as agreement. -->
    <controls:TitleBar x:Name="Chrome" Grid.Row="0"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>
    <StackPanel Grid.Row="1" Margin="24,20">
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="&#x2139;"
                       FontSize="{DynamicResource FontSizeHeading}"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Top"
                       Margin="0,0,14,0"/>
            <TextBlock Grid.Column="1"
                       x:Name="BodyText"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextWrapping="Wrap"/>
        </Grid>
        <!-- Says exactly what is written and where it is undone. The old balloon named
             neither, and it arrived after the write rather than before it. -->
        <!-- UiTextDim, not "TextMuted": there is no TextMuted brush in Colors.xaml, and an
             unresolved DynamicResource does not fail or warn - the property simply keeps its
             default, which for Foreground is BLACK. On this navy it read as a smudge, in the
             one dialog whose whole job is to be read before somebody agrees to something. -->
        <TextBlock x:Name="DetailText"
                   Foreground="{DynamicResource UiTextDim}"
                   FontSize="{DynamicResource FontSizeCaption}"
                   TextWrapping="Wrap"
                   Margin="34,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="NoButton"
                    Click="NoButton_Click"
                    Style="{StaticResource SidebarPrimaryButton}"
                    Background="#3a3d44"
                    Padding="18,6"
                    MinWidth="110"
                    Margin="0,0,10,0"/>
            <Button x:Name="YesButton"
                    Click="YesButton_Click"
                    IsDefault="True"
                    Style="{StaticResource SidebarPrimaryButton}"
                    Padding="18,6"
                    MinWidth="140"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
