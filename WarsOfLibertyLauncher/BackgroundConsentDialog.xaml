<controls:BaseDialog x:Class="WarsOfLibertyLauncher.BackgroundConsentDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
                     Width="480"
                     Tone="Info">
    <!-- Says exactly what is written and where it is undone. The old balloon named neither, and
         it arrived after the write rather than before it. -->
    <TextBlock x:Name="DetailText" Style="{StaticResource DialogHint}"/>
</controls:BaseDialog>
