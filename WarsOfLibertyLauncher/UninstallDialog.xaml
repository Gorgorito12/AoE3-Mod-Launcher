<Window x:Class="WarsOfLibertyLauncher.UninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Uninstall"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="False">

    <!-- docs/design_archivos_antivirus 49b / 49d.

         ONE window uninstalls the active copy and any other copy: the caller hands
         it the plan UninstallService built for THAT folder, and the plan is what
         refuses. When it refuses (49d) the options and the Uninstall button are
         COLLAPSED, never shown disabled — a dimmed red button invites looking for
         the way to switch it on — and Close is the only action.

         Every fact is said once: the title bar says "Uninstall", the headline
         names the copy, and "Age of Empires III is not touched" lives in the green
         strip alone (it used to be the description AND a line under the options). -->

  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

    <StackPanel Grid.Row="1" Margin="24,20,24,18">

        <!-- ===== 49b: the confirmation ===== -->
        <StackPanel x:Name="ConfirmPanel">
            <TextBlock x:Name="HeaderText" Style="{StaticResource SetDialogHeadline}"/>

            <!-- The folder, rimmed red because it is what goes. -->
            <Border Style="{StaticResource SetCard}" BorderBrush="{DynamicResource UiRimDanger}"
                    Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Margin="13,11,13,11">
                        <TextBlock x:Name="DeletedLabelText" Style="{StaticResource SetCardLabel}"
                                   Foreground="{DynamicResource UiDangerLabel}"/>
                        <TextBlock x:Name="InstallPathText"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="{DynamicResource SetControlSize}"
                                   Foreground="{DynamicResource MpTextHeading}"
                                   TextWrapping="Wrap" LineHeight="18.5"
                                   Margin="0,7,0,0"/>
                        <TextBlock x:Name="CountsText"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="{DynamicResource SetMonoSize}"
                                   Foreground="{DynamicResource MpTextMuted}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Background="{DynamicResource UiOkStripBg}"
                            BorderBrush="{DynamicResource UiRimSeam}" BorderThickness="0,1,0,0"
                            Padding="13,9,13,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#x2713;" FontWeight="SemiBold"
                                       FontSize="{DynamicResource SetMonoSize}"
                                       Foreground="{DynamicResource MpOk}"
                                       Margin="0,1,9,0"/>
                            <TextBlock x:Name="SafeNoteText" Grid.Column="1"
                                       FontSize="{DynamicResource SetDescSize}"
                                       Foreground="{DynamicResource UiOkText}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ALSO REMOVE: each option says what it removes. -->
            <TextBlock x:Name="OptionsTitleText" Style="{StaticResource SetCardLabel}"
                       Margin="0,18,0,8"/>
            <Border Style="{StaticResource SetCard}">
                <StackPanel>
                    <Border x:Name="RowShortcuts" Style="{StaticResource SetRow}" Padding="12,10,12,10">
                        <CheckBox x:Name="OptDeleteShortcuts" IsChecked="True"
                                  Style="{StaticResource SetCheckBox}" VerticalContentAlignment="Top">
                            <StackPanel>
                                <TextBlock x:Name="OptShortcutsTitle" Style="{StaticResource SetRowTitle}"/>
                                <TextBlock x:Name="OptShortcutsDesc" Style="{StaticResource SetRowDesc}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border x:Name="RowRegistry" Style="{StaticResource SetRow}" Padding="12,10,12,10">
                        <CheckBox x:Name="OptRemoveRegistry" IsChecked="True"
                                  Style="{StaticResource SetCheckBox}" VerticalContentAlignment="Top">
                            <StackPanel>
                                <TextBlock x:Name="OptRegistryTitle" Style="{StaticResource SetRowTitle}"/>
                                <TextBlock x:Name="OptRegistryDesc" Style="{StaticResource SetRowDesc}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <!-- Collapsed unless this install actually seeded user-data files, and
                         always for a copy that is not the active one: every copy of a mod
                         shares ONE My Games folder. -->
                    <Border x:Name="RowUserData" Style="{StaticResource SetRowLast}" Padding="12,10,12,10"
                            Visibility="Collapsed">
                        <CheckBox x:Name="OptDeleteUserData" IsChecked="False"
                                  Style="{StaticResource SetCheckBox}" VerticalContentAlignment="Top">
                            <StackPanel>
                                <TextBlock x:Name="OptUserDataTitle" Style="{StaticResource SetRowTitle}"/>
                                <TextBlock x:Name="OptUserDataDesc" Style="{StaticResource SetRowDesc}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== 49d: refused ===== -->
        <StackPanel x:Name="RefusedPanel" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Top"
                        Background="{DynamicResource UiDangerSoftBg}" Margin="0,0,13,0">
                    <TextBlock Text="!" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource UiDangerText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="RefusedTitleText" Style="{StaticResource SetDialogHeadline}"
                               FontSize="{DynamicResource FontSizeSubtitle}"/>
                    <TextBlock x:Name="RefusedDetailText"
                               FontSize="{DynamicResource SetControlSize}"
                               Foreground="{DynamicResource MpTextBody}"
                               TextWrapping="Wrap" LineHeight="18.5" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource SetPathBox}" Margin="0,12,0,0">
                <TextBlock x:Name="RefusedPathText"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="{DynamicResource SetDescSize}"
                           Foreground="{DynamicResource UiTextStrong}"
                           TextWrapping="Wrap"/>
            </Border>
            <TextBlock x:Name="RefusedHintText"
                       FontSize="{DynamicResource SetMonoSize}"
                       Foreground="{DynamicResource UiTextDim}"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Footer: Cancel as a link, one solid button. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource SetFooterLinkButton}"
                    IsCancel="True" Margin="0,0,14,0" Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Style="{StaticResource SetFooterDangerButton}"
                    Click="OkButton_Click"/>
            <Button x:Name="CloseButton" Style="{StaticResource SetFooterSolidButton}"
                    MinWidth="110" Visibility="Collapsed" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
