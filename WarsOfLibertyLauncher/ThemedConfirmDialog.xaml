<Window x:Class="WarsOfLibertyLauncher.ThemedConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBase}"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar x:Name="Chrome" Grid.Row="0"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>
    <StackPanel Grid.Row="1" Margin="24,20">
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="ToneGlyph"
                       FontSize="{DynamicResource FontSizeHeading}"
                       VerticalAlignment="Top"
                       Margin="0,0,14,0"/>
            <TextBlock Grid.Column="1"
                       x:Name="BodyText"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextWrapping="Wrap"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- DialogButton + PrimaryButton, NOT SidebarPrimaryButton: that template paints its
                 own gold gradient and ignores Background, so "Cancel" would render as a second
                 gold button and the two choices would look the same. -->
            <Button x:Name="CancelButton"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Style="{StaticResource DialogButton}"
                    MinWidth="110"
                    Margin="0,0,10,0"/>
            <Button x:Name="ConfirmButton"
                    Click="ConfirmButton_Click"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="140"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
