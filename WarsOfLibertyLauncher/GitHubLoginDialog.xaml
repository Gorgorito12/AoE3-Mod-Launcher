<Window x:Class="WarsOfLibertyLauncher.GitHubLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Discord sign-in"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                       TitleIcon="pack://application:,,,/Aoe3ModLauncher;component/AppIcon.png"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

    <StackPanel Grid.Row="1" Margin="22,24,22,20">
        <TextBlock x:Name="HeadlineText" Style="{StaticResource WindowHeadline}"/>
        <TextBlock x:Name="LeadText" Style="{StaticResource WindowBody}" Margin="0,8,0,0"/>

        <!-- BEFORE the button, not after it: advice that arrives after the action it is about is
             decoration. It names what to check rather than leaving it to judgement. -->
        <Border x:Name="CautionBox" Style="{StaticResource WindowNotice}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource WindowNoticeMark}">
                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="BrowserHintText"
                           Style="{StaticResource WindowBody}"
                           Foreground="{DynamicResource WindowNoticeTitle}"
                           Margin="10,1,0,0"/>
            </Grid>
        </Border>

        <!-- The link, WHOLE and selectable: you cannot verify a link you cannot read. A RichTextBox
             because a TextBox cannot put the host in bold. -->
        <Border x:Name="LinkBox" Style="{StaticResource WindowField}" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UriLabelText"
                               FontSize="{DynamicResource SetCaptionSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource UiTextFaint}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button Grid.Column="1" x:Name="CopyLinkButton"
                            Style="{StaticResource WindowChipButton}"
                            Click="CopyLinkButton_Click"/>
                </Grid>
                <RichTextBox x:Name="VerificationUriText"
                             Margin="-5,7,0,0"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             FontFamily="Consolas, Courier New, monospace"
                             FontSize="{DynamicResource SetRowDescSize}"
                             Foreground="{DynamicResource UiBodyText}"/>
                <StackPanel x:Name="LinkPlaceholder" Margin="0,9,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource WindowPlaceholder}"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64*"/>
                            <ColumnDefinition Width="36*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="10" CornerRadius="5" Background="{DynamicResource WindowPlaceholderFaint}"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Only for a server that sends a user_code (the GitHub-style flow). Discord does not. -->
        <TextBlock x:Name="Step2Text" Style="{StaticResource WindowBody}" Margin="0,14,0,0"/>
        <Border x:Name="UserCodeBorder" Style="{StaticResource WindowField}"
                Padding="13,11" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UserCodeText"
                           Foreground="#FFFFFF"
                           FontFamily="Consolas, Courier New, monospace"
                           FontSize="{DynamicResource DialogCodeSize}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0"/>
                <Button Grid.Column="1" x:Name="CopyButton"
                        Style="{StaticResource WindowSecondaryButton}"
                        Click="CopyButton_Click"/>
            </Grid>
        </Border>

        <!-- A failure: a plain title, and what the log holds underneath. -->
        <Border x:Name="ErrorBox" Style="{StaticResource WindowNotice}" Padding="11,9" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource WindowNoticeMark}">
                    <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,1,0,0">
                    <TextBlock x:Name="ErrorTitleText"
                               FontSize="{DynamicResource SetRowTitleSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WindowNoticeTitle}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ErrorBodyText" Style="{StaticResource WindowBody}"
                               Foreground="{DynamicResource WindowNoticeBody}"
                               Margin="0,5,0,0"/>
                    <TextBlock x:Name="ErrorDetailText"
                               FontFamily="Consolas, Courier New, monospace"
                               FontSize="{DynamicResource SetDescSize}"
                               Foreground="{DynamicResource WindowMuted}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The wait, on its own row. -->
        <Border x:Name="StatusRow"
                BorderBrush="{DynamicResource WindowFooterRule}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:WindowSpinner/>
                <TextBlock Grid.Column="1" x:Name="StatusText"
                           FontSize="{DynamicResource SetRowDescSize}"
                           Foreground="{DynamicResource WindowMuted}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <TextBlock x:Name="PrivacyConsentBlock"
                   FontSize="{DynamicResource SetControlSize}"
                   Foreground="{DynamicResource WindowFineText}"
                   TextWrapping="Wrap"
                   Margin="0,14,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton"
                    Style="{StaticResource WindowSecondaryButton}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="OpenBrowserButton"
                    Style="{StaticResource WindowPrimaryButton}"
                    ToolTipService.ShowOnDisabled="True"
                    Margin="8,0,0,0"
                    Click="OpenBrowserButton_Click"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
