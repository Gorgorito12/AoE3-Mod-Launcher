<Window x:Class="WarsOfLibertyLauncher.CompatibilityLayerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBase}"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar x:Name="Chrome" Grid.Row="0"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>
    <StackPanel Grid.Row="1" Margin="24,20">
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="&#x26A0;"
                       FontSize="{StaticResource FontSizeHeading}"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Top"
                       Margin="0,0,14,0"/>
            <TextBlock Grid.Column="1"
                       x:Name="BodyText"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"/>
        </Grid>

        <!-- The exact file, so the user can find it themselves in Explorer. -->
        <TextBlock x:Name="FileLabel"
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="{StaticResource FontSizeCaption}"
                   Margin="0,0,0,4"/>
        <Border Background="{DynamicResource BgPanel}"
                CornerRadius="{StaticResource RadiusSm}"
                Padding="10,8"
                Margin="0,0,0,16">
            <TextBlock x:Name="FilePathText"
                       FontFamily="Consolas"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap"/>
        </Border>

        <CheckBox x:Name="DontAskCheck"
                  FontSize="{StaticResource FontSizeCaption}"
                  Margin="0,0,0,18"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LaterButton"
                    Click="LaterButton_Click"
                    IsCancel="True"
                    Style="{StaticResource SidebarPrimaryButton}"
                    Background="#3a3d44"
                    Padding="16,6"
                    MinWidth="100"
                    Margin="0,0,10,0"/>
            <Button x:Name="PropertiesButton"
                    Click="PropertiesButton_Click"
                    Style="{StaticResource SidebarPrimaryButton}"
                    Background="#3a3d44"
                    Padding="16,6"
                    MinWidth="150"
                    Margin="0,0,10,0"/>
            <Button x:Name="RemoveButton"
                    Click="RemoveButton_Click"
                    IsDefault="True"
                    Style="{StaticResource SidebarPrimaryButton}"
                    Padding="16,6"
                    MinWidth="120"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
