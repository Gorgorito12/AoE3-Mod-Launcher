<controls:BaseDialog x:Class="WarsOfLibertyLauncher.CompatibilityLayerDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
                     Width="520"
                     Tone="Caution">
    <StackPanel>
        <!-- Filled in code-behind by Controls.SupportLink.Build. It matters most in the
             branch where the Remove button is hidden, whose entire answer today is "review it
             yourself in Properties -> Compatibility". -->
        <ContentControl x:Name="SupportLinkHost" HorizontalAlignment="Left"/>
        <CheckBox x:Name="DontAskCheck"
                  Style="{StaticResource WindowCheckBox}"
                  Margin="0,12,0,0">
            <TextBlock x:Name="DontAskText" Style="{StaticResource DialogHint}"/>
        </CheckBox>
    </StackPanel>
</controls:BaseDialog>
