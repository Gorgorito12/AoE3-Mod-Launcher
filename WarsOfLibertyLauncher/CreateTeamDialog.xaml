<controls:BaseDialog x:Class="WarsOfLibertyLauncher.CreateTeamDialog"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
                     Width="480">
    <!-- A team's name and tag, and nothing else: the members come by invitation afterwards.
         Only collects, like every tournament dialog; the caller makes the call. -->
    <StackPanel>
        <TextBlock x:Name="NameLabel" Style="{StaticResource WindowFieldLabel}"/>
        <Border Style="{StaticResource DialogFieldBox}" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="92"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameEntry" Style="{StaticResource DialogBareText}"
                         MaxLength="40" VerticalAlignment="Center"
                         TextChanged="Field_TextChanged"/>
                <TextBox x:Name="TagEntry" Grid.Column="1" Style="{StaticResource DialogBareText}"
                         FontFamily="Consolas, Courier New, monospace" TextAlignment="Right"
                         MaxLength="8" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <TextBlock x:Name="TagHint" Style="{StaticResource DialogHint}" Margin="0,6,0,0"/>
    </StackPanel>
</controls:BaseDialog>
