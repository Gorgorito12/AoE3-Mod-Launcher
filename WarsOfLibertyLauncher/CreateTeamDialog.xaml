<Window x:Class="WarsOfLibertyLauncher.CreateTeamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="New team"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpSurface}"
        ShowInTaskbar="False">
  <!-- A team's name and tag, and nothing else: the members come by invitation afterwards.
       Only collects, like every tournament dialog; the caller makes the call. -->
  <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <controls:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="New team"
                       ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>
    <StackPanel Grid.Row="1" Margin="22,18,22,20">
        <TextBlock x:Name="NameLabel"
                   Foreground="{DynamicResource MpTextLabel}"
                   FontSize="{DynamicResource MpLabelSize}"
                   FontWeight="SemiBold"/>
        <TextBox x:Name="NameEntry"
                 Margin="0,6,0,0"
                 Style="{StaticResource MpDialogField}"
                 MaxLength="40"
                 TextChanged="Field_TextChanged"/>

        <TextBlock x:Name="TagLabel"
                   Margin="0,14,0,0"
                   Foreground="{DynamicResource MpTextLabel}"
                   FontSize="{DynamicResource MpLabelSize}"
                   FontWeight="SemiBold"/>
        <TextBox x:Name="TagEntry"
                 Margin="0,6,0,0"
                 Style="{StaticResource MpDialogField}"
                 MaxLength="8"
                 TextChanged="Field_TextChanged"/>
        <TextBlock x:Name="HintText"
                   Margin="1,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MpTextMuted}"
                   FontSize="{DynamicResource MpPillSize}"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Click="CancelButton_Click"
                    Style="{StaticResource MpLinkButton}"
                    Margin="0,0,14,0"
                    Content="Cancel"/>
            <Button x:Name="OkButton"
                    Click="OkButton_Click"
                    IsDefault="True"
                    IsEnabled="False"
                    Style="{StaticResource MpPrimaryButton}"
                    MinWidth="128"
                    Content="Create"/>
        </StackPanel>
    </StackPanel>
  </Grid>
</Window>
