<Window x:Class="WarsOfLibertyLauncher.InstallFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Install"
        Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="False">

    <!--
        "Where it installs" — rebuilt to docs/design_publicar_e_instalar (19a the dialog,
        19b the path field measured).

        THE WINDOW IS 700, NOT 560. The spec contradicts itself — its Medidas table says
        560, which is simply the geometry it was measuring, while its mockup draws the card
        at 700. House rule: when a reference disagrees with itself, the markup is the
        version somebody actually looked at. And the width IS half the fix: at 560 both
        TextBoxes were the same "*" column and NEITHER path fitted — the source lost its
        END ("…Age Of Emp") and the destination lost its START, drive letter and all. In a
        window whose only job is to have you confirm two paths, neither was confirmable.

        THE OTHER HALF IS THE THREE-PART FIELD (PathDisplay.SplitForDisplay): root + an
        elided middle + the last folder, so the drive and the folder you are choosing can
        never be the parts that fall off.

        ⚠ THE DESTINATION IS STILL A REAL TEXTBOX HOLDING THE WHOLE PATH.
        FolderTextBox.Text IS SelectedFolder — it is read back at five call sites and ends
        up in Path.GetFullPath and in the installer — so shortening the TEXT would install
        into a folder that does not exist. Only what is PAINTED changes: DestDisplay covers
        the box while it is unfocused and gets out of the way the moment you click it, which
        is also what 19b asks for ("al enfocarlo debe mostrar la ruta entera"). The source
        needs no such care: Aoe3PathTextBox was IsReadOnly and fed nothing, so it is a
        display block now and the truth lives in Aoe3SourcePath.

        SizeToContent="Height" + NoResize stay: rows collapse (the AoE3 block for an
        in-place overlay, the copy-settings row with nothing to copy from) and the window
        follows. Don't add a ScrollViewer or a fixed height — they fight the measure pass.
    -->
    <Window.Resources>
        <!-- Gold globally, and the shared TextBox template paints the focus ring by
             TargetName, so a field cannot opt out on its own. -->
        <SolidColorBrush x:Key="TextBoxFocusBrush" Color="#2F7FE0"/>

        <!-- The label above a field, and the note that rides opposite it. -->
        <Style x:Key="InLabel" TargetType="TextBlock" BasedOn="{StaticResource SetGroupLabel}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InNote" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource SetGroupLabelSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource UiTextDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- The field shell. Both rows use the SAME one, which is the alignment fix: the
             handoff's author warns that he drew the nesting as a rail INSIDE the second row
             and stole 20 px from its field, so the two "Change…" buttons stopped lining up.
             The nesting is said in the LABEL instead. -->
        <Style x:Key="InFieldShell" TargetType="Border">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource MpField}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MpRimField}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- The three pieces of a path. Root and middle dim, the folder you are actually
             choosing bright and semibold. -->
        <Style x:Key="InPathRoot" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource SetMonoSize}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextMuted}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InPathMid" TargetType="TextBlock" BasedOn="{StaticResource InPathRoot}">
            <Setter Property="Foreground" Value="{DynamicResource UiTextDim}"/>
        </Style>
        <Style x:Key="InPathLeaf" TargetType="TextBlock" BasedOn="{StaticResource InPathRoot}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MpTextPrimary}"/>
        </Style>

        <Style x:Key="InChangeButton" TargetType="Button" BasedOn="{StaticResource SetActionButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="{DynamicResource SetDescSize}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                           ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

        <StackPanel Grid.Row="1" Margin="20,18,20,20">
            <TextBlock x:Name="HeaderText" Style="{StaticResource SetSectionTitle}"/>
            <TextBlock x:Name="DescriptionText"
                       FontSize="{DynamicResource SetControlSize}"
                       Foreground="{DynamicResource MpTextBody}"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       LineStackingStrategy="BlockLineHeight"
                       Margin="0,6,0,0"/>

            <!-- One card holds both paths and the space line, because they are one
                 question: where the base comes from, where the mod lands, and whether it
                 fits. -->
            <Border Style="{StaticResource SetCard}" Padding="13" Margin="0,16,0,0">
                <StackPanel>
                    <!-- AoE3 source — the folder to CLONE. Collapsed as a block for an
                         in-place overlay, which clones nothing: the base game is already at
                         the destination, so asking for a source there would block an
                         install that needs none. -->
                    <StackPanel x:Name="Aoe3Row">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblAoE3Folder" Grid.Column="0"
                                       Style="{StaticResource InLabel}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="Aoe3StatusDot"
                                         Width="6" Height="6"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <TextBlock x:Name="Aoe3StatusText"
                                           FontSize="{DynamicResource SetGroupLabelSize}"
                                           FontWeight="Medium"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource InFieldShell}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="Aoe3PathRoot" Style="{StaticResource InPathRoot}"/>
                                    <TextBlock x:Name="Aoe3PathMid"  Style="{StaticResource InPathMid}"/>
                                    <TextBlock x:Name="Aoe3PathLeaf" Style="{StaticResource InPathLeaf}"/>
                                    <TextBlock x:Name="Aoe3PathEmpty" Style="{StaticResource InPathMid}"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BrowseAoE3InDialogButton"
                                    Grid.Column="1"
                                    Style="{StaticResource InChangeButton}"
                                    Click="BrowseAoE3InDialogButton_Click"/>
                        </Grid>

                        <!-- The long "AoE3 was not detected" explanation, only when there
                             is nothing to show above. -->
                        <TextBlock x:Name="Aoe3MissingText"
                                   FontSize="{DynamicResource SetGroupLabelSize}"
                                   Foreground="{DynamicResource MpCautionText}"
                                   TextWrapping="Wrap"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight"
                                   Margin="0,7,0,0"
                                   Visibility="Collapsed"/>

                        <!-- Manual "search my Asian Dynasties" — exhaustive content scan,
                             shown only when no source is set. The automatic pre-fill
                             already runs a conservative scan; this is the user-initiated
                             exhaustive one. -->
                        <!-- Auto width, not one of the fixed action widths: those exist to
                             keep a COLUMN of buttons from zigzagging, and this one stands
                             alone with a caption long enough to be clipped by 132 px. -->
                        <Button x:Name="SearchAoe3Button"
                                Style="{StaticResource SetFooterGhostButton}"
                                Height="30"
                                HorizontalAlignment="Left"
                                Margin="0,9,0,0"
                                Visibility="Collapsed"
                                Click="SearchAoe3Button_Click"/>
                    </StackPanel>

                    <!-- Destination. The "↳" and the note beside it are the NESTING, shown
                         only when the destination really is inside the source — the row
                         itself keeps exactly the geometry of the one above. -->
                    <StackPanel x:Name="DestBlock" Margin="0,11,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NestGlyph" Grid.Column="0"
                                       Text="↳"
                                       FontSize="{DynamicResource SetMonoSize}"
                                       Foreground="{DynamicResource UiTextGhost}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="LblFolder" Grid.Column="1"
                                       Style="{StaticResource InLabel}"/>
                            <TextBlock x:Name="NestNote" Grid.Column="3"
                                       Style="{StaticResource InNote}"/>
                        </Grid>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <!-- The real value, always the WHOLE path. -->
                                <TextBox x:Name="FolderTextBox"
                                         Height="34"
                                         Background="{DynamicResource MpField}"
                                         Foreground="{DynamicResource MpTextPrimary}"
                                         CaretBrush="{DynamicResource MpActionText}"
                                         SelectionBrush="{DynamicResource MpAction}"
                                         BorderBrush="{DynamicResource MpRimField}"
                                         BorderThickness="1"
                                         Padding="11,0"
                                         VerticalContentAlignment="Center"
                                         FontFamily="{DynamicResource MonoFont}"
                                         FontSize="{DynamicResource SetMonoSize}"
                                         TextChanged="FolderTextBox_TextChanged"
                                         GotKeyboardFocus="FolderTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="FolderTextBox_LostKeyboardFocus"/>
                                <!-- What you SEE while the box is not focused. Not
                                     hit-testable, so a click goes straight through to the
                                     box underneath and the whole path comes back. -->
                                <Border x:Name="DestDisplay"
                                        Style="{StaticResource InFieldShell}"
                                        IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="DestPathRoot" Style="{StaticResource InPathRoot}"/>
                                        <TextBlock x:Name="DestPathMid"  Style="{StaticResource InPathMid}"/>
                                        <TextBlock x:Name="DestPathLeaf" Style="{StaticResource InPathLeaf}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Button x:Name="BrowseButton"
                                    Grid.Column="1"
                                    Style="{StaticResource InChangeButton}"
                                    Click="BrowseButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- What it needs and what you have, in ONE line. They used to be 200 px
                         apart: the requirement was the tail of the header paragraph ("About
                         12 GB… recommended") and the figure was a grey line under the field
                         — and the MEASURED requirement only ever appeared when it was short. -->
                    <Border x:Name="DiskSpaceBox"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="11,9"
                            Margin="0,12,0,0"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DiskSpaceGlyph"
                                       FontSize="{DynamicResource SetGroupLabelSize}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,0"/>
                            <TextBlock x:Name="DiskSpaceText"
                                       FontSize="{DynamicResource SetMonoSize}"
                                       FontFamily="{DynamicResource BodyFont}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- First-run reminder: open the original game at least once before installing
                 (non-blocking, shown only when AoE3's user-data folder is missing). -->
            <Border x:Name="FirstRunWarningBox"
                    Style="{StaticResource SetNoticeAmber}"
                    Margin="0,13,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="FirstRunWarningText"
                           FontSize="{DynamicResource SetGroupLabelSize}"
                           TextWrapping="Wrap"
                           LineHeight="16"
                           LineStackingStrategy="BlockLineHeight"/>
            </Border>

            <!-- Copy the player's graphics / sound / hotkeys from a mod they already have.

                 The WHOLE block is collapsed when there is no other mod to copy from, which
                 is the case for anyone installing their first one — so the question only
                 ever appears to somebody who can answer it. Eligibility is decided by the
                 caller through GameSettingsStore.CanImportFrom, the same rule the settings
                 page uses.

                 The copy is NOT made here. This dialog only reports the choice; see
                 ModState.PendingSettingsImportFrom for why it usually cannot happen until
                 the mod has been opened once. -->
            <Border x:Name="CopySettingsRow"
                    Style="{StaticResource SetNoticeInfo}"
                    Padding="13"
                    Margin="0,13,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="CopySettingsCheck"
                              Grid.Column="0"
                              Style="{StaticResource SetCheckBox}"
                              VerticalAlignment="Top"
                              Margin="0,1,0,0"
                              Click="CopySettingsCheck_Click"/>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CopySettingsTitle"
                                       Grid.Column="0"
                                       FontSize="{DynamicResource SetBodySize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MpTextPrimary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <ComboBox x:Name="CopySettingsCombo"
                                      Grid.Column="1"
                                      Style="{StaticResource SetCompactCombo}"
                                      Height="30"
                                      MinWidth="180"
                                      Margin="11,0,0,0"
                                      IsEnabled="False"/>
                        </Grid>
                        <TextBlock x:Name="CopySettingsHint"
                                   FontSize="{DynamicResource SetMonoSize}"
                                   FontFamily="{DynamicResource BodyFont}"
                                   Foreground="{DynamicResource MpTextMuted}"
                                   TextWrapping="Wrap"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Validation warning -->
            <TextBlock x:Name="WarningText"
                       FontSize="{DynamicResource SetGroupLabelSize}"
                       Foreground="{DynamicResource MpDestructiveText}"
                       TextWrapping="Wrap"
                       Margin="0,13,0,0"
                       Visibility="Collapsed"/>

            <Border BorderBrush="{DynamicResource UiRimSeam}"
                    BorderThickness="0,1,0,0"
                    Margin="0,17,0,0"
                    Padding="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource MpLinkButton}"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0"
                            Click="CancelButton_Click"/>
                    <Button x:Name="OkButton"
                            Style="{StaticResource SetFooterPrimaryButton}"
                            Height="36"
                            MinWidth="136"
                            IsDefault="True"
                            Click="OkButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
