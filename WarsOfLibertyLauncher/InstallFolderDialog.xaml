<Window x:Class="WarsOfLibertyLauncher.InstallFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Install"
        Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource MpAppBg}"
        ShowInTaskbar="False">

    <!--
        "Where it installs": docs/design_publicar_e_instalar (19a, 19b) on the base of design 74,
        with the mod's image and colour, glass cards and solid secondary buttons.

        THE WINDOW IS 700, NOT 560. The spec contradicts itself — its Medidas table says
        560, which is simply the geometry it was measuring, while its mockup draws the card
        at 700. House rule: when a reference disagrees with itself, the markup is the
        version somebody actually looked at. And the width IS half the fix: at 560 both
        TextBoxes were the same "*" column and NEITHER path fitted — the source lost its
        END ("…Age Of Emp") and the destination lost its START, drive letter and all. In a
        window whose only job is to have you confirm two paths, neither was confirmable.

        THE OTHER HALF IS THE THREE-PART FIELD (PathDisplay.SplitForDisplay): root + an
        elided middle + the last folder, so the drive and the folder you are choosing can
        never be the parts that fall off.

        ⚠ THE DESTINATION IS STILL A REAL TEXTBOX HOLDING THE WHOLE PATH.
        SelectedFolder is DERIVED from FolderTextBox.Text (normalised and made a full path by
        InstallFolderRules), and the box is read back at five call sites that end up in
        Path.GetFullPath and in the installer — so shortening the TEXT would install
        into a folder that does not exist. Only what is PAINTED changes: DestDisplay covers
        the box while it is unfocused and gets out of the way the moment you click it, which
        is also what 19b asks for ("al enfocarlo debe mostrar la ruta entera"). The source
        needs no such care: Aoe3PathTextBox was IsReadOnly and fed nothing, so it is a
        display block now and the truth lives in Aoe3SourcePath.

        SizeToContent="Height" + NoResize stay: rows collapse (the AoE3 block for an
        in-place overlay, the copy-settings row with nothing to copy from) and the window
        follows. Don't add a ScrollViewer or a fixed height — they fight the measure pass.
    -->
    <Window.Resources>
        <!-- The window puts the mod's colour here too: the shared TextBox template paints the
             focus ring by TargetName, so a field cannot opt out on its own. -->
        <SolidColorBrush x:Key="TextBoxFocusBrush" Color="#2F7FE0"/>

        <Style x:Key="InLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource DialogBodySize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowStrongText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InNote" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
        <!-- The field shell. Both rows use the SAME one, which keeps the two "Change…" buttons
             on one line; the nesting is said in the label. -->
        <Style x:Key="InFieldShell" TargetType="Border">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource MpField}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowFieldRim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <!-- The three pieces of a path. Root and middle dim, the folder you are actually
             choosing bright and semibold. -->
        <Style x:Key="InPathRoot" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource SetRowDescSize}"/>
            <Setter Property="Foreground" Value="#8EA4C0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InPathMid" TargetType="TextBlock" BasedOn="{StaticResource InPathRoot}">
            <Setter Property="Foreground" Value="#6D829D"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="InPathLeaf" TargetType="TextBlock" BasedOn="{StaticResource InPathRoot}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
        </Style>
        <Style x:Key="InChangeButton" TargetType="Button" BasedOn="{StaticResource WindowSecondaryButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="112"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                           ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

        <StackPanel Grid.Row="1" Margin="22,26,22,20">
            <TextBlock x:Name="HeaderText" Style="{StaticResource WindowHeadline}"
                       FontSize="{DynamicResource DialogTitleSize}"
                       Margin="2,0,2,0"/>
            <TextBlock x:Name="DescriptionText" Style="{StaticResource WindowBody}"
                       MaxWidth="400"
                       HorizontalAlignment="Left"
                       Margin="2,7,2,0"/>

            <!-- One card holds both paths and the space line, because they are one question:
                 where the base comes from, where the mod lands, and whether it fits. -->
            <Border Style="{StaticResource WindowCard}" Padding="16" Margin="0,20,0,0">
                <StackPanel>
                    <!-- AoE3 source: the folder to CLONE. Collapsed for an in-place overlay,
                         which clones nothing. -->
                    <StackPanel x:Name="Aoe3Row" Margin="0,0,0,14">
                        <Grid MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblAoE3Folder" Style="{StaticResource InLabel}"
                                       Margin="0,0,10,0"/>
                            <Border Grid.Column="1" Height="24" CornerRadius="12" Padding="10,0"
                                    Background="#8C0A1321" BorderThickness="1"
                                    BorderBrush="{DynamicResource WindowCardRim}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="Aoe3StatusDot" Width="7" Height="7"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="Aoe3StatusText"
                                               FontSize="{DynamicResource SetCaptionSize}"
                                               FontWeight="SemiBold"
                                               Foreground="#E8EEF6"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Aoe3PathShell" Grid.Column="0" Style="{StaticResource InFieldShell}">
                                <Grid>
                                    <controls:PathLinePanel VerticalAlignment="Center">
                                        <TextBlock x:Name="Aoe3PathRoot" Style="{StaticResource InPathRoot}"/>
                                        <TextBlock x:Name="Aoe3PathMid"  Style="{StaticResource InPathMid}"/>
                                        <TextBlock x:Name="Aoe3PathLeaf" Style="{StaticResource InPathLeaf}"/>
                                    </controls:PathLinePanel>
                                    <TextBlock x:Name="Aoe3PathEmpty"
                                               FontSize="{DynamicResource SetRowDescSize}"
                                               Foreground="{DynamicResource WindowFineText}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Button x:Name="BrowseAoE3InDialogButton" Grid.Column="1"
                                    Style="{StaticResource InChangeButton}"
                                    Click="BrowseAoE3InDialogButton_Click"/>
                        </Grid>
                        <!-- Only with nothing to show above: what is missing, and the exhaustive
                             search of the disks, which the automatic scan is not. -->
                        <Grid x:Name="Aoe3MissingRow" Margin="0,9,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Aoe3MissingText"
                                       FontSize="{DynamicResource SetRowDescSize}"
                                       Foreground="{DynamicResource WindowNoticeTitle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,12,0"/>
                            <Button x:Name="SearchAoe3Button" Grid.Column="1"
                                    Style="{StaticResource WindowSecondaryButton}"
                                    VerticalAlignment="Center"
                                    Click="SearchAoe3Button_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Destination. The "↳" and the note beside it are the NESTING, shown only
                         when the destination really is inside the source. -->
                    <StackPanel x:Name="DestBlock">
                        <Grid MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NestGlyph" Grid.Column="0"
                                       Text="↳"
                                       FontFamily="{DynamicResource MonoFont}"
                                       FontSize="{DynamicResource DialogBodySize}"
                                       FontWeight="SemiBold"
                                       Foreground="#8EA4C0"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock x:Name="LblFolder" Grid.Column="1"
                                       Style="{StaticResource InLabel}"/>
                            <TextBlock x:Name="NestNote" Grid.Column="3"
                                       Style="{StaticResource InNote}"/>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <!-- The real value, always the WHOLE path. -->
                                <TextBox x:Name="FolderTextBox"
                                         Height="34"
                                         Background="{DynamicResource MpField}"
                                         Foreground="{DynamicResource UiBodyText}"
                                         CaretBrush="{DynamicResource MpActionText}"
                                         SelectionBrush="{DynamicResource MpAction}"
                                         BorderBrush="{DynamicResource WindowFieldRim}"
                                         BorderThickness="1"
                                         Padding="11,0"
                                         VerticalContentAlignment="Center"
                                         FontFamily="{DynamicResource MonoFont}"
                                         FontSize="{DynamicResource SetRowDescSize}"
                                         TextChanged="FolderTextBox_TextChanged"
                                         GotKeyboardFocus="FolderTextBox_GotKeyboardFocus"
                                         LostKeyboardFocus="FolderTextBox_LostKeyboardFocus"/>
                                <!-- What you SEE while the box is not focused. Not hit-testable,
                                     so a click goes straight through to the box underneath and
                                     the whole path comes back. -->
                                <Border x:Name="DestDisplay"
                                        Style="{StaticResource InFieldShell}"
                                        IsHitTestVisible="False">
                                    <Grid>
                                        <controls:PathLinePanel VerticalAlignment="Center">
                                            <TextBlock x:Name="DestPathRoot" Style="{StaticResource InPathRoot}"/>
                                            <TextBlock x:Name="DestPathMid"  Style="{StaticResource InPathMid}"/>
                                            <TextBlock x:Name="DestPathLeaf" Style="{StaticResource InPathLeaf}"/>
                                        </controls:PathLinePanel>
                                        <TextBlock x:Name="DestPlaceholder"
                                                   FontSize="{DynamicResource SetRowDescSize}"
                                                   Foreground="{DynamicResource WindowFineText}"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Button x:Name="BrowseButton" Grid.Column="1"
                                    Style="{StaticResource InChangeButton}"
                                    Click="BrowseButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- What it needs and what you have, in ONE line. -->
                    <Border x:Name="DiskSpaceBox"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Margin="0,14,0,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DiskSpaceMark" Width="20" Height="20" CornerRadius="10"
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="DiskSpaceGlyph" FontSize="11" FontWeight="Bold"
                                           Foreground="#0F1C2E"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="DiskSpaceText" Grid.Column="1"
                                       Style="{StaticResource WindowBody}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- First-run reminder: open the original game at least once before installing
                 (non-blocking, shown only when AoE3's user-data folder is missing). -->
            <Border x:Name="FirstRunWarningBox"
                    Style="{StaticResource WindowNotice}"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="FirstRunWarningText"
                           FontSize="{DynamicResource SetRowDescSize}"
                           Foreground="{DynamicResource WindowNoticeTitle}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Copy the player's graphics / sound / hotkeys from a mod they already have.
                 Collapsed when there is no other mod to copy from, so the question only ever
                 appears to somebody who can answer it. Eligibility is decided by the caller
                 through GameSettingsStore.CanImportFrom. The copy is NOT made here: this dialog
                 only reports the choice, see ModState.PendingSettingsImportFrom. -->
            <Border x:Name="CopySettingsRow"
                    Style="{StaticResource WindowCard}"
                    Padding="16,14"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="CopySettingsCheck"
                                  Style="{StaticResource WindowCheckBox}"
                                  VerticalAlignment="Center"
                                  Click="CopySettingsCheck_Click">
                            <TextBlock x:Name="CopySettingsTitle"
                                       FontSize="{DynamicResource DialogBodySize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WindowStrongText}"
                                       Margin="-2,0,0,0"
                                       VerticalAlignment="Center"/>
                        </CheckBox>
                        <ComboBox x:Name="CopySettingsCombo"
                                  Style="{StaticResource SetCompactCombo}"
                                  Height="32"
                                  MinWidth="170"
                                  Margin="10,0,0,0"
                                  IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="CopySettingsHint"
                               FontSize="{DynamicResource SetRowDescSize}"
                               Foreground="{DynamicResource WindowMuted}"
                               TextWrapping="Wrap"
                               Margin="26,8,0,0"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Why Install is off, beside the button it explains. -->
                <TextBlock x:Name="WarningText"
                           FontSize="{DynamicResource SetRowDescSize}"
                           Foreground="{DynamicResource WindowNoticeTitle}"
                           TextWrapping="Wrap"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Visibility="Collapsed"/>
                <Button x:Name="CancelButton" Grid.Column="1"
                        Style="{StaticResource WindowSecondaryButton}"
                        MinWidth="112"
                        Click="CancelButton_Click"/>
                <Button x:Name="OkButton" Grid.Column="2"
                        Style="{StaticResource WindowPrimaryButton}"
                        MinWidth="136"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Click="OkButton_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
