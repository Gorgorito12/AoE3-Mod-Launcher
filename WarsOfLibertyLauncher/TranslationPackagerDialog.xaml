<Window x:Class="WarsOfLibertyLauncher.TranslationPackagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="Package translation"
        Width="720" Height="720"
        MinHeight="600" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        ShowInTaskbar="False">

    <!-- Turns translated XMLs into a pack ready to publish (design 102): five cards, one blue
         button, and every problem marked on the field it belongs to. -->

    <Window.Resources>
        <SolidColorBrush x:Key="TextBoxFocusBrush" Color="#2F7FE0"/>

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource WindowCardLabel}"/>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowFineText}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="MonoBig" TargetType="TextBox" BasedOn="{StaticResource WindowInputMono}">
            <Setter Property="FontSize" Value="{DynamicResource DialogBodySize}"/>
        </Style>

        <!-- The line the language menu will show. Both copies, form and result, share it. -->
        <Style x:Key="PreviewBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#66050A12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowFooterRule}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>
        <Style x:Key="PreviewName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SetRowTitleSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowStrongText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="PreviewVersion" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource UiBodyText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="PreviewNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SetControlSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" x:Name="TitleBarControl"
                           TitleIcon="pack://application:,,,/Aoe3ModLauncher;component/AppIcon.png"
                           ShowMinimize="False" ShowMaximize="True" ShowClose="True"/>

        <ScrollViewer Grid.Row="1" x:Name="BodyScroll" Padding="0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="22,22,22,20">

                <!-- THE FORM -->
                <StackPanel x:Name="FormPanel">
                    <TextBlock x:Name="HeaderText" Style="{StaticResource WindowHeadline}"/>
                    <TextBlock x:Name="DescriptionText" Style="{StaticResource WindowBody}"
                               MaxWidth="600" HorizontalAlignment="Left" Margin="0,8,0,0"/>

                    <!-- Mod -->
                    <Border Style="{StaticResource WindowCard}" Padding="16,13,16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SectionModHeader" Style="{StaticResource CardTitle}"/>
                            <ComboBox x:Name="ModCombo" Height="40" Margin="0,8,0,0"
                                      Background="{DynamicResource MpField}"
                                      BorderBrush="{DynamicResource WindowFieldRim}"
                                      SelectionChanged="ModCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="6"
                                                    Background="{Binding Icon}"
                                                    BorderBrush="{DynamicResource WindowCardRim}"
                                                    BorderThickness="1"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       Foreground="{Binding NameBrush}"
                                                       FontSize="{DynamicResource SetRowTitleSize}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,10,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Version}"
                                                       FontFamily="Consolas, Courier New, monospace"
                                                       FontSize="{DynamicResource SetControlSize}"
                                                       Foreground="{DynamicResource WindowMuted}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="HintMod" Style="{StaticResource FieldHint}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Your translation -->
                    <Border Style="{StaticResource WindowCard}" Padding="16,13,16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SectionIdentityHeader" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="LblId" Style="{StaticResource WindowInputLabel}"/>
                                    <Border x:Name="IdShell" Style="{StaticResource WindowInputShell}">
                                        <TextBox x:Name="IdBox" Style="{StaticResource MonoBig}"/>
                                    </Border>
                                    <TextBlock x:Name="HintId" Style="{StaticResource FieldHint}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="LblName" Style="{StaticResource WindowInputLabel}"/>
                                    <Border x:Name="NameShell" Style="{StaticResource WindowInputShell}">
                                        <TextBox x:Name="NameBox" Style="{StaticResource WindowInputText}"/>
                                    </Border>
                                    <TextBlock x:Name="HintName" Style="{StaticResource FieldHint}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2">
                                    <TextBlock x:Name="LblAuthor" Style="{StaticResource WindowInputLabel}"/>
                                    <Border Style="{StaticResource WindowInputShell}">
                                        <TextBox x:Name="AuthorBox" Style="{StaticResource WindowInputText}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock x:Name="LblVersion" Style="{StaticResource WindowInputLabel}"/>
                                    <Border x:Name="VersionShell" Style="{StaticResource WindowInputShell}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="VersionBox" Style="{StaticResource MonoBig}"/>
                                            <Border Grid.Column="1" x:Name="VersionProposed"
                                                    Style="{StaticResource WindowProposedChip}">
                                                <TextBlock x:Name="VersionProposedText"
                                                           Style="{StaticResource WindowProposedChipText}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="HintVersion" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="VersionExistsBox" Style="{StaticResource WindowNotice}"
                                    Margin="0,12,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource WindowNoticeMark}">
                                        <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" x:Name="VersionExistsText"
                                               FontSize="{DynamicResource SetRowDescSize}"
                                               Foreground="{DynamicResource WindowNoticeTitle}"
                                               TextWrapping="Wrap"
                                               Margin="10,1,0,0"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="LblDescription" Style="{StaticResource WindowInputLabel}"
                                       Margin="0,12,0,6"/>
                            <Border Style="{StaticResource WindowInputShell}" Height="Auto" MinHeight="52"
                                    Padding="11,8">
                                <Grid>
                                    <TextBlock x:Name="DescriptionPlaceholder"
                                               Style="{StaticResource WindowInputPlaceholder}"
                                               FontFamily="{DynamicResource BodyFont}"
                                               FontSize="{DynamicResource DialogBodySize}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>
                                    <TextBox x:Name="DescriptionBox" Style="{StaticResource WindowInputText}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource PreviewBox}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="LblPreviewForm" Style="{StaticResource WindowFieldLabel}"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="FormPreviewName" Style="{StaticResource PreviewName}"/>
                                        <TextBlock x:Name="FormPreviewVersion" Style="{StaticResource PreviewVersion}"/>
                                        <TextBlock x:Name="FormPreviewCompat" Style="{StaticResource PreviewNote}"/>
                                        <TextBlock x:Name="FormPreviewAuthor" Style="{StaticResource PreviewNote}"
                                                   Foreground="{DynamicResource WindowFineText}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Files -->
                    <Border Style="{StaticResource WindowCard}" Padding="16,13,16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SectionSourceHeader" Style="{StaticResource CardTitle}"/>

                            <TextBlock x:Name="LblFolder" Style="{StaticResource WindowInputLabel}" Margin="0,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="FolderShell" Style="{StaticResource WindowInputShell}"
                                        Height="Auto" MinHeight="32">
                                    <Grid>
                                        <WrapPanel x:Name="FolderChips" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FolderPlaceholder"
                                                   Style="{StaticResource WindowInputPlaceholder}"/>
                                        <TextBox x:Name="FolderBox" Style="{StaticResource WindowInputMono}"/>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="2" x:Name="BrowseFolderButton"
                                        Style="{StaticResource WindowBrowseButton}" VerticalAlignment="Top"
                                        Click="BrowseFolderButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="HintFolder" Style="{StaticResource FieldHint}"/>

                            <TextBlock x:Name="LblOriginals" Style="{StaticResource WindowInputLabel}" Margin="0,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource WindowInputShell}" Height="Auto" MinHeight="32">
                                    <Grid>
                                        <WrapPanel x:Name="OriginalsChips" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="OriginalsPlaceholder"
                                                   Style="{StaticResource WindowInputPlaceholder}"/>
                                        <TextBox x:Name="OriginalsBox" Style="{StaticResource WindowInputMono}"/>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="2" x:Name="BrowseOriginalsButton"
                                        Style="{StaticResource WindowBrowseButton}" VerticalAlignment="Top"
                                        Click="BrowseOriginalsButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="HintOriginals" Style="{StaticResource FieldHint}"/>
                        </StackPanel>
                    </Border>

                    <!-- Compatibility -->
                    <Border Style="{StaticResource WindowCard}" Padding="16,13,16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SectionCompatHeader" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="CompatCurrentCheck" Style="{StaticResource WindowCheckBox}"
                                      IsChecked="True" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="CompatCurrentText"
                                               FontSize="{DynamicResource SetRowTitleSize}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource WindowStrongText}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CompatCurrentHint" Style="{StaticResource FieldHint}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="LblCompatExtra" Style="{StaticResource WindowInputLabel}" Margin="0,10,0,6"/>
                            <Border x:Name="CompatShell" Style="{StaticResource WindowInputShell}">
                                <Grid>
                                    <TextBlock x:Name="CompatPlaceholder" Style="{StaticResource WindowInputPlaceholder}"/>
                                    <TextBox x:Name="CompatExtraBox" Style="{StaticResource WindowInputMono}"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="HintCompat" Style="{StaticResource FieldHint}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Save to -->
                    <TextBlock x:Name="LblOutput" Style="{StaticResource WindowInputLabel}" Margin="0,14,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="OutputShell" Style="{StaticResource WindowInputShell}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputBox" Style="{StaticResource WindowInputMono}"/>
                                <Border Grid.Column="1" x:Name="OutputProposed"
                                        Style="{StaticResource WindowProposedChip}">
                                    <TextBlock x:Name="OutputProposedText"
                                               Style="{StaticResource WindowProposedChipText}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Button Grid.Column="2" x:Name="BrowseOutputButton"
                                Style="{StaticResource WindowBrowseButton}"
                                Click="BrowseOutputButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="HintOutput" Style="{StaticResource FieldHint}" Visibility="Collapsed"/>

                    <Border x:Name="ErrorBox" Style="{StaticResource WindowNotice}" Padding="11,9"
                            Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource WindowNoticeMark}">
                                <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#0F1C2E"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,1,0,0">
                                <TextBlock x:Name="ErrorTitle"
                                           FontSize="{DynamicResource DialogBodySize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WindowNoticeTitle}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="ErrorBody"
                                           FontSize="{DynamicResource SetRowDescSize}"
                                           Foreground="{DynamicResource WindowNoticeBody}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- THE RESULT -->
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Top"
                                Background="#2E4FD68A" BorderBrush="#804FD68A" BorderThickness="1">
                            <TextBlock Text="&#x2713;" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource WindowSafeTick}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                            <TextBlock x:Name="ResultHeaderText" Style="{StaticResource WindowHeadline}"/>
                            <TextBlock x:Name="ResultSummaryText" Style="{StaticResource WindowBody}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource WindowCard}" Padding="16,13,16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResultFilesHeader" Style="{StaticResource CardTitle}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="OpenFolderInCardButton"
                                        Style="{StaticResource WindowBrowseButton}"
                                        Click="OpenFolderButton_Click"/>
                            </Grid>
                            <StackPanel x:Name="ResultFiles"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PreviewBox}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="LblPreview" Style="{StaticResource WindowFieldLabel}"/>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock x:Name="ResultPreviewName" Style="{StaticResource PreviewName}"/>
                                <TextBlock x:Name="ResultPreviewVersion" Style="{StaticResource PreviewVersion}"/>
                                <TextBlock x:Name="ResultPreviewCompat" Style="{StaticResource PreviewNote}"/>
                                <TextBlock x:Name="ResultPreviewAuthor" Style="{StaticResource PreviewNote}"
                                           Foreground="{DynamicResource WindowFineText}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WindowCard}" BorderBrush="#592F7FE0"
                            Padding="16,13,16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ResultInstructionsHeader" Style="{StaticResource CardTitle}"
                                       Foreground="{DynamicResource WindowIncremental}"/>
                            <StackPanel x:Name="ResultSteps"/>
                            <TextBlock x:Name="ResultInstructionsNote" Style="{StaticResource FieldHint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WindowCard}" Padding="16,13,16,14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="IndexSectionHeader" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="IndexHint" Style="{StaticResource WindowBody}"
                                       Foreground="{DynamicResource WindowSoftText}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="LblIndexZipUrl" Style="{StaticResource WindowInputLabel}" Margin="0,10,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource WindowInputShell}">
                                    <Grid>
                                        <TextBlock x:Name="IndexZipUrlPlaceholder"
                                                   Style="{StaticResource WindowInputPlaceholder}"/>
                                        <TextBox x:Name="IndexZipUrlBox" Style="{StaticResource WindowInputMono}"/>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="2" x:Name="AddToIndexButton"
                                        Style="{StaticResource WindowBrowseButton}"
                                        Click="AddToIndexButton_Click"/>
                            </Grid>
                            <Border x:Name="IndexResultBox" CornerRadius="8" BorderThickness="1"
                                    Padding="11,8" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IndexResultMark" FontWeight="Bold"
                                               FontSize="{DynamicResource SetControlSize}"
                                               Margin="0,1,9,0"/>
                                    <TextBlock Grid.Column="1" x:Name="IndexResultText"
                                               FontSize="{DynamicResource SetRowDescSize}"
                                               Foreground="{DynamicResource UiBodyText}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource GlassFooter}"
                BorderBrush="{DynamicResource WindowFooterRule}"
                BorderThickness="0,1,0,0"
                Padding="22,12,22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterNote"
                           FontSize="{DynamicResource SetControlSize}"
                           Foreground="{DynamicResource WindowFineText}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" x:Name="FormFooter" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Style="{StaticResource WindowSecondaryButton}"
                            MinWidth="112" Click="CancelButton_Click"/>
                    <Button x:Name="GenerateButton" Style="{StaticResource WindowPrimaryButton}"
                            MinWidth="136" Margin="8,0,0,0" Click="GenerateButton_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" x:Name="ResultFooter" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="OpenFolderButton" Style="{StaticResource WindowSecondaryButton}"
                            MinWidth="112" Click="OpenFolderButton_Click"/>
                    <Button x:Name="DoneButton" Style="{StaticResource WindowPrimaryButton}"
                            MinWidth="136" Margin="8,0,0,0" Click="DoneButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
